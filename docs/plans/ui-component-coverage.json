    "exactJsxAttributes": "accepted: quoted record keys, exact hyphenated JSX names, ownership and incomplete-source editor help",
    "semanticElements": "accepted portable subset: tags, naming, roles, live content, hidden controls and orientation; arbitrary ARIA/HTML remains unsupported",
    "composedControls": "accepted portable foundation: owned mixed children, inline containers, optional handlers, noninteractive phrasing validation, exact owning array widening, resource-union clone rejection and inferred native callback identities",
    "editableStateAndIme": "pending",
    "layoutAndTheme": "accepted portable layout, alpha/OKLCH colors, surface rings, bounded structural predicates, inherited numeric spacing, generic typography, independent edges/corners and rounded paint/pointer clipping; media, container queries and named font assets remain pending",
    "focusAndOverlays": "pending",
    "baseComponentComposition": "pending",
    "reactiveExpressions": "pending: computed strings/trees are construction-time snapshots; direct signals and disabled predicates refresh",
    "ownedPropForwarding": "accepted: JSX consumes sources, projects declared props, fills omitted optional fields, rejects explicit unknown attributes and releases excess fields exactly once; ordinary spread/rest remains checked-copy"
  },
