{
  "build": {
    "entry": "src/main.tsr",
    "output": "target/tsrust-docs"
  },
  "name": "tsrust-docs",
  "schemaVersion": 1,
  "ui": {
    "components": "src/components/ui",
    "lock": "ui-components.lock.json",
    "target": {
      "embedded": false,
      "native": true,
      "web": true
    },
    "theme": {
      "dark": {
        "accent": "#3f3f46",
        "accentForeground": "@foreground",
        "background": "#09090b",
        "border": "#3f3f46",
        "card": "#18181b",
        "cardForeground": "@foreground",
        "destructive": "#f87171",
        "destructiveForeground": "#18181b",
        "foreground": "#fafafa",
        "input": "@border",
        "muted": "#27272a",
        "mutedForeground": "#a1a1aa",
        "primary": "#ffad8a",
        "primaryForeground": "#18181b",
        "ring": "#a1a1aa",
        "secondary": "#27272a",
        "secondaryForeground": "@foreground",
        "syntaxKeyword": "#fda4af",
        "syntaxString": "#86efac",
        "syntaxNumber": "#fcd34d",
        "syntaxType": "#93c5fd"
      },
      "light": {
        "accent": "#e4e4e7",
        "accentForeground": "@foreground",
        "background": "#fafafa",
        "border": "#d4d4d8",
        "card": "#ffffff",
        "cardForeground": "@foreground",
        "destructive": "#b91c1c",
        "destructiveForeground": "#ffffff",
        "foreground": "#18181b",
        "input": "@border",
        "muted": "#f4f4f5",
        "mutedForeground": "#52525b",
        "primary": "#a93819",
        "primaryForeground": "#fafafa",
        "ring": "#71717a",
        "secondary": "#f4f4f5",
        "secondaryForeground": "@foreground",
        "syntaxKeyword": "#9f1239",
        "syntaxString": "#166534",
        "syntaxNumber": "#92400e",
        "syntaxType": "#1e40af"
      },
      "radius": {
        "lg": 12,
        "md": 8,
        "sm": 4,
        "xl": 12
      },
      "schemaVersion": 1,
      "spacing": {
        "lg": 24,
        "md": 16,
        "sm": 8
      },
      "typography": {
        "base": 16,
        "xl": 24
      }
    }
  },
  "documentation": {
    "content": "content",
    "inventory": "plans/ui-component-coverage.json",
    "apiSources": [
      "std:ui",
      "src/components/ui/button.tsrx",
      "src/components/ui/card.tsrx",
      "src/components/ui/input.tsrx",
      "src/components/ui/textarea.tsrx",
      "src/components/ui/label.tsrx",
      "src/components/ui/kbd.tsrx",
      "src/components/ui/separator.tsrx",
      "src/components/ui/aspect-ratio.tsrx",
      "src/components/ui/alert.tsrx"
    ],
    "examples": [
      {
        "id": "counter",
        "source": "src/examples/counter.tsrx",
        "export": "Counter",
        "kind": "component"
      },
      {
        "id": "strings-trim",
        "source": "src/examples/strings-trim.tsr",
        "export": "trimmed",
        "kind": "code"
      },
      {
        "id": "rust-message",
        "source": "src/examples/rust-message.tsr",
        "export": "rustMessage",
        "kind": "code"
      },
      {
        "id": "native-service",
        "source": "src/examples/native-service.tsr",
        "export": "service",
        "kind": "code"
      },
      {
        "id": "visibility",
        "source": "src/examples/visibility.tsrx",
        "export": "Visibility",
        "kind": "component"
      },
      {
        "id": "card-layout",
        "source": "src/examples/card-layout.tsrx",
        "export": "CardLayout",
        "kind": "component"
      },
      {
        "id": "input-states",
        "source": "src/examples/input-states.tsrx",
        "export": "InputStates",
        "kind": "component"
      },
      {
        "id": "card-project",
        "source": "src/examples/card-project.tsrx",
        "export": "CardProject",
        "kind": "component"
      },
      {
        "id": "multiline-draft",
        "source": "src/examples/multiline-draft.tsrx",
        "export": "MultilineDraft",
        "kind": "component"
      },
      {
        "id": "field-labels",
        "source": "src/examples/field-labels.tsrx",
        "export": "FieldLabels",
        "kind": "component"
      },
      {
        "id": "keyboard-shortcuts",
        "source": "src/examples/keyboard-shortcuts.tsrx",
        "export": "KeyboardShortcuts",
        "kind": "component"
      },
      {
        "id": "section-dividers",
        "source": "src/examples/section-dividers.tsrx",
        "export": "SectionDividers",
        "kind": "component"
      },
      {
        "id": "aspect-ratio-layout",
        "source": "src/examples/aspect-ratio-layout.tsrx",
        "export": "AspectRatioLayout",
        "kind": "component"
      },
      {
        "id": "alert-variants",
        "source": "src/examples/alert-variants.tsrx",
        "export": "AlertVariants",
        "kind": "component"
      },
      {
        "id": "alert-actions",
        "source": "src/examples/alert-actions.tsrx",
        "export": "AlertActions",
        "kind": "component"
      },
      {
        "id": "alert-validation",
        "source": "src/examples/alert-validation.tsrx",
        "export": "AlertValidation",
        "kind": "component"
      },
      {
        "id": "alert-layouts",
        "source": "src/examples/alert-layouts.tsrx",
        "export": "AlertLayouts",
        "kind": "component"
      },
      {
        "id": "alert-theme",
        "source": "src/examples/alert-theme.tsrx",
        "export": "AlertTheme",
        "kind": "component"
      },
      {
        "id": "parent-positioning",
        "source": "src/examples/parent-positioning.tsrx",
        "export": "ParentPositioning",
        "kind": "component"
      }
    ]
  }
}
