import { document } from 'std:ui';
import { strictEqual } from 'std:testing';
import { ReactiveSemanticsExample } from '../examples/reactive-semantics';

function main() {
  const node = ReactiveSemanticsExample();
  const html = document(node, 'Reactive semantics');
  strictEqual(html.includes('aria-label="Draft"'), true);
  strictEqual(html.includes('aria-describedby="metadata-hint"'), true);
  strictEqual(html.includes('aria-label="Change metadata"'), true);
  strictEqual(html.includes('aria-label="Initial status"'), true);
  strictEqual(html.includes('role="presentation"'), true);
  strictEqual(html.includes('data-size="sm"'), true);
  console.log('Reactive semantics passed');
}
