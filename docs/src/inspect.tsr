import { document } from 'std:ui';
import { strictEqual } from 'std:testing';
import { Page } from './app/page';

function main() {
  const html = document(Page(), 'Tsrust');
  strictEqual(html.includes('Stay expressive.'), true);
  strictEqual(html.includes('href="/docs"'), true);
  strictEqual(html.includes('Documentation'), true);
  strictEqual(html.includes('href="/docs/getting-started/installation"'), true);
  strictEqual(html.includes('Count: 0'), true);
  strictEqual(html.includes('Show source'), true);
  strictEqual(html.includes('103 page destinations'), false);
  strictEqual(html.includes('100vh'), true);
  console.log('Documentation home and links passed');
}
