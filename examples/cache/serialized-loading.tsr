import { LruCache } from 'std:cache';
import { Channel, Sender, delay, allSettled } from 'std:futures';
import { strictEqual } from 'std:testing';

type Request = {
  client: int;
  key: string;
  done: boolean;
};

type Reply = {
  value: string;
  loads: int;
};

async function load(key: string): Task<Result<string, string>> {
  await delay(1);
  if (key === 'failure') {
    return Err('loader failed');
  }

  return Ok('loaded:' + key);
}

async function deliver(sender: ReadOnly<Sender<Reply>>, reply: Reply): Task<void> {
  try {
    await sender.send(reply);
  } catch (error) {
    if (error.code !== 'closed') {
      throw error;
    }
  }
}

async function receiveRequest(requests: ReadOnly<Channel<Request>>): Task<Request | undefined> {
  try {
    return await requests.receive();
  } catch (error) {
    if (error.code !== 'closed') {
      throw error;
    }

    return undefined;
  }
}

async function serve(requests: Channel<Request>, replies: Sender<Reply>[]): Task<int> {
  const cache = new LruCache<string, string>(2);
  let loads = 0;
  const finished = new Set<int>();
  if (replies.length === 0) {
    requests.close();
  }

  let receiving = true;
  while (receiving) {
    const request = await receiveRequest(requests);
    if (request === undefined) {
      receiving = false;
      break;
    }

    if (request.client < 0 || request.client >= replies.length) {
      throw 'invalid cache client';
    }

    if (finished.has(request.client)) {
      throw 'cache client already finished';
    }

    if (request.done) {
      finished.add(request.client);
      if (finished.size === replies.length) {
        requests.close();
      }

      continue;
    }

    let value = '';
    let found = false;
    {
      const cached = cache.get(request.key);
      if (cached !== undefined) {
        value = clone(cached);
        found = true;
      }
    }

    if (!found) {
      loads++;
      match (await load(clone(request.key))) {
        Ok(loaded) => {
          value = loaded;
          unwrap(cache.set(clone(request.key), clone(value)));
        },
        Err(error) => {
          value = 'failed';
        }
      }
    }

    const reply: Reply = {
      value, loads
    };
    await deliver(replies[request.client], reply);
  }

  cache.clear();
  return loads;
}

async function client(id: int, requests: Sender<Request>, replies: Channel<Reply>): Task<int> {
  const request: Request = {
    client: id, key: 'shared', done: false
  };
  await requests.send(request);
  const first = await replies.receive();
  strictEqual(first.value, 'loaded:shared');
  const again: Request = {
    client: id, key: 'shared', done: false
  };
  await requests.send(again);
  const second = await replies.receive();
  strictEqual(second.value, 'loaded:shared');
  const failure: Request = {
    client: id, key: 'failure', done: false
  };
  await requests.send(failure);
  const failed = await replies.receive();
  strictEqual(failed.value, 'failed');
  const done: Request = {
    client: id, key: '', done: true
  };
  await requests.send(done);
  replies.close();
  return 0;
}

async function checkClientDeparture(): Task<void> {
  const replies = new Channel<Reply>(1);
  const sender = replies.sender();
  replies.close();
  const requests = new Channel<Request>(2);
  const request: Request = {
    client: 0, key: 'abandoned', done: false
  };
  const done: Request = {
    client: 0, key: '', done: true
  };
  await requests.send(request);
  await requests.send(done);
  strictEqual(await serve(requests, [sender]).start().timeout(5000), 1);
  const empty = new Channel<Request>(1);
  const nobody: Sender<Reply>[] = [];
  strictEqual(await serve(empty, nobody).start().timeout(5000), 0);
}

async function blockedLoader(ready: Sender<int>): Task<void> {
  const cache = new LruCache<int, string>(1);
  unwrap(cache.set(1, 'retained until cancellation'));
  await ready.send(1);
  await delay(60000);
  cache.clear();
}

async function checkCancellation(): Task<void> {
  const ready = new Channel<int>(1);
  const job = blockedLoader(ready.sender()).start();
  try {
    strictEqual(await ready.receive(), 1);
  } finally {
    job.cancel();
    const outcomes = await allSettled([job]);
    match (clone(outcomes[0])) {
      Ok(_) => {
        throw 'cancelled loader completed';
      },
      Err(error) => {
        strictEqual(error.code, 'cancelled');
      }
    }
  }

  ready.close();
}

async function main(): Task<void> {
  const requests = new Channel<Request>(2);
  const first = new Channel<Reply>(1);
  const second = new Channel<Reply>(1);
  const afterClose = requests.sender();
  const firstRequests = requests.sender();
  const secondRequests = requests.sender();
  const firstReplies = first.sender();
  const secondReplies = second.sender();
  const outcomes = await allSettled([serve(requests, [firstReplies, secondReplies]).start(), client(0, firstRequests, first).start(), client(1, secondRequests, second).start()]).timeout(5000);
  strictEqual(unwrap(clone(outcomes[0])), 3);
  strictEqual(unwrap(clone(outcomes[1])), 0);
  strictEqual(unwrap(clone(outcomes[2])), 0);
  const late: Request = {
    client: 0, key: 'late', done: false
  };
  let closed = false;
  try {
    await afterClose.send(late);
  } catch (error) {
    strictEqual(error.code, 'closed');
    closed = true;
  }

  strictEqual(closed, true);
  await checkCancellation();
  await checkClientDeparture();
  console.log('serialized cache loading accepted');
}
