import { ThreadPool, spawn } from 'std:threads';


function main() {
  const pool = new ThreadPool();
  const first = unwrap(pool.task((): int => 20));
  const second = unwrap(pool.task((): int => 22));
  console.log(unwrap(first.join()) + unwrap(second.join()));

  const listener = unwrap(spawn((task): void => {
    while (!task.cancellationRequested()) {}
  }));
  listener.cancel();
  match (listener.join()) {
    Ok(_) => {},
    Err(error) => console.log(error.code),
  }

  console.log(pool.stats().outstanding);
  unwrap(pool.shutdown());
}
// 42
// cancelled
// 0
