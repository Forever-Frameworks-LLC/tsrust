import { document, computed, useProp } from 'std:ui';
import { strictEqual } from 'std:testing';
import { Page } from './app/page';
import { Order } from './order';

enum Phase {
  Ready = 'ready', Busy = 'busy'
}

function scalar(value: Owned<Function<string>>): string {
  return value();
}

interface FactoryProps {
  evaluate?: Owned<Function<string>>;
}

function ReadFactory(props: FactoryProps): string {
  const evaluate = props.evaluate;
  if (evaluate === undefined) {
    return 'absent';
  }

  return evaluate();
}

function main() {
  const empty: FactoryProps = {};
  strictEqual(<ReadFactory {...empty}/>, 'absent');
  const populated: FactoryProps = {
    evaluate: () => 'present'
  };
  strictEqual(<ReadFactory {...populated}/>, 'present');
  const constant = useProp<int>(9007199254740993);
  const value = computed<int>(() => constant.get() + 1);
  const absent = computed<int | undefined>(() => undefined);
  strictEqual(value.get(), 9007199254740994);
  strictEqual(absent.get(), undefined);
  const phase = computed<Phase>(() => Phase.Ready);
  strictEqual(phase.get() === Phase.Ready, true);
  const choice = computed<'default' | 'destructive'>(() => 'destructive');
  strictEqual(choice.get() === 'destructive', true);
  strictEqual(scalar(() => choice.get()), 'destructive');
  const html = document(Page(), 'Reactive props');
  strictEqual(html.includes('data-slot="notice"'), true);
  strictEqual(html.includes('data-variant="default"'), true);
  strictEqual(html.includes('Count: 0 / doubled: 0'), true);
  strictEqual(html.includes('data-slot="replacement"'), true);
  strictEqual(html.includes('data-slot="reactive-alert"'), true);
  strictEqual(html.includes('<section'), true);
  strictEqual(html.split('role="alert"').length, 2);
  strictEqual(html.split('<button').length, 3);
  const ordered = document(Order(), 'Order');
  strictEqual(ordered.includes('source-order'), true);
  strictEqual(ordered.includes('<section'), true);
  console.log('Reactive props passed');
}
