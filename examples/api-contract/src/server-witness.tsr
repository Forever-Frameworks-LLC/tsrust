import { Router } from 'std:http';
import { Channel } from 'std:futures';
import { FixtureState, stopFixture } from './server-policy.tsr';
import { dispatch } from '../generated-server/index.tsr';

type Ready = {
  kind: 'ready';
  address: string;
};

async function main(): Task<void> {
  const control = new Channel<boolean>(1);
  const app = new Router<FixtureState>({
    stop: control.sender(), increment: 10
  });
  app.configure({
    bodyLimit: 65536, maxConnections: 8, maxRequests: 8, requestTimeoutMs: 5000, shutdownTimeoutMs: 5000, handshakeTimeoutMs: 3000, requestsPerSecond: 1000
  });
  app.post('/api', dispatch);
  // Only the fixture runner uses this authenticated orderly shutdown route.
  app.post('/__fixture_stop', stopFixture);
  const server = await app.listen('127.0.0.1:0');
  const ready: Ready = {
    kind: 'ready', address: server.address()
  };
  console.log(JSON.stringify(ready));
  try {
    await control.receive();
  } finally {
    await server.shutdown();
    control.close();
  }
}
