import { connect } from 'std:sql';

async function main(): Task<void> {
  const db = await connect('sqlite::memory:', 1);
  await db.execute('CREATE TABLE people(id BIGINT PRIMARY KEY, name TEXT NOT NULL)');
  {
    const transaction = await db.begin();
    await transaction.execute('INSERT INTO people(id, name) VALUES (?, ?)', [1, 'Ada']);
    await transaction.execute('INSERT INTO people(id, name) VALUES (?, ?)', [2, 'Grace']);
    await transaction.commit();
  }

  const rows = await db.query('SELECT id, name FROM people ORDER BY id');
  await db.close();
  for (const row of rows) {
    console.log(`${unwrap(row.int('id'))}: ${unwrap(row.text('name'))}`);
  }
}
