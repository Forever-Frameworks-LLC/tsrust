import { connect } from 'std:sql';

async function main(): Task<void> {
  const db = await connect('sqlite::memory:', 1);
  await db.execute('CREATE TABLE transfers(amount BIGINT)');
  try {
    const transaction = await db.begin();
    await transaction.execute('INSERT INTO transfers(amount) VALUES (?)', [25]);
    throw 'Transfer failed';
  } catch (error) {
    console.log('Transfer rolled back');
  }

  const rows = await db.query('SELECT COUNT(*) AS total FROM transfers');
  console.log(unwrap(rows[0].int('total')));
  await db.close();
}
