import { Router, Context, ContextNext, Response, Client, request } from 'std:http';
import { strictEqual } from 'std:testing';

type Configuration = {
  greeting: string;
};

async function outer(c: Mutable<Context>, next: ContextNext): Task<void> {
  c.header('x-entry', 'outer');
  await next();
  c.header('x-exit', 'outer');
}

async function inner(c: Mutable<Context>, next: ContextNext): Task<void> {
  strictEqual(c.req.header('x-client'), 'checked');
  await next();
  c.header('x-exit', 'inner');
}

function greet(config: ReadOnly<Configuration>, c: Mutable<Context>): Response {
  c.status(201);
  return c.text(clone(config.greeting));
}

async function blocked(c: Mutable<Context>, next: ContextNext): Task<Response> {
  return c.text('blocked', 403);
}

function routes(config: Owned<Configuration>): Router {
  const app = new Router();
  app.use(outer);
  app.use('/hello', inner);
  app.use('/ordered/*', async (c, next) => {
    c.header('x-scope', 'matched');
    await next();
    c.header('x-unwind', 'outer');
  });
  app.get('/ordered/:name', async (c, next) => {
    const name = c.req.param('name')!;
    c.header('x-parameter', name);
    await next();
    c.header('x-unwind', 'inner');
  }, async (c) => c.text('first match'));
  app.get('/ordered/literal', (c) => c.text('must not outrank earlier parameter'));
  app.get('/conditional', async (c, next): Task<Response | undefined> => {
    if (c.req.header('x-stop') === 'yes') {
      return c.text('early', 409);
    }

    await next();
    return undefined;
  }, (c) => c.text('continued'));
  app.post('/echo', async (c) => {
    const body = await c.req.text();
    return c.text(body);
  });
  app.get('/hello', (c) => greet(config, c));
  app.use(blocked);
  app.get('/blocked', (c) => c.text('must not run'));
  return app;
}

async function main(): Task<void> {
  const app = routes({
    greeting: 'Hello from context'
  });
  const server = await app.listen('127.0.0.1:0');
  const client = new Client();
  const base = 'http://' + server.address();
  const input = request('GET', base + '/hello', '');
  input.setHeader('x-client', 'checked');
  const response = await client.send(input);
  strictEqual(response.status(), 201);
  strictEqual(response.header('x-entry'), 'outer');
  strictEqual(response.header('x-exit'), 'outer');
  strictEqual(await response.text(), 'Hello from context');
  const denied = request('GET', base + '/blocked', '');
  denied.setHeader('x-client', 'checked');
  const rejection = await client.send(denied);
  strictEqual(rejection.status(), 403);
  strictEqual(rejection.header('x-exit'), 'outer');
  strictEqual(await rejection.text(), 'blocked');
  const ordered = await client.send(request('GET', base + '/ordered/literal', ''));
  strictEqual(ordered.header('x-scope'), 'matched');
  strictEqual(ordered.header('x-parameter'), 'literal');
  strictEqual(ordered.header('x-unwind'), 'outer');
  strictEqual(await ordered.text(), 'first match');
  const continued = await client.send(request('GET', base + '/conditional', ''));
  strictEqual(await continued.text(), 'continued');
  const stop = request('GET', base + '/conditional', '');
  stop.setHeader('x-stop', 'yes');
  const early = await client.send(stop);
  strictEqual(early.status(), 409);
  strictEqual(await early.text(), 'early');
  const echoed = await client.send(request('POST', base + '/echo', 'owned body'));
  strictEqual(await echoed.text(), 'owned body');
  await server.shutdown();
}
