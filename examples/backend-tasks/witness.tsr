import { connect } from 'std:sql';
import { get } from 'std:env';
import { strictEqual } from 'std:testing';
import { list, create, update, remove } from './repository.tsr';

async function main(): Task<void> {
  const database = unwrap(get('TASK_TEST_DATABASE_URL'));
  if (database === undefined || database === 'sqlite::memory:') {
    throw 'TASK_TEST_DATABASE_URL must select a disposable disk database';
  }

  const phase = unwrap(get('TASK_TEST_PHASE'));
  const pool = await connect(database, 2);
  try {
    await pool.migrate('examples/backend-tasks/migrations');
    if (phase === 'verify') {
      const persisted = await list(pool, {
        after: 0, limit: 100
      });
      if (persisted.kind !== 'page') {
        throw 'Expected persisted page';
      }

      strictEqual(persisted.items.length, 1);
      strictEqual(persisted.items[0].title, 'Persisted task');
      strictEqual(persisted.items[0].completed, true);
      console.log('Task repository process-restart persistence passed');
      return;
    }

    const empty = await list(pool, {
      after: 0, limit: 100
    });
    if (empty.kind !== 'page') {
      throw 'Expected empty page';
    }

    strictEqual(empty.items.length, 0);
    const invalid = await create(pool, {
      title: '   '
    });
    if (invalid.kind !== 'error') {
      throw 'Empty title was accepted';
    }

    strictEqual(invalid.code === 'invalid-input', true);
    const tooLong = await create(pool, {
      title: 'a'.repeat(201)
    });
    if (tooLong.kind !== 'error') {
      throw 'Long title was accepted';
    }

    strictEqual(tooLong.code === 'invalid-input', true);
    const unicodeLong = await create(pool, {
      title: '🚀'.repeat(51)
    });
    if (unicodeLong.kind !== 'error') {
      throw 'Long UTF-8 title was accepted';
    }

    strictEqual(unicodeLong.code === 'invalid-input', true);
    const unicodeBoundary = await create(pool, {
      title: '🚀'.repeat(50)
    });
    if (unicodeBoundary.kind !== 'task') {
      throw 'UTF-8 boundary title rejected';
    }

    strictEqual(unicodeBoundary.title, '🚀'.repeat(50));
    const unicodeDeleted = await remove(pool, {
      id: unicodeBoundary.id
    });
    if (unicodeDeleted.kind !== 'deleted') {
      throw 'UTF-8 boundary cleanup failed';
    }

    const first = await create(pool, {
      title: '  First task  '
    });
    if (first.kind !== 'task') {
      throw 'First create failed';
    }

    strictEqual(first.title, 'First task');
    strictEqual(first.completed, false);
    const boundary = await create(pool, {
      title: 'a'.repeat(200)
    });
    if (boundary.kind !== 'task') {
      throw 'Boundary title was rejected';
    }

    const boundaryDeleted = await remove(pool, {
      id: boundary.id
    });
    if (boundaryDeleted.kind !== 'deleted') {
      throw 'Boundary cleanup failed';
    }

    const second = await create(pool, {
      title: "SQL '); DROP TABLE tasks; --"
    });
    if (second.kind !== 'task') {
      throw 'Parameterized title failed';
    }

    const page = await list(pool, {
      after: 0, limit: 1
    });
    if (page.kind !== 'page') {
      throw 'Expected bounded page';
    }

    strictEqual(page.items.length, 1);
    strictEqual(page.items[0].id, first.id);
    const next = await list(pool, {
      after: first.id, limit: 1
    });
    if (next.kind !== 'page') {
      throw 'Expected cursor page';
    }

    strictEqual(next.items.length, 1);
    strictEqual(next.items[0].id, second.id);
    strictEqual(next.items[0].title, "SQL '); DROP TABLE tasks; --");
    const changed = await update(pool, {
      id: first.id, title: 'Persisted task', completed: true
    });
    if (changed.kind !== 'task') {
      throw 'Update failed';
    }

    strictEqual(changed.completed, true);
    strictEqual(changed.title, 'Persisted task');
    const badUpdate = await update(pool, {
      id: first.id, title: ' ', completed: false
    });
    if (badUpdate.kind !== 'error') {
      throw 'Invalid update accepted';
    }

    strictEqual(badUpdate.code === 'invalid-input', true);
    const missingUpdate = await update(pool, {
      id: 9007199254740991, title: 'Missing', completed: false
    });
    if (missingUpdate.kind !== 'error') {
      throw 'Missing update accepted';
    }

    strictEqual(missingUpdate.code === 'not-found', true);
    const badId = await remove(pool, {
      id: -1
    });
    if (badId.kind !== 'error') {
      throw 'Invalid id accepted';
    }

    strictEqual(badId.code === 'invalid-input', true);
    const deleted = await remove(pool, {
      id: second.id
    });
    if (deleted.kind !== 'deleted') {
      throw 'Delete failed';
    }

    strictEqual(deleted.id, second.id);
    const missing = await remove(pool, {
      id: second.id
    });
    if (missing.kind !== 'error') {
      throw 'Repeated delete accepted';
    }

    strictEqual(missing.code === 'not-found', true);
    const badPage = await list(pool, {
      after: 0, limit: 101
    });
    if (badPage.kind !== 'error') {
      throw 'Unbounded page accepted';
    }

    strictEqual(badPage.code === 'invalid-input', true);
    const zeroLimit = await list(pool, {
      after: 0, limit: 0
    });
    if (zeroLimit.kind !== 'error') {
      throw 'Zero limit accepted';
    }

    strictEqual(zeroLimit.code === 'invalid-input', true);
    console.log('Task repository CRUD and validation passed');
  } finally {
    await pool.close();
  }
}
