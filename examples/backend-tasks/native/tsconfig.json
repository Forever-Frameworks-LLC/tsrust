{
  "compilerOptions": {
    "target": "ES2022", "module": "preserve", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true,
    "jsx": "react-jsx", "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node"], "paths": { "@/*": ["../web/src/*"] }
  },
  "include": ["src/**/*", "*.mts", "declarations.d.ts"]
}
