import { connect } from 'std:sql';
import { get } from 'std:env';
import { Channel, Sender } from 'std:futures';
import { Response } from 'std:http';
import { TaskContext } from './context.tsr';
import { routes } from './application.tsr';
import { authorize } from './access.tsr';
import { tokenHash } from '../service/security.tsr';

type Ready = {
  kind: 'ready';
  address: string;
};

function required(name: string): string {
  const value = unwrap(get(name));
  if (value === undefined || value === '') {
    throw 'Missing task HTTP witness setting';
  }

  return value;
}

async function stopFixture(context: Mutable<TaskContext>, stop: ReadOnly<Sender<boolean>>): Task<Response> {
  const allowed = await authorize(context);
  if (!allowed) {
    return context.text('Denied', 403);
  }

  await stop.send(true);
  return context.text('stopping');
}

async function main(): Task<void> {
  const control = new Channel<boolean>(1);
  const stop = control.sender();
  const pool = await connect(required('TASK_TEST_DATABASE_URL'), 2, 3000);
  await pool.migrate(required('TASK_TEST_MIGRATIONS'));
  const app = routes({
    pool, tokenDigest: tokenHash(required('TASK_TEST_TOKEN')), browserOrigin: 'http://127.0.0.1:5173'
  });
  // This authenticated control route exists only in the test executable.
  app.post('/__fixture_stop', (context) => stopFixture(context, stop));
  const server = await app.listen('127.0.0.1:0');
  const ready: Ready = {
    kind: 'ready', address: server.address()
  };
  console.log(JSON.stringify(ready));
  try {
    await control.receive();
  } finally {
    await server.shutdown();
    control.close();
  }
}
