// Generated by tools/generate-ui-gallery.py from pages.spec. Do not edit.
import { Button, Message, MessageScroller, Node, Text, View, signal } from 'std:ui';
import { Example, ExampleTitle, ExampleDescription, ExampleTabs, ExamplePreview, ExampleCode, PageHeader } from '../example.tsrx';

function LiveTranscript(): Node {
  const count = signal(6);
  const lines: int[] = [];
  for (let index = 0; index < 200; index += 1) {
    lines.push(index);
  }

  return (
    <View className="flex-col gap-3 w-[520px]">
      <MessageScroller className="h-72 rounded-lg border border-border" jumpLabel="Latest" rowClassName="px-3 py-1">
        {...lines.filter((line: int) => line < count.get()).map((line: int) => <Message align={line % 2 === 0 ? 'start' : 'end'} variant={line % 2 === 0 ? 'secondary' : 'filled'}>Message {line + 1}</Message>)}
      </MessageScroller>
      <Button onPress={() => { count.set(count.get() + 1); }}>Send message</Button>
    </View>
  );
}

export function MessageScrollerPage(): Node {
  return (
    <View className="flex-col gap-10">
      <PageHeader summary="A transcript that follows new messages, keeps its place while you read history and offers a jump button." slug="message-scroller" />
