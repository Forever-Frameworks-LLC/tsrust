  );
}

function NestedResizable(): Node {
  return (
    <View className="h-[260px] w-full rounded-lg border border-border">
      <Resizable>
        <ResizablePanel size={180} fixed={true}><View className="p-4"><Text>Fixed</Text></View></ResizablePanel>
