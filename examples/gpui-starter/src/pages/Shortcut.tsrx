import { Kbd, Node, Shortcut, Text, View, signal } from 'std:ui';
import { Example, ExampleTitle, ExampleDescription, ExampleTabs, ExamplePreview, ExampleCode, PageHeader } from '../example.tsrx';

function BasicShortcut(): Node {
  const count = signal(0);
  return (
    <View className="flex-row items-center gap-3">
      <Shortcut command="increment" keys="secondary-k" onTrigger={() => { count.set(count.get() + 1); }} />
      <Kbd>secondary-k</Kbd>
      <Text>Pressed {count} times</Text>
    </View>
  );
}

