      </Field>
      <Field label="Show advanced"><Switch checked={advanced.get()} onChange={(on) => { advanced.set(on); }} /></Field>
      <Field label="Timeout (seconds)" visible={advanced.get()}><NumberInput defaultValue={30} /></Field>
    </Form>
  );
}

