import { test, strictEqual } from 'std:testing';
import { Node, View, Text, LazyChildren, Dialog, DialogContent, Button, CodeEditor, signal, document } from 'std:ui';

interface DeferredProps {
  children?: LazyChildren;
}

function Deferred(props: DeferredProps): Node {
  const render = props.children;
  if (render === undefined) {
    return <View />;
  }

  return <View children={render()} />;
}

function ReactiveContent(): Node {
  const count = signal(2);
  return (
    <Deferred>
      <Dialog open={true}>
        <DialogContent>
          <Button onPress={() => { count.set(count.get() + 1); }}>Add row</Button>
          {...[1, 2, 3].slice(0, count.get()).map((id) => <Text>Row {id}</Text>)}
        </DialogContent>
      </Dialog>
    </Deferred>
  );
}

test('deferred component children own reactive list captures', () => {
  const node = ReactiveContent();
  const html = document(node, 'Deferred content');
  strictEqual(html.includes('Row 1'), true);
  strictEqual(html.includes('Row 2'), true);
  strictEqual(html.includes('Row 3'), false);
});

test('code editor rejects invalid indentation and scrolling counts', () => {
  for (const value of [0, -1]) {
    let rejected = false;
    try {
      const node = <CodeEditor tabSize={value} />;
    } catch {
      rejected = true;
    }

    strictEqual(rejected, true);
  }

  let rejected = false;
  try {
    const node = <CodeEditor cursorSurroundingLines={-1} />;
  } catch {
    rejected = true;
  }

  strictEqual(rejected, true);
});
