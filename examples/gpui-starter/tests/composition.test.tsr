import { test, strictEqual } from 'std:testing';
import { Node, View, Text, LazyChildren, Dialog, DialogContent, Button, CodeEditor, Switch, Plot, PlotLine, PlotTooltip, Input, Textarea, NumberInput, SpeechButton, Questionnaire, Question, QuestionChoice, QuestionInput, Settings, SettingsPage, SettingsGroup, SettingItem, SettingsFooter, SettingsTitleSuffix, signal, document } from 'std:ui';

interface DeferredProps {
  children?: LazyChildren;
}

function Deferred(props: DeferredProps): Node {
  const render = props.children;
  if (render === undefined) {
    return <View />;
  }

  return <View children={render()} />;
}

function ReactiveContent(): Node {
  const count = signal(2);
  return (
    <Deferred>
      <Dialog open={true}>
        <DialogContent>
          <Button onPress={() => { count.set(count.get() + 1); }}>Add row</Button>
          {...[1, 2, 3].slice(0, count.get()).map((id) => <Text>Row {id}</Text>)}
        </DialogContent>
      </Dialog>
    </Deferred>
  );
}

test('deferred component children own reactive list captures', () => {
  const node = ReactiveContent();
  const html = document(node, 'Deferred content');
  strictEqual(html.includes('Row 1'), true);
  strictEqual(html.includes('Row 2'), true);
  strictEqual(html.includes('Row 3'), false);
});

function KitStyleRoot(): Node {
  const selected = signal(true);
  return <Switch disabled={selected.get()} className={selected.get() ? 'p-[13px] disabled:opacity-50' : 'p-2'}>Styled Kit control</Switch>;
}

test('Kit components retain reactive class expressions and disabled utility state', () => {
  const node = KitStyleRoot();
  const html = document(node, 'Kit classes');
  strictEqual(html.includes('p-[13px]'), true);
  strictEqual(html.includes(' disabled'), true);
});

test('code editor rejects invalid indentation and scrolling counts', () => {
  for (const value of [0, -1]) {
    let rejected = false;
    try {
      const node = <CodeEditor tabSize={value} />;
    } catch {
      rejected = true;
    }

    strictEqual(rejected, true);
  }

  let rejected = false;
  try {
    const node = <CodeEditor cursorSurroundingLines={-1} />;
  } catch {
    rejected = true;
  }

  strictEqual(rejected, true);
});

function LivePlot(): Node {
  const value = signal(2);
  return <Plot labels={['A', `${value.get()}`]}><PlotLine values={[Number(value.get()), 3]} /><PlotTooltip /></Plot>;
}

test('live Plot array props compile and reject nonfinite values at construction', () => {
  const plot = LivePlot();
  const html = document(plot, 'Live Plot');
  strictEqual(html.includes('Live Plot'), true);
  for (const value of [Number.NaN, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY]) {
    let rejected = false;
    try {
      const node = <PlotLine values={[1, value]} />;
    } catch {
      rejected = true;
    }

    strictEqual(rejected, true);
  }

  let rejected = false;
  try {
    const node = <PlotTooltip gap={-1} />;
  } catch {
    rejected = true;
  }

  strictEqual(rejected, true);
});

interface ArrayGetter {
  evaluate: Owned<Function<number[]>>;
}

function DeferredArray(source: number[] | ArrayGetter): string {
  if (Array.isArray(source)) {
    return source.join(',');
  }

  const evaluate = source.evaluate;
  const read = () => evaluate().join(',');
  const first = read();
  return `${first}|${read()}`;
}

test('an unused array-getter branch keeps a concrete absent callback capture', () => {
  strictEqual(DeferredArray([1, 2]), '1,2');
  strictEqual(DeferredArray(Array.of ()), '');
  strictEqual(DeferredArray(Array.of (3, 4)), '3,4');
  const numbers: number[] = [5, 6];
  strictEqual(DeferredArray([...numbers]), '5,6');
});

function SynchronousFields(): Node {
  const limit = signal(8);
  return <View><Input onValidate={(value) => value.length <= limit.get()} onPaste={(payload) => payload.length === 0}/><Textarea onPaste={(payload) => false}/><CodeEditor onPaste={(payload) => false}/><NumberInput stepBy={(value, increment) => increment && value < 1 ? 0.1 : 0.5} onValidate={(value) => !value.includes('e')}/></View>;
}

test('synchronous input callbacks compile with retained signal captures and numeric results', () => {
  const node = SynchronousFields();
  strictEqual(document(node, 'Synchronous fields').includes('Synchronous fields'), true);
  for (const value of [Number.NaN, Number.POSITIVE_INFINITY]) {
    let rejected = false;
    try {
      const field = <NumberInput value={value} />;
    } catch {
      rejected = true;
    }

    strictEqual(rejected, true);
  }

  let rejected = false;
  try {
    const field = <NumberInput step={-1} />;
  } catch {
    rejected = true;
  }

  strictEqual(rejected, true);
});

test('speech options compile and reject negative timeout without microphone access', () => {
  const node = <SpeechButton locale="en-US" systemFallback={false} showWhenUnsupported={true} disabled={true} size="small" waveform={true} waveformStyle="liquid" stopTimeout={0} onStarted={() => {}} onCancelled={() => {}} />;
  const html = document(node, 'Speech options');
  strictEqual(html.includes('Speech options'), true);
  let rejected = false;
  try {
    const invalid = <SpeechButton stopTimeout={-1} />;
  } catch {
    rejected = true;
  }

  strictEqual(rejected, true);
});

function FormOptions(): Node {
  const value = signal(true);
  return <View>
    <Questionnaire shortcuts="letters" defaultCurrent="plan" size="small" onChange={(answer) => {}} onComplete={(answers) => {}} onSubmitDetails={(answers) => {}}>
      <Question id="plan" title="Plan" required={true}>
        <QuestionChoice id="free" label="Free" defaultSelected={true} disabled={!value.get()} />
        <QuestionInput placeholder="Other" defaultValue="Custom" />
      </Question>
    </Questionnaire>
    <Settings sidebarWidth={200} sidebarMinWidth={100} sidebarMaxWidth={300} defaultPage={0} defaultGroup={0} groupVariant="outline" size="small">
      <SettingsPage title="General" defaultOpen={true} icon="settings">
        <SettingsTitleSuffix><Text>Live</Text></SettingsTitleSuffix>
        <SettingsGroup title="Updates" variant="fill">
          <SettingItem title="Automatic" dirty={!value.get()} keywords={['startup']} layout="vertical" onReset={() => { value.set(true); }}>
            <Switch checked={value.get()} onChange={(next) => { value.set(next); }} />
          </SettingItem>
          <SettingsFooter><Text>Immediate changes</Text></SettingsFooter>
        </SettingsGroup>
      </SettingsPage>
    </Settings>
  </View>;
}

test('questionnaire freeform and settings reset props compose and validate schemas', () => {
  const node = FormOptions();
  const html = document(node, 'Form options');
  strictEqual(html.includes('Form options'), true);
  let rejected = false;
  try {
    const invalid = <Questionnaire><Question id="a" title="A"><QuestionInput /><QuestionInput /></Question></Questionnaire>;
  } catch {
    rejected = true;
  }

  strictEqual(rejected, true);
});
