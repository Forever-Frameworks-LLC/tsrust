import { args, currentExe } from 'std:env';
import { spawn } from 'std:process';
import { readAll, writeAll, close, stdin, readStdin, stdout, stderr } from 'std:io';
import { fromUtf8, length, toUtf8 } from 'std:bytes';
async function main(): Task<void> {
  if (unwrap(args()).length > 0) {
    const input = stdin();
    while (length(unwrap(readStdin(input, 8192))) > 0) {}

    const output = stdout();
    unwrap(await writeAll(output, unwrap(fromUtf8('hello'))));
    unwrap(await close(output));
    const errors = stderr();
    unwrap(await writeAll(errors, unwrap(fromUtf8('note'))));
    unwrap(await close(errors));
    return;
  }

  const child = unwrap(spawn(unwrap(currentExe()), ['--child'], {
    stdin: 'pipe', stdout: 'pipe', stderr: 'pipe'
  }));
  const input = child.takeStdin();
  const output = child.takeStdout();
  const errors = child.takeStderr();
  if (child.takeStdin() !== undefined || child.takeStdout() !== undefined || child.takeStderr() !== undefined) {
    throw 'pipe transferred twice';
  }

  if (input === undefined || output === undefined || errors === undefined) {
    throw 'missing pipe';
  }

  unwrap(await writeAll(input, unwrap(fromUtf8('input'))));
  unwrap(await close(input));
  const captured = unwrap(await readAll(output));
  const diagnostics = unwrap(await readAll(errors));
  unwrap(await close(output));
  unwrap(await close(errors));
  console.log(unwrap(toUtf8(captured)), unwrap(toUtf8(diagnostics)), unwrap(await child.wait()).success);
}
