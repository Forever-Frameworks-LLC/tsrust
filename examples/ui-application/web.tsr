import { withTheme, document } from 'std:ui';
import config from './tsrust.config.json';
import { Page } from './src/app/page';
import { strictEqual } from 'std:testing';

function main() {
  const node = withTheme(Page(), config.ui.theme, 'dark');
  const html = document(node, 'Project UI');
  strictEqual(html.includes('Count: 0'), true);
  strictEqual(html.includes('--ui-background:#0f172a'), true);
  for (const corner of ['top-left', 'top-right', 'bottom-right', 'bottom-left']) {
    strictEqual(html.includes('border-' + corner + '-radius:12px'), true);
  }

  console.log('project-ui-ok');
}
