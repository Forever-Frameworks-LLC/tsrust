import { Request, Response, FormField, MultipartPart, text, html, json } from 'std:http';
import { Pool } from 'std:sql';
import { Bytes, length, fromUtf8 } from 'std:bytes';
import { now, startOfSecond, toUnixMilliseconds } from 'std:date';
import { Sender } from 'std:futures';
import { monotonicNow } from 'std:time';
import { formatUuid } from 'std:uuid';
import { Event, newTrace, emitEvent } from '../service-observability/telemetry.tsr';
import { isToken, matchesToken, tokenHash, newToken, sessionCookie, setSessionCookie } from './security.tsr';

type NotePayload = {
  body: string;
};

type UploadPayload = {
  bytes: int;
};

async function respond(pool: ReadOnly<Pool>, admin: ReadOnly<Bytes>, origin: string, input: Request): Task<Response> {
  const path = input.url();
  const method = input.method();
  const suppliedOrigin = input.header('origin');
  // Browsers must send the exact configured origin for every state-changing request.
  if (suppliedOrigin !== undefined && suppliedOrigin !== origin) {
    return text('Forbidden', 403);
  }

  if (method === 'OPTIONS') {
    if (suppliedOrigin === undefined) {
      return text('Forbidden', 403);
    }

    const response = text('', 204);
    response.setHeader('access-control-allow-methods', 'GET, POST, DELETE, OPTIONS');
    response.setHeader('access-control-allow-headers', 'authorization, content-type');
    return response;
  }

  if (method === 'GET' && path === '/') {
    const response = html('<!doctype html><html lang="en"><meta charset="utf-8"><title>Notes service</title><h1>Notes service</h1><p>Use the authenticated notes API.</p></html>');
    response.setHeader('content-security-policy', "default-src 'none'; frame-ancestors 'none'");
    return response;
  }

  if (method === 'GET' && path === '/health') {
    return text('ready');
  }

  const timestamp = unwrap(toUnixMilliseconds(startOfSecond(unwrap(now()))));
  if (method === 'POST' && path === '/session') {
    const authorization = input.header('authorization');
    if (authorization === undefined || !authorization.startsWith('Bearer ')) {
      return text('Unauthorized', 401);
    }

    if (!matchesToken(authorization.slice(7), admin)) {
      return text('Unauthorized', 401);
    }

    const token = newToken();
    const digest = tokenHash(token);
    await pool.execute('DELETE FROM service_sessions WHERE expires <= ?', [timestamp]);
    // Cap durable session cardinality atomically; expired rows never authorize requests.
    const added = await pool.execute('INSERT INTO service_sessions(digest, expires) SELECT ?, ? WHERE (SELECT COUNT(*) FROM service_sessions) < 1024', [digest, timestamp + 3600000]);
    if (added !== 1) {
      return text('Session capacity reached', 503);
    }

    const response = text('authenticated', 201);
    response.setHeader('set-cookie', setSessionCookie(token));
    return response;
  }

  const cookie = input.header('cookie');
  if (cookie === undefined) {
    return text('Unauthorized', 401);
  }

  const token = sessionCookie(cookie);
  if (token === undefined) {
    return text('Unauthorized', 401);
  }

  const digest = tokenHash(token);
  const sessions = await pool.query('SELECT expires FROM service_sessions WHERE digest = ? AND expires > ?', [clone(digest), timestamp]);
  if (sessions.length !== 1) {
    return text('Unauthorized', 401);
  }

  if ((method === 'POST' || method === 'DELETE') && suppliedOrigin === undefined) {
    return text('Forbidden', 403);
  }

  if (method === 'DELETE' && path === '/session') {
    await pool.execute('DELETE FROM service_sessions WHERE digest = ?', [digest]);
    const response = text('', 204);
    response.setHeader('set-cookie', '__Host-session=; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age=0');
    return response;
  }

  if (method === 'GET' && path === '/notes') {
    const rows = await pool.query('SELECT body FROM service_notes WHERE id = 1');
    const body = unwrap(rows[0].text('body'));
    const payload: NotePayload = {
      body
    };
    return json(payload);
  }

  if (method === 'POST' && path === '/notes') {
    let fields: FormField[] = [];
    try {
      fields = await input.form();
    } catch {
      return text('Invalid form', 400);
    }

    if (fields.length !== 1 || fields[0].name !== 'body' || length(unwrap(fromUtf8(fields[0].value))) > 4096) {
      return text('Expected one body field, at most 4096 bytes', 400);
    }

    await pool.execute('UPDATE service_notes SET body = ? WHERE id = 1', [clone(fields[0].value)]);
    return text('saved');
  }

  if (method === 'POST' && path === '/upload') {
    let parts: MultipartPart[] = [];
    try {
      parts = await input.multipart();
    } catch {
      return text('Invalid multipart body', 400);
    }

    if (parts.length !== 1 || parts[0].name !== 'attachment') {
      return text('Expected one attachment', 400);
    }
    // File names are metadata only; never turn client input into a filesystem path.
    const payload: UploadPayload = {
      bytes: length(parts[0].data)
    };
    return json(payload);
  }

  return text('Not Found', 404);
}

export async function handle(pool: ReadOnly<Pool>, admin: ReadOnly<Bytes>, origin: string, telemetry: ReadOnly<Sender<Event>>, input: Request): Task<Response> {
  const trace = newTrace();
  const started = monotonicNow();
  await emitEvent(telemetry, trace, 'request-start', 'service.handle', 0, 0);
  let response = text('Unavailable', 503);
  try {
    response = await respond(pool, admin, clone(origin), input);
    await emitEvent(telemetry, trace, 'request-end', 'service.handle', response.status(), monotonicNow() - started);
  } catch {
    await emitEvent(telemetry, trace, 'request-failed', 'service.handle', 503, monotonicNow() - started);
  }

  response.setHeader('x-request-id', formatUuid(trace.requestId));
  response.setHeader('access-control-allow-origin', origin);
  response.setHeader('access-control-allow-credentials', 'true');
  response.setHeader('vary', 'Origin');
  response.setHeader('cache-control', 'no-store');
  response.setHeader('x-content-type-options', 'nosniff');
  return response;
}
