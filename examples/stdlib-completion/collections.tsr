import { OrderedSet, OrderedMap, Deque, Heap } from 'std:collections';
import { strictEqual } from 'std:testing';

function main() {
  const empty = new OrderedSet<string>();
  strictEqual(empty.first(), undefined);
  strictEqual(empty.last(), undefined);
  strictEqual(empty.values().length, 0);
  strictEqual(empty.entries().length, 0);
  const values = new OrderedSet<string>();
  values.add('b');
  values.add('a');
  values.add('b');
  strictEqual(values.first()!, 'a');
  strictEqual(values.last()!, 'b');
  const keys = values.keys();
  const snapshot = values.values();
  const entries = values.entries();
  let text = '';
  values.forEach((value, key, source) => {
    strictEqual(value, key);
    strictEqual(source.size, 2);
    text += value;
  });
  strictEqual(text, 'ab');
  values.clear();
  strictEqual(keys.join(','), 'a,b');
  strictEqual(snapshot.join(','), 'a,b');
  strictEqual(entries[0][0], 'a');
  strictEqual(entries[0][1], 'a');
  const map = new OrderedMap<string, int>();
  strictEqual(map.firstKey(), undefined);
  strictEqual(map.lastKey(), undefined);
  map.set('b', 2);
  map.set('a', 1);
  strictEqual(map.firstKey()!, 'a');
  strictEqual(map.lastKey()!, 'b');
  const deque = new Deque<int[]>();
  deque.pushBack([1]);
  deque.pushBack([2]);
  deque.popFront();
  deque.pushBack([3]);
  const rows = deque.values();
  rows[0].push(9);
  strictEqual(deque.front()!.length, 1);
  deque.clear();
  strictEqual(rows[0].join(','), '2,9');
  strictEqual(rows[1][0], 3);
  const heap = new Heap<number>();
  strictEqual(heap.toSortedArray().length, 0);
  heap.push(NaN);
  heap.push(-0.0);
  heap.push(3.0);
  heap.push(-Infinity);
  heap.push(Infinity);
  heap.push(0.0);
  const sorted = heap.toSortedArray();
  strictEqual(sorted.length, 6);
  strictEqual(sorted[0], -Infinity);
  strictEqual(Object.is(sorted[1], 0.0), true);
  strictEqual(Object.is(sorted[2], 0.0), true);
  strictEqual(sorted[3], 3.0);
  strictEqual(sorted[4], Infinity);
  strictEqual(isNaN(sorted[5]), true);
  strictEqual(heap.size, 6);
  strictEqual(isNaN(heap.peek()!), true);
}
