import { hashPassword, verifyPassword, verifyPasswordBounded } from 'std:crypto';
import { ThreadPool } from 'std:threads';
import { fromUtf8, view } from 'std:bytes';
import { strictEqual } from 'std:testing';
async function main(): Task<void> {
  const pool = new ThreadPool({
    workers: 1, capacity: 2
  });
  try {
    const password = unwrap(fromUtf8('public synthetic password'));
    const readable = unwrap(view(password, 0, 25));
    const encoded = unwrap(await hashPassword(pool, readable));
    strictEqual(encoded.startsWith('$argon2id$v=19$m=19456,t=2,p=1$'), true);
    strictEqual(unwrap(await verifyPassword(pool, readable, encoded)), true);
    strictEqual(unwrap(await verifyPassword(pool, unwrap(fromUtf8('wrong')), encoded)), false);
    strictEqual(unwrap(await verifyPasswordBounded(pool, readable, encoded, {
      maxMemoryKiB: 19456, maxIterations: 2, maxParallelism: 1
    })), true);
    const alias = hashPassword;
    const alternate = unwrap(await alias(pool, readable, {
      memoryKiB: 32, iterations: 1, parallelism: 1, outputBytes: 32
    }));
    strictEqual(unwrap(await verifyPasswordBounded(pool, readable, alternate, {
      maxMemoryKiB: 32, maxIterations: 1, maxParallelism: 1
    })), true);
    console.log('explicit bounded password work');
  } finally {
    pool.shutdown();
  }
}
