import { connect } from 'std:sql';
import { get } from 'std:env';
import { strictEqual } from 'std:testing';
import { initialize, enqueue, claim, retry, acknowledge } from './jobs.tsr';

async function main(): Task<void> {
  const url = unwrap(get('DATABASE_URL'));
  if (url === undefined || !url.startsWith('sqlite:') || url.includes(':memory:')) {
    throw 'Set DATABASE_URL to a fresh file-backed SQLite database';
  }

  const db = await connect(clone(url), 1);
  const databases = await db.query("SELECT file FROM pragma_database_list WHERE name = 'main'");
  if (unwrap(databases[0].text('file')) === '') {
    throw 'Jobs require file-backed SQLite';
  }

  await initialize(db);
  strictEqual(await enqueue(db, 'receipt-1', 'receipt body', 0), true);
  strictEqual(await enqueue(db, 'receipt-1', 'receipt body', 0), true);
  strictEqual(await enqueue(db, 'receipt-1', 'different body', 0), false);
  const first = await claim(db, 0);
  if (first === undefined) {
    throw 'Expected first delivery';
  }

  strictEqual(first.attempt, 1);
  strictEqual(await claim(db, 1) === undefined, true);
  strictEqual(await retry(db, first, 10), true);
  strictEqual(await claim(db, 1009) === undefined, true);
  const second = await claim(db, 1010);
  if (second === undefined) {
    throw 'Expected retry';
  }

  strictEqual(second.attempt, 2);
  await db.close();

  // A new pool models a worker restart; the unfinished lease remains in the file.
  const reopened = await connect(clone(url), 1);
  strictEqual(await claim(reopened, 31009) === undefined, true);
  strictEqual(await acknowledge(reopened, second, 31010), false);
  const recovered = await claim(reopened, 31010);
  if (recovered === undefined) {
    throw 'Expected recovered delivery';
  }

  strictEqual(recovered.attempt, 3);
  strictEqual(await acknowledge(reopened, second, 31010), false);
  strictEqual(await retry(reopened, second, 31010), false);
  strictEqual(await acknowledge(reopened, recovered, 31011), true);
  strictEqual(await acknowledge(reopened, recovered, 31012), false);
  strictEqual(await enqueue(reopened, 'receipt-1', 'receipt body', 31012), true);
  strictEqual(await claim(reopened, 31012) === undefined, true);
  const effects = await reopened.query('SELECT body FROM effects');
  strictEqual(effects.length, 1);
  strictEqual(unwrap(effects[0].text('body')), 'receipt body');

  strictEqual(await enqueue(reopened, 'poison', 'cannot process', 40000), true);
  for (let attempt = 1; attempt <= 3; attempt++) {
    const failed = await claim(reopened, 40000 + attempt * 10000);
    if (failed === undefined) {
      throw 'Expected poison delivery';
    }

    strictEqual(failed.attempt, attempt);
    strictEqual(await retry(reopened, failed, 40000 + attempt * 10000), true);
  }

  strictEqual(await claim(reopened, 100000) === undefined, true);
  const terminal = await reopened.query('SELECT state FROM jobs WHERE id = ?', ['poison']);
  strictEqual(unwrap(terminal[0].text('state')), 'failed');
  strictEqual(await enqueue(reopened, 'abandoned', 'worker disappeared', 200000), true);
  for (let attempt = 1; attempt <= 3; attempt++) {
    const abandoned = await claim(reopened, 200000 + (attempt - 1) * 30000);
    if (abandoned === undefined) {
      throw 'Expected abandoned delivery';
    }

    strictEqual(abandoned.attempt, attempt);
  }

  strictEqual(await claim(reopened, 290000) === undefined, true);
  const abandonedState = await reopened.query('SELECT state FROM jobs WHERE id = ?', ['abandoned']);
  strictEqual(unwrap(abandonedState[0].text('state')), 'failed');
  await reopened.close();
  console.log('Durable jobs accepted');
}
