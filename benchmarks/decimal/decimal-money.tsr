import { parseDecimal, fromInt, add, multiply, toInt } from 'std:decimal';
import { monotonicNow } from 'std:time';

function batch(): int {
  let checksum = 0;
  const price = unwrap(parseDecimal('19.99'));
  const fee = unwrap(parseDecimal('0.01'));
  const hundred = fromInt(100);
  for (let i = 0; i < 256; i += 1) {
    const total = unwrap(multiply(price, fromInt(i)));
    const adjusted = unwrap(add(total, fee));
    const cents = unwrap(multiply(adjusted, hundred));
    checksum += unwrap(toInt(cents));
  }

  return checksum;
}

function main() {
  for (let warmup = 0; warmup < 8; warmup += 1) {
    batch();
  }

  for (let sample = 0; sample < 31; sample += 1) {
    const start = monotonicNow();
    const checksum = batch();
    const elapsed = monotonicNow() - start;
    console.log(checksum);
    console.log(elapsed);
  }
}
