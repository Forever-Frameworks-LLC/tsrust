import { compile } from 'std:regex';

function workload(n: int, seed: int, input: string): int {
  const expression = unwrap(compile('(?:[a-z]+)=(?:[0-9]+)'));
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const values = expression.split(input);
    for (const value of values) {
      checksum += value.start + value.end + 1;
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, 'a=12 b=3'));
}
