import { Bytes, alloc, resize, at, length } from "std:bytes";

function read(bytes: ReadOnly<Bytes>, index: int): int {
  match (at(bytes, index)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      return -1;
    },
  }
}

function workload(n: int, seed: int, input: string): int[][] {
  const output: int[][] = [];
  const change = resize;
  let i = 0;
  while (i < n) {
    const byte = (i + seed) % 256;
    match (alloc(2, byte)) {
      Ok(bytes) => {
        const initial = read(bytes, 0);
        let growth = -1;
        match (change(bytes, 4)) {
          Ok(_) => {
            growth = 1;
          },
          Err(error) => {
            growth = -2;
          },
        }

        const zero = read(bytes, 3);
        let invalid = -1;
        match (resize(bytes, 0, 256)) {
          Ok(_) => {
            invalid = -2;
          },
          Err(error) => {
            invalid = error.code.length;
          },
        }

        const preserved = length(bytes);
        let shrink = -1;
        match (resize(bytes, 1)) {
          Ok(_) => {
            shrink = 1;
          },
          Err(error) => {
            shrink = -2;
          },
        }

        let regrow = -1;
        match (resize(bytes, 3, 255)) {
          Ok(_) => {
            regrow = 1;
          },
          Err(error) => {
            regrow = -2;
          },
        }

        output.push([initial, growth, zero, invalid, preserved, shrink, regrow, read(bytes, 0), read(bytes, 1), read(bytes, 2), length(bytes)]);
      },
      Err(error) => {
        output.push([-1000000]);
      },
    }

    i += 1;
  }

  return output;
}

function main() {
  workload(1, 0, "bytes");
}
