import { Bytes, ByteView, fromArray, view, at, length } from "std:bytes";

type Picker = {
  pick: Once<Function<ByteView, [Owned<ByteView>]>>;
};

function window(owner: ReadOnly<Bytes>, start: int, end: int): ByteView {
  match (view(owner, start, end)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function first(value: ReadOnly<ByteView>): int {
  match (at(value, 0)) {
    Ok(byte) => {
      return byte;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function make(captured: ByteView, expected: int): Picker {
  return {
    pick: (other: Owned<ByteView>) => {
      const kept = captured;
      if (first(kept) !== expected) {
        throw "capture mismatch";
      }

      return other;
    }
  };
}

type OwnerPicker = {
  pick: Once<Function<ByteView, [ReadOnly<Bytes>]>>;
};

function makeOwner(captured: ByteView, expected: int): OwnerPicker {
  return {
    pick: (other: ReadOnly<Bytes>) => {
      const kept = captured;
      if (first(kept) !== expected) {
        throw "capture mismatch";
      }

      match (view(other, 1, 3)) {
        Ok(value) => {
          return value;
        },
        Err(error) => {
          throw error.message;
        },
      }
    }
  };
}

function workload(n: int, seed: int, input: string): int[][] {
  const output: int[][] = [];
  let i = 0;
  while (i < n) {
    const byte = (i + seed) % 256;
    const next = (byte + 1) % 256;
    match (fromArray([byte, next, 255])) {
      Ok(owner) => {
        const picker = make(window(owner, 0, 1), byte);
        const selected = picker.pick(window(owner, 1, 3));
        const borrowed = makeOwner(window(owner, 0, 1), byte).pick(owner);
        output.push([length(selected), first(selected), length(borrowed), first(borrowed)]);
      },
      Err(error) => {
        throw error.message;
      },
    }

    i++;
  }

  return output;
}

function main() {
}
