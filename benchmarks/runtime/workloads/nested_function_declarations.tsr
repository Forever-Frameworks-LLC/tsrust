function workload(n: int, seed: int, input: string): int[][] {
  function double(value: int): int { return value + value; }
  function factorial(value: int): int {
    if (value === 0) { return 1; }
    return value * factorial(value - 1);
  }
  function even(value: int): boolean {
    if (value === 0) { return true; }
    return odd(value - 1);
  }
  function odd(value: int): boolean {
    if (value === 0) { return false; }
    return even(value - 1);
  }
  const output: int[][] = [];
  let i = 0;
  while (i < n) {
    const value = i % 5 + seed % 5 + 1;
    const first = double(value);
    let shadowed = 0;
    {
      shadowed = double(value);
      function double(value: int): int { return value * 3; }
    }
    const mapped = [value, value + 1].map(double);
    output.push([first, factorial(5), even(value) ? 1 : 0, shadowed, mapped[0], mapped[1]]);
    i += 1;
  }
  return output;
}
function main() { const result = workload(3, 0, "nested"); }
