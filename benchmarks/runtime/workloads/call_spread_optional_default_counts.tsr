function integers(base: int, count: int): int[] {
  const values: int[] = [];
  let at = 0;
  while (at < count) {
    values.push(base + at);
    at = at + 1;
  }

  return values;
}

function collect<T>(...values: T[]): T[] {
  return values;
}

type Trace = {
  calls: int;
  defaults: int;
};

function fallback(trace: Trace): int {
  trace.defaults = trace.defaults + 1;
  return 10;
}

function argumentsValues(trace: Trace, base: int, count: int): int[] {
  trace.calls = trace.calls + 1;
  return integers(base, count);
}

function apply(trace: Trace, prefix: int = fallback(trace), ...tail: int[]): int[] {
  const result: int[] = [prefix];
  let at = 0;
  while (at < tail.length) {
    result.push(tail[at]);
    at = at + 1;
  }

  return result;
}

function workload(n: int, seed: int, input: string): int[][] {
  const output: int[][] = [];
  const defaults: Trace = {
    calls: 0, defaults: 0
  };
  const argumentsTrace: Trace = {
    calls: 0, defaults: 0
  };
  let i = 0;
  while (i < n) {
    const mode = (i + seed) % 3;
    const base = (i * 13 + seed) % 97;
    const count = mode === 0 ? 0 : mode === 1 ? 1 : 5;
    const argumentBefore = argumentsTrace.calls;
    const defaultBefore = defaults.defaults;
    const action = (i + seed) % 4 === 0 ? undefined : apply;
    const result = action?.(defaults, ...argumentsValues(argumentsTrace, base, count));
    output.push(result ?? []);
    output.push([argumentsTrace.calls - argumentBefore, defaults.defaults - defaultBefore]);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(3, 0, "abc");
}
