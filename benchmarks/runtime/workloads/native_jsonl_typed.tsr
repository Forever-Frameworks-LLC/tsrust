import { openJsonl, readJsonl, closeJsonl } from 'std:json';

type Item = {
  name: string;
  values: int[];
  active: boolean;
};

function workload(n: int, seed: int, input: string): int {
  let checksum = seed;
  let i = 0;
  while (i < n) {
    match (openJsonl(input)) {
      Ok(reader) => {
        let done = false;
        while (!done) {
          match (readJsonl<Item>(reader)) {
            Ok(item) => {
              if (item === undefined) {
                done = true;
              } else {
                if (!item.active) {
                  throw 'Inactive item';
                }

                checksum += item.name.length + item.values[0] + item.values[1];
              }
            },
            Err(error) => {
              throw error.message;
            }
          }
        }

        match (closeJsonl(reader)) {
          Ok(_) => {},
          Err(error) => {
            throw error.message;
          }
        }
      },
      Err(error) => {
        throw error.message;
      }
    }

    i++;
  }

  return checksum;
}
