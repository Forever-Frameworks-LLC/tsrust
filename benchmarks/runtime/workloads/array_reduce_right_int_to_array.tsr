function workload(n:int,seed:int):int[][]{const base:int[]=[seed,seed+1,2,3,seed+4];let trace=seed;let visits=0;let i=0;const output:int[][]=[];while(i<n){const mode=(i+seed)%5;let count=5;if(mode===0){count=0;}else if(mode===1){count=1;}else if(mode===2){count=4;}const values=base.slice(0,count);const selected:int[]=values.reduceRight((a:int[],v:int,index:int,source:int[]):int[]=>{trace=(trace*131+index+source.length+i)%1000000007;visits=visits+1;a.push(v+index);return a;},[]);output.push(selected);i=i+1;}return output;}
function main(){const result=workload(2,7);}
