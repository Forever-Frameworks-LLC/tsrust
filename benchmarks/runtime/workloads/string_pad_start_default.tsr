function workload(n: int, seed: int, input: string): string[] {
    const values: string[] = [clone(input), "", "A", "a\u0000b", "XY", " x ", input.repeat(2), "Z"];
    const extras: int[] = [- 10000, - 1, 0, 1, 2, 5, 8, 17];
    const output: string[] = [];
    let i = 0;
    while (i < n) {
        const at = (i * 13 + seed) % 8;
        const target: int = values[at].length + extras[(i * 7 + seed) % 8];
        const selected: string = values[at].padStart(target);
        output.push(selected);
        i = i + 1;
    }

    return output;
}

function main() {
    const result = workload(2, 7, " A alpha Z ");
}
