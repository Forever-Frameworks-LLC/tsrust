function workload(n:int,seed:int,input:string):string[][][]{const base:string[][]=[[clone(input),"é"],[],["😀","a\u0000b"],["e\u0301"],["last"]];const output:string[][][]=[];let i=0;while(i<n){const mode=(i+seed)%4;let count=5;if(mode===0){count=0;}else if(mode===1){count=1;}else if(mode===2){count=4;}const selected=base.slice(0,count);const result=selected.concat();output.push(result);i=i+1;}return output;}
function main(){const result=workload(2,7,"é 😀 e\u0301");}
