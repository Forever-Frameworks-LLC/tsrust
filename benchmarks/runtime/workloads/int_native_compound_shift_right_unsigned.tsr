function workload(n: int, seed: int): int[] {
    const operands: int[] = [0, 1, 2, 3, 7, 15, 65535, 1073741823];
    const rhs: int[] = [0, 1, 2, 3, 4, 7, 15, 31];
    const output: int[] = [];
    let i = 0;
    while (i < n) {
        let value: int = operands[(i * 13 + seed) % 8];
        const other: int = rhs[(i * 7 + seed) % 8];
        value >>>= other;
        output.push(value);
        i = i + 1;
    }

    return output;
}

function main() {
    const result = workload(2, 7);
}
