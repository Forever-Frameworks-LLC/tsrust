function workload(n: int, seed: int, input: string): string[] {
    const values: string[] = [clone(input), "", "ABC", "a\u0000b", " x ", "quote\"", "slash\\", input.repeat(2)];
    const bounds: int[][][] = [[[0, input.length], [1, 0], [1000000, 7], [- 1000000, input.length], [1, 3], [- 3, 2], [1, - 1], [2, 1000000], [- 1000000, 0]], [[0, 0], [1, 0], [1000000, 7], [- 1000000, 0], [1, 3], [- 3, 2], [1, - 1], [2, 1000000], [- 1000000, 0]], [[0, 3], [1, 0], [1000000, 7], [- 1000000, 3], [1, 3], [- 3, 2], [1, - 1], [2, 1000000], [- 1000000, 0]], [[0, 3], [1, 0], [1000000, 7], [- 1000000, 3], [1, 3], [- 3, 2], [1, - 1], [2, 1000000], [- 1000000, 0]], [[0, 3], [1, 0], [1000000, 7], [- 1000000, 3], [1, 3], [- 3, 2], [1, - 1], [2, 1000000], [- 1000000, 0]], [[0, 6], [1, 0], [1000000, 7], [- 1000000, 6], [1, 3], [- 3, 2], [1, - 1], [2, 1000000], [- 1000000, 0]], [[0, 6], [1, 0], [1000000, 7], [- 1000000, 6], [1, 3], [- 3, 2], [1, - 1], [2, 1000000], [- 1000000, 0]], [[0, input.length * 2], [1, 0], [1000000, 7], [- 1000000, input.length * 2], [1, 3], [- 3, 2], [1, - 1], [2, 1000000], [- 1000000, 0]]];
    const output: string[] = [];
    let i = 0;
    while (i < n) {
        const at = (i * 13 + seed) % 8;
        const mode = (i * 7 + seed) % 9;
        const selected: string = values[at].substr(bounds[at][mode][0], bounds[at][mode][1]);
        output.push(selected);
        i = i + 1;
    }

    return output;
}

function main() {
    const result = workload(2, 7, "dynamic ASCII");
}
