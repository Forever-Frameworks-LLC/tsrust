function workload(n: int, seed: int): int {
  let digest = seed;
  let i = 0;
  while (i < n) {
    const left = (i * 37 + seed) % 2001 - 1000;
    let divisor = (i * 17 + seed) % 127 - 63;
    if (divisor === 0) {
      divisor = 1;
    }

    const result = left / divisor;
    digest = (digest * 131 + result + 1100) % 1000000007;
    i = i + 1;
  }

  return digest;
}

function main() {
  console.log(workload(17, 7));
}
