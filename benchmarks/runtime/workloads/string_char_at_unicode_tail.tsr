function workload(n: int, seed: int, input: string): string[] {
  const results: string[] = [];
  let i = 0;
  while (i < n) {
    results.push(input.charAt((i * 13 + seed) % 37 - 7));
    i = i + 1;
  }

  return results;
}

function main() {
  const results = workload(2, 7, "A😀e\u0301\u0000Z");
  console.log(results.length);
}
