type Trace = {
    predicates: int;
    left: int;
    right: int;
};

function workload(n: int, seed: int, input: string): string[][] {
    const output: string[][] = [];
    const trace: Trace = {
        predicates: 0, left: 0, right: 0
    };
    let i = 0;
    while (i < n) {
        const size: int = (i * 7 + seed * 2) % 4;
        const at: int = (i * 13 + seed * 2) % 8;
        const selected: string[] = predicate(trace, (i + seed) % 2 === 0) ? leftValue(trace, at, size, input) : rightValue(trace, at, size, input);
        output.push(selected);
        i = i + 1;
    }

    output.push(["P".repeat(trace.predicates), "L".repeat(trace.left), "R".repeat(trace.right)]);
    return output;
}

function predicate(trace: Trace, flag: boolean): boolean {
    trace.predicates = trace.predicates + 1;
    return flag;
}

function leftValue(trace: Trace, at: int, size: int, input: string): string[] {
    trace.left = trace.left + 1;
    const values: string[] = [];
    let j = 0;
    while (j < size) {
        values.push((input + "L").repeat(j + 1));
        j = j + 1;
    }

    return values;
}

function rightValue(trace: Trace, at: int, size: int, input: string): string[] {
    trace.right = trace.right + 1;
    const values: string[] = [];
    let j = 0;
    while (j < size) {
        values.push((input + "R").repeat(j + 1));
        j = j + 1;
    }

    return values;
}

function main() {
    const result = workload(2, 7, " A alpha Z ");
}
