function grow(values:Mutable<int[]>):int { values.push(9);return values.length; }
function workload(n: int, seed: int, input: string): int[][] {
 const output: int[][] = []; let i = 0;
 while (i < n) { const base = (i + seed) % 97; const values = [base,base + 1]; const packed = [...values,grow(values),...values];output.push(packed);output.push(values); i = i + 1; } return output;
}
function main() { const result = workload(3, 0, "abc"); }
