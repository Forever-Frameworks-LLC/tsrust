function workload(n: int, seed: int): boolean[][] {
    const output: boolean[][] = [];
    const sizes: int[] = [0, 1, 4, 5, 17];
    let i = 0;
    while (i < n) {
        const count = sizes[(i + seed) % 5];
        const source: boolean[] = [];
        let j = 0;
        while (j < count) {
            const ordinal = j; source.push((ordinal + seed) % 3 !== 0);
            j = j + 1;
        }
        const flattened = source.flatMap(mapPiece);
        output.push(flattened);
        i = i + 1;
    }
    return output;
}
function mapPiece(value: boolean, index: int, source: boolean[]): boolean[] {
    if (index % 3 === 0) { return []; }
    return [value, !value];
}
function main() { const result = workload(2, 7); }
