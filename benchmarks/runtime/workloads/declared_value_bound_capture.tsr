function workload(n:int,seed:int):int{const selected=step;const action=(value:int):int=>{return selected(value);};let trace=seed;let i=0;while(i<n){const value=action(seed+i);trace=(trace*131+value)%1000000007;i=i+1;}return trace;}
function step(value:int):int{return(value*3+1)%1000000007;}

function main(){const result=workload(2,7);}
