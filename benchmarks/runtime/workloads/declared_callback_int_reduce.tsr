function workload(n:int,seed:int):int{const base:int[]=[seed+1,2,seed+3,4,seed+5];let trace=seed;let i=0;while(i<n){const mode=(seed+i)%4;let count=5;if(mode===0){count=0;}else if(mode===1){count=1;}else if(mode===2){count=4;}const values=base.slice(0,count);const value=values.reduce(fold,0);trace=(trace*131+value)%1000000007;i=i+1;}return trace;}
function fold(a:int,v:int):int{return(a*17+v)%1000000007;}

function main(){const result=workload(2,7);}
