import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.string().min(2).max(6);
  let checksum = seed;
  let i = 0;
  while (i < n) {
    match (schema.safeParse(JSON.parse(input))) {
      Ok(text) => {
        checksum += text.length;
      },
      Err(error) => {
        throw 'Expected string success';
      }
    }

    match (schema.safeParse(JSON.parse('"x"'))) {
      Ok(text) => {
        throw 'Expected short string rejection';
      },
      Err(error) => {
        if (error.truncated || error.issues.length !== 1) {
          throw 'Invalid error count';
        }

        for (const issue of error.issues) {
          if (issue.code !== 'too-small' || issue.expected !== 'string' || issue.observed !== 'string' || issue.path.length !== 0 || issue.pathTruncated) {
            throw 'Invalid issue';
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, '"hello"'));
}
