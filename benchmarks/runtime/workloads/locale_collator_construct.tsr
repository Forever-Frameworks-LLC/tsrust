import { parseLocale, formatLocale, createCollator, createSegmenter, createNumberFormat } from 'std:locale';

function workload(n: int, seed: int, input: string): int {
  const locale = unwrap(parseLocale('en'));
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const value = unwrap(createCollator(locale));
    checksum += value.compare(input, 'e10') + 2;
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, "é2"));
}
