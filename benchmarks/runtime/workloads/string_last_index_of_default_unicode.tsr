function workload(n: int, seed: int, input: string): int[] {
  const needles: string[] = ["", "a", "aa", "aba", "é", "😀", "é", "missing\u0000", "a\u0000b"];
  const output: int[] = [];
  let i = 0;
  while (i < n) {
    const at = input.lastIndexOf(needles[(i * 17 + seed) % 9]);
    output.push(at + 1);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(2, 7, "aaababaé😀ababaé😀é😀Z");
}
