function first<T>(value: T, base: int): int {
    return base;
}

function second<T>(value: T, base: int): int {
    return base + 7;
}

function failing<T>(value: T, base: int): int {
    throw "selected failure";
}

function attempt(flag: boolean, base: int): int {
    let action = first;
    if (flag) {
        action = failing;
    }

    try {
        return action<int>(base, base);
    } catch (error) {
        if (error === "selected failure") {
            return 11;
        }

        return 0;
    }
}

function firstDefault<T>(value: T, offset: int = 3): int {
    return offset;
}

function secondDefault<T>(value: T, offset: int = 7): int {
    return offset;
}

function defaulted(flag: boolean): int {
    let action = firstDefault;
    if (flag) {
        action = secondDefault;
    }

    return action<int>(1);
}

function ownedHead<T>(value: T, ...tail: T[]): T {
    return value;
}

function ownedTail<T>(value: T, ...tail: T[]): T {
    return tail.shift()!;
}

function selectedText(flag: boolean): string {
    let action = ownedHead;
    if (flag) {
        action = ownedTail;
    }

    return action<string>("head", "next-value");
}

function nullableRead<T>(value: T): string | undefined {
    return "read";
}

function nullableTake<T>(value: T): T {
    return value;
}

function nullableLength(flag: boolean, value: Owned<string | undefined>): int {
    let action = nullableRead;
    if (flag) {
        action = nullableTake;
    }

    const selected = action<string | undefined>(value);
    return selected ?. length ?? 0;
}

function callbackFirst<T>(value: T, callback: ReadOnly<Function<int>>): int {
    return callback();
}

function callbackSecond<T>(value: T, callback: ReadOnly<Function<int>>): int {
    return callback() + 7;
}

function callbackResult(flag: boolean, fail: boolean, base: int): int {
    let action = callbackFirst;
    if (flag) {
        action = callbackSecond;
    }

    const callback = (): int => {
        if (fail) {
            throw "callback failed";
        }

        return base;
    };
    try {
        return action<int>(base, callback);
    } catch (error) {
        if (error === "callback failed") {
            return 11;
        }

        return 0;
    }
}

function capturedResult(flag: boolean, fail: boolean, base: int): int {
    const left = base;
    const right = base + 7;
    function capturedFirst<T>(value: T): int {
        return left;
    }

    function capturedSecond<T>(value: T): int {
        if (fail) {
            throw right;
        }

        return right;
    }

    let action = capturedFirst;
    const saved = action;
    action = capturedFirst;
    if (flag) {
        action = capturedSecond;
    }

    try {
        return saved<int>(0) + action<int>(0);
    } catch (error) {
        return 11;
    }
}

function stateFirst<T>(value: T): T {
    return value;
}

function stateSecond<T>(value: T, other: T): T {
    return other;
}

function stateFactory<A>(initial: A) {
    let action = initial;
    return (restore: boolean) => {
        const previous = action;
        if (restore) {
            action = stateFirst;
        } else {
            action = stateSecond;
        }

        return previous;
    };
}

function stateResult(base: int): int[] {
    const first = stateFactory(stateFirst);
    const second = stateFactory(stateSecond);
    const original = first(false);
    const changed = first(true);
    const restored = first(false);
    const independent = second(true);
    return [original<int>(base), changed<int>(base, base + 7), restored<int>(base), independent<int>(base, base + 9)];
}

function workload(n: int, seed: int, input: string): int[][] {
    const output: int[][] = [];
    for (let i = 0; i < n; i += 1) {
        const base = i % 5 + seed % 5 + 1;
        const flag = (i + seed) % 2 === 1;
        let action = first;
        const saved = action;
        action = first;
        if (flag) {
            action = second;
        }

        const original = saved<int>(base, base);
        const selected = action<int>(base, base);
        const completed = attempt(flag, base);
        const omitted = defaulted(flag);
        const text = selectedText(flag);
        const present = nullableLength(flag, "nullable");
        const absent = nullableLength(flag, undefined);
        const callback = callbackResult(flag, i % 3 === 0, base);
        const captured = capturedResult(flag, i % 3 === 0, base);
        const state = stateResult(base);
        output.push([original, selected, completed, omitted, text.length, present, absent, callback, captured, state[0], state[1], state[2], state[3]]);
    }

    return output;
}

function main() {
    const result = workload(3, 0, "replacement");
}
