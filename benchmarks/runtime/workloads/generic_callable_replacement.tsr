function first<T>(value: T, base: int): int {
    return base;
}

function second<T>(value: T, base: int): int {
    return base + 7;
}

function failing<T>(value: T, base: int): int {
    throw "selected failure";
}

function attempt(flag: boolean, base: int): int {
    let action = first;
    if (flag) {
        action = failing;
    }

    try {
        return action<int>(base, base);
    } catch (error) {
        if (error === "selected failure") {
            return 11;
        }

        return 0;
    }
}

function firstDefault<T>(value: T, offset: int = 3): int {
    return offset;
}

function secondDefault<T>(value: T, offset: int = 7): int {
    return offset;
}

function defaulted(flag: boolean): int {
    let action = firstDefault;
    if (flag) {
        action = secondDefault;
    }

    return action<int>(1);
}

function ownedHead<T>(value: T, ...tail: T[]): T {
    return value;
}

function ownedTail<T>(value: T, ...tail: T[]): T {
    return tail.shift()!;
}

function selectedText(flag: boolean): string {
    let action = ownedHead;
    if (flag) {
        action = ownedTail;
    }

    return action<string>("head", "next-value");
}

function nullableRead<T>(value: T): string | undefined {
    return "read";
}

function nullableTake<T>(value: T): T {
    return value;
}

function nullableLength(flag: boolean, value: Owned<string | undefined>): int {
    let action = nullableRead;
    if (flag) {
        action = nullableTake;
    }

    const selected = action<string | undefined>(value);
    return selected ?. length ?? 0;
}

function callbackFirst<T>(value: T, callback: ReadOnly<Function<int>>): int {
    return callback();
}

function callbackSecond<T>(value: T, callback: ReadOnly<Function<int>>): int {
    return callback() + 7;
}

function callbackResult(flag: boolean, fail: boolean, base: int): int {
    let action = callbackFirst;
    if (flag) {
        action = callbackSecond;
    }

    const callback = (): int => {
        if (fail) {
            throw "callback failed";
        }

        return base;
    };
    try {
        return action<int>(base, callback);
    } catch (error) {
        if (error === "callback failed") {
            return 11;
        }

        return 0;
    }
}

function workload(n: int, seed: int, input: string): int[][] {
    const output: int[][] = [];
    for (let i = 0; i < n; i += 1) {
        const base = i % 5 + seed % 5 + 1;
        const flag = (i + seed) % 2 === 1;
        let action = first;
        const saved = action;
        action = first;
        if (flag) {
            action = second;
        }

        const original = saved<int>(base, base);
        const selected = action<int>(base, base);
        const completed = attempt(flag, base);
        const omitted = defaulted(flag);
        const text = selectedText(flag);
        const present = nullableLength(flag, "nullable");
        const absent = nullableLength(flag, undefined);
        const callback = callbackResult(flag, i % 3 === 0, base);
        output.push([original, selected, completed, omitted, text.length, present, absent, callback]);
    }

    return output;
}

function main() {
    const result = workload(3, 0, "replacement");
}
