import { fromUtf16, toUtf16, fromUtf8, length, at } from "std:bytes";

function workload(n: int, seed: int, input: string): int[] {
  let size = 32;
  if (input === "4k") {
    size = 4096;
  }

  if (input === "1m") {
    size = 1048576;
  }

  const text = "é😀Ab".repeat(size / 8);
  const bytes = unwrap(fromUtf16(text, "little"));
  const output: int[] = [];
  let i = 0;
  while (i < n) {
    const result = unwrap(toUtf16(bytes, "little"));
    output.push(result.length);
    output.push(result.startsWith("é😀") ? 1 : 0);
    output.push(result.endsWith("Ab") ? 1 : 0);
    i += 1;
  }

  return output;
}

function main() {
  workload(1, 7, "token");
}
