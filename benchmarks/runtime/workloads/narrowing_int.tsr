function workload(n: int, seed: int): int[] {
    const values: int[] = [seed, 0, 1, 17, 9001];
    const output: int[] = []; let i = 0;
    while (i < n) {
        const mode = (i + seed) % 3;
        const at = (i * 13 + seed) % 5;
        const value: int | null | undefined = mode === 0 ? null : mode === 1 ? undefined : values[at];
        if (value !== null && value !== undefined) { output.push(2); output.push(value + 1); } else if (value === null) { output.push(0); output.push(0); } else { output.push(1); output.push(0); }
        i = i + 1;
    }
    return output;
}
function main() { const result = workload(2, 7); }
