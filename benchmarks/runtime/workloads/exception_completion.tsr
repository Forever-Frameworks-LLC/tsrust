function attempt(value: int, trace: int[]): int {
  try {
    if (value % 3 === 0) {
      throw value;
    }

    return value + 1;
  } catch (error) {
    if (typeof error !== "number") {
      throw error;
    }

    return error + 2;
  } finally {
    trace.push(value);
  }
}

function replaced(value: int): int {
  try {
    return value;
  } finally {
    return value + 4;
  }
}

function retained(value: string, early: boolean, trace: int[]): string {
  try {
    if (early) {
      return value;
    }
  } finally {
    trace.push(7);
  }

  return value;
}

type RetainedOwner = {
  text: string;
  stamp: int;
};

function retainedField(value: RetainedOwner, early: boolean, trace: int[]): string {
  try {
    if (early) {
      return value.text;
    }
  } finally {
    trace.push(value.stamp);
  }

  return value.text;
}

type CallbackHolder = {
  run: ReadOnly<Function<int>>;
};

function retainedMap(value: RetainedOwner, early: boolean, trace: int[]): string {
  const old = [3];
  const current = [7];
  const handlers = new Map<string, CallbackHolder>();
  handlers.set("old", {
    run: (): int => old[0]
  });
  try {
    if (early) {
      return value.text;
    }

    handlers.clear();
    handlers.set("new", {
      run: (): int => current[0]
    });
    throw 32;
  } catch (error) {
    trace.push(32);
  } finally {
    const item = handlers.get(early ? "old" : "new");
    if (item !== undefined) {
      trace.push(item.run() + value.stamp);
    }
  }

  return value.text;
}

function retainedLoop(value: RetainedOwner, mode: int, trace: int[]): string {
  for (let i = 0; i < 2; i += 1) {
    try {
      if (mode === 0) {
        return value.text;
      }

      if (mode === 1) {
        break;
      }

      if (mode === 2) {
        continue;
      }
    } finally {
      trace.push(20 + i);
    }
  }

  return value.text;
}

function retainedCatch(value: RetainedOwner, mode: int, trace: int[]): string {
  try {
    if (mode === 0) {
      return value.text;
    }

    if (mode === 1) {
      throw 31;
    }

    trace.push(29);
  } catch (error) {
    trace.push(30);
    if (mode === 1) {
      return value.text;
    }
  } finally {
    trace.push(31);
  }

  return value.text;
}

type CleanupChoice = {
  first: string;
  second: string;
};

function conditionalCleanup(value: string, early: boolean, replace: boolean): string {
  const pair: CleanupChoice = {
    first: value, second: "alternate"
  };
  try {
    if (early) {
      return pair.first;
    }
  } finally {
    if (replace) {
      return pair.second;
    }
  }

  return pair.second;
}

function workload(n: int, seed: int, input: string): string[][] {
  const output: string[][] = [];
  let i = 0;
  while (i < n) {
    const value = (i * 13 + seed) % 97;
    const trace: int[] = [];
    const result = attempt(value, trace);
    const owned = retained(input + String(value), value % 2 === 0, trace);
    const field = retainedField({
      text: owned, stamp: 11
    }, value % 2 === 0, trace);
    const mapped = retainedMap({
      text: field, stamp: 1
    }, value % 2 === 0, trace);
    const looped = retainedLoop({
      text: mapped, stamp: 0
    }, value % 4, trace);
    const caught = retainedCatch({
      text: looped, stamp: 0
    }, value % 3, trace);
    const selected = conditionalCleanup(caught, value % 2 === 0, value % 3 === 0);
    output.push([String(result), String(replaced(value)), trace.join(","), selected]);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(3, 0, "abc");
}
