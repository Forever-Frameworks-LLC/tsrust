function attempt(value: int, trace: int[]): int {
  try {
    if (value % 3 === 0) {
      throw value;
    }

    return value + 1;
  } catch (error) {
    if (typeof error !== "number") {
      throw error;
    }

    return error + 2;
  } finally {
    trace.push(value);
  }
}

function replaced(value: int): int {
  try {
    return value;
  } finally {
    return value + 4;
  }
}

function retained(value: string, early: boolean, trace: int[]): string {
  try {
    if (early) {
      return value;
    }
  } finally {
    trace.push(7);
  }

  return value;
}

function workload(n: int, seed: int, input: string): string[][] {
  const output: string[][] = [];
  let i = 0;
  while (i < n) {
    const value = (i * 13 + seed) % 97;
    const trace: int[] = [];
    const result = attempt(value, trace);
    const owned = retained(input + String(value), value % 2 === 0, trace);
    output.push([String(result), String(replaced(value)), trace.join(","), owned]);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(3, 0, "abc");
}
