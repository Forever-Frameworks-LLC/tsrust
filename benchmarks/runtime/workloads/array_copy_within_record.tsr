type Row={code:int;text:string;items:int[];};
function workload(n:int,seed:int,input:string):Row[]{const output:Row[]=[];let i=0;while(i<n){const values:Row[]=[item(seed+i+0,input),item(seed+i+1,input),item(seed+i+2,input),item(seed+i+3,input),item(seed+i+4,input),item(seed+i+5,input)];if((i+seed)%8===7){values.copyWithin(target(i,seed),start(i,seed));}else{values.copyWithin(target(i,seed),start(i,seed),ending(i,seed));}for(const value of values){output.push(clone(value));}i=i+1;}return output;}
function start(i:int,seed:int):int{const c=(i+seed)%8;if(c===0){return 0;}if(c===1){return 1;}if(c===2){return -6;}if(c===3){return -9;}if(c===4){return -9;}if(c===5){return 4;}if(c===6){return -3;}return -9;}
function ending(i:int,seed:int):int{const c=(i+seed)%8;if(c===0){return 5;}if(c===1){return 6;}if(c===2){return -1;}if(c===3){return 9;}if(c===4){return 9;}if(c===5){return 1;}if(c===6){return 9;}return -1;}
function target(i:int,seed:int):int{const c=(i+seed)%8;if(c===0){return 1;}if(c===1){return 0;}if(c===2){return -2;}if(c===3){return -9;}if(c===4){return 9;}if(c===5){return 2;}if(c===6){return -1;}return 0;}
function item(base:int,input:string):Row{return {code:base%1009,text:clone(input),items:[base%17,0,(base+1)%17]};}
function main(){const result=workload(2,7," xé😀e\u0301 ");}
