function workload(n: int, seed: int): string[] {
  const output: string[] = [];
  const sizes: int[] = [0, 1, 4, 5, 17];
  let i = 0;
  while (i < n) {
    const count = sizes[(i + seed) % 5];
    const arity = (i * 7 + seed) % 3;
    const values: null[] = [];
    let j = 0;
    while (j < count) {
      values.push(null);
      j = j + 1;
    }

    let newLength = 0;
    if (arity === 0) {
      newLength = values.unshift();
    } else if (arity === 1) {
      newLength = values.unshift(null);
    } else {
      newLength = values.unshift(null, null, null);
    }

    output.push(String(newLength));
    output.push(String(values.length));
    let at = 0;
    while (at < values.length) {
      output.push(describe(values[at]));
      at = at + 1;
    }

    i = i + 1;
  }

  return output;
}

function describe(value: null): string {
  return String(value);
}

function main() {
  const result = workload(2, 7);
}
