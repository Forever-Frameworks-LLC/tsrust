type Row = {
  total: int;
  text: string;
  rows: int[][];
  trace: int;
  visits: int;
};

function workload(n: int, seed: int): Row {
  const base: int[] = [seed, seed + 1, 2, 3, seed + 4];
  let trace = seed;
  let visits = 0;
  let i = 0;
  let last: Row = {
    total: 0, text: "initial", rows: [], trace: 0, visits: 0
  };
  while (i < n) {
    const mode = (i + seed) % 5;
    let count = 5;
    if (mode === 0) {
      count = 0;
    } else if (mode === 1) {
      count = 1;
    } else if (mode === 2) {
      count = 4;
    }

    const values = base.slice(0, count);
    const selected: Row = values.reduce((a: Row, v: int, index: int, source: int[]): Row => {
      trace = (trace * 131 + index + source.length + i) % 1000000007;
      visits = visits + 1;
      a.rows.push([v, index]);
      return {
        total: (a.total * 17 + v + index) % 1000003, text: a.text.replace("initial", "owned"), rows: a.rows, trace: trace, visits: visits
      };
    }, {
      total: 0, text: "initial", rows: [], trace: 0, visits: 0
    });
    last = selected;
    i = i + 1;
  }

  return last;
}

function main() {
  const result = workload(2, 7);
}
