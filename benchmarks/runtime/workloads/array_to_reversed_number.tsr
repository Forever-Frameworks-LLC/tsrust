function workload(n: int, seed: int): number[] {
    const output: number[] = [];
    let i = 0;
    while (i < n) {
        const values: number[] = [item(seed + i + 0), item(seed + i + 1), item(seed + i + 2), item(seed + i + 3), item(seed + i + 4), item(seed + i + 5)];
        const result = values.toReversed();
        for (const value of result) {
            output.push(value);
        }

        i = i + 1;
    }

    return output;
}

function item(base: int): number {
    const c = base % 8;
    if (c === 0) {
        return 0.0;
    }

    if (c === 1) {
        return -0.0;
    }

    if (c === 2) {
        return 1.25;
    }

    if (c === 3) {
        return -2.5;
    }

    if (c === 4) {
        return Number.NaN;
    }

    if (c === 5) {
        return Number.POSITIVE_INFINITY;
    }

    if (c === 6) {
        return Number.NEGATIVE_INFINITY;
    }

    return Number(base % 17) / 4.0;
}

function main() {
    const result = workload(2, 7);
}
