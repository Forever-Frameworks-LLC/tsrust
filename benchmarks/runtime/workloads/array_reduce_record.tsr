type Row = {
  total: int;
  text: string;
  rows: int[][];
  trace: int;
  visits: int;
};

function workload(n: int, seed: int): Row {
  const base: Row[] = [{
    total: seed, text: "é", rows: [[seed]], trace: 0, visits: 0
  }, {
    total: 2, text: "😀", rows: [], trace: 0, visits: 0
  }, {
    total: 3, text: "a\u0000b", rows: [[1, 2]], trace: 0, visits: 0
  }, {
    total: 4, text: "e\u0301", rows: [[]], trace: 0, visits: 0
  }, {
    total: 5, text: "last", rows: [[5]], trace: 0, visits: 0
  }];
  let trace = seed;
  let visits = 0;
  let i = 0;
  let last: Row = {
    total: 0, text: "initial", rows: [], trace: 0, visits: 0
  };
  while (i < n) {
    const mode = (i + seed) % 5;
    let count = 5;
    if (mode === 0) {
      count = 0;
    } else if (mode === 1) {
      count = 1;
    } else if (mode === 2) {
      count = 4;
    }

    const values = base.slice(0, count);
    let selected: Row = {
      total: 0, text: "initial", rows: [], trace: 0, visits: 0
    };
    if (mode === 3) {
      selected = values.reduce((a: Row, v: Row, index: int, source: Row[]): Row => {
        trace = (trace * 131 + index + source.length + i) % 1000000007;
        visits = visits + 1;
        return {
          total: (a.total * 17 + v.total + index) % 1000003, text: clone(v.text), rows: clone(v.rows), trace: trace, visits: visits
        };
      });
    } else {
      selected = values.reduce((a: Row, v: Row, index: int, source: Row[]): Row => {
        trace = (trace * 131 + index + source.length + i) % 1000000007;
        visits = visits + 1;
        return {
          total: (a.total * 17 + v.total + index) % 1000003, text: clone(v.text), rows: clone(v.rows), trace: trace, visits: visits
        };
      }, clone(last));
    }

    last = selected;
    i = i + 1;
  }

  return last;
}

function main() {
  const result = workload(2, 7);
}
