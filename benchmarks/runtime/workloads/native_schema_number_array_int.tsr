import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.array(s.number());
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const exact: int[] = [42];
    {
      const outcome0 = schema.safeParse(exact);
      if (outcome0.success) {
        const values = outcome0.data;
        for (const value of values) {
          if (value !== 42.0) {
            throw 'Expected exact conversion';
          }

          checksum += 1;
        }
      } else {
        const error = outcome0.error;
        throw 'Expected success';
      }
    }

    const lossy: int[] = [9007199254740993];
    {
      const outcome1 = schema.safeParse(lossy);
      if (outcome1.success) {
        const values = outcome1.data;
        throw 'Expected rejection';
      } else {
        const error = outcome1.error;
        if (error.truncated || error.issues.length !== 1) {
          throw 'Invalid count';
        }

        for (const issue of error.issues) {
          if (issue.code !== 'number-precision' || issue.expected !== 'number' || issue.observed !== 'integer' || issue.path.length !== 1 || issue.pathTruncated) {
            throw 'Invalid issue';
          }

          for (const segment of issue.path) {
            if (segment.index !== 0 || segment.field !== undefined) {
              throw 'Invalid path';
            }
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, 'native-int-array'));
}
