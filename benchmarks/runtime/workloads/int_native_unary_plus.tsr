function workload(n: int, seed: int): int[] {
  const operands: int[] = [0, 1, 3, 7, 15, 63, 255, 65535];
  const output: int[] = [];
  let i = 0;
  while (i < n) {
    const value: int = operands[(i * 13 + seed) % 8];
    const observed: int = +value;
    output.push(observed);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(2, 7);
}
