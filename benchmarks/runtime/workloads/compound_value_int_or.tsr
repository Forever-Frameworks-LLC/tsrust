function workload(n: int, seed: int): int[] {
    const operands: int[] = [0, 1, 3, 7, 15, 63, 255, 65535];
    const rhs: int[] = [0, 2, 5, 8, 17, 42, 170, 43690];
    const output: int[] = [];
    let i = 0;
    while (i < n) {
        let value: int = operands[(i * 13 + seed) % 8];
        const other: int = rhs[(i * 7 + seed) % 8];
        const observed: int = (value |= other);
        output.push(observed);
        output.push(value);
        i = i + 1;
    }

    return output;
}

function main() {
    const result = workload(2, 7);
}
