type Row = {
  label: string | undefined;
  amount: int;
};

function workload(n: int, seed: int, input: string): string[][] {
  const output: string[][] = [];
  let i = 0;
  while (i < n) {
    const row: Row = {
      label: undefined, amount: i + seed
    };
    const values = [i, seed];
    const position = (i + seed) % 4;
    output.push([String(Object.hasOwn(row, "label")), String(Object.hasOwn(row, "missing")), String(Object.hasOwn(row, "toString")), String(Object.hasOwn(values, position)), String(Object.hasOwn(values, "length")), String(Object.hasOwn(values, "01")), String(Object.hasOwn(input, position)), String(Object.hasOwn(input, "length")), String(Object.hasOwn(values, -0.0))]);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(3, 0, "é😀");
}
