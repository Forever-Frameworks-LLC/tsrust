function workload(n: int, seed: int): int[][][] {
    const output: int[][][] = [];
    let i = 0;
    while (i < n) {
        const values: int[][][] = [item(seed + i + 0), item(seed + i + 1), item(seed + i + 2), item(seed + i + 3), item(seed + i + 4), item(seed + i + 5)];
        const result = values.toReversed();
        for (const value of result) {
            output.push(clone(value));
        }

        i = i + 1;
    }

    return output;
}

function item(base: int): int[][] {
    if (base % 3 === 0) {
        return [];
    }

    if (base % 3 === 1) {
        return [[], [base % 17]];
    }

    return [[base % 17, (base + 1) % 17], [], [0]];
}

function main() {
    const result = workload(2, 7);
}
