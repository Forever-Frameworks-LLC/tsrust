function workload(n: int, seed: int): int {
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const base = i + seed;
    const actions: (() => int)[] = [(): int => {
      return base;
    }];
    actions.push((): int => {
      return base + 1;
    });
    actions.unshift((): int => {
      return base + 2;
    });
    actions[1] = (): int => {
      return base + 3;
    };
    const first = actions.remove(0);
    const removed = actions.splice(0, 1, (): int => {
      return base + 4;
    });
    checksum = checksum + first() + removed[0]() + actions[0]() + actions[1]() + actions.length;
    i = i + 1;
  }

  return checksum;
}

function main() {
  console.log(workload(2, 7));
}
