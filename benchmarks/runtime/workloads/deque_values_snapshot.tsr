import { Deque } from 'std:collections';

function workload(n: int, seed: int): int {
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const deque = new Deque<int[]>();
    deque.pushBack([seed + i]);
    deque.pushBack([seed + i + 1]);
    deque.popFront();
    deque.pushBack([seed + i + 2]);
    const rows = deque.values();
    rows[0].push(9);
    checksum += rows[0][0] + rows[0][1] + 2 * rows[1][0] + deque.front()!.length;
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 7));
}
