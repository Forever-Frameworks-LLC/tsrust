function integers(base: int, count: int): int[] {
  const values: int[] = [];
  let at = 0;
  while (at < count) {
    values.push(base + at);
    at = at + 1;
  }

  return values;
}

function collect<T>(...values: T[]): T[] {
  return values;
}

type Trace = {
  calls: int;
  defaults: int;
};

function argumentsValues(trace: Trace, base: int, count: int): int[] {
  trace.calls = trace.calls + 1;
  return integers(base, count);
}

function consume(text: string): string {
  return text;
}

function makeAction(text: string): Once<Function<string[], [trace: Mutable<Trace>, ...values: int[]]>> {
  return (trace: Trace, ...values: int[]): string[] => {
    trace.calls = trace.calls + 1;
    const result: string[] = [consume(text)];
    let at = 0;
    while (at < values.length) {
      result.push(String(values[at]));
      at = at + 1;
    }

    return result;
  };
}

function workload(n: int, seed: int, input: string): string[][] {
  const output: string[][] = [];
  const calls: Trace = {
    calls: 0, defaults: 0
  };
  const argumentsTrace: Trace = {
    calls: 0, defaults: 0
  };
  let i = 0;
  while (i < n) {
    const mode = (i + seed) % 3;
    const base = (i * 13 + seed) % 97;
    const count = mode === 0 ? 0 : mode === 1 ? 1 : 5;
    const argumentBefore = argumentsTrace.calls;
    const callBefore = calls.calls;
    let action: (Once<Function<string[], [trace: Mutable<Trace>, ...values: int[]]>>) | undefined = undefined;
    if ((i + seed) % 4 !== 0) {
      action = makeAction(input.repeat(mode + 1));
    }

    let result: string[] = ["missing"];
    if (action !== undefined) {
      result = action(calls, ...argumentsValues(argumentsTrace, base, count));
    }

    output.push(result);
    output.push([String(argumentsTrace.calls - argumentBefore), String(calls.calls - callBefore)]);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(3, 0, "abc");
}
