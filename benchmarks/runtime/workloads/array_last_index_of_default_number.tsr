function workload(n: int, seed: int): int[] { const values: number[] = []; let j = 0; while (j < 129) { values.push(numberItem(j * 37 + seed)); j = j + 1; } const output: int[] = []; let i = 0; while (i < n) { let needle = numberItem(i * 17 + seed); if ((i + seed) % 11 === 10) { needle = 99.75; } const at = values.lastIndexOf(needle); output.push(at + 1); i = i + 1; } return output; }
function numberItem(base: int): number { const c = base % 8; if (c === 0) { return 0.0; } if (c === 1) { return -0.0; } if (c === 2) { return 1.25; } if (c === 3) { return -2.5; } if (c === 4) { return Number.NaN; } if (c === 5) { return Number.POSITIVE_INFINITY; } if (c === 6) { return Number.NEGATIVE_INFINITY; } return Number(base % 17) / 4.0; }
function main() { const result = workload(2, 7); }
