import { alloc, length, at, copyInto } from "std:bytes";

function workload(n: int, seed: int, input: string): int[] {
  let size = 32;
  if (input === "4k") {
    size = 4096;
  }

  if (input === "1m") {
    size = 1048576;
  }

  const bytes = unwrap(alloc(size, 97));
  const target = unwrap(alloc(size + 1));
  const output: int[] = [];
  let i = 0;
  while (i < n) {
    unwrap(copyInto(target, 1, bytes));
    output.push(length(target));
    output.push(unwrap(at(target, 0)));
    output.push(unwrap(at(target, length(target) - 1)));
    i += 1;
  }

  return output;
}

function main() {
  workload(1, 7, "token");
}
