function consumeScoped(action: Once<Function<Receipt<int>>>): Receipt<int> {
    return action();
}

function retainOnce(action: Once<Function<Receipt<int>>>): Once<Function<Receipt<int>>> {
    return action;
}

function retainPolymorphic<A>(action: A) {
    return () => action;
}

function polymorphicFirst<T>(value: T): T {
    return value;
}

function polymorphicSecond<T>(value: T, other: T): T {
    return other;
}

function lexicalEcho<T>(value: T): T {
    function echo(other: T): T {
        return other;
    }

    return echo(value);
}

function lexicalCapture<T>(value: T) {
    function take(): T {
        return value;
    }

    return take;
}

function sumPayload(value: int = 4, ...tail: int[]): int {
    let sum = value;
    for (const item of tail) {
        sum += item;
    }

    return sum;
}

type PatternBox<T> = {
    value: T;
};

function arrayPatternFactory(start: int) {
    let calls = start;
    function head<T>([first, second]: Owned<T[]>): Receipt<T> {
        calls += 1;
        return {
