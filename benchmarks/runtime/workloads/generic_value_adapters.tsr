    return invoke;
}

type Receipt<T> = {
    value: T;
    calls: int;
};

type Holder = {
    run: Function<Receipt<int>, [value: int]>;
};

function make(start: int) {
    let calls = start;
    function select<T>(value: T): Receipt<T> {
