        output.push([firstValue, firstCalls, generic.value.length, generic.calls, last.value.length, last.calls, mapped[0].value, mapped[1].value, mapped[0].calls, mapped[1].calls, after.value ? 1 : 0, after.calls, record.value, record.calls, stored.value.length, stored.calls, input.length, reduced, reducedAfter.length, reversed, reversedAfter.length, found, searchedAfter ? 1 : 0, sortable[0], copied[0], sortedAfter, defaultValue, omittedCalls, overrideCalls, undefinedCalls, defaultsAfter.calls, defaultsAfter.value.length, emptyValue, emptyCalls, packedCalls, restAfter.calls, restAfter.value.length, directFirst.value, directFirst.calls, directSecond.value, directSecond.calls, factoryMapped[0].value, factoryMapped[1].value, factoryMapped[0].calls, factoryMapped[1].calls, aliasValue.value, aliasValue.calls, selectedMapped[0].value, selectedMapped[1].value, selectedMapped[0].calls, selectedMapped[1].calls, genericFirst.value, genericFirst.calls, genericSecond.calls, genericMapped[0].value, genericMapped[1].value, genericMapped[0].calls, genericMapped[1].calls, distinctFirst.value, distinctFirst.calls, distinctSecond.calls, distinctMapped[0].value, distinctMapped[1].value, distinctMapped[0].calls, distinctMapped[1].calls, selections, evaluations, nestedFirst.value, nestedFirst.calls, nestedSecond.calls, nestedMapped[0].value, nestedMapped[1].value, nestedMapped[0].calls, nestedMapped[1].calls, nestedSelections, nestedEvaluations, inferredFirst, inferredSecond, inferredMapped[0], inferredMapped[1], freshRecord.value, freshRecord.calls, freshStored.value.length, freshStored.calls, callbackFirst.value, callbackFirst.calls, callbackSecond.value, callbackSecond.calls, nullableRecord.value, nullableRecord.calls, absentValue === undefined ? 1 : 0, scalarResult, arrayResult[0], payloadInt, payloadString, payloadAfter ? 1 : 0, explicitInt.value, explicitInt.calls, explicitText.value.length, explicitText.calls, explicitAfter.calls, optionalResult ?. value ?? -1, optionalResult ?.