        };
    }

    return select;
}

function inferredFactory(start: int) {
    let calls = start;
    function select<T>(left: T, right: T) {
        calls += 1;
        if (calls === start + 1) {
            return left;
        }

        return right;
    }

    return select;
}

function reducer() {
    let calls = 0;
    function first<T>(left: T, right: T): T {
        calls += 1;
        return calls === 4 ? right : left;
    }

    return first;
}

function predicate() {
    let calls = 0;
    function accept<T>(value: T): boolean {
        calls += 1;
        return calls === 2;
    }

    return accept;
}

function comparator() {
    let seen = 0;
    function compare<T>(left: T, right: T): int {
        if (typeof left === "string") {
            return seen;
        }

        seen = 1;
        return 0;
    }

    return compare;
}

function defaultFactory() {
    let calls = 0;
    function next(): int {
        calls += 1;
        return calls;
    }

    function select<T>(value: T, offset: int = next()): Receipt<T> {
        return {
            value: value, calls: offset
        };
    }

    return select;
}

function restFactory() {
    let calls = 0;
    function select<T>(fallback: T, ...values: T[]): Receipt<T> {
        calls += 1;
        return {
            value: fallback, calls: calls + values.length
        };
    }

    return select;
}

function genericFactory<T>(seed: T, start: int) {
    let calls = start;
    function select<U>(value: U): Receipt<U> {
        calls += 1;
        if (typeof seed === "string") {
            calls += 1;
        }

        return {
            value: value, calls: calls
        };
    }

    return select;
}

function workload(n: int, seed: int, input: string): int[][] {
    const output: int[][] = [];
    for (let i = 0; i < n; i += 1) {
