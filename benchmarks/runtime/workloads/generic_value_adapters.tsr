        return {
            value: value, calls: calls
        };
    }

    return take;
}

function optionalEmptyFactory() {
    function empty<T>(): T[] {
        return [];
    }

    return empty;
}

function payloadFactory(start: int) {
    let calls = start;
    function identity<T>(value: T): T {
        calls += 1;
        if (typeof value === "boolean") {
            if (calls !== start + 3) {
