        return value;
    }

    return select;
}

function arrayFactory() {
    let calls = 0;
    function select<T>(value: T): T[] {
        calls += 1;
        return [value];
    }

    return select;
}

function increment(value: int): int {
    return value + 1;
}

function callbackFactory(start: int) {
