function workload(n: int, seed: int): number[] {
  const output: number[] = [];
  const sizes: int[] = [0, 1, 4, 5, 17];
  const pool: number[] = [-0.0, Number(seed) / 4.0, 0.0 / 0.0, 1.0 / 0.0];
  let i = 0;
  while (i < n) {
    const count = sizes[(i + seed) % 5];
    const arity = (i * 7 + seed) % 3;
    const values: number[] = [];
    let j = 0;
    while (j < count) {
      values.push(pool[j % 4]);
      j = j + 1;
    }

    let newLength = 0;
    if (arity === 0) {
      newLength = values.unshift();
    } else if (arity === 1) {
      newLength = values.unshift(-0.0);
    } else {
      newLength = values.unshift(-0.0, Number(seed) / 4.0, 0.0 / 0.0);
    }

    output.push(Number(newLength));
    output.push(Number(values.length));
    let at = 0;
    while (at < values.length) {
      output.push(values[at]);
      at = at + 1;
    }

    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(2, 7);
}
