import { alloc, length, at, concat } from "std:bytes";

function workload(n: int, seed: int, input: string): int[] {
  let size = 32;
  if (input === "4k") {
    size = 4096;
  }

  if (input === "1m") {
    size = 1048576;
  }

  const bytes = unwrap(alloc(size, 97));
  const other = unwrap(alloc(size, 98));
  const output: int[] = [];
  let i = 0;
  while (i < n) {
    const result = unwrap(concat(bytes, other));
    output.push(length(result));
    output.push(unwrap(at(result, 0)));
    output.push(unwrap(at(result, length(result) - 1)));
    i += 1;
  }

  return output;
}

function main() {
  workload(1, 7, "token");
}
