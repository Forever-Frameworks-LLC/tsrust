import { parseLocale, formatLocale, createCollator, createSegmenter, createNumberFormat } from 'std:locale';

function workload(n: int, seed: int, input: string): int {
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const value = createSegmenter();
    const ranges = value.segment(input);
    for (const range of ranges) {
      checksum += range.start + range.end + 1;
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, "é🦀👨‍👩‍👧‍👦"));
}
