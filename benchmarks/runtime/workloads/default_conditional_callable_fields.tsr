type Handler = {
    run: (value: int) => int;
};

function workload(n: int, seed: int): int {
    let checksum = seed;
    let i = 0;
    while (i < n) {
        const base = i + seed;
        const handler: Handler = {
            run: i % 2 === 0 ? (value: int) : int => {
                return base + value;
            }

            : (value: int): int => {
                return base - value;
            }
        };
        checksum = checksum + handler.run(i);
        handler.run = i % 3 === 0 ? (value: int) : int => {
            return value * 2;
        }

        : (value: int): int => {
            return value + 1;
        };
        checksum = checksum + handler.run(i);
        i = i + 1;
    }

    return checksum;
}

function main() {
    console.log(workload(2, 7));
}
