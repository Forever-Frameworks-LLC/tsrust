type Trace = {
  calls: int;
  arguments: int;
  fallbacks: int;
  factories: int;
};

function workload(n: int, seed: int, input: string): int[][] {
  const output: int[][] = [];
  const trace: Trace = {
    calls: 0, arguments: 0, fallbacks: 0, factories: 0
  };
  const bias = seed % 11;
  const callback: ReadOnly<Function<int, [input: int, trace: Mutable<Trace>]>> = (callValue: int, callTrace: Trace): int => {
    callTrace.calls = callTrace.calls + 1;
    return (callValue * 17 + bias + 3) % 1009;
  };
  let i = 0;
  while (i < n) {
    const tag = (i + seed) % 3;
    const value = (i * 13 + seed) % 97;
    const beforeCalls = trace.calls;
    const beforeArguments = trace.arguments;
    const beforeFallbacks = trace.fallbacks;
    const beforeFactories = trace.factories;
    const observed: int[] = [];
    const selected = forward(tag === 0 ? callback : tag === 1 ? null : undefined, value, trace);
    if (selected !== undefined) {
      observed.push(selected);
    }

    output.push(observed);
    output.push([trace.calls - beforeCalls, trace.arguments - beforeArguments, trace.fallbacks - beforeFallbacks, trace.factories - beforeFactories]);
    i = i + 1;
  }

  return output;
}

function main() {
  const output = workload(3, 0, "abc");
}

function forward(action: (ReadOnly<Function<int, [input: int, trace: Mutable<Trace>]>>) | null | undefined, value: int, trace: Trace): int | undefined {
  if (action !== null && action !== undefined) {
    return action(argument(trace, value), trace);
  }

  return undefined;
}

function argument(trace: Trace, value: int): int {
  trace.arguments = trace.arguments + 1;
  return value;
}

function step(input: int, trace: Trace): int {
  trace.calls = trace.calls + 1;
  return (input * 17 + 3) % 1009;
}

function fallbackStep(input: int, trace: Trace): int {
  trace.calls = trace.calls + 1;
  return (input * 17 + 103) % 1009;
}
