import { hashPassword, verifyPassword, verifyPasswordBounded } from 'std:crypto';
import { ThreadPool } from 'std:threads';
import { alloc, set } from 'std:bytes';

export async function workload(n: int, seed: int): Task<int> {
  const input = unwrap(alloc(16));
  for (let j = 0; j < 16; j++) {
    unwrap(set(input, j, (j + seed) % 251));
  }

  const pool = new ThreadPool({
    workers: 1, capacity: 2
  });
  let sum = 0;
  try {
    for (let i = 0; i < n; i++) {
      const encoded = unwrap(await hashPassword(pool, input));
      if (!encoded.startsWith('$argon2id$v=19$m=19456,t=2,p=1$')) {
        throw 'PHC defaults';
      }

      const valid = unwrap(await verifyPassword(pool, input, encoded));
      if (!valid) {
        throw 'roundtrip';
      }

      sum = (sum * 131 + 1) % 1000000007;
    }

    return sum;
  } finally {
    pool.shutdown();
  }
}

function main() {}
