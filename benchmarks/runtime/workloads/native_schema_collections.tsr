import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const record = s.record(s.int());
  const map = s.map(s.string(), s.int());
  const set = s.set(s.string());
  const collisionMap = s.map(s.string().transform(value => value.toLowerCase()), s.int());
  const collisionSet = s.set(s.string().transform(value => value.toLowerCase()));
  let checksum = seed;
  let i = 0;
  while (i < n) {
    {
      const outcome0 = record.safeParseJson(input);
      if (outcome0.success) {
        const value = outcome0.data;
        if (value.size !== 1 || value.get('x') !== 2) {
          throw 'Wrong record';
        }

        checksum += 2;
      } else {
        const error = outcome0.error;
        throw 'Record rejected';
      }
    }

    const entries = new Map<string, int>();
    entries.set('x', 3);
    {
      const outcome1 = map.safeParse(entries);
      if (outcome1.success) {
        const value = outcome1.data;
        if (value.size !== 1 || value.get('x') !== 3) {
          throw 'Wrong map';
        }

        checksum += 3;
      } else {
        const error = outcome1.error;
        throw 'Map rejected';
      }
    }

    const elements = new Set<string>();
    elements.add('ready');
    {
      const outcome2 = set.safeParse(elements);
      if (outcome2.success) {
        const value = outcome2.data;
        if (value.size !== 1 || !value.has('ready')) {
          throw 'Wrong set';
        }

        checksum += 1;
      } else {
        const error = outcome2.error;
        throw 'Set rejected';
      }
    }

    const keys = new Map<string, int>();
    keys.set('A', 1);
    keys.set('a', 2);
    {
      const outcome3 = collisionMap.safeParse(keys);
      if (outcome3.success) {
        const value = outcome3.data;
        throw 'Map collision accepted';
      } else {
        const error = outcome3.error;
        if (error.truncated || error.issues.length !== 1 || error.issues[0].code !== 'collection-collision') {
          throw 'Wrong collision';
        }

        checksum += 1;
      }
    }

    const tags = new Set<string>();
    tags.add('A');
    tags.add('a');
    {
      const outcome4 = collisionSet.safeParse(tags);
      if (outcome4.success) {
        const value = outcome4.data;
        throw 'Set collision accepted';
      } else {
        const error = outcome4.error;
        if (error.truncated || error.issues.length !== 1 || error.issues[0].code !== 'collection-collision') {
          throw 'Wrong collision';
        }

        checksum += 1;
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, '{"x":2}'));
}
