function workload(n: int, seed: int, input: string): string[] {
    const boundaries: int[] = [0];
    let position = 0;
    let bytes = 0;
    while (true) {
        const scalar = input.charAt(position);
        if (scalar.length === 0) {
            break;
        }

        bytes = bytes + scalar.length;
        boundaries.push(bytes);
        position = position + 1;
    }

    const width = boundaries.length - 1;
    const totalBytes = input.length;
    const results: string[] = [];
    let i = 0;
    while (i < n) {
        const start = byteCoordinate(boundaries, totalBytes, width, (i * 13 + seed) % (width * 3 + 1) - width);
        const end = byteCoordinate(boundaries, totalBytes, width, (i * 7 + seed) % (width * 3 + 1) - width);
        results.push(input.slice(start, end));
        i = i + 1;
    }

    return results;
}

function byteCoordinate(boundaries: int[], totalBytes: int, width: int, ordinal: int): int {
    if (ordinal < 0) {
        const index = width + ordinal;
        if (index < 0) {
            return -totalBytes;
        }

        return boundaries[index] - totalBytes;
    }

    if (ordinal > width) {
        return totalBytes;
    }

    return boundaries[ordinal];
}

function main() {
    const results = workload(2, 7, "A😀e\u0301Z");
    console.log(results.length);
}
