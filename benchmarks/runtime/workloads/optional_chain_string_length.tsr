type Trace = {
  bases: int;
  indices: int;
  args: int;
};

function workload(n: int, seed: int, input: string): int[][] {
  const output: int[][] = [];
  const trace: Trace = {
    bases: 0, indices: 0, args: 0
  };
  let i = 0;
  while (i < n) {
    const value = i + seed;
    const bb = trace.bases;
    const bi = trace.indices;
    const ba = trace.args;
    const carrier: string | null | undefined = makeCarrier(trace, value, input);
    const selected = carrier?.length;
    const db = trace.bases - bb;
    const di = trace.indices - bi;
    const da = trace.args - ba;
    if (selected === undefined) {
      output.push([]);
    } else {
      output.push([selected]);
    }

    output.push([db, di, da]);
    i = i + 1;
  }

  return output;
}

function makeCarrier(trace: Trace, value: int, input: string): string | null | undefined {
  trace.bases = trace.bases + 1;
  const tag = value % 5;
  if (tag === 0) {
    return null;
  }

  if (tag === 1) {
    return undefined;
  }

  return value % 3 === 0 ? "" : clone(input);
}

function main() {
  const result = workload(2, 7, "dynamic text");
}
