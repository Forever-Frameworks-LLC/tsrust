type Trace = { calls: int; defaults: int; };
function consume(text: string): string { return text; }
function apply(action: Once<Function<string[], [trace: Mutable<Trace>, ...values: int[]]>>, trace: Trace, mode: int, base: int): string[] { if (mode === 0) { return action(trace); } if (mode === 1) { return action(trace, base); } return action(trace, base, base + 1, base + 2, base + 3, base + 4); }
function workload(n: int, seed: int, input: string): string[][] {
    const output: string[][] = []; const trace: Trace = { calls: 0, defaults: 0 }; let i = 0;
    while (i < n) { const before = trace.calls; const mode = (i + seed) % 3; const base = (i * 13 + seed) % 97; const text = input.repeat(base % 3 + 1).concat(":", String(base));
        const action = (callTrace: Trace, ...values: int[]): string[] => { callTrace.calls = callTrace.calls + 1; const result: string[] = [consume(text)]; let at = 0; while (at < values.length) { result.push(String(values[at])); at = at + 1; } return result; };
        output.push(apply(action, trace, mode, base)); output.push([String(trace.calls - before)]); i = i + 1;
    } return output;
}
function main() { const result = workload(3, 0, "abc"); }
