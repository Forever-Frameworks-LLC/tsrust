import { scalar } from "./rust-owned-adapter.rs";

function workload(n: int, seed: int): int {
  let checksum = 0;
  let i = 0;
  while (i < n) {
    const observed = scalar(seed + i);
    checksum = (checksum * 131 + observed) % 1000000007;
    i = i + 1;
  }

  return checksum;
}

function main() {
  console.log(workload(17, 3));
}
