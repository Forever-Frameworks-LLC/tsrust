import { borrowRaw } from 'std:json';

function workload(n: int, seed: int, input: string): int {
  let checksum = seed;
  let i = 0;
  while (i < n) {
    match (borrowRaw(input)) {
      Ok(raw) => {
        checksum += 1;
      },
      Err(error) => {
        throw error.message;
      }
    }

    i++;
  }

  return checksum;
}
