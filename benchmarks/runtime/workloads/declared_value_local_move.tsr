function workload(n:int,seed:int):int{let trace=seed;let i=0;while(i<n){const original=step;const action=original;const first=action(seed+i);const second=action(seed+i+1);trace=(trace*131+first+second)%1000000007;i=i+1;}return trace;}
function step(value:int):int{return(value*3+1)%1000000007;}

function main(){const result=workload(2,7);}
