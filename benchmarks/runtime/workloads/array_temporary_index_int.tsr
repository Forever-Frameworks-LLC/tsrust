function workload(n: int, seed: int): int {
  let sum = seed;
  let i = 0;
  while (i < n) {
    const value = make_int(seed, i)[index_for(i, seed)];
    sum = sum + value;
    i = i + 1;
  }

  return sum;
}

function main() {
  const result = workload(2, 7);
  console.log(result);
}

function make_int(seed: int, i: int): int[] {
  return [seed + i, seed + i + 1, i * 2 + 3, seed * 3 + 7];
}

function index_for(i: int, seed: int): int {
  return (i * 3 + seed) % 4;
}
