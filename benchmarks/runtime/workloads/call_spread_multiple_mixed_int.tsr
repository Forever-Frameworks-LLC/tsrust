function integers(base: int, count: int): int[] {
    const values: int[] = [];
    let at = 0;
    while (at < count) {
        values.push(base + at);
        at = at + 1;
    }

    return values;
}

function collect<T>(...values: T[]): T[] {
    return values;
}

function workload(n: int, seed: int, input: string): int[][] {
    const output: int[][] = [];
    let i = 0;
    while (i < n) {
        const mode = (i + seed) % 3;
        const base = (i * 13 + seed) % 97;
        const count = mode === 0 ? 0 : mode === 1 ? 1 : 5;
        const left = integers(base + 10, mode === 0 ? 0 : mode === 1 ? 1 : 3);
        const rightMode = (mode + 1) % 3;
        const right = integers(base + 20, rightMode === 0 ? 0 : rightMode === 1 ? 1 : 3);
        output.push(collect(base, ...left, base + 7, ...right, base + 9));
        i = i + 1;
    }

    return output;
}

function main() {
    const result = workload(3, 0, "abc");
}
