function workload(n:int,seed:int):int[][]{const base:int[]=[seed,seed+1,2,0,seed+4];const output:int[][]=[];let i=0;while(i<n){const mode=(i+seed)%4;let count=5;if(mode===0){count=0;}else if(mode===1){count=1;}else if(mode===2){count=4;}const selected=base.slice(0,count);const first=base.slice(1,mode%3+2);const second=base.slice(0,mode%2);const empty:int[]=[];const scalar0:int=seed+i;const scalar1:int=i+1;const result=selected.concat(scalar0,first,scalar1,empty,second);output.push(result);i=i+1;}return output;}
function main(){const result=workload(2,7);}
