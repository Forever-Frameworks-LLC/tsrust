type OnceHolder = {
    run: Once<Function<int>>;
};

type Holder = {
    run: ReadOnly<Function<int>>;
};

type MutableHolder = {
    run: Mutable<Function<int>>;
};

type Box = {
    handler: Holder;
};

function workload(n: int, seed: int, input: string): int[][] {
    const output: int[][] = [];
    let i = 0;
    while (i < n) {
        const value = i % 5 + seed % 5 + 1;
        const base = [value];
        const other = [value + 2];
        let first = 0;
        let replaced = 0;
        let nested = 0;
        let callback = 0;
        let callbackReplaced = 0;
        let pairReplaced = 0;
        let paired = 0;
        let changedFirst = 0;
        let changedSecond = 0;
        let callbackFirst = 0;
        let callbackSecond = 0;
        let callbackAfter = 0;
        let mutableReplaced = 0;
        {
            const holder: Holder = {
                run: (): int => 0
            };
            installArray(holder, base);
            first = holder.run();
            replaceBoth(holder, base, other);
            replaced = holder.run();
            const box: Box = {
                handler: {
                    run: (): int => 0
                }
            };
            installNested(box, base, other);
            nested = box.handler.run();
            const action = (): int => base[0];
            const constant = (): int => 9;
            const callbackHolder: Holder = {
                run: (): int => 0
            };
            installCallback(callbackHolder, action);
            callback = callbackHolder.run();
            installDirect(callbackHolder, constant);
            const readCallback = (): int => callbackHolder.run();
            callbackReplaced = readCallback();
            const pairHolder: Holder = {
                run: (): int => 0
            };
            installPair(pairHolder, action, constant);
            paired = pairHolder.run();
            installPair(pairHolder, constant, action);
            pairReplaced = pairHolder.run();
        }

        base[0] += 1;
        {
            const holder: MutableHolder = {
                run: (): int => 0
            };
            installMutable(holder, base);
            changedFirst = holder.run();
            changedSecond = holder.run();
        }

        {
            const action = (): int => {
                base[0] += 1;
                return base[0];
            };
            const secondAction = (): int => {
                other[0] += 10;
                return other[0];
            };
            {
                const holder: MutableHolder = {
                    run: (): int => 0
                };
                installMutableCallback(holder, action);
                callbackFirst = holder.run();
                callbackSecond = holder.run();
                installMutableCallback(holder, secondAction);
                const invoke = (): int => holder.run();
                mutableReplaced = invoke();
            }

            callbackAfter = action();
        }

        let consumed = 0;
        let afterFailure = 0;
        let beforeFailure = 0;
        {
            const owned = [value];
            const once = (): int => {
                const moved = owned;
                return moved[0];
            };
            const holder: OnceHolder = {
                run: (): int => 0
            };
            installOnce(holder, once);
            consumed = holder.run();
        }

        {
            const action = (): int => base[0];
            const holder: Holder = {
                run: (): int => value + 9
            };
            let caught = false;
            try {
                installAndFail(holder, action);
            } catch (error) {
                caught = error === "installed";
            }

            afterFailure = holder.run() + (caught ? 0 : 100);
        }

        {
            const action = (): int => base[0];
            const holder: Holder = {
                run: (): int => value + 9
            };
            let caught = false;
            try {
                failBeforeInstall(holder, action, true);
            } catch (error) {
                caught = error === "before";
            }

            beforeFailure = holder.run() + (caught ? 0 : 100);
        }

        let callbackFailure = 0;
        {
            const payload = [value + 17];
            const action = (): int => {
                throw payload[0];
            };
            const holder: Holder = {
                run: (): int => 0
            };
            installDirect(holder, action);
            const guarded = (): int => {
                try {
                    return holder.run();
                } catch (error) {
                    return typeof error === "number" ? error : 0;
                }
            };
            callbackFailure = guarded();
        }

        output.push([first, replaced, nested, callback, paired, changedFirst, changedSecond, callbackFirst, callbackSecond, callbackAfter, base[0], callbackReplaced, pairReplaced, mutableReplaced, consumed, afterFailure, beforeFailure, callbackFailure]);
        i += 1;
    }

    return output;
}

function installArray(holder: Mutable<Holder>, source: ReadOnly<int[]>): void {
    const alias = source;
    holder.run = (): int => alias[0];
}

function replaceBoth(holder: Mutable<Holder>, left: ReadOnly<int[]>, right: ReadOnly<int[]>): void {
    installArray(holder, left);
    installArray(holder, right);
}

function installNested(box: Mutable<Box>, left: ReadOnly<int[]>, right: ReadOnly<int[]>): void {
    box.handler.run = (): int => left[0] + right[0];
}

function installCallback(holder: Mutable<Holder>, action: ReadOnly<Function<int>>): void {
    const alias = action;
    holder.run = (): int => alias();
}

function installPair(holder: Mutable<Holder>, left: ReadOnly<Function<int>>, right: ReadOnly<Function<int>>): void {
    holder.run = (): int => left() + right();
}

function installMutable(holder: Mutable<MutableHolder>, source: Mutable<int[]>): void {
    holder.run = (): int => {
        source[0] += 1;
        return source[0];
    };
}

function installMutableCallback(holder: Mutable<MutableHolder>, action: Mutable<Function<int>>): void {
    holder.run = (): int => action();
}

function installDirect(holder: Mutable<Holder>, action: ReadOnly<Function<int>>): void {
    holder.run = action;
}

function installOnce(holder: Mutable<OnceHolder>, action: Once<Function<int>>): void {
    holder.run = action;
}

function installAndFail(holder: Mutable<Holder>, action: ReadOnly<Function<int>>): void {
    holder.run = action;
    throw "installed";
}

function failBeforeInstall(holder: Mutable<Holder>, action: ReadOnly<Function<int>>, fail: boolean): void {
    if (fail) {
        throw "before";
    }

    holder.run = action;
}

function main() {
}
