import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.object({
    count: s.int().min(2)
  });
  let checksum = seed;
  let i = 0;
  while (i < n) {
    match (schema.safeParseJson(input)) {
      Ok(value) => {
        checksum += value.count;
      },
      Err(error) => {
        throw 'Expected success';
      }
    }

    match (schema.safeParseJson('{"extra":true}')) {
      Ok(value) => {
        throw 'Expected rejection';
      },
      Err(error) => {
        if (error.kind !== 'validation') {
          throw 'Expected validation failure';
        }

        if (error.error.truncated || error.error.issues.length !== 2) {
          throw 'Invalid count';
        }

        for (const issue of error.error.issues) {
          if (issue.pathTruncated || issue.path.length !== 1) {
            throw 'Invalid path';
          }

          for (const segment of issue.path) {
            if (segment.index !== undefined) {
              throw 'Unexpected index';
            }

            if (issue.code === 'missing-field') {
              if (segment.field !== 'count' || issue.expected !== 'integer' || issue.observed !== 'missing') {
                throw 'Invalid missing field';
              }
            } else if (issue.code === 'unknown-field') {
              if (segment.field !== 'extra' || issue.expected !== 'missing' || issue.observed !== 'boolean') {
                throw 'Invalid unknown field';
              }
            } else {
              throw 'Unexpected issue';
            }
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, '{"count":2}'));
}
