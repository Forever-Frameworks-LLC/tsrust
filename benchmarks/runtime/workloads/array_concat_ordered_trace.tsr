type Probe={trace:int;};
function workload(n:int,seed:int):int{const base=[seed,seed+1,2,0,seed+4];const probe:Probe={trace:seed};let trace=seed;let i=0;while(i<n){const mode=(i+seed)%4;let count=5;if(mode===0){count=0;}else if(mode===1){count=1;}else if(mode===2){count=4;}const output=receiver(base,count,probe).concat(arrayArgument(base,mode%3+2,probe),scalarArgument(seed+i,probe));let index=0;for(const value of output){trace=(trace*131+value+index+i)%1000000007;index=index+1;}trace=(trace*131+probe.trace)%1000000007;i=i+1;}return trace;}
function receiver(base:int[],count:int,probe:Probe):int[]{probe.trace=(probe.trace*10+1)%1000003;return base.slice(0,count);}
function arrayArgument(base:int[],end:int,probe:Probe):int[]{probe.trace=(probe.trace*10+2)%1000003;return base.slice(1,end);}
function scalarArgument(value:int,probe:Probe):int{probe.trace=(probe.trace*10+3)%1000003;return value;}
function main(){const result=workload(2,7);}
