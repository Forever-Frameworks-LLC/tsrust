function workload(n: int, seed: int, input: string, coordinates: int): string[] {
    const width = coordinates; const results: string[] = []; let i = 0;
    while (i < n) {
        results.push(input.charAt(width - 7 + (i * 13 + seed) % 11));
        i = i + 1;
    }
    return results;
}
function main() { const results = workload(2, 7, "ABC😀Z", 5); console.log(results.length); }
