import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.array(s.int().min(2));
  let checksum = seed;
  let i = 0;
  while (i < n) {
    {
      const outcome0 = schema.safeParse([2, 3]);
      if (outcome0.success) {
        const value = outcome0.data;
        checksum += value.length;
      } else {
        const error = outcome0.error;
        throw 'Expected success';
      }
    }

    {
      const outcome1 = schema.safeParse([1, 0]);
      if (outcome1.success) {
        const value = outcome1.data;
        throw 'Expected rejection';
      } else {
        const error = outcome1.error;
        if (error.truncated || error.issues.length !== 2) {
          throw 'Invalid count';
        }

        let index = 0;
        for (const issue of error.issues) {
          if (issue.code !== 'too-small' || issue.expected !== 'integer' || issue.observed !== 'integer' || issue.path.length !== 1 || issue.pathTruncated) {
            throw 'Invalid issue';
          }

          for (const segment of issue.path) {
            if (segment.index !== index || segment.field !== undefined) {
              throw 'Invalid path';
            }
          }

          checksum += 1;
          index++;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, 'owned-array'));
}
