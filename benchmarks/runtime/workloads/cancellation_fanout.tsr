import { CancellationToken } from 'std:futures';
async function workload(n: int, seed: int): Task<int> {
  let sum: int = 0;
  for (let i: int = 0; i < n; i++) {
    const token = new CancellationToken();
    const shared = token.share();
    const a = token.child();
    const b = token.child();
    const c = token.child();
    const d = token.child();
    shared.cancel();
    await a.cancelled();
    await b.cancelled();
    await c.cancelled();
    await d.cancelled();
    if (a.isCancelled() && b.isCancelled() && c.isCancelled() && d.isCancelled()) {
      sum = (sum + 4 * (seed + i) + 6) % 1000000007;
    }
  }

  return sum;
}

function main() {}
