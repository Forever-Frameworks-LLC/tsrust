import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.number();
  let checksum = seed;
  let i = 0;
  while (i < n) {
    match (schema.safeParse(42)) {
      Ok(text) => {
        if (text !== 42.0) {
          throw 'Expected exact integer';
        }

        checksum += 1;
      },
      Err(error) => {
        throw 'Expected number success';
      }
    }

    match (schema.safeParse(9007199254740993)) {
      Ok(text) => {
        throw 'Expected precision rejection';
      },
      Err(error) => {
        if (error.truncated || error.issues.length !== 1) {
          throw 'Invalid error count';
        }

        for (const issue of error.issues) {
          if (issue.code !== 'number-precision' || issue.expected !== 'number' || issue.observed !== 'integer' || issue.path.length !== 0 || issue.pathTruncated) {
            throw 'Invalid issue';
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, 'native-int'));
}
