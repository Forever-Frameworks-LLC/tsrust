import { randomInt } from 'std:crypto';

export function workload(n: int, seed: int): int {
  let sum = 0;
  for (let i = 0; i < n; i++) {
    const value = unwrap(randomInt(-1000000 + seed, 1000000 + seed));
    if (value < -1000000 + seed || value >= 1000000 + seed) {
      throw 'range';
    }

    sum = (sum * 131 + 1) % 1000000007;
  }

  return sum;
}

function main() {}
