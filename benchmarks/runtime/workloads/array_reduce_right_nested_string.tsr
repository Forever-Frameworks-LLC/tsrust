function workload(n: int, seed: int): string[][] {
    const base: string[][] = [["é", "😀"], [], ["a\u0000b"], ["e\u0301"], ["last"]];
    let trace = seed;
    let visits = 0;
    let i = 0;
    const output: string[][] = [];
    while (i < n) {
        const mode = (i + seed) % 5;
        let count = 5;
        if (mode === 0) {
            count = 0;
        } else if (mode === 1) {
            count = 1;
        } else if (mode === 2) {
            count = 4;
        }

        const values = base.slice(0, count);
        let selected: string[] = [];
        if (mode === 3) {
            selected = values.reduceRight((a: string[], v: string[], index: int, source: string[][]): string[] => {
                trace = (trace * 131 + index + source.length + i) % 1000000007; visits = visits + 1; return clone(v);
            });
        } else {
            selected = values.reduceRight((a: string[], v: string[], index: int, source: string[][]): string[] => {
                trace = (trace * 131 + index + source.length + i) % 1000000007; visits = visits + 1; return clone(v);
            }, []);
        }

        output.push(selected);
        i = i + 1;
    }

    return output;
}

function main() {
    const result = workload(2, 7);
}
