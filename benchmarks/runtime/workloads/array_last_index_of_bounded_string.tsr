function workload(n: int, seed: int, input: string): int[] { const values: string[] = []; let j = 0; while (j < 129) { const c = (j * 37 + seed) % 4; if (c === 0) { values.push(clone(input)); } else if (c === 1) { values.push("a\u0000bé😀e\u0301"); } else if (c === 2) { values.push("Å😀"); } else { values.push(""); } j = j + 1; } const output: int[] = []; let i = 0; while (i < n) { const choice = (i * 17 + seed) % 5; let at = -1; if (choice === 0) { at = values.lastIndexOf(input, bound(i, seed)); } else if (choice === 1) { at = values.lastIndexOf("a\u0000bé😀e\u0301", bound(i, seed)); } else if (choice === 2) { at = values.lastIndexOf("Å😀", bound(i, seed)); } else if (choice === 3) { at = values.lastIndexOf("", bound(i, seed)); } else { at = values.lastIndexOf("missing ö", bound(i, seed)); } output.push(at + 1); i = i + 1; } return output; }
function bound(i: int, seed: int): int { const c = (i * 13 + seed) % 12; if (c === 0) { return -9223372036854775808; } if (c === 1) { return 9223372036854775807; } if (c === 2) { return -130; } if (c === 3) { return -129; } if (c === 4) { return -128; } if (c === 5) { return -1; } if (c === 6) { return 0; } if (c === 7) { return 1; } if (c === 8) { return 64; } if (c === 9) { return 128; } if (c === 10) { return 129; } return 193; }
function main() { const result = workload(2, 7, " xé😀e\u0301 "); }
