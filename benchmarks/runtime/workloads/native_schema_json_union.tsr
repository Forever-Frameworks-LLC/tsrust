import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.union([s.string().min(20), s.string().min(2)]);
  let checksum = seed;
  let i = 0;
  while (i < n) {
    {
      const outcome0 = schema.safeParse(JSON.parse(input));
      if (outcome0.success) {
        const value = outcome0.data;
        if (value !== 'union-value') {
          throw 'Wrong value';
        }

        checksum += value.length;
      } else {
        const error = outcome0.error;
        throw 'Expected success';
      }
    }

    {
      const outcome1 = schema.safeParse(JSON.parse('true'));
      if (outcome1.success) {
        const value = outcome1.data;
        throw 'Expected rejection';
      } else {
        const error = outcome1.error;
        if (error.truncated || error.issues.length !== 2) {
          throw 'Wrong issues';
        }

        for (const issue of error.issues) {
          if (issue.code !== 'type-mismatch' || issue.expected !== 'string' || issue.observed !== 'boolean' || issue.pathTruncated || issue.path.length !== 0) {
            throw 'Wrong issue';
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(0, 0, '"union-value"'), workload(1, 0, '"union-value"'), workload(17, 7, '"union-value"'), workload(2000, 1, '"union-value"'));
}
