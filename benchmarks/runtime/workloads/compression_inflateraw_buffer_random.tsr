import { inflateRaw } from 'std:compression';
import { ThreadPool } from 'std:threads';
import { get } from 'std:env';
import { readFile, writeFile } from 'std:fs';
import { length, at } from 'std:bytes';
async function workload(n: int, seed: int): Task<int> {
  const directory = unwrap(get('TSRUST_COMPRESSION_INPUT_DIR'));
  if (directory === undefined) {
    throw 'missing corpus';
  }

  const payload = unwrap(readFile(directory + '/random-' + String(seed) + '-raw.bin'));
  const pool = new ThreadPool({
    workers: 1, capacity: 1
  });
  let sum: int = 0;
  if (n === -1) {
    const path = unwrap(get('TSRUST_COMPRESSION_PROBE_OUTPUT'));
    if (path === undefined) {
      throw 'missing probe path';
    }

    const output = unwrap(await inflateRaw(pool, clone(payload)));
    unwrap(writeFile(path, output));
    const size = length(output);
    unwrap(pool.shutdown());
    return size;
  }

  for (let i: int = 0; i < n; i++) {
    const output = unwrap(await inflateRaw(pool, clone(payload)));
    if (length(output) !== 16384) {
      throw 'wrong decoded size';
    }

    for (let j: int = 0; j < 16384; j++) {
      sum = (sum * 131 + unwrap(at(output, j))) % 1000000007;
    }
  }

  unwrap(pool.shutdown());
  return sum;
}
