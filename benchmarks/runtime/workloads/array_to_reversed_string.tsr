function workload(n:int,seed:int,input:string):string[]{const output:string[]=[];let i=0;while(i<n){const values:string[]=[item(seed+i+0,input),item(seed+i+1,input),item(seed+i+2,input),item(seed+i+3,input),item(seed+i+4,input),item(seed+i+5,input)];const result=values.toReversed();for(const value of result){output.push(clone(value));}i=i+1;}return output;}
function item(base:int,input:string):string{if(base%3===0){return clone(input);}if(base%3===1){return "a\u0000b";}return "é😀e\u0301";}
function main(){const result=workload(2,7," xé😀e\u0301 ");}
