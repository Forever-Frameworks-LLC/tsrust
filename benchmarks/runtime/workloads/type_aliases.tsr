type Id = int | string;
type Ids = Id[];
type Count = int;
type Pair = [Count, string];
type Row = string[];
type Rows = Row[];
function kind(id: Id): string { if (typeof id === "string") { return "text"; } return "number"; }
function workload(n: int, seed: int, input: string): string[][] {
 const output:Rows=[];let i:Count=0;
 while(i<n){
  const k:Count=i+seed;
  const ids:Ids=[k,String(input)];
  const pair:Pair=[k*2,String(k)];
  const [doubled,label]=pair;
  const row:Row=[kind(ids[0]),kind(ids[1]),String(doubled),String(label),String(ids.length)];
  output.push(row);i+=1;
 }
 return output;
}
function main(){const result=workload(3,0,"abc");}
