import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.int();
  let checksum = seed;
  let i = 0;
  while (i < n) {
    match (schema.safeParse(JSON.parse(input))) {
      Ok(text) => {
        checksum += text;
      },
      Err(error) => {
        throw 'Expected integer success';
      }
    }

    match (schema.safeParse(JSON.parse('1.5'))) {
      Ok(text) => {
        throw 'Expected fraction rejection';
      },
      Err(error) => {
        if (error.truncated || error.issues.length !== 1) {
          throw 'Invalid error count';
        }

        for (const issue of error.issues) {
          if (issue.code !== 'integer-fractional' || issue.expected !== 'integer' || issue.observed !== 'number' || issue.path.length !== 0 || issue.pathTruncated) {
            throw 'Invalid issue';
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, '7'));
}
