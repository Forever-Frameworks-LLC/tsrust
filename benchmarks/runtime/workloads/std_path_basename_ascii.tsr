import { basename } from "std:path";

function workload(n: int, seed: int): string[] {
    const values: string[] = [];
    let i = 0;
    while (i < n) {
        let path = "/tmp/report.txt";
        if ((i + seed) % 2 === 0) {
            path = "/var/log/archive.txt/";
        }

        values.push(basename(path, ".txt"));
        i = i + 1;
    }

    return values;
}

function main() {
    const values = workload(2, 7);
    for (const value of values) {
        console.log(value);
    }
}
