function workload(n: int, seed: int, input: string, coordinates: int): string[] {
    const width = coordinates;
    const results: string[] = [];
    let i = 0;
    while (i < n) {
        results.push(input.charAt((i * 13 + seed) % (width * 2 + 3) - width));
        i = i + 1;
    }

    return results;
}

function main() {
    const results = workload(2, 7, "A😀e\u0301\u0000Z", 6);
    console.log(results.length);
}
