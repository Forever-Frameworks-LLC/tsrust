type Handler = {
    run: Function<int, [value: int]>;
};

function workload(n: int, seed: int): int {
    let checksum = seed;
    let i = 0;
    while (i < n) {
        const base = i + seed;
        const handler: Handler = {
            run: (value: int): int => {
                return base + value;
            }
        };
        checksum = checksum + handler.run(i);
        handler.run = (value: int): int => {
            return base - value;
        };
        checksum = checksum + handler.run(i);
        i = i + 1;
    }

    return checksum;
}

function main() {
    console.log(workload(2, 7));
}
