function workload(n: int, seed: int): boolean[][] {
    const base: boolean[][] = [[true, false], [], [false], [true], [true, true, false]];
    let trace = seed;
    let visits = 0;
    let i = 0;
    const output: boolean[][] = [];
    while (i < n) {
        const mode = (i + seed) % 5;
        let count = 5;
        if (mode === 0) {
            count = 0;
        } else if (mode === 1) {
            count = 1;
        } else if (mode === 2) {
            count = 4;
        }

        const values = base.slice(0, count);
        let selected: boolean[] = [];
        if (mode === 3) {
            selected = values.reduceRight((a: boolean[], v: boolean[], index: int, source: boolean[][]): boolean[] => {
                trace = (trace * 131 + index + source.length + i) % 1000000007; visits = visits + 1; return clone(v);
            });
        } else {
            selected = values.reduceRight((a: boolean[], v: boolean[], index: int, source: boolean[][]): boolean[] => {
                trace = (trace * 131 + index + source.length + i) % 1000000007; visits = visits + 1; return clone(v);
            }, []);
        }

        output.push(selected);
        i = i + 1;
    }

    return output;
}

function main() {
    const result = workload(2, 7);
}
