function workload(n: int, seed: int): string[] {
    const values: number[] = [Number(seed), -0.0, 0.5, -2.5, 17.0, Number.NaN, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY];
    const output: string[] = [];
    let i = 0;
    while (i < n) {
        const mode = (i + seed) % 3;
        const at = (i * 13 + seed) % 8;
        const initial: number | null = mode === 0 ? null : values[at];
        const value: number | null = pass(initial);
        output.push(typeof value);
        output.push(String(value));
        output.push(Boolean(value) ? "true" : "false");
        output.push(value === null ? "sentinel" : "payload");
        i = i + 1;
    }

    return output;
}

function pass(value: number | null): number | null {
    return value;
}

function main() {
    const result = workload(2, 7);
}
