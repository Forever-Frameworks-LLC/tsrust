type ForEachNode = {
    n: int;
    text: string;
    children: ForEachNode[];
};

function workload(n: int, seed: int, input: string): int {
    const base: ForEachNode[] = [{
        n: seed, text: clone(input), children: [{
            n: 1, text: "é", children: []
        }]
    }, {
        n: 2, text: "😀", children: []
    }, {
        n: 3, text: "a\u0000b", children: [{
            n: 4, text: "e\u0301", children: []
        }]
    }, {
        n: 5, text: "x", children: []
    }, {
        n: 6, text: "z", children: []
    }];
    let trace: int = seed;
    let visits = 0;
    let i = 0;
    while (i < n) {
        const mode = (i + seed) % 5;
        let count = 5;
        if (mode === 0) {
            count = 0;
        } else if (mode === 1) {
            count = 1;
        } else if (mode === 2) {
            count = 4;
        }

        const selected = base.slice(0, count);
        selected.forEach((value: ForEachNode, index: int, source: ForEachNode[]): void => {
            trace = (trace * 131 + nodeWeight(value, input) + index + source.length + i) % 1000000007; visits = visits + 1;
        });
        i = i + 1;
    }

    return (trace + visits) % 1000000007;
}

function stringWeight(value: string, input: string): int {
    let w = 1;
    if (value === input) {
        w = w + 3;
    }

    if (value.includes("\u0000")) {
        w = w + 5;
    }

    if (value === "e\u0301") {
        w = w + 7;
    }

    if (value === "é") {
        w = w + 11;
    }

    if (value === "😀") {
        w = w + 13;
    }

    return w;
}

function nodeWeight(value: ForEachNode, input: string): int {
    let w = value.n + stringWeight(value.text, input);
    for (const child of value.children) {
        w = w + nodeWeight(child, input);
    }

    return w;
}

function main() {
    const result = workload(2, 7, "é 😀 e\u0301");
}
