import { parseLocale, formatLocale, createCollator, createSegmenter, createNumberFormat } from 'std:locale';
import { parseDecimal } from 'std:decimal';

function workload(n: int, seed: int, input: string): int {
  const locale = unwrap(parseLocale('en'));
  const value = unwrap(createNumberFormat(locale));
  const decimal = unwrap(parseDecimal(input));
  let checksum = seed;
  let i = 0;
  while (i < n) {
    checksum += value.format(decimal).length;
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, "12345678901234567890.12"));
}
