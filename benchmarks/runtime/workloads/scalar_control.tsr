function workload(n: int, seed: int): int {
 let state = seed; let sum = seed; let i = 0;
 while (i < n) { state = (state * 17 + 13) % 1009;
  if (state % 2 === 0 && state > 100) { sum = sum + state; } else { sum = sum - 1; }
  i = i + 1;
 } return sum;
}
function main() { console.log(workload(2, 7)); }
