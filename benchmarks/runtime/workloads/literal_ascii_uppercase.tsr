function workload(n: int, seed: int): string[] {
    const labels: string[] = ["Abc xyz 09", "ALREADY UPPER", " nul\u0000 lower "];
    const results: string[] = [];
    let i = 0;
    while (i < n) {
        results.push(labels[(i + seed) % 3].toUpperCase());
        i = i + 1;
    }
    return results;
}
function main() { const results = workload(2, 7); console.log(results.length); }
