import { readFile, writeFile } from "std:fs";
import { alloc, at, length } from "std:bytes";

function sample(input: ReadOnly<string>, count: int, fill: int): int[] {
  const destination = input + ".out";
  {
    const owner = unwrap(alloc(count, fill));
    unwrap(writeFile(destination, owner));
  }

  const bytes = unwrap(readFile(destination));
  let sum = 0;
  let index = 0;
  while (index < length(bytes)) {
    sum += unwrap(at(bytes, index));
    index++;
  }

  return [length(bytes), sum];
}

function workload(n: int, seed: int, input: string): int[][] {
  let output: int[][] = [];
  let i = 0;
  while (i < n) {
    let count = 65536;
    if (i % 3 === 1) {
      count = 1048576;
    }

    if (i % 3 === 2) {
      count = 67108865;
    }

    const fill = (i + seed) % 256;
    output.push(sample(input, count, fill));
    i++;
  }

  return output;
}

function main() {}
