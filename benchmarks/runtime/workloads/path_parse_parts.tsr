import { parse } from 'std:path';

function workload(n: int, seed: int, input: string): int {
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const value = parse(input);
    if (value.root !== '' || value.dir !== 'reports' || value.base !== 'file.tar.gz' || value.ext !== '.gz' || value.name !== 'file.tar') {
      throw 'path parts';
    }

    checksum += value.root.length + value.dir.length + value.base.length + value.ext.length + value.name.length;
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, "reports/file.tar.gz"));
}
