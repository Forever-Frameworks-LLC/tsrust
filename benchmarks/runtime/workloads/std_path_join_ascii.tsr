import { join } from "std:path";

function workload(n: int, seed: int): string[] {
    const values: string[] = [];
    let i = 0;
    while (i < n) {
        let part = "reports";
        if ((i + seed) % 2 === 0) {
            part = "..";
        }

        values.push(join("/tmp", part, "archive.txt"));
        i = i + 1;
    }

    return values;
}

function main() {
    const values = workload(2, 7);
    for (const value of values) {
        console.log(value);
    }
}
