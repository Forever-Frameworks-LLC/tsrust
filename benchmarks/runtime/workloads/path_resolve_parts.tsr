import { resolve, separator } from 'std:path';

function workload(n: int, seed: int, input: string): int {
  const root = separator() === '\\' ? 'C:\\base' : '/base';
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const value = unwrap(resolve(root, input));
    if (!value.endsWith('file.txt')) {
      throw 'path resolve';
    }

    checksum += value.length;
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, "../next/file.txt"));
}
