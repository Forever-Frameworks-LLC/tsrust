function workload(n: int, seed: int): boolean[][] {
  const output: boolean[][] = [];
  let i = 0;
  while (i < n) {
    const values = makeItems(i + seed);
    output.push(values);
    i = i + 1;
  }

  return output;
}

function makeItems(seed: int): boolean[] {
  const choice = seed % 3;
  if (choice === 0) {
    const empty: boolean[] = Array.of ();
    return empty;
  }

  if (choice === 1) {
    return Array.of (item(seed, 0));
  }

  return Array.of (item(seed, 0), item(seed, 1), item(seed, 2), item(seed, 3), item(seed, 4));
}

function item(seed: int, ordinal: int): boolean {
  return (seed + ordinal) % 3 !== 0;
}

function main() {
  const result = workload(2, 7);
}
