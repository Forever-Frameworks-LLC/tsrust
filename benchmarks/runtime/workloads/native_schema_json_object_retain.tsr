import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.object({
    count: s.int().min(2)
  }).retain();
  let checksum = seed;
  let i = 0;
  while (i < n) {
    {
      const outcome0 = schema.safeParse(JSON.parse(input));
      if (outcome0.success) {
        const value = outcome0.data;
        if (!value.extra.has('extra') || value.extra.size !== 1) {
          throw 'Invalid extras';
        }

        checksum += value.value.count + value.extra.size;
      } else {
        const error = outcome0.error;
        throw 'Expected success';
      }
    }

    {
      const outcome1 = schema.safeParse(JSON.parse('{"extra":true}'));
      if (outcome1.success) {
        const value = outcome1.data;
        throw 'Expected rejection';
      } else {
        const error = outcome1.error;
        if (error.truncated || error.issues.length !== 1) {
          throw 'Invalid count';
        }

        for (const issue of error.issues) {
          if (issue.pathTruncated || issue.path.length !== 1) {
            throw 'Invalid path';
          }

          for (const segment of issue.path) {
            if (segment.index !== undefined) {
              throw 'Unexpected index';
            }

            if (issue.code === 'missing-field') {
              if (segment.field !== 'count' || issue.expected !== 'integer' || issue.observed !== 'missing') {
                throw 'Invalid missing field';
              }
            } else {
              throw 'Unexpected issue';
            }
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, '{"count":3,"extra":true}'));
}
