import { compile } from 'std:regex';

function workload(n: int, seed: int, input: string): int {
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const expression = unwrap(compile(input));
    checksum += expression.isMatch('a=12') ? 1 : 0;
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, '([a-z]+)=([0-9]+)'));
}
