type RemovalRecord = {
  id: int;
  label: string;
};

function workload(n: int, seed: int, input: string): string[] {
  const output: string[] = [];
  let i = 0;
  while (i < n) {
    const count = (i + seed) % 4;
    const values: RemovalRecord[] = [];
    if (count > 0) {
      values.push({
        id: seed, label: input.repeat(1)
      });
    }

    if (count > 1) {
      values.push({
        id: seed + 1, label: input.concat("!")
      });
    }

    if (count > 2) {
      values.push({
        id: seed + 2, label: "é😀e\u0301\u0000"
      });
    }

    const removed0 = values.pop();
    output.push(typeof removed0);
    if (removed0 === undefined) {
      output.push("undefined");
    } else {
      output.push(describe(removed0));
    }

    output.push(String(values.length));
    if (values.length > 0) {
      output.push(describe(values[0]));
    } else {
      output.push("<absent>");
    }

    if (values.length > 1) {
      output.push(describe(values[1]));
    } else {
      output.push("<absent>");
    }

    const removed1 = values.pop();
    output.push(typeof removed1);
    if (removed1 === undefined) {
      output.push("undefined");
    } else {
      output.push(describe(removed1));
    }

    output.push(String(values.length));
    if (values.length > 0) {
      output.push(describe(values[0]));
    } else {
      output.push("<absent>");
    }

    if (values.length > 1) {
      output.push(describe(values[1]));
    } else {
      output.push("<absent>");
    }

    i = i + 1;
  }

  return output;
}

function describe(value: RemovalRecord): string {
  return String(value.id).concat(":", value.label);
}

function main() {
  const result = workload(2, 7, "dynamic text");
}
