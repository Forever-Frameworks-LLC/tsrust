function workload(n: int, seed: int, input: string): string[][] {
    const base: string[] = [clone(input), "x😀", "a\u0000b", "e\u0301", "xxé"];
    const output: string[][] = [];
    let i = 0;
    while (i < n) {
        const mode = (seed + i) % 4;
        let count = 5;
        if (mode === 0) {
            count = 0;
        } else if (mode === 1) {
            count = 1;
        } else if (mode === 2) {
            count = 4;
        }

        const values = base.slice(0, count);
        const result = values.map(paint);
        output.push(result);
        i = i + 1;
    }

    return output;
}

function paint(text: string): string {
    return text.replaceAll("x", "é\u0000");
}

function main() {
    const result = workload(2, 7, " xé😀e\u0301 ");
}
