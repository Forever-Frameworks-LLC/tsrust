type OfRecord = { id: int; label: string; };
function workload(n: int, seed: int, input: string): string[][] {
    const output: string[][] = []; let i = 0;
    while (i < n) {
        const values = makeItems(i + seed, input);
        output.push(describe(values));
        i = i + 1;
    }
    return output;
}
function makeItems(seed: int, input: string): OfRecord[] {
    const choice = seed % 3;
    if (choice === 0) { const empty: OfRecord[] = Array.of(); return empty; }
    if (choice === 1) { return Array.of(item(seed, 0, input)); }
    return Array.of(item(seed, 0, input), item(seed, 1, input), item(seed, 2, input), item(seed, 3, input), item(seed, 4, input));
}
function item(seed: int, ordinal: int, input: string): OfRecord { return { id: seed + ordinal, label: input.concat(":", String(ordinal)) }; }
function describe(values: OfRecord[]): string[] { const result: string[] = []; let at = 0; while (at < values.length) { result.push(String(values[at].id).concat(":", values[at].label)); at = at + 1; } return result; }
function main() { const result = workload(2, 7, "dynamic text"); }
