import { PathFormatOptions, format } from 'std:path';

function workload(n: int, seed: int, input: string): int {
  const parts: PathFormatOptions = {
    dir: String(input), name: 'file.tar', ext: 'gz'
  };
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const value = format(parts);
    if (value.length !== 19 || !value.startsWith('reports') || !value.endsWith('file.tar.gz')) {
      throw 'path format';
    }

    checksum += value.length;
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, "reports"));
}
