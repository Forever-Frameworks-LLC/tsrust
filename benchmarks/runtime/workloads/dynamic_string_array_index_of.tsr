function workload(n: int, seed: int, input: string): int {
    const values: string[] = []; let j = 0;
    while (j < 129) {
        if ((j * 37 + seed) % 101 < 100) { values.push(input.trim().toLowerCase()); }
        else { values.push(input.trim()); }
        j = j + 1;
    }
    let sum = seed; let i = 0;
    while (i < n) {
        const choice = (i + seed) % 3; const from = (i * 13 + seed) % 387 - 193;
        if (choice === 0) { sum = sum + values.indexOf("label å", from); }
        else { if (choice === 1) { sum = sum + values.indexOf("Label Å", from); } else { sum = sum + values.indexOf("label ö", from); } }
        i = i + 1;
    }
    return sum;
}
function main() { console.log(workload(2, 7, "  Label Å  ")); }
