function workload(n: int, seed: int): int[][] {
  const output: int[][] = [];
  const sizes: int[] = [0, 1, 4, 5, 17];
  const ints: int[] = [seed % 100 + 11, 2, 10, seed % 100 + 1];
  let i = 0;
  while (i < n) {
    const count = sizes[(i + seed) % 5];
    const values: int[] = [];
    let j = 0;
    while (j < count) {
      values.push(ints[j % 4]);
      j = j + 1;
    }

    const sorted = values.toSorted();
    output.push(values);
    output.push(sorted);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(2, 7);
}
