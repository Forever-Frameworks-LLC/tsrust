import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.discriminatedUnion('kind', [s.object({
    kind: s.literal('count'), count: s.int()
  }), s.object({
    kind: s.literal('text'), text: s.string()
  })]);
  let checksum = seed;
  let i = 0;
  while (i < n) {
    {
      const outcome0 = schema.safeParse(JSON.parse(input));
      if (outcome0.success) {
        const value = outcome0.data;
        if (value.kind === 'count') {
          if (value.count !== 4) {
            throw 'Wrong count';
          }

          checksum += value.count;
        } else {
          throw 'Wrong branch';
        }
      } else {
        const error = outcome0.error;
        throw 'Expected success';
      }
    }

    {
      const outcome1 = schema.safeParse(JSON.parse('{"kind":"unknown"}'));
      if (outcome1.success) {
        const value = outcome1.data;
        throw 'Expected rejection';
      } else {
        const error = outcome1.error;
        if (error.truncated || error.issues.length !== 1) {
          throw 'Wrong issues';
        }

        for (const issue of error.issues) {
          if (issue.code !== 'discriminator-mismatch' || issue.expected !== 'union' || issue.observed !== 'string' || issue.pathTruncated || issue.path.length !== 1) {
            throw 'Wrong issue';
          }

          for (const segment of issue.path) {
            if (segment.field !== 'kind' || segment.index !== undefined) {
              throw 'Wrong path';
            }
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(0, 0, '{"kind":"count","count":4}'), workload(1, 0, '{"kind":"count","count":4}'), workload(17, 7, '{"kind":"count","count":4}'), workload(2000, 1, '{"kind":"count","count":4}'));
}
