import { s } from 'std:schema';
enum Code {
  Low = 1, High = 2.5
}

function workload(n: int, seed: int, input: string): int {
  const schema = s.enum(Code);
  let checksum = seed;
  let i = 0;
  while (i < n) {
    {
      const outcome0 = schema.safeParse(JSON.parse(input));
      if (outcome0.success) {
        const value = outcome0.data;
        if (value !== Code.High) {
          throw 'Invalid enum value';
        }

        checksum += 1;
      } else {
        const error = outcome0.error;
        throw 'Expected success';
      }
    }

    {
      const outcome1 = schema.safeParse(JSON.parse('3.0'));
      if (outcome1.success) {
        const value = outcome1.data;
        throw 'Expected rejection';
      } else {
        const error = outcome1.error;
        if (error.truncated || error.issues.length !== 1) {
          throw 'Invalid issue count';
        }

        for (const issue of error.issues) {
          if (issue.code !== 'literal-mismatch' || issue.expected !== 'number' || issue.observed !== 'number' || issue.pathTruncated || issue.path.length !== 0) {
            throw 'Invalid issue';
          }
        }

        checksum += 1;
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(0, 0, '2.5'), workload(1, 0, '2.5'), workload(17, 7, '2.5'), workload(2000, 1, '2.5'));
}
