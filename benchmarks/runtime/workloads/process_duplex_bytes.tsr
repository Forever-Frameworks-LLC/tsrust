import { run, spawn } from 'std:process';
import { get } from 'std:env';
import { alloc, set, at, length } from 'std:bytes';
import { reader } from 'std:io';
async function workload(n: int, seed: int): Task<int> {
  const executable = unwrap(get('TSRUST_PROCESS_HELPER'));
  if (executable === undefined) {
    throw 'missing helper';
  }

  const payload = unwrap(alloc(16384));
  for (let j: int = 0; j < 16384; j++) {
    unwrap(set(payload, j, (seed + j) % 251));
  }

  let sum: int = 0;
  for (let i: int = 0; i < n; i++) {
    const output = unwrap(await run(executable, ['echo'], {
      input: clone(payload)
    }));
    if (!output.status.success) {
      throw 'child failed';
    }

    if (length(output.stdout) !== 16384 || length(output.stderr) !== 0) {
      throw 'wrong output size';
    }

    for (let j: int = 0; j < 16384; j++) {
      sum = (sum * 131 + unwrap(at(output.stdout, j))) % 1000000007;
    }
  }

  return sum;
}
