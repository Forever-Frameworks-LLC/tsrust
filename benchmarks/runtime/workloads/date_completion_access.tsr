import { parseDate, formatDate, getDay, startOfYear, endOfYear, parseTime, getHours, getMinutes, getSeconds, getNanoseconds } from 'std:date';

function workload(n: int, seed: int): int {
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const date = unwrap(parseDate('2024-02-29'));
    const time = unwrap(parseTime('23:59:58.123456789'));
    const start = startOfYear(date);
    const end = endOfYear(date);
    if (formatDate(start) !== '2024-01-01' || formatDate(end) !== '2024-12-31') {
      throw 'year';
    }

    checksum += getDay(date) + getHours(time) + getMinutes(time) + getSeconds(time) + getNanoseconds(time);
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 7));
}
