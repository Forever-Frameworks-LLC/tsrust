function workload(n: int, seed: int): string[] {
    const values: boolean[] = [true, false, seed % 2 === 0, false, true, false];
    const output: string[] = []; let i = 0;
    while (i < n) {
        const count = (i + seed) % 7;
        let joined: string = "";
        const receiver = values.slice(0, count);
        joined = receiver.toString();
        output.push(joined);
        i = i + 1;
    }
    return output;
}
function main() { const result = workload(2, 7); }
