function workload(n: int, seed: int): string[] {
  const output: string[] = [];
  const sizes: int[] = [0, 1, 4, 5, 17];
  const starts: int[] = [-9007199254740991, -3, -1, 0, 1, 3, 9007199254740991];
  const deletes: int[] = [-9007199254740991, -1, 0, 1, 3, 17, 9007199254740991];
  let i = 0;
  while (i < n) {
    const count = sizes[(i + seed) % 5];
    const mode = (i * 7 + seed) % 6;
    const start = starts[(i * 11 + seed) % 7];
    const deleteCount = deletes[(i * 3 + seed) % 7];
    const values: boolean[] = [];
    let j = 0;
    while (j < count) {
      values.push((seed + j) % 2 === 0);
      j = j + 1;
    }

    let removed: boolean[] = [];
    if (mode === 0) {
      removed = values.splice();
    } else if (mode === 1) {
      removed = values.splice(start);
    } else if (mode === 2) {
      removed = values.splice(start, deleteCount);
    } else if (mode === 3) {
      removed = values.splice(start, deleteCount, false);
    } else if (mode === 4) {
      removed = values.splice(start, deleteCount, false, true, true);
    } else {
      removed = values.splice(start, deleteCount, false);
    }

    output.push(String(removed.length));
    output.push(String(values.length));
    let at = 0;
    while (at < removed.length) {
      output.push(describe(removed[at]));
      at = at + 1;
    }

    let remain = 0;
    while (remain < values.length) {
      output.push(describe(values[remain]));
      remain = remain + 1;
    }

    i = i + 1;
  }

  return output;
}

function describe(value: boolean): string {
  return String(value);
}

function main() {
  const result = workload(2, 7);
}
