function workload(n: int, seed: int, input: string): string[] {
    const output: string[] = [];
    let i = 0;
    while (i < n) {
        const values: string[] = [item(seed + i + 0, input), item(seed + i + 1, input), item(seed + i + 2, input), item(seed + i + 3, input), item(seed + i + 4, input), item(seed + i + 5, input)];
        const replacement = item(seed + i + 11, input);
        const result = values.with(index(i, seed), replacement);
        for (const value of result) {
            output.push(clone(value));
        }

        i = i + 1;
    }

    return output;
}

function index(i: int, seed: int): int {
    const c = (i + seed) % 8;
    if (c === 0) {
        return - 6;
    }

    if (c === 1) {
        return - 1;
    }

    if (c === 2) {
        return 0;
    }

    if (c === 3) {
        return 5;
    }

    if (c === 4) {
        return - 3;
    }

    if (c === 5) {
        return 2;
    }

    if (c === 6) {
        return - 2;
    }

    return 1;
}

function item(base: int, input: string): string {
    if (base % 3 === 0) {
        return clone(input);
    }

    if (base % 3 === 1) {
        return "a\u0000b";
    }

    return "é😀e\u0301";
}

function main() {
    const result = workload(2, 7, " xé😀e\u0301 ");
}
