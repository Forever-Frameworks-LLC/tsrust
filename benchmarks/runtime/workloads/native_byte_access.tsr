import { Bytes, fromArray, at, set, length } from "std:bytes";

function read(bytes: ReadOnly<Bytes>): int {
  match (at(bytes, 1)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      return -1;
    },
  }
}

function workload(n: int, seed: int, input: string): int[][] {
  const output: int[][] = [];
  const write = set;
  let i = 0;
  while (i < n) {
    const byte = (i + seed) % 256;
    const changed = (byte + 1) % 256;
    match (fromArray([0, byte, 255])) {
      Ok(bytes) => {
        const initial = read(bytes);
        let success = -1;
        match (write(bytes, 1, changed)) {
          Ok(_) => {
            success = 1;
          },
          Err(error) => {
            success = -2;
          },
        }

        const updated = read(bytes);
        let indexCode = -1;
        let indexOffset = -9;
        match (set(bytes, -1, 256)) {
          Ok(_) => {
            indexCode = -2;
          },
          Err(error) => {
            indexCode = error.code.length;
            indexOffset = error.offset ?? -3;
          },
        }

        const afterIndex = read(bytes);
        let byteCode = -1;
        let byteOffset = -9;
        match (set(bytes, 1, 256)) {
          Ok(_) => {
            byteCode = -2;
          },
          Err(error) => {
            byteCode = error.code.length;
            byteOffset = error.offset ?? -3;
          },
        }

        const afterByte = read(bytes);
        let readCode = -1;
        let readOffset = -9;
        match (at(bytes, 3)) {
          Ok(value) => {
            readCode = -2;
          },
          Err(error) => {
            readCode = error.code.length;
            readOffset = error.offset ?? -3;
          },
        }

        output.push([initial, updated, success, afterIndex, afterByte, indexCode, indexOffset + 1, byteCode, byteOffset, readCode, readOffset, length(bytes)]);
      },
      Err(error) => {
        output.push([-1000000]);
      },
    }

    i += 1;
  }

  return output;
}

function main() {
  workload(1, 0, "bytes");
}
