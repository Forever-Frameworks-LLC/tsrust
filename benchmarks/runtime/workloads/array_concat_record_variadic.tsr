type Row = {
  code: int;
  text: string;
  items: int[];
};

function workload(n: int, seed: int, input: string): Row[][] {
  const base: Row[] = [{
    code: seed, text: clone(input), items: [seed, 1]
  }, {
    code: 2, text: "é", items: []
  }, {
    code: 3, text: "a\u0000b", items: [2, 3]
  }, {
    code: 4, text: "😀", items: [4]
  }, {
    code: 5, text: "e\u0301", items: [5, 6]
  }];
  const output: Row[][] = [];
  let i = 0;
  while (i < n) {
    const mode = (i + seed) % 4;
    let count = 5;
    if (mode === 0) {
      count = 0;
    } else if (mode === 1) {
      count = 1;
    } else if (mode === 2) {
      count = 4;
    }

    const selected = base.slice(0, count);
    const first = base.slice(1, mode % 3 + 2);
    const second = base.slice(0, mode % 2);
    const empty: Row[] = [];
    const scalar0: Row = {
      code: seed + i, text: clone(input), items: [i, seed]
    };
    const scalar1: Row = {
      code: i, text: "a\u0000b", items: []
    };
    const result = selected.concat(scalar0, first, scalar1, empty, second);
    output.push(result);
    i = i + 1;
  }

  return output;
}

function main() {
  const result = workload(2, 7, "é 😀 e\u0301");
}
