function workload(n: int, seed: int): int {
    const base: int[][][] = [[[seed], []], [], [[1, 2]], [[3]], [[4], [5]]];
    let trace: int = seed;
    let visits = 0;
    let i = 0;
    while (i < n) {
        const mode = (i + seed) % 5;
        let count = 5;
        if (mode === 0) {
            count = 0;
        } else if (mode === 1) {
            count = 1;
        } else if (mode === 2) {
            count = 4;
        }

        const selected = base.slice(0, count);
        selected.forEach((value: int[][], index: int, source: int[][][]): void => {
            let weight = 0; for (const inner of value) {
                for (const item of inner) {
                    weight = weight + item;
                }
            }

            trace = (trace * 131 + weight + index + source.length + i) % 1000000007; visits = visits + 1;
        });
        i = i + 1;
    }

    return (trace + visits) % 1000000007;
}

function main() {
    const result = workload(2, 7);
}
