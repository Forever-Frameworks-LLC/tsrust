function workload(n: int, seed: int): int {
  let trace = seed;
  const consumer = (f: Function<int, [x: int]>, x: int): int => {
    return f(x);
  };
  let i = 0;
  while (i < n) {
    const callback = (x: int): int => {
      return (x * 3 + 1) % 1000000007;
    };
    const value = consumer(callback, seed + i);
    trace = (trace * 131 + value) % 1000000007;
    i = i + 1;
  }

  return trace;
}

function main() {
  const result = workload(2, 7);
}
