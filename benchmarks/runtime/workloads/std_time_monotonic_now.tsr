import { monotonicNow } from "std:time";

function workload(n: int, seed: int): boolean[] {
  const values: boolean[] = [];
  let previous = monotonicNow();
  let i = 0;
  while (i < n) {
    const current = monotonicNow();
    values.push(Number.isFinite(current) && current >= previous && current >= 0);
    previous = current;
    i = i + 1;
  }

  return values;
}
