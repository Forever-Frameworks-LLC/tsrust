import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const text = s.string().min(2).max(8);
  const flags = s.array(s.boolean());
  let checksum = seed;
  let i = 0;
  while (i < n) {
    const first = JSON.stringify(text.toJsonSchema());
    const second = JSON.stringify(flags.toJsonSchema());
    if (first !== input || second !== '{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"boolean"},"type":"array"}') {
      throw 'Invalid exported document';
    }

    checksum += first.length + second.length;
    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, '{"$schema":"https://json-schema.org/draft/2020-12/schema","maxLength":8,"minLength":2,"type":"string"}'));
}
