function workload(n: int, seed: int, input: string): int {
    const values: string[] = ["label 000 Å", "label 001 Å", "label 002 Å", "label 003 Å", "label 004 Å", "label 005 Å", "label 006 Å", "label 007 Å", "label 008 Å", "label 009 Å", "label 010 Å", "label 011 Å", "label 012 Å", "label 013 Å", "label 014 Å", "label 015 Å", "label 016 Å", "label 017 Å", "label 018 Å", "label 019 Å", "label 020 Å", "label 021 Å", "label 022 Å", "label 023 Å", "label 024 Å", "label 025 Å", "label 026 Å", "label 027 Å", "label 028 Å", "label 029 Å", "label 030 Å", "label 031 Å", "label 032 Å", "label 033 Å", "label 034 Å", "label 035 Å", "label 036 Å", "label 037 Å", "label 038 Å", "label 039 Å", "label 040 Å", "label 041 Å", "label 042 Å", "label 043 Å", "label 044 Å", "label 045 Å", "label 046 Å", "label 047 Å", "label 048 Å", "label 049 Å", "label 050 Å", "label 051 Å", "label 052 Å", "label 053 Å", "label 054 Å", "label 055 Å", "label 056 Å", "label 057 Å", "label 058 Å", "label 059 Å", "label 060 Å", "label 061 Å", "label 062 Å", "label 063 Å", "label 064 Å", "label 065 Å", "label 066 Å", "label 067 Å", "label 068 Å", "label 069 Å", "label 070 Å", "label 071 Å", "label 072 Å", "label 073 Å", "label 074 Å", "label 075 Å", "label 076 Å", "label 077 Å", "label 078 Å", "label 079 Å", "label 080 Å", "label 081 Å", "label 082 Å", "label 083 Å", "label 084 Å", "label 085 Å", "label 086 Å", "label 087 Å", "label 088 Å", "label 089 Å", "label 090 Å", "label 091 Å", "label 092 Å", "label 093 Å", "label 094 Å", "label 095 Å", "label 096 Å", "label 097 Å", "label 098 Å", "label 099 Å", "label 100 Å", "label 101 Å", "label 102 Å", "label 103 Å", "label 104 Å", "label 105 Å", "label 106 Å", "label 107 Å", "label 108 Å", "label 109 Å", "label 110 Å", "label 111 Å", "label 112 Å", "label 113 Å", "label 114 Å", "label 115 Å", "label 116 Å", "label 117 Å", "label 118 Å", "label 119 Å", "label 120 Å", "label 121 Å", "label 122 Å", "label 123 Å", "label 124 Å", "label 125 Å", "label 126 Å", "label 127 Å", "label 128 Å"];
    let sum = seed;
    let i = 0;
    while (i < n) {
        const needle = (i * 17 + seed) % 137;
        const from = (i * 13 + seed) % 387 - 193;
        if (needle < 129) {
            sum = sum + values.indexOf(values[needle], from);
        } else {
            sum = sum + values.indexOf(input, from);
        }

        i = i + 1;
    }

    return sum;
}

function main() {
    console.log(workload(2, 7, "label 064 Å"));
}
