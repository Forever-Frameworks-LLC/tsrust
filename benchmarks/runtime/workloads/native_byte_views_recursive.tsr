import { Bytes, ByteView, fromArray, view, at, length } from "std:bytes";

type Chunk = {
  data: ByteView;
  children: Chunk[];
};

function byteWindow(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, 2)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function first(chunk: ReadOnly<Chunk>): int {
  match (at(chunk.data, 0)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function workload(n: int, seed: int, input: string): int[][] {
  const output: int[][] = [];
  let i = 0;
  while (i < n) {
    const byte = (i + seed) % 256;
    match (fromArray([byte, 255])) {
      Ok(owner) => {
        let root: Chunk = {
          data: byteWindow(owner), children: []
        };
        let depth = 0;
        while (depth < 16) {
          root = {
            data: byteWindow(owner), children: [root]
          };
          depth++;
        }

        let sum = 0;
        let count = 0;
        while (root.children.length > 0) {
          sum += first(root);
          count++;
          const child = root.children.pop()!;
          root = child;
        }

        sum += first(root);
        count++;
        output.push([count, sum, length(root.data)]);
      },
      Err(error) => {
        throw error.message;
      },
    }

    i++;
  }

  return output;
}

function main() {}
