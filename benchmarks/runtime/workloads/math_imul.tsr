function workload(n: int, seed: int): number {
    let sum: number = Number(seed);
    let i = 0;
    while (i < n) {
        const a: number = Number((i * 13 + seed) % 1048576 - 524288) * 8192.0 + 0.75;
        const b: number = Number((i * 17 + seed) % 65537 - 32768) * 65536.0 - 0.5;
        const value_result: number = Math.imul(a, b);
        sum = sum + value_result;
        i = i + 1;
    }

    return sum;
}

function main() {
    const result = workload(2, 7);
    console.log(result);
}
