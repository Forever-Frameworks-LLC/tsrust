function workload(n: int, seed: int): string {
    const base: string[] = ["MARKa", "MARKé", "MARK😀", "MARK\u0000", "MARKz"];
    let trace = seed;
    let visits = 0;
    let i = 0;
    let last: string = "MARK";
    while (i < n) {
        const mode = (i + seed) % 5;
        let count = 5;
        if (mode === 0) {
            count = 0;
        } else if (mode === 1) {
            count = 1;
        } else if (mode === 2) {
            count = 4;
        }

        const values = base.slice(0, count);
        let selected: string = "MARK";
        if (mode === 3) {
            selected = values.reduce((a: string, v: string, index: int, source: string[]): string => {
                trace = (trace * 131 + index + source.length + i) % 1000000007; visits = visits + 1; return a.replace("MARK", v);
            });
        } else {
            selected = values.reduce((a: string, v: string, index: int, source: string[]): string => {
                trace = (trace * 131 + index + source.length + i) % 1000000007; visits = visits + 1; return a.replace("MARK", v);
            }, clone(last));
        }

        last = selected;
        i = i + 1;
    }

    return last.repeat(trace % 2 + 1);
}

function main() {
    const result = workload(2, 7);
}
