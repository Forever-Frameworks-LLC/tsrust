import { s } from 'std:schema';

function workload(n: int, seed: int, input: string): int {
  const schema = s.int().min(2).max(9);
  let checksum = seed;
  let i = 0;
  while (i < n) {
    {
      const outcome0 = schema.safeParse(JSON.parse(input));
      if (outcome0.success) {
        const text = outcome0.data;
        checksum += text;
      } else {
        const error = outcome0.error;
        throw 'Expected integer success';
      }
    }

    {
      const outcome1 = schema.safeParse(JSON.parse('10'));
      if (outcome1.success) {
        const text = outcome1.data;
        throw 'Expected upper-bound rejection';
      } else {
        const error = outcome1.error;
        if (error.truncated || error.issues.length !== 1) {
          throw 'Invalid error count';
        }

        for (const issue of error.issues) {
          if (issue.code !== 'too-large' || issue.expected !== 'integer' || issue.observed !== 'number' || issue.path.length !== 0 || issue.pathTruncated) {
            throw 'Invalid issue';
          }

          checksum += 1;
        }
      }
    }

    i++;
  }

  return checksum;
}

function main() {
  console.log(workload(1, 0, '7'));
}
