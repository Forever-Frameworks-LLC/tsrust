type Trace = { calls: int; };
type AssignRecord = { id: int; label: string; };
function workload(n: int, seed: int, input: string): string[][] {
    const output: string[][] = []; const trace: Trace = { calls: 0 }; let i = 0;
    while (i < n) {
        const value = i + seed; let target: AssignRecord | null | undefined = makeLeft(value, input);
        const before = trace.calls;
        const selected = (target ??= fallback(trace, value, input));
        const delta = trace.calls - before;
        output.push([String(selected.id).concat(":", selected.label), String(target.id).concat(":", target.label), String(delta)]);
        i = i + 1;
    }
    output.push([String(trace.calls)]);
    return output;
}
function makeLeft(value: int, input: string): AssignRecord | null | undefined {
    const tag = value % 5; if (tag === 0) { return null; } if (tag === 1) { return undefined; }
    return { id: value % 4, label: value % 3 === 0 ? "" : input.concat(":", String(value)) };
}
function fallback(trace: Trace, value: int, input: string): AssignRecord {
    trace.calls = trace.calls + 1;
    return { id: value + 100, label: input.concat("|fallback:", String(value)) };
}
function main() { const result = workload(2, 7, "dynamic text"); }
