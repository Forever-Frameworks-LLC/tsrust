function independentMapRead(left: ReadOnly<Map<string, Holder>>, right: ReadOnly<Map<string, Holder>>): int {
  let observed = (left.get("k")?.run() ?? 1) + (right.get("k")?.run() ?? 1);
  for (const [key, holder] of left) observed += holder.run();
  for (const [key, holder] of right) observed += holder.run();
  return observed;
}
