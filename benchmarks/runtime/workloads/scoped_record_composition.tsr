type Holder = {
    run: ReadOnly<Function<int>>;
};

type Box = {
    handlers: Map<string, Holder>;
};

type RefillBox = {
    handlers: Map<string, Holder>;
    marker: int;
};

function workload(n: int, seed: int, input: string): int[][] {
    const output: int[][] = [];
    let i = 0;
    while (i < n) {
        const value = i % 5 + seed % 5 + 1;
        const base = [value, value + 1];
        let removedValue = 0;
        let arrayValue = 0;
        let mapFirst = 0;
        let mapSecond = 0;
        let replaced = 0;
        let iterated = 0;
        let peerValue = 0;
        let populated = 0;
        let cleared = 0;
        {
            const items: Holder[] = [{
                run: (): int => base[0]
            }];
            const removed = items.pop();
            items.push({
                run: (): int => base[1]
            });
            if (removed !== undefined) removedValue = removed.run();
            arrayValue = items[0].run();
            const handlers = new Map<string, Holder>();
            handlers.set("first", {
                run: (): int => base[0]
            });
            const peerMap = new Map<string, Holder>();
            peerMap.set("peer", {
                run: (): int => base[1] + 2
            });
            const boxes: Box[] = [{
                handlers: handlers
            }, {
                handlers: peerMap
            }];
            boxes[0].handlers.set("second", {
                run: (): int => base[1]
            });
            {
                const first = boxes[0].handlers.get("first");
                const second = boxes[0].handlers.get("second");
                if (first !== undefined) mapFirst = first.run();
                if (second !== undefined) mapSecond = second.run();
            }

            {
                const peer = boxes[1].handlers.get("peer");
                if (peer !== undefined) peerValue = peer.run();
            }

            populated = boxes[0].handlers.size;
            boxes[0].handlers.forEach((holder: ReadOnly<Holder>): void => {
                iterated += holder.run();
            });
            const replacementMap = new Map<string, Holder>();
            replacementMap.set("replacement", {
                run: (): int => base[1] + 1
            });
            boxes[0].handlers = replacementMap;
            {
                const replacement = boxes[0].handlers.get("replacement");
                if (replacement !== undefined) replaced = replacement.run();
            }

            boxes[0].handlers.clear();
            cleared = boxes[0].handlers.size;
        }

        const oldCapture = [value];
        const newCapture = [value + 4];
        const refillMap = new Map<string, Holder>();
        const refillBox: RefillBox = {
            handlers: refillMap, marker: 1
        };
        refillBox.handlers.set("old", {
            run: (): int => oldCapture[0]
        });
        if (value % 2 === 0) {
            refillBox.handlers.clear();
        } else {
            refillBox.handlers.clear();
        }

        refillBox.handlers.set("new", {
            run: (): int => newCapture[0]
        });
        oldCapture[0] = value + 5;
        let refilled = 0;
        {
            const current = refillBox.handlers.get("new");
            if (current !== undefined) refilled = current.run();
        }

        let movedSize = 0;
        if (value % 2 === 0) {
            refillBox.handlers.clear();
            const moved = refillBox.handlers;
            movedSize = moved.size;
        } else {
            refillBox.handlers.clear();
            movedSize = refillBox.handlers.size;
        }

        newCapture[0] = value + 6;
        refilled += oldCapture[0] + newCapture[0] + refillBox.marker;

        const beforeThrow = [value];
        const afterThrow = [value + 8];
        const caughtMap = new Map<string, Holder>();
        caughtMap.set("old", {
            run: (): int => beforeThrow[0]
        });
        let caughtValue = 0;
        try {
            caughtMap.clear();
            caughtMap.set("new", {
                run: (): int => afterThrow[0]
            });
            throw value;
        } catch (error) {
            caughtValue = caughtMap.size;
        }

        beforeThrow[0] = value + 9;
        {
            const current = caughtMap.get("new");
            if (current !== undefined) caughtValue += current.run();
        }

        caughtMap.clear();
        afterThrow[0] = value + 10;
        caughtValue += beforeThrow[0] + afterThrow[0];

        let branchTrace = 0;
        let normalCleanup = 0;
        let caughtCleanup = 0;
        let normalRenewed = 0;
        let caughtRenewed = 0;
        {
            const prefixOld = [value];
            const prefixNew = [value + 12];
            const prefixMap = new Map<string, Holder>();
            prefixMap.set("old", {
                run: (): int => prefixOld[0]
            });
            let prefixValue = 0;
            try {
                if (value % 2 === 0) {
                    branchTrace += 1;
                    prefixValue = prefixResult(false);
                    prefixMap.clear();
                    prefixMap.set("new", {
                        run: (): int => prefixNew[0]
                    });
                } else {
                    branchTrace += 2;
                    prefixValue = prefixResult(false);
                    prefixMap.clear();
                    prefixMap.set("new", {
                        run: (): int => prefixNew[0]
                    });
                }
            } catch (error) {
                {
                    prefixValue = 2;
                    prefixValue += prefixMap.size;
                    prefixMap.clear();
                    prefixMap.set("new", {
                        run: (): int => prefixNew[0]
                    });
                }
            } finally {
                normalCleanup = prefixMap.size;
            }

            prefixOld[0] = value + 13;
            {
                const entry = prefixMap.get("new");
                if (entry !== undefined) prefixValue += entry.run();
            }

            prefixMap.clear();
            prefixNew[0] = value + 14;
            normalRenewed = prefixValue + prefixOld[0] + prefixNew[0];
        }

        {
            const prefixOld = [value];
            const prefixNew = [value + 12];
            const prefixMap = new Map<string, Holder>();
            prefixMap.set("old", {
                run: (): int => prefixOld[0]
            });
            let prefixValue = 0;
            try {
                if (value % 2 === 0) {
                    branchTrace += 1;
                    prefixValue = prefixResult(true);
                    prefixMap.clear();
                    prefixMap.set("new", {
                        run: (): int => prefixNew[0]
                    });
                } else {
                    branchTrace += 2;
                    prefixValue = prefixResult(true);
                    prefixMap.clear();
                    prefixMap.set("new", {
                        run: (): int => prefixNew[0]
                    });
                }
            } catch (error) {
                {
                    prefixValue = 2;
                    prefixValue += prefixMap.size;
                    prefixMap.clear();
                    prefixMap.set("new", {
                        run: (): int => prefixNew[0]
                    });
                }
            } finally {
                caughtCleanup = prefixMap.size;
            }

            prefixOld[0] = value + 13;
            {
                const entry = prefixMap.get("new");
                if (entry !== undefined) prefixValue += entry.run();
            }

            prefixMap.clear();
            prefixNew[0] = value + 14;
            caughtRenewed = prefixValue + prefixOld[0] + prefixNew[0];
        }

        base[0] = 0;
        output.push([removedValue, arrayValue, mapFirst, mapSecond, replaced, iterated, peerValue, populated, cleared, base[0] + base[1], refilled, movedSize, caughtValue, normalRenewed, caughtRenewed, normalCleanup, caughtCleanup, branchTrace]);
        i += 1;
    }

    return output;
}

function prefixResult(fail: boolean): int {
    if (fail) throw 5;
    return 1;
}

function main() {
    const result = workload(3, 0, "composition");
}
