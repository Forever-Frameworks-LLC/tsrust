  let observed = independentParameterRead(left, right) + independentParameterRead(right, left);
  independentParameterFill(left, right, value + 5);
  const leftArray: Holder[] = [{
    run: (): int => leftCapture[0]
  }];
  const rightArray: Holder[] = [{
    run: (): int => rightCapture[0]
