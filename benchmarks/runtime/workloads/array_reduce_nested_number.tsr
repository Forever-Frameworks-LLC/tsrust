function workload(n: int, seed: int): number[][] {
    const base: number[][] = [[Number(seed) + 0.25, - 0.0], [], [2.5, - 1.25], [4.75], [0.0]];
    let trace = seed;
    let visits = 0;
    let i = 0;
    const output: number[][] = [];
    while (i < n) {
        const mode = (i + seed) % 5;
        let count = 5;
        if (mode === 0) {
            count = 0;
        } else if (mode === 1) {
            count = 1;
        } else if (mode === 2) {
            count = 4;
        }

        const values = base.slice(0, count);
        let selected: number[] = [];
        if (mode === 3) {
            selected = values.reduce((a: number[], v: number[], index: int, source: number[][]): number[] => {
                trace = (trace * 131 + index + source.length + i) % 1000000007; visits = visits + 1; return clone(v);
            });
        } else {
            selected = values.reduce((a: number[], v: number[], index: int, source: number[][]): number[] => {
                trace = (trace * 131 + index + source.length + i) % 1000000007; visits = visits + 1; return clone(v);
            }, []);
        }

        output.push(selected);
        i = i + 1;
    }

    return output;
}

function main() {
    const result = workload(2, 7);
}
