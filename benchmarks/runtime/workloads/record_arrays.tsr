type Profile = {
  score: int;
};

type Entry = {
  profile: Profile;
  name: string;
};

type Catalog = {
  users: Entry[];
  rows: int[][];
};

function workload(n: int, seed: int): int {
  let sum = seed;
  let i = 0;
  while (i < n) {
    const catalog: Catalog = {
      users: [{
        profile: {
          score: i
        }, name: "Pat"
      }], rows: [[seed]]
    };
    append(catalog, i);
    for (const user of catalog.users) {
      sum = sum + user.profile.score;
    }

    for (const row of catalog.rows) {
      for (const score of row) {
        sum = sum + score;
      }
    }

    catalog.users[0].profile = {
      score: i + 1
    };
    sum = sum + catalog.users[0].profile.score;
    i = i + 1;
  }

  return sum;
}

function append(catalog: Catalog, value: int) {
  catalog.users.push({
    profile: {
      score: value + 2
    }, name: "Sam"
  });
  catalog.rows[0].push(value);
}

function main() {
  console.log(workload(2, 7));
}
