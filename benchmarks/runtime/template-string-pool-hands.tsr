  console.log(`${0.5}|${1.25}|${2.5}|${12.75}` === "0.5|1.25|2.5|12.75");
  console.log(`outer:${`inner:${3}`}` === "outer:inner:3");
  console.log(`a
b` === "a\nb");
  console.log(`ab` === "a\nb");
  console.log(`a
b` === "a\nb");
