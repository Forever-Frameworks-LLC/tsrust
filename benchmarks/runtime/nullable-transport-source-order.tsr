function observe(value: string | null | undefined): string { return typeof value; }
function fresh(trace: int[], mode: int): string | null | undefined { trace.push(1); return mode === 0 ? null : mode === 1 ? undefined : "é😀".repeat(1); }
function main() { const trace: int[] = []; const first: undefined | string | null | string = fresh(trace, 2); console.log(observe(first)); console.log(trace[0]); const second: string | undefined | null = fresh(trace, 0); console.log(String(second)); const third: null | string | undefined = fresh(trace, 1); console.log(Boolean(third)); console.log(trace.length); }
