import { alloc, readInt, writeInt, readUint, writeUint, readFloat32, writeFloat32, readFloat64, writeFloat64 } from "std:bytes";

function workload(n: int, seed: int, input: string): int {
  const bytes = unwrap(alloc(64));
  let checksum = 0;
  let i = 0;
  while (i < n) {
    unwrap(writeInt(bytes, 1, 65, 1, "little"));
    checksum += unwrap(readInt(bytes, 1, 1, "little")) * 4;
    unwrap(writeInt(bytes, 3, -12345, 2, "little"));
    checksum += unwrap(readInt(bytes, 3, 2, "little")) * 4;
    unwrap(writeInt(bytes, 5, -1234567, 4, "little"));
    checksum += unwrap(readInt(bytes, 5, 4, "little")) * 4;
    unwrap(writeInt(bytes, 9, 123456789, 8, "little"));
    checksum += unwrap(readInt(bytes, 9, 8, "little")) * 4;
    unwrap(writeUint(bytes, 17, 255, 1, "little"));
    checksum += unwrap(readUint(bytes, 17, 1, "little")) * 4;
    unwrap(writeUint(bytes, 19, 65535, 2, "little"));
    checksum += unwrap(readUint(bytes, 19, 2, "little")) * 4;
    unwrap(writeUint(bytes, 21, 4294967295, 4, "little"));
    checksum += unwrap(readUint(bytes, 21, 4, "little")) * 4;
    unwrap(writeFloat32(bytes, 25, 1.5, "little"));
    checksum += (unwrap(readFloat32(bytes, 25, "little")) === 1.5 ? 6 : 0);
    unwrap(writeFloat64(bytes, 33, -2.25, "little"));
    checksum += (unwrap(readFloat64(bytes, 33, "little")) === -2.25 ? -9 : 0);
    i += 1;
  }

  return checksum;
}

function main() {
  workload(1, 7, "packet");
}
