function main() {
    const v0: int[] = [];
    console.log(v0.toString());
    const v1: int[] = [0, 17, 9001];
    console.log(v1.toString());
    const v2: boolean[] = [true, false, true];
    console.log(v2.toString());
    const v3: string[] = ["", "é😀", "﻿\u0000"];
    console.log(v3.toString());
    const v4: int[][] = [[1, 2], [], [3]];
    console.log(v4.toString());
    const v5: int[][] = [[1], [], [2, 3]];
    console.log(v5.toString());
    const v6: null[] = [null, null, null];
    console.log(v6.toString());
    const v7: undefined[] = [undefined, undefined, undefined];
    console.log(v7.toString());
    const v8: number[] = [0.0, - 0.0, 0.5, - 2.5, 17.0, Number.NaN, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY];
    console.log(v8.toString());
    const v9: string[] = ["a,b", "&<>", ""];
    console.log(v9.toString());
    const v10: string[] = ["﻿", "é", "😀"];
    console.log(v10.toString());
    const v11: string[] = [""];
    console.log(v11.toString());
}
