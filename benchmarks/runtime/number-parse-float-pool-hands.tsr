function same(actual: number, expected: number): boolean {
    if (expected !== expected) {
        return actual !== actual;
    }

    if (expected === 0.0) {
        return actual === 0.0 && 1.0 / actual === 1.0 / expected;
    }

    return actual === expected;
}

