import { createJsonl, writeJsonl, closeJsonlWriter } from 'std:json';

type Item = {
  active: boolean;
  name: string;
  values: int[];
};

function workload(n: int, seed: int, input: string): int {
  let checksum = seed;
  let i = 0;
  const item: Item = {
    active: true, name: 'hello', values: [20, 17]
  };
  match (createJsonl(input)) {
    Ok(writer) => {
      while (i < n) {
        match (writeJsonl(writer, item)) {
          Ok(_) => {},
          Err(error) => {
            throw error.message;
          }
        }

        checksum += 1;
        i++;
      }

      match (closeJsonlWriter(writer)) {
        Ok(_) => {},
        Err(error) => {
          throw error.message;
        }
      }
    },
    Err(error) => {
      throw error.message;
    }
  }


  return checksum;
}
