import { s, Schema } from "std:schema";

function createSchema(): Schema<int[]> {
  return s.union([s.array(s.int().min(0).max(0)), s.array(s.int())]);
}

function workload(schema: Schema<int[]>, input: string): int[] {
  const result = schema.safeParseJson(input);
  if (result.success) {
    return result.data;
  } else {
    throw "validation failed";
  }
}
