import { s, Schema } from "std:schema";

type Payload = {
  items: int[];
};

function createSchema(): Schema<Payload> {
  return s.object({
    items: s.array(s.int())
  });
}

function workload(schema: Schema<Payload>, input: string): int[] {
  const result = schema.safeParseJson(input);
  if (result.success) {
    const value = result.data;
    return value.items;
  } else {
    throw "validation failed";
  }
}
