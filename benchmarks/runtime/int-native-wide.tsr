function main() {
    let minimum: int = -9223372036854775808; let maximum: int = 9223372036854775807;
    console.log(+minimum); console.log(~maximum); console.log(~minimum);
    let wide: int = 4294967296; console.log(wide & maximum); console.log(wide | 1); console.log(wide ^ 1);
    let one: int = 1; let two: int = 2; let negative: int = -1;
    console.log(one << 40); console.log(two << 63); console.log(maximum << 1);
    console.log(minimum >> 63); console.log(negative >>> 0); console.log(negative >>> 1);
    console.log(two ** 62); let minusTwo: int = -2; console.log(minusTwo ** 63); let zero: int = 0; console.log(zero ** 0);
    wide |= 1; console.log(wide); wide >>>= 32; console.log(wide); two **= 62; console.log(two);
}
