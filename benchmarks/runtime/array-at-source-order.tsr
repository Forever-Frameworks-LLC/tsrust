function index(trace: int[]): int {
    trace.push(1);
    return - 1;
}

function main() {
    const trace: int[] = [];
    const values: string[] = ["a", "é"];
    const selected = values.at(index(trace));
    console.log(typeof selected);
    if (selected !== undefined) {
        console.log(selected);
    }

    console.log(trace.join(","));
    console.log(values.join("|"));
    const empty: string[] = [];
    const missing = empty.at(index(trace));
    console.log(typeof missing);
    console.log(trace.join(","));
}
