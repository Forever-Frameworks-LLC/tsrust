type Trace = { tag: int; };
function index(trace: Trace): int { trace.tag = trace.tag * 10 + 1; return 0; }
function rhs(values: int[], trace: Trace): int { trace.tag = trace.tag * 10 + 2; values[0] = 99; values.push(17); return 7; }
function bit(value: boolean): int { if (value) { return 1; } return 0; }
function main() {
    const trace: Trace = { tag: 0 }; const values = [6, 2, 3, 4];
    const observed = (values[index(trace)] += rhs(values, trace));
    console.log(observed); console.log(values[0]); console.log(values[1]); console.log(values[2]); console.log(values[3]); console.log(values[4]); console.log(values.length); console.log(trace.tag);
    let first: int = 5; let second: int = 3;
    const chained = (first += (second *= 4));
    console.log(chained); console.log(first); console.log(second);
    let base: int = 2; let exponent: int = 2;
    const powered = (base **= (exponent += 1));
    console.log(powered); console.log(base); console.log(exponent);
    let zero: number = -0.0; const zeroResult = (zero += -0.0);
    console.log(bit(1.0 / zeroResult < 0.0)); console.log(bit(1.0 / zero < 0.0));
    let numberLeft: number = 5.0; let numberRight: number = 3.0;
    const numberChain = (numberLeft += (numberRight *= 4.0));
    console.log(numberChain); console.log(numberLeft); console.log(numberRight);
}
