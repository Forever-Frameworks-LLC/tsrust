import { toInt, toNumber, toFloat32, checkSigned } from 'std:numeric';
import { monotonicNow } from 'std:time';

function batch(): int {
  let checksum = 0;
  for (let i = 0; i < 2048; i += 1) {
    const value = unwrap(toInt(unwrap(toNumber(i))));
    const exact = match (toFloat32(i)) {
      Ok(_) => 1,
      Err(_) => 0,
    };
    const range = match (checkSigned(i, 8)) {
      Ok(_) => 1,
      Err(_) => 0,
    };
    checksum += value + exact + range;
  }

  return checksum;
}

function main() {
  for (let warmup = 0; warmup < 8; warmup += 1) {
    batch();
  }

  for (let sample = 0; sample < 31; sample += 1) {
    const start = monotonicNow();
    const checksum = batch();
    const elapsed = monotonicNow() - start;
    console.log(checksum);
    console.log(elapsed);
  }
}
