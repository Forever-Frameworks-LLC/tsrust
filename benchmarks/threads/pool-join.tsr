import { pool, join } from 'std:threads';
import { monotonicNow } from 'std:time';

function batch(): int {
  let checksum = 0;
  for (let index = 0; index < 8; index += 2) {
    const left = index;
    const right = index + 1;
    const first = unwrap(pool.task((): int => left * left));
    const second = unwrap(pool.task((): int => right * right));
    const a = unwrap(join(first));
    const b = unwrap(join(second));
    checksum += a + b;
  }

  return checksum;
}

function main() {
  unwrap(pool.configure(2, 16));
  for (let warmup = 0; warmup < 8; warmup += 1) {
    batch();
  }

  for (let sample = 0; sample < 31; sample += 1) {
    const start = monotonicNow();
    const checksum = batch();
    const elapsed = monotonicNow() - start;
    console.log(checksum);
    console.log(elapsed);
  }

  unwrap(pool.shutdown());
}
