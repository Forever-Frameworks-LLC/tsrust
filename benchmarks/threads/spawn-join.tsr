import { spawn, join } from 'std:threads';
import { monotonicNow } from 'std:time';

function batch(): int {
  let checksum = 0;
  for (let index = 0; index < 8; index += 1) {
    const input = index;
    match (spawn((): int => input * input)) {
      Ok(worker) => {
        match (join(worker)) {
          Ok(value) => {
            checksum += value;
          },
          Err(error) => {
            throw error.code;
          }
        }
      },
      Err(error) => {
        throw error.code;
      }
    }
  }

  return checksum;
}

function main() {
  for (let warmup = 0; warmup < 8; warmup += 1) {
    batch();
  }

  for (let sample = 0; sample < 31; sample += 1) {
    const start = monotonicNow();
    const checksum = batch();
    const elapsed = monotonicNow() - start;
    console.log(checksum);
    console.log(elapsed);
  }
}
