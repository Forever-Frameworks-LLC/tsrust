import { parseISO, formatISO, addDuration, durationFromMilliseconds, toUnixMilliseconds } from 'std:date';
import { monotonicNow } from 'std:time';

function batch(): int {
  const base = unwrap(parseISO('2024-01-01T00:00:00Z'));
  let checksum = 0;
  for (let i = 0; i < 256; i += 1) {
    const shifted = unwrap(addDuration(base, unwrap(durationFromMilliseconds(i))));
    const restored = unwrap(parseISO(formatISO(shifted)));
    checksum += unwrap(toUnixMilliseconds(restored)) - 1704067200000;
  }

  return checksum;
}

function main() {
  for (let warmup = 0; warmup < 8; warmup += 1) {
    batch();
  }

  for (let sample = 0; sample < 31; sample += 1) {
    const start = monotonicNow();
    const checksum = batch();
    const elapsed = monotonicNow() - start;
    console.log(checksum);
    console.log(elapsed);
  }
}
