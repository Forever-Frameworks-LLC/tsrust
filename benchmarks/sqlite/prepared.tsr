import { open, Connection } from 'std:sqlite';
import { monotonicNow } from 'std:time';

function batch(db: Mutable<Connection>): int {
  const tx = unwrap(db.begin());
  {
    const clear = unwrap(tx.prepare('DELETE FROM items'));
    unwrap(clear.execute());
    const insert = unwrap(tx.prepare('INSERT INTO items VALUES (?1, ?2)'));
    for (let index = 0; index < 128; index++) {
      unwrap(insert.execute([index, index * 2]));
    }
  }

  unwrap(tx.commit());
  const select = unwrap(db.prepare('SELECT sum(value) AS total FROM items'));
  const rows = unwrap(select.query());
  return unwrap(rows[0].int('total'));
}

function main(): void {
  const db = unwrap(open(':memory:'));
  {
    const create = unwrap(db.prepare('CREATE TABLE items(id INTEGER PRIMARY KEY, value INTEGER NOT NULL)'));
    unwrap(create.execute());
  }

  for (let warmup = 0; warmup < 8; warmup++) {
    batch(db);
  }

  for (let sample = 0; sample < 31; sample++) {
    const start = monotonicNow();
    const checksum = batch(db);
    const elapsed = monotonicNow() - start;
    console.log(checksum);
    console.log(elapsed);
  }

  unwrap(db.close());
}
