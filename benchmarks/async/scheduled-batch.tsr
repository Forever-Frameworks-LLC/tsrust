import { monotonicNow } from 'std:time';
import { allSettled, yield } from 'std:futures';

async function step(value: int): Task<int> {
  await yield();
  return value * 2 + 1;
}

async function batch(): Task<int> {
  let checksum = 0;
  for (let value = 0; value < 4096; value += 4) {
    const second = value + 1;
    const third = value + 2;
    const fourth = value + 3;
    const outcomes = await allSettled([step(value).start(), step(second).start(), step(third).start(), step(fourth).start(),]);
    for (const outcome of outcomes) {
      checksum += unwrap(clone(outcome));
    }
  }

  return checksum;
}

async function main(): Task<void> {
  for (let warmup = 0; warmup < 8; warmup++) {
    await batch();
  }

  for (let sample = 0; sample < 31; sample++) {
    const start = monotonicNow();
    const checksum = await batch();
    const elapsed = monotonicNow() - start;
    console.log(checksum);
    console.log(elapsed);
  }
}
