import { Router } from 'std:http';
import { listen, receive } from 'std:signals';

type Input = {
  id: int
};

type Output = {
  id: int;
  checksum: int;
  escaped: int
};

type Ready = {
  address: string
};

function render(id: int): Output {
  let checksum = 0;
  let escaped = 0;
  for (let y = 0; y < 64; y++) {
    for (let x = 0; x < 96; x++) {
      const cx = -2.0 + Number(x) * 3.0 / 96.0 + Number(id % 7) * 0.0001;
      const cy = -1.0 + Number(y) * 2.0 / 64.0 + Number(id % 11) * 0.0001;
      let zx = 0.0;
      let zy = 0.0;
      let iterations = 0;
      while (iterations < 256 && zx * zx + zy * zy <= 4.0) {
        const next = zx * zx - zy * zy + cx;
        zy = 2.0 * zx * zy + cy;
        zx = next;
        iterations++;
      }

      checksum = (checksum + iterations * (y * 96 + x + 1)) % 1000000007;
      if (iterations < 256) escaped++;
    }
  }

  return {
    id, checksum, escaped
  };
}

async function main(): Task<void> {
  const signals = unwrap(listen());
  const app = new Router();
  app.configure({
    bodyLimit: 65536, maxConnections: 64, maxRequests: 32, requestTimeoutMs: 5000, shutdownTimeoutMs: 5000, handshakeTimeoutMs: 3000, requestsPerSecond: 0
  });
  app.post('/render', async (c) => {
    let id = 0;
    try {
      const input = JSON.parse<Input>(await c.req.text());
      id = input.id;
      if (id < 1 || id > 128) return c.text('invalid', 400);
    } catch (error) {
      return c.text('invalid', 400);
    }

    return c.json(render(id));
  });
  const server = await app.listen('127.0.0.1:0');
  const ready: Ready = {
    address: server.address()
  };
  console.log(JSON.stringify(ready));
  try {
    await receive(signals);
  } finally {
    await server.shutdown();
  }
}
