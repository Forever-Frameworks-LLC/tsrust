import { Router, Context, ContextNext, Client, Response, text, request } from 'std:http';
import { monotonicNow } from 'std:time';

type Config = {
  body: string;
};

type Variables = {
  body: string;
};
async function handle(c: Mutable<Context<Config, Variables>>): Task<Response> {
  const body = c.get('body');
  if (body === undefined) {
    throw 'Missing request variable';
  }

  return c.text(clone(body));
}

async function headers(c: Mutable<Context<Config, Variables>>, next: ContextNext<Config>): Task<void> {
  c.header('x-before', 'entry');
  const body = clone(c.env.body);
  c.set('body', body);
  await next();
  c.header('x-after', 'exit');
}

function routes(config: Owned<Config>): Router<Config, Variables> {
  const app = new Router<Config, Variables>(config);
  app.use('/', headers);
  app.get('/', async (c, next) => {
    await next();
  }, (c) => handle(c));
  return app;
}

async function batch(client: ReadOnly<Client>, url: ReadOnly<string>): Task<int> {
  let sum = 0;
  for (let index = 0; index < 128; index++) {
    const response = await client.send(request('GET', url, ''));
    if (response.status() !== 200) {
      throw 'Unexpected status';
    }

    if (response.header('x-before') !== 'entry' || response.header('x-after') !== 'exit') {
      throw 'Middleware header mismatch';
    }

    const body = await response.text();
    if (body !== '42') {
      throw 'Unexpected body';
    }

    sum += 42;
  }

  return sum;
}

async function main(): Task<void> {
  const config: Config = {
    body: '42'
  };
  const app = routes(config);
  const server = await app.listen('127.0.0.1:0');
  const client = new Client();
  const url = 'http://' + server.address() + '/';
  for (let warmup = 0; warmup < 8; warmup++) {
    await batch(client, url);
  }

  for (let sample = 0; sample < 31; sample++) {
    const start = monotonicNow();
    const sum = await batch(client, url);
    console.log(sum);
    console.log(monotonicNow() - start);
  }

  await server.shutdown();
}
