{
  "name": "Tsrust",
  "scopeName": "source.tsrust",
  "patterns": [
    {
      "include": "#jsx"
    },
    {
      "name": "comment.line.double-slash.tsrust",
      "begin": "//",
      "end": "$"
    },
    {
      "name": "comment.block.tsrust",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.tsrust",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tsrust",
          "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    {
      "name": "string.quoted.single.tsrust",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.tsrust",
          "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    {
      "include": "#template"
    },
    {
      "name": "meta.import.tsrust",
      "begin": "\\bimport\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.import.tsrust"
        }
      },
      "end": "(?=;)",
      "patterns": [
        {
          "name": "keyword.control.import.tsrust",
          "match": "\\b(?:from|as)\\b"
        },
        {
          "include": "$self"
        }
      ]
    },
    {
      "name": "keyword.control.export.tsrust",
      "match": "\\bexport\\b"
    },
    {
      "name": "keyword.control.tsrust",
      "match": "\\b(?:await|if|else|while|do|for|of|in|return|break|continue|switch|match|case|default|try|catch|finally|throw)\\b"
    },
    {
      "name": "meta.binding.tsrust",
      "begin": "\\b(const|let)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.tsrust"
        }
      },
      "end": "(?=[=;)]|\\b(?:of|in)\\b)",
      "patterns": [
        {
          "include": "#annotation"
        }
      ]
    },
    {
      "name": "meta.type.alias.tsrust",
      "begin": "\\b(type)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.tsrust"
        },
        "2": {
          "name": "entity.name.type.tsrust"
        }
      },
      "end": "(?=;)",
      "patterns": [
        {
          "include": "#type"
        },
        {
          "name": "keyword.operator.tsrust",
          "match": "="
        }
      ]
    },
    {
      "name": "meta.function.signature.tsrust",
      "begin": "\\b(function)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.tsrust"
        },
        "2": {
          "name": "entity.name.function.tsrust"
        }
      },
      "end": "(?=\\{)",
      "patterns": [
        {
          "include": "#parameters"
        },
        {
          "begin": ":",
          "beginCaptures": {
            "0": {
              "name": "punctuation.separator.tsrust"
            }
          },
          "end": "(?=\\{|;)",
          "patterns": [
            {
              "include": "#type"
            }
          ]
        },
        {
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.tsrust"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.operator.tsrust"
            }
          },
          "patterns": [
            {
              "include": "#type"
            }
          ]
        }
      ]
    },
    {
      "name": "meta.interface.tsrust",
      "begin": "\\b(interface)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.tsrust"
        },
        "2": {
          "name": "entity.name.type.interface.tsrust"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#record"
        },
        {
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.tsrust"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.operator.tsrust"
            }
          },
          "patterns": [
            {
              "name": "entity.name.type.parameter.tsrust",
              "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b"
            }
          ]
        },
        {
          "name": "storage.modifier.tsrust",
          "match": "\\bextends\\b"
        },
        {
          "name": "entity.other.inherited-class.tsrust",
          "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b"
        },
        {
          "include": "$self"
        }
      ]
    },
    {
      "name": "keyword.control.async.tsrust",
      "match": "\\basync\\b"
    },
    {
      "name": "storage.type.tsrust",
      "match": "\\b(?:type|interface|enum|function|const|let|new)\\b"
    },
    {
      "name": "storage.modifier.tsrust",
      "match": "\\bextends\\b"
    },
    {
      "name": "support.type.builtin.tsrust",
      "match": "\\b(?:Task|Function|Mutable|ReadOnly|Once|Owned|Set|Map|Result)\\b(?=\\s*<)"
    },
    {
      "match": "(:\\s*)(void)\\b(?=\\s*(?:[,;)}]|=>|\\{))",
      "captures": {
        "1": {
          "name": "punctuation.separator.tsrust"
        },
        "2": {
          "name": "support.type.primitive.tsrust"
        }
      }
    },
    {
      "name": "keyword.operator.expression.tsrust",
      "match": "\\b(?:typeof|void|in|as|satisfies)\\b(?!\\s*[,;)}\\]])"
    },
    {
      "name": "support.type.primitive.tsrust",
      "match": "\\b(?:int|number|string|boolean|void)\\b"
    },
    {
      "name": "constant.language.tsrust",
      "match": "\\b(?:true|false|null|undefined)\\b|(?<![\\w.])(?:NaN|Infinity)\\b"
    },
    {
      "name": "constant.numeric.tsrust",
      "match": "(?<![\\w.])(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*|(?:\\d(?:_?\\d)*(?:\\.(?![a-df-zA-DF-Z_])(?:\\d(?:_?\\d)*)?)?|\\.\\d(?:_?\\d)*)(?:[eE][+-]?\\d(?:_?\\d)*)?)(?!\\w)"
    },
    {
      "name": "support.class.tsrust",
      "match": "\\b(?:Math|Number|console|Array|String|Boolean)\\b"
    },
    {
      "name": "support.function.tsrust",
      "match": "\\bclone\\b|(?<![\\w.])(?:Ok|Err)(?=\\s*(?:<|\\())|(?<![\\w.])(?:parseInt|parseFloat|isNaN|isFinite)(?=\\s*\\()"
    },
    {
      "name": "entity.name.function.tsrust",
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.tsrust",
      "match": "\\b(?:typeof|void|in|as|satisfies)\\b|>>>=|===|!==|>>>|&&=|\\|\\|=|<<=|>>=|\\*\\*=|=>|\\+\\+|--|&&|\\|\\||<<|>>|\\*\\*|[+*/%&|^!-]=?|[-=<>~]"
    },
    {
      "name": "punctuation.separator.tsrust",
      "match": "[;,:.]"
    },
    {
      "name": "punctuation.section.tsrust",
      "match": "[{}\\[\\]()]"
    }
  ],
  "repository": {
    "type": {
      "patterns": [
        {
          "name": "support.type.primitive.tsrust",
          "match": "\\b(?:int|number|string|boolean|void|never|unknown)\\b"
        },
        {
          "name": "constant.language.tsrust",
          "match": "\\b(?:null|undefined|true|false)\\b"
        },
        {
          "name": "support.type.builtin.tsrust",
          "match": "\\b(?:Task|Function|Mutable|ReadOnly|Once|Owned|Set|Map|Result)\\b"
        },
        {
          "include": "#record"
        },
        {
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.tsrust"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.operator.tsrust"
            }
          },
          "patterns": [
            {
              "include": "#type"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.tsrust"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.tsrust"
            }
          },
          "patterns": [
            {
              "include": "#annotation"
            },
            {
              "include": "#type"
            }
          ]
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.tsrust"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.tsrust"
            }
          },
          "patterns": [
            {
              "include": "#annotation"
            },
            {
              "include": "#type"
            }
          ]
        },
        {
          "name": "entity.name.type.tsrust",
          "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b"
        },
        {
          "name": "keyword.operator.tsrust",
          "match": "=>|[|&?]"
        },
        {
          "name": "punctuation.separator.tsrust",
          "match": "[,.:]"
        },
        {
          "name": "comment.line.double-slash.tsrust",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.tsrust",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "string.quoted.double.tsrust",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tsrust",
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.tsrust",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tsrust",
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
            }
          ]
        }
      ]
    },
    "annotation": {
      "begin": ":",
      "end": "(?=[,;)=}\\]])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.tsrust"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.separator.tsrust"
        }
      },
      "patterns": [
        {
          "include": "#type"
        }
      ],
      "name": "meta.type.annotation.tsrust"
    },
    "record": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.tsrust"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.tsrust"
        }
      },
      "patterns": [
        {
          "include": "#annotation"
        },
        {
          "name": "comment.line.double-slash.tsrust",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.tsrust",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "string.quoted.double.tsrust",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tsrust",
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.tsrust",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tsrust",
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
            }
          ]
        },
        {
          "name": "punctuation.separator.tsrust",
          "match": "[;,?]"
        }
      ],
      "name": "meta.type.record.tsrust"
    },
    "parameters": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.tsrust"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.tsrust"
        }
      },
      "patterns": [
        {
          "include": "#annotation"
        },
        {
          "include": "$self"
        }
      ],
      "name": "meta.parameters.tsrust"
    },
    "template": {
      "name": "string.template.tsrust",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tsrust"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tsrust"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tsrust",
          "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
        },
        {
          "name": "meta.embedded.line.tsrust",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.tsrust"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.tsrust"
            }
          },
          "patterns": [
            {
              "include": "#template-expression-braces"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "template-expression-braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.tsrust"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.tsrust"
        }
      },
      "patterns": [
        {
          "include": "#template-expression-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "jsx": {
      "begin": "(<)([A-Z][A-Za-z0-9_]*)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.tsrust"
        },
        "2": {
          "name": "entity.name.function.tsrust"
        }
      },
      "end": "(/>)|(</)(\\2)(>)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.tsrust"
        }
      },
      "patterns": [
        {
          "include": "#jsx"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.tsrust"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*=)",
          "name": "entity.other.attribute-name.tsrust"
        },
        {
          "match": ">",
          "name": "punctuation.definition.tag.end.tsrust"
        }
      ]
    }
  }
}
