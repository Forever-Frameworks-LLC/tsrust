import { readTextFile, writeTextFileAtomic, mkdirAll } from 'std:fs';
import { homeDir } from 'std:env';
import { join } from 'std:path';
import { fromUtf8, toHex } from 'std:bytes';
import { sha256 } from 'std:crypto';
import { Workspace, openFile } from './workspace.tsr';
import { dirty, edit } from './documents.tsr';

interface Draft {
  path: string;
  text: string;
  savedText: string;
  durabilityPending: boolean;
}

interface Journal {
  schemaVersion: int;
  root: string;
  drafts: Draft[];
}

export interface Recovery {
  path: string;
  baseline: string;
  ready: boolean;
}

export function recoveryPath(root: ReadOnly<string>): Result<string, string> {
  try {
    const home = unwrap(homeDir());
    if (home === undefined) return Err('The home directory is unavailable. Draft recovery is disabled.');
    const folder = join(home, '.tsrust', 'studio', 'recovery');
    unwrap(mkdirAll(folder));
    const hash = unwrap(toHex(sha256(unwrap(fromUtf8(root)))));
    return Ok(join(folder, hash + '.json'));
  } catch (error) {
    return Err(clone(error.message));
  }
}

// Validate the complete journal before changing any open buffers.
export function restoreRecovery(workspace: Mutable<Workspace>, path: string): Result<Recovery, string> {
  let baseline = '';
  match (readTextFile(path, 32 * 1024 * 1024)) {
    Ok(text) => {
      baseline = text;
    },
    Err(error) => {
      if (error.code === 'not-found') return Ok({
        path, baseline, ready: true
      });
      return Err(clone(error.message));
    }
  }

  try {
    const journal = JSON.parse<Journal>(baseline);
    if (journal.schemaVersion !== 1 || journal.root !== workspace.root) return Err('Draft recovery belongs to another workspace or version.');
    const next = clone(workspace);
    for (const draft of journal.drafts) {
      unwrap(openFile(next, draft.path));
      const index = next.files.findIndex((file) => file.document.path === draft.path);
      if (index < 0 || next.files[index].kind !== 'text') return Err('Invalid recovery document.');
      edit(next.files[index].document, clone(draft.text));
      next.files[index].document.savedText = clone(draft.savedText);
      next.files[index].document.durabilityPending = draft.durabilityPending;
    }

    workspace.files = next.files;
    workspace.active = next.active;
    return Ok({
      path, baseline, ready: true
    });
  } catch (_) {
    return Err('Draft recovery could not be read. Its file was preserved: ' + path);
  }
}

export function persistRecovery(workspace: ReadOnly<Workspace>, recovery: Mutable<Recovery>): Result<void, string> {
  if (!recovery.ready) return Err('Draft recovery is unavailable. Save your work before restarting.');
  const drafts: Draft[] = [];
  for (const file of workspace.files) {
    if (file.kind === 'text' && dirty(file.document)) drafts.push({
      path: clone(file.document.path), text: clone(file.document.text), savedText: clone(file.document.savedText), durabilityPending: file.document.durabilityPending
    });
  }

  const journal: Journal = {
    schemaVersion: 1, root: clone(workspace.root), drafts
  };
  const text = JSON.stringify(journal);
  if (text === recovery.baseline) return Ok();
  // shortcut: one Studio writer per workspace; coordinate first journal creation before supporting duplicate workspace windows.
  const expected = recovery.baseline === '' ? undefined : clone(recovery.baseline);
  match (writeTextFileAtomic(recovery.path, text, expected)) {
    Ok(_) => {
      recovery.baseline = text;
      return Ok();
    },
    Err(error) => {
      if (error.code === 'committed-not-durable') recovery.baseline = text;
      return Err(clone(error.message));
    }
  }
}
