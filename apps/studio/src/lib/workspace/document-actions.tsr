import { Signal } from 'std:ui';
import { Workspace } from './workspace.tsr';
import { edit } from './documents.tsr';
import { saveDocument } from './storage.tsr';
import { Recovery, persistRecovery } from './recovery.tsr';

// All document navigation and edits persist the same workspace snapshot.
export function publishWorkspace(next: Workspace, workspace: Signal<Workspace>, recovery: Signal<Recovery>): void {
  const journal = recovery.get();

  match (persistRecovery(next, journal)) {
    Ok(_) => {},
    Err(error) => {
      next.error += ' Draft recovery: ' + error;
    }
  }

  recovery.set(journal);
  workspace.set(next);
}

export function updateDraft(workspace: Signal<Workspace>, recovery: Signal<Recovery>, path: ReadOnly<string>, text: ReadOnly<string>): void {
  const next = workspace.get();
  const index = next.files.findIndex((file) => file.document.path === path);

  if (index < 0) return;
  edit(next.files[index].document, clone(text));
  next.error = '';
  publishWorkspace(next, workspace, recovery);
}

export function saveActive(workspace: Signal<Workspace>, recovery: Signal<Recovery>): void {
  const next = workspace.get();
  const index = next.files.findIndex((file) => file.document.path === next.active);

  if (index < 0 || next.files[index].kind !== 'text') return;
  next.error = '';

  match (saveDocument(next.files[index].document)) {
    Ok(_) => {},
    Err(error) => {
      next.error = 'Save failed: ' + error.message;
    }
  }

  publishWorkspace(next, workspace, recovery);
}
