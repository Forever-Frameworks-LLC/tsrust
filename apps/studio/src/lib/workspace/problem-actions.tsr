import { controlInput } from 'std:ui';
import { join } from 'std:path';
import { fromUtf8, length } from 'std:bytes';
import { SearchActionContext } from '../explorer/search-actions.tsr';
import { openFile } from './workspace.tsr';
import { publishWorkspace } from './document-actions.tsr';
import { problemOffset } from './problems.tsr';

export interface ProblemLocation {
  path: string;
  line: int;
  column: int;
}

export interface ProblemSelection {
  start: int;
  end: int;
}

// Location columns are Unicode scalars; native selection offsets are UTF-8 bytes.
export function problemSelection(text: ReadOnly<string>, line: int, column: int): ProblemSelection {
  const start = problemOffset(text, line, column);
  const lines = text.split('\n');
  const row = line > 0 && line <= lines.length ? line - 1 : 0;
  const tail = Array.from(lines[row]).slice(column > 0 ? column - 1 : 0).join('');
  return {
    start, end: start + length(unwrap(fromUtf8(tail)))
  };
}

export function openProblem(context: ReadOnly<SearchActionContext>, location: ReadOnly<ProblemLocation>): Result<void, string> {
  if (!context.allowNavigation) return Err('Problem navigation is not permitted by the host.');

  if (location.path === '' || location.path.length > 8192 || location.line < 1 || location.column < 1) return Err('Invalid problem location.');
  const next = context.workspace.get();
  const path = location.path.startsWith('/') ? clone(location.path) : join(next.root, location.path);

  match (openFile(next, path)) {
    Err(error) => {
      return Err(clone(error));
    },
    Ok(_) => {}
  }

  const index = next.files.findIndex((file) => file.document.path === next.active);

  if (index < 0 || next.files[index].kind !== 'text') return Err('Problem location is not a text document.');

  if (location.line > next.files[index].document.text.split('\n').length) return Err('Problem location is no longer present in this document.');
  const selected = problemSelection(next.files[index].document.text, location.line, location.column);
  const target = clone(next.active);
  publishWorkspace(next, context.workspace, context.recovery);

  if (context.focusEditor) {
    controlInput(clone(target), 'setSelection', {
      start: selected.start, end: selected.end
    });
    controlInput(target, 'focus');
  }

  return Ok();
}
