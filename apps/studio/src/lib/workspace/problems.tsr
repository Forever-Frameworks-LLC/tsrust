import { fromUtf8, length } from 'std:bytes';

import { Workspace } from './workspace.tsr';

export interface Problem {
  source: string;
  path: string;
  line: int;
  column: int;
  code: string;
  message: string;
  severity: string;
  terminal?: string;
  session?: string;
  revision?: int;
  unversioned?: boolean;
}

export function operationProblem(source: string, path: string, message: string): Problem {
  return {
    source: clone(source), path, line: 0, column: 0, code: source, message, severity: 'error'
  };
}

export function replaceProblems(current: ReadOnly<Problem[]>, source: ReadOnly<string>, next: Problem[], path: string | undefined = undefined): Problem[] {
  return current.filter((problem) => problem.source !== source || (path !== undefined && problem.path !== path)).concat(next);
}

// Compiler columns count Unicode scalars; CodeEditor selections use UTF-8 bytes.
export function problemOffset(text: ReadOnly<string>, line: int, column: int): int {
  const lines = text.split('\n');
  const target = line > 0 && line <= lines.length ? line - 1 : 0;
  let offset = 0;

  for (let index = 0; index < target; index += 1) offset += length(unwrap(fromUtf8(lines[index]))) + 1;
  const prefix = Array.from(lines[target]).slice(0, column > 0 ? column - 1 : 0).join('');
  return offset + length(unwrap(fromUtf8(prefix)));
}

export function formatProblems(problems: ReadOnly<Problem[]>): string {
  return problems.map((problem) => (problem.path === '' ? clone(problem.source) : problem.path + (problem.line > 0? ':' + problem.line.toString() + ':' + problem.column.toString(): '')) + ' [' + problem.source + '/' + problem.code + (problem.unversioned === true ? ', unversioned' : '') + '] ' + problem.message).join('\n');
}

export function collectProblems(workspace: ReadOnly<Workspace>, problems: ReadOnly<Problem[]>, terminalError: ReadOnly<string>): Problem[] {
  const result = clone(problems);
  const error = clone(workspace.error);

  if (error !== '' && !result.some((problem) => problem.message === error)) result.push(operationProblem('studio', '', error));
  const terminal = clone(terminalError);

  if (terminal !== '' && !result.some((problem) => problem.message === terminal)) result.push(operationProblem('terminal', '', terminal));

  for (const file of workspace.files) {
    if (file.document.saveConflict !== undefined && !result.some((problem) => problem.path === file.document.path && problem.source === 'save')) result.push(operationProblem('save', clone(file.document.path), 'This file changed on disk. Compare the versions before saving.'));
  }

  return result;
}
