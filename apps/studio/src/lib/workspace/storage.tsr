import { FsError, readTextFile, writeTextFileAtomic } from 'std:fs';
import { Document, SaveConflict, dirty, markSaved, edit } from './documents.tsr';

function writeDocument(document: Mutable<Document>, expected: ReadOnly<string>): Result<void, FsError> {
  const text = clone(document.text);

  match (writeTextFileAtomic(document.path, text, expected)) {
    Ok(_) => {
      markSaved(document, text, true);
      document.saveConflict = undefined;
      return Ok();
    },
    Err(error) => {
      if (error.code === 'conflict') {
        match (readTextFile(document.path, 16 * 1024 * 1024)) {
          Ok(diskText) => {
            document.saveConflict = {
              path: clone(document.path), session: clone(document.session), revision: document.revision, diskText: clone(diskText)
            };
          },
          Err(_) => {}
        }
      }

      if (error.code === 'committed-not-durable') markSaved(document, text, false);
      return Err(error);
    }
  }
}

export function saveDocument(document: Mutable<Document>): Result<void, FsError> {
  if (!dirty(document)) return Ok();
  const expected = clone(document.savedText);
  return writeDocument(document, expected);
}

// The host supplies destructive-effect grants; the model cannot approve itself.
export function resolveSaveConflict(document: Mutable<Document>, target: ReadOnly<SaveConflict>, action: ReadOnly<string>, allowDiscard: boolean, allowOverwrite: boolean): Result<void, string> {
  if (document.path !== target.path || document.session !== target.session || document.revision !== target.revision) return Err('The draft changed. Compare the current versions before resolving this conflict.');

  if (action === 'overwrite') {
    if (!allowOverwrite) return Err('Overwriting the file is not permitted by the host.');

    match (writeDocument(document, target.diskText)) {
      Ok(_) => {
        return Ok();
      },
      Err(error) => {
        return Err(error.code === 'conflict' ? 'The file changed again on disk. Compare the current versions before continuing.' : clone(error.message));
      }
    }
  }

  if (action !== 'reload') return Err('Unknown save conflict action.');

  if (!allowDiscard) return Err('Discarding the draft is not permitted by the host.');

  match (readTextFile(document.path, 16 * 1024 * 1024)) {
    Err(error) => {
      return Err(clone(error.message));
    },
    Ok(diskText) => {
      if (diskText !== target.diskText) return Err('The file changed again on disk. Compare the current versions before continuing.');
      edit(document, clone(diskText));
      markSaved(document, clone(diskText), true);
      document.saveConflict = undefined;
      return Ok();
    }
  }
}
