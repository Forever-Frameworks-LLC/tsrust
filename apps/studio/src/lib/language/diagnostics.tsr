import { fromUtf8, length } from 'std:bytes';
import { JsonRaw, JsonLimits } from 'std:json';
import { fileUrlToPath, parseUrl, pathToFileUrl } from 'std:url';

import { Problem } from '../workspace/problems.tsr';

export interface LanguageIdentity {
  server?: string;
  path: string;
  session: string;
  revision: int;
  version: int;
  verifiedDiagnostics?: boolean;
}

export interface LanguageDocument {
  server?: string;
  languageId?: string;
  path: string;
  session: string;
  revision: int;
  version: int;
  text: string;
}

export interface DiagnosticPosition {
  line: int;
  character: int;
}

export interface DiagnosticRange {
  start: DiagnosticPosition;
  end: DiagnosticPosition;
}

export interface LanguageDiagnostic {
  range: DiagnosticRange;
  severity?: int;
  code?: string;
  message: string;
}

export interface PublishedDiagnostics {
  uri: string;
  version?: int;
  diagnostics: LanguageDiagnostic[];
}

interface WireDiagnostic {
  range: DiagnosticRange;
  severity?: int;
  code?: JsonRaw;
  message: string;
}

interface WireDiagnostics {
  uri: string;
  version?: int;
  diagnostics: WireDiagnostic[];
}

interface DiagnosticNotification {
  params: WireDiagnostics;
}

export function publishedDiagnostics(body: ReadOnly<string>, limits: ReadOnly<JsonLimits>): PublishedDiagnostics {
  const notification = JSON.parse<DiagnosticNotification>(body, limits);
  const result: PublishedDiagnostics = {
    uri: clone(notification.params.uri), version: notification.params.version, diagnostics: []
  };

  for (const diagnostic of notification.params.diagnostics) {
    let code = '';

    if (diagnostic.code !== undefined) {
      const encoded = JSON.stringify(diagnostic.code);
      code = encoded.startsWith('"') ? JSON.parse<string>(encoded) : JSON.parse<int>(encoded).toString();
    }

    result.diagnostics.push({
      range: clone(diagnostic.range), severity: diagnostic.severity, code, message: clone(diagnostic.message)
    });
  }

  return result;
}

export function documentUri(path: ReadOnly<string>): string {
  const url = unwrap(pathToFileUrl(path));
  return String(url.href);
}

// LSP columns count UTF-16 units; Problems uses Unicode scalars.
export function diagnosticColumn(line: ReadOnly<string>, units: int): int {
  if (units < 0) throw 'Invalid diagnostic column.';
  let offset = 0;
  let column = 1;

  for (const glyph of Array.from(line)) {
    if (offset === units) return column;
    offset += length(unwrap(fromUtf8(glyph))) > 3 ? 2 : 1;
    column += 1;
  }

  if (offset !== units) throw 'Invalid diagnostic column.';
  return column;
}

export function diagnosticPath(uri: ReadOnly<string>): string {
  const url = unwrap(parseUrl(uri));
  return unwrap(fileUrlToPath(url));
}

function diagnosticSeverity(severity: int | undefined): string {
  return severity === 2 ? 'warning' : severity === 3 ? 'information' : severity === 4 ? 'hint' : 'error';
}

// A report without a version identifies its file, but none of its positions are trustworthy.
export function unversionedProblems(path: ReadOnly<string>, published: ReadOnly<PublishedDiagnostics>, source: ReadOnly<string>): Problem[] {
  return published.diagnostics.map((entry): Problem => ({
    source: clone(source), path: clone(path), line: 0, column: 0, code: clone(entry.code) ?? '', message: clone(entry.message), severity: diagnosticSeverity(entry.severity), unversioned: true
  }));
}

export function documentProblems(document: ReadOnly<LanguageDocument>, published: ReadOnly<PublishedDiagnostics>, source: string = 'lsp:tsrust'): Problem[] {
  const result: Problem[] = [];

  if (published.version !== document.version || diagnosticPath(published.uri) !== document.path) return result;
  const lines = document.text.split('\n');

  for (const diagnostic of published.diagnostics) {
    const start = diagnostic.range.start;

    if (start.line < 0 || start.line >= lines.length) continue;

    try {
      result.push({
        source: clone(source), path: clone(document.path), line: start.line + 1, column: diagnosticColumn(lines[start.line], start.character), code: diagnostic.code === undefined ? '' : diagnostic.code.toString(), message: clone(diagnostic.message), severity: diagnosticSeverity(diagnostic.severity)
      });
    } catch (_) {}
  }

  return result;
}

export function languageIdentity(document: ReadOnly<LanguageDocument>): LanguageIdentity {
  return {
    server: clone(document.server), path: clone(document.path), session: clone(document.session), revision: document.revision, version: document.version
  };
}
