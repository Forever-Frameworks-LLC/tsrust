import { ChatMessage } from './prompts.tsr';

export type ModelRequest = {
  kind: string;
  id: string;
  prompt: string;
  maxTokens: int;
  suffix?: string;
  modelPath?: string;
  tokenizerPath?: string;
  messages?: ChatMessage[];
  workspaceStart?: int;
  workspaceEnd?: int;
};

export type ModelUpdate = {
  kind: string;
  id: string;
  text: string;
  error: string;
  stop?: string;
};
