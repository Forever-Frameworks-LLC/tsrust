import { JsonLimits } from 'std:json';
import { ProposedEdit } from '../workspace/documents.tsr';

interface Replacement {
  before: string;
  after: string;
}

interface LocatedReplacement {
  start: int;
  end: int;
  after: string;
}

// The model supplies text only. Studio owns the target, revision and original buffer.
export function replacementProposal(snapshot: ReadOnly<ProposedEdit>, response: ReadOnly<string>): Result<ProposedEdit, string> {
  try {
    let body = response.trim();

    if (body.startsWith('```json\n') && body.endsWith('\n```')) body = body.slice(8, -4);
    const limits: JsonLimits = {
      maxBytes: body.length, maxDepth: 4, maxEntries: body.length, maxNodes: body.length
    };
    const changes = body.startsWith('[') ? JSON.parse<Replacement[]>(body, limits) : [JSON.parse<Replacement>(body, limits)];

    if (changes.length === 0) return Err('The model did not return a valid edit proposal.');
    const edits: LocatedReplacement[] = [];

    for (const change of changes) {
      const start = snapshot.before.indexOf(change.before);

      if ((change.before === '' && snapshot.before !== '') || change.before === change.after || start < 0 || snapshot.before.lastIndexOf(change.before) !== start) return Err('The proposed change did not match one unique passage in the original file.');
      edits.push({
        start, end: start + change.before.length, after: clone(change.after)
      });
    }

    edits.sort((a, b) => a.start - b.start);
    const parts: string[] = [];
    let end = 0;
    let previous = -1;

    for (const item of edits) {
      if (item.start < end || item.start === previous) return Err('The proposed changes overlap in the original file.');
      parts.push(snapshot.before.slice(end, item.start));
      parts.push(clone(item.after));
      previous = item.start;
      end = item.end;
    }

    parts.push(snapshot.before.slice(end));
    const result = clone(snapshot);
    result.after = parts.join('');
    return Ok(result);
  } catch (_) {
    return Err('The model did not return a valid edit proposal.');
  }
}
