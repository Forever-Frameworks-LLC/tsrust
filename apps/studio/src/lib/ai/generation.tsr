import { AiMessage, messageContent } from './conversations.tsr';
import { ChatMessage } from './prompts.tsr';
import { ModelRequest } from './protocol.tsr';

// Replace only the newest edit turn and exclude incomplete exchanges.
export function fitGeneration(request: Mutable<ModelRequest>, history: ReadOnly<AiMessage[]>, includeWorkspace: boolean, editPrompt?: string): Result<boolean, string> {
  const messages: ChatMessage[] = [];
  const seen = new Set<string>();
  const lastUser = history.findLastIndex((entry) => entry.role === 'user' && entry.status !== 'rejected');

  for (let index = history.length - 1; index >= 0; index -= 1) {
    const entry = history[index];

    if (entry.text === '' || entry.status === 'rejected' || (entry.role === 'user' && entry.status !== undefined && entry.status !== 'complete')) continue;

    const excerpt = entry.workspaceExcerpt ?? '';
    const editing = editPrompt !== undefined && index === lastUser;
    const content = editing && editPrompt !== undefined ? clone(editPrompt) : messageContent(entry, includeWorkspace && !seen.has(excerpt));

    if (includeWorkspace && excerpt !== '' && !editing) seen.add(clone(excerpt));
    messages.push({
      role: clone(entry.role), content
    });
  }

  messages.reverse();
  const first = messages.findIndex((message) => message.role === 'user');

  if (first < 0) return Err('A user message is required.');
  request.messages = first === 0 ? messages : messages.slice(first);
  return Ok(false);
}
