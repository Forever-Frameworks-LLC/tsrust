import { Signal, controlInput } from 'std:ui';
import { fromUtf8, length, view, toUtf8 } from 'std:bytes';
import { Workspace, openFile } from '../workspace/workspace.tsr';
import { Recovery } from '../workspace/recovery.tsr';
import { publishWorkspace } from '../workspace/document-actions.tsr';
import { SearchHit, SearchResults, searchContents } from './search.tsr';

// Created by the host, never decoded from a tool's arguments.
export interface SearchActionContext {
  workspace: Signal<Workspace>;
  recovery: Signal<Recovery>;
  allowNavigation: boolean;
  focusEditor: boolean;
}

export function runContentSearch(context: ReadOnly<SearchActionContext>, query: string, regex: boolean, caseSensitive: boolean): Result<SearchResults, string> {
  return searchContents(context.workspace.get(), query, regex, caseSensitive);
}

function validateSearchHit(workspace: ReadOnly<Workspace>, hit: ReadOnly<SearchHit>): Result<void, string> {
  const file = workspace.files.find((entry) => entry.document.path === hit.path);

  if (file === undefined || file.kind !== 'text' || hit.matches.length === 0) return Err('This search result is no longer current. Run the search again.');

  try {
    const bytes = unwrap(fromUtf8(file.document.text));
    const count = length(bytes);

    if (hit.line < 1 || hit.offset < 0 || hit.offset > count || hit.preview.length > count - hit.offset) return Err('Invalid search result range.');
    const line = unwrap(toUtf8(unwrap(view(bytes, hit.offset, hit.offset + hit.preview.length))));

    if (line !== hit.preview) return Err('This search result is no longer current. Run the search again.');
    const first = hit.matches[0];

    if (first.start < 0 || first.end < first.start || first.end > hit.preview.length) return Err('Invalid search result range.');
    unwrap(toUtf8(unwrap(view(bytes, hit.offset + first.start, hit.offset + first.end))));
    return Ok();
  } catch (_) {
    return Err('This search result is no longer current. Run the search again.');
  }
}

export function openSearchResult(context: ReadOnly<SearchActionContext>, hit: ReadOnly<SearchHit>): Result<void, string> {
  if (!context.allowNavigation) return Err('Search result navigation is not permitted for this task.');
  const next = context.workspace.get();

  match (openFile(next, hit.path)) {
    Ok(_) => {},
    Err(error) => {
      return Err(clone(error));
    }
  }

  match (validateSearchHit(next, hit)) {
    Ok(_) => {},
    Err(error) => {
      return Err(clone(error));
    }
  }

  publishWorkspace(next, context.workspace, context.recovery);

  if (context.focusEditor) {
    controlInput(clone(hit.path), 'setSelection', {
      start: hit.offset + hit.matches[0].start, end: hit.offset + hit.matches[0].end
    });
    controlInput(clone(hit.path), 'focus');
  }

  return Ok();
}
