import { readTextFile, writeTextFileAtomic, mkdirAll } from 'std:fs';
import { homeDir } from 'std:env';
import { join } from 'std:path';
import themeNames from './themes/names.json';
import localeNames from './locales/names.json';

export function themes(): string[] {
  return clone(themeNames);
}

export interface StudioConfig {
  schemaVersion: int;
  theme: string;
  fontSize: int;
  navigationSide: string;
  activityBarSide: string;
  panelPosition: string;
  chatPosition: string;
  locale: string;
  fileIcons: boolean;
}

// Existing version-one files may omit layout fields; resolve them before use.
interface StoredConfig {
  schemaVersion: int;
  theme: string;
  fontSize: int;
  navigationSide?: string;
  activityBarSide?: string;
  panelPosition?: string;
  chatPosition?: string;
  locale?: string;
  fileIcons?: boolean;
}

export function defaultConfig(): StudioConfig {
  return {
    schemaVersion: 1, theme: 'Studio Dark', fontSize: 14, navigationSide: 'left', activityBarSide: 'left', panelPosition: 'bottom', chatPosition: 'right', locale: 'en', fileIcons: true
  };
}

export function parseConfig(text: ReadOnly<string>): Result<StudioConfig, string> {
  try {
    const config = JSON.parse<StoredConfig>(text);
    if (config.schemaVersion !== 1) return Err('Unsupported Studio settings version.');
    if (config.fontSize < 8 || config.fontSize > 48) return Err('fontSize must be between 8 and 48.');
    if (!themeNames.includes(config.theme)) return Err('Choose a theme from the installed Studio catalog.');
    const resolved: StudioConfig = {
      schemaVersion: config.schemaVersion, theme: config.theme, fontSize: config.fontSize, navigationSide: config.navigationSide ?? 'left', activityBarSide: config.activityBarSide ?? 'left', panelPosition: config.panelPosition ?? 'bottom', chatPosition: config.chatPosition ?? 'right', locale: config.locale ?? 'en', fileIcons: config.fileIcons ?? true
    };
    if (!['left', 'right'].includes(resolved.navigationSide)) return Err('navigationSide must be left or right.');
    if (!['left', 'right'].includes(resolved.activityBarSide)) return Err('activityBarSide must be left or right.');
    if (!['left', 'right', 'bottom'].includes(resolved.panelPosition)) return Err('panelPosition must be left, right or bottom.');
    if (!['left', 'right', 'bottom'].includes(resolved.chatPosition)) return Err('chatPosition must be left, right or bottom.');
    if (!localeNames.includes(resolved.locale)) return Err('locale must be en or pt-BR.');
    return Ok(resolved);
  } catch (error) {
    return Err('Settings must contain schemaVersion, theme and an integer fontSize.');
  }
}

export function configPath(): Result<string, string> {
  match (homeDir()) {
    Err(error) => {
      return Err(clone(error.message));
    },
    Ok(home) => {
      if (home === undefined) return Err('The home directory is unavailable.');
      const folder = join(home, '.tsrust', 'studio');
      match (mkdirAll(folder)) {
        Err(error) => {
          return Err(clone(error.message));
        },
        Ok(_) => {
          return Ok(join(folder, 'tsrust_studio.config.json'));
        }
      }
    }
  }
}

export function loadConfig(path: ReadOnly<string>): Result<StudioConfig, string> {
  match (readTextFile(path, 1024 * 1024)) {
    Ok(text) => {
      return parseConfig(text);
    },
    Err(error) => {
      if (error.code === 'not-found') return Ok(defaultConfig());
      return Err(clone(error.message));
    }
  }
}

export function saveConfig(path: ReadOnly<string>, text: ReadOnly<string>, expected?: string): Result<StudioConfig, string> {
  match (parseConfig(text)) {
    Err(error) => {
      return Err(error);
    },
    Ok(config) => {
      match (writeTextFileAtomic(path, text, expected)) {
        Err(error) => {
          return Err(clone(error.message));
        },
        Ok(_) => {
          return Ok(config);
        }
      }
    }
  }
}


export function formatConfig(config: ReadOnly<StudioConfig>): string {
  return '{\n' + ['  "schemaVersion": ' + config.schemaVersion.toString(), '  "theme": ' + JSON.stringify(config.theme), '  "fontSize": ' + config.fontSize.toString(), '  "locale": ' + JSON.stringify(config.locale), '  "navigationSide": ' + JSON.stringify(config.navigationSide), '  "activityBarSide": ' + JSON.stringify(config.activityBarSide), '  "panelPosition": ' + JSON.stringify(config.panelPosition), '  "chatPosition": ' + JSON.stringify(config.chatPosition), '  "fileIcons": ' + JSON.stringify(config.fileIcons)].join(',\n') + '\n}\n';
}
