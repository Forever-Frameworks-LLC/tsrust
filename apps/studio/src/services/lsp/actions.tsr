import { Sender } from 'std:futures';
import { parse, get, kind, stringify, at } from 'std:json';
import { Signal, completionText } from 'std:ui';

import { DiagnosticPosition } from '../../lib/language/diagnostics.tsr';
import { propose } from '../../lib/workspace/documents.tsr';
import { Problem } from '../../lib/workspace/problems.tsr';
import { Workspace } from '../../lib/workspace/workspace.tsr';
import { EditorTool } from '../editor-tools.tsr';
import { LanguageState, LanguageConnection, queueLanguageRead, cancelLanguageRead, connectionFor } from './controller.tsr';
import { LanguageMessage } from './session.tsr';
import { languageSettingsTools, invokeLanguageSettingsTool } from './settings-tools.tsr';

export function restartLanguageService(requests: ReadOnly<Sender<LanguageMessage>>, generation: int, server: string = 'tsrust'): Result<void, string> {
  return sendLanguageControl(requests, generation, server, 'restart');
}

function sendLanguageControl(requests: ReadOnly<Sender<LanguageMessage>>, generation: int, server: ReadOnly<string>, action: ReadOnly<string>): Result<void, string> {
  match (requests.trySend({
    server: clone(server), kind: action === 'restart' && generation === 0 && server !== 'tsrust' ? 'start' : clone(action), generation
  })) {
    Ok(_) => {
      return Ok();
    },
    Err(error) => {
      return Err('Could not queue language service control: ' + error.code);
    }
  }
}

export function requestLanguageRestart(state: Mutable<LanguageState>, requests: ReadOnly<Sender<LanguageMessage>>, server: string, generation: int): Result<void, string> {
  return requestLanguageControl(state, requests, server, generation, 'restart');
}

export function languageControlAvailable(connection: ReadOnly<LanguageConnection>, action: ReadOnly<string>): boolean {
  if (connection.transitioning === true) return false;

  if (action === 'start') return !connection.requested || connection.status === 'LSP: stopped' || connection.status === 'LSP: failed';

  if (action === 'stop') return connection.generation > 0 && connection.requested && connection.status !== 'LSP: stopped' && connection.status !== 'LSP: failed';

  if (action === 'restart') return connection.generation > 0 || !connection.requested;
  return false;
}

export function requestLanguageControl(state: Mutable<LanguageState>, requests: ReadOnly<Sender<LanguageMessage>>, server: string, generation: int, action: string): Result<void, string> {
  const index = state.connections.findIndex((entry) => entry.server === server);

  if (index < 0) return Err('No matching language server is registered.');

  if (state.connections[index].generation !== generation) return Err('Language-service connection changed.');

  if (!languageControlAvailable(state.connections[index], action)) return Err('Language-service action is unavailable in its current state.');

  match (sendLanguageControl(requests, generation, server, action)) {
    Err(error) => {
      return Err(clone(error));
    },
    Ok(_) => {}
  }

  state.connections[index].ready = false;
  state.connections[index].requested = true;
  state.connections[index].transitioning = true;
  state.connections[index].status = action === 'stop' ? 'LSP: stopping' : action === 'start' ? 'LSP: starting' : 'LSP: restarting';
  return Ok();
}

export interface LanguageToolContext {
  settingsPath?: string;
  allowSettingsRead?: boolean;
  allowSettingsProposal?: boolean;
  server?: string;
  root: string;
  generation: int;
  status: string;
  problems: Problem[];
  allowRead: boolean;
  allowRestart: boolean;
  allowControl?: boolean;
}

interface LanguageArguments {
  server?: string;
  root: string;
  generation?: int;
}

export function languageTools(): EditorTool[] {
  return [{
    name: 'language_service_status', description: 'Read the current workspace language-service status and source-labelled LSP diagnostics without changing focus or files. The trusted host must grant read access.', inputSchema: '{"type":"object","properties":{"root":{"type":"string"}},"required":["root"]}'
  }, {
    name: 'restart_language_service', description: 'Restart the existing workspace language server through the same action as the status menu. Requires a trusted host process-control grant and matching connection generation; cannot select an executable or change files.', inputSchema: '{"type":"object","properties":{"root":{"type":"string"},"server":{"type":"string"},"generation":{"type":"integer","minimum":0}},"required":["root","generation"]}'
  }, {
    name: 'start_language_service', description: 'Start a registered stopped, failed or idle language server through the same guarded action as its submenu. Requires trusted host allowControl, explicit server and current generation. Cannot select an executable or change files.', inputSchema: '{"type":"object","properties":{"root":{"type":"string"},"server":{"type":"string"},"generation":{"type":"integer","minimum":0}},"required":["root","server","generation"]}'
  }, {
    name: 'stop_language_service', description: 'Stop only the explicit registered language server and cancel its pending reads. It stays stopped while files remain open. Requires trusted host allowControl and current generation; does not edit or save files.', inputSchema: '{"type":"object","properties":{"root":{"type":"string"},"server":{"type":"string"},"generation":{"type":"integer","minimum":0}},"required":["root","server","generation"]}'
  }, ...languageReadTools(), ...languageSettingsTools()];
}

export function invokeLanguageTool(
  context: ReadOnly<LanguageToolContext>,
  requests: ReadOnly<Sender<LanguageMessage>>,
  name: ReadOnly<string>,
  payload: ReadOnly<string>,
  workspace: Signal<Workspace> | undefined = undefined,
  state: Signal<LanguageState> | undefined = undefined
): Result<string, string> {
  if (languageSettingsTools().some((tool) => tool.name === name)) {
    if (workspace !== undefined && workspace.get().root !== context.root) return Err('Language-service workspace changed.');
    return invokeLanguageSettingsTool({
      root: clone(context.root), settingsPath: clone(context.settingsPath), allowSettingsRead: context.allowSettingsRead, allowSettingsProposal: context.allowSettingsProposal
    }, name, payload);
  }

  if (languageReadTools().some((tool) => tool.name === name)) {
    if (workspace === undefined || state === undefined) return Err('Document language reads are unavailable in this host context.');
    return invokeLanguageRead(
      context,
      workspace,
      state,
      requests,
      name,
      payload
    );
  }

  if (name !== 'language_service_status' && name !== 'restart_language_service' && name !== 'start_language_service' && name !== 'stop_language_service') return Err('Unknown language-service action.');

  if (!languageTools().some((tool) => tool.name === name)) return Err('Unknown language-service action.');

  if (payload.length > 4096) return Err('Invalid language-service arguments.');

  try {
    const args = JSON.parse<LanguageArguments>(payload, {
      maxBytes: 4096, maxDepth: 4, maxEntries: 8, maxNodes: 16
    });

    if (args.root !== context.root) return Err('Language-service workspace changed.');

    if (workspace !== undefined && workspace.get().root !== args.root) return Err('Language-service workspace changed.');

    const server = clone(args.server) ?? clone(context.server) ?? 'tsrust';

    if (name === 'language_service_status') {
      if (!context.allowRead) return Err('Language-service read access is not permitted by the host.');

      if (state !== undefined) return Ok(JSON.stringify({
        connections: state.get().connections, problems: context.problems.filter((problem) => problem.source.startsWith('lsp:'))
      }));
      return Ok(JSON.stringify({
        server: clone(server), generation: context.generation, status: clone(context.status), problems: context.problems.filter((problem) => problem.source === 'lsp:' + server)
      }));
    }

    const action = name === 'start_language_service' ? 'start' : name === 'stop_language_service' ? 'stop' : 'restart';

    if (action === 'restart' ? !context.allowRestart && context.allowControl !== true : context.allowControl !== true) return Err('Language-service control is not permitted by the host.');

    if (action !== 'restart' && (state === undefined || args.server === undefined)) return Err('Language-service control requires explicit server state.');

    let generation = context.generation;

    if (state !== undefined) {
      const connection = connectionFor(state.get(), server);

      if (connection === undefined) return Err('No matching language server is registered.');
      generation = connection.generation;
    } else if (server !== (context.server ?? 'tsrust')) return Err('No matching language server is registered.');

    if (args.generation !== generation) return Err('Language-service connection changed.');

    if (state !== undefined) {
      const next = state.get();
      unwrap(requestLanguageControl(next, requests, server, generation, action));
      state.set(next);
    } else unwrap(restartLanguageService(requests, generation, server));
    return Ok('{"queued":true}');
  } catch (error) {
    return Err(JSON.stringify(error));
  }
}

interface LanguageReadArguments {
  root: string;
  id: string;
  path: string;
  session: string;
  revision: int;
  position?: DiagnosticPosition;
  includeDeclaration?: boolean;
  itemIndex?: int;
  start?: int;
  end?: int;
}

export function languageReadTools(): EditorTool[] {
  const schema = '{"type":"object","properties":{"root":{"type":"string"},"id":{"type":"string"},"path":{"type":"string"},"session":{"type":"string"},"revision":{"type":"integer"},"itemIndex":{"type":"integer","minimum":0},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0},"includeDeclaration":{"type":"boolean"},"position":{"type":"object","properties":{"line":{"type":"integer","minimum":0},"character":{"type":"integer","minimum":0}},"required":["line","character"]}},"required":["root","id","path","session","revision"]}';
  const readSchema = schema.slice(0, schema.length - 2) + ',"position"]}';
  const proposalSchema = schema.slice(0, schema.length - 2) + ',"itemIndex","start","end"]}';
  return [{
    name: 'language_hover', description: 'Queue a read-only LSP hover for an explicit current document and zero-based UTF-16 position. Requires host read permission. Does not focus, edit or save. Use language_read_result to receive it or language_cancel_read to cancel.', inputSchema: clone(readSchema)
  }, {
    name: 'language_completion', description: 'Queue current LSP completion candidates without inserting them. Requires an explicit document identity, zero-based UTF-16 position and host read grant. Returned edits are proposals only; this action cannot apply them.', inputSchema: clone(readSchema)
  }, {
    name: 'language_file_references', description: 'Queue direct Tsrust import references to an explicit open file through the Tsrust server. Scans workspace Tsrust sources using compiler import resolution, ignores generated/ignored files except open buffers, and reports scan issues. No cursor position required. Requires host read grant. Use language_read_result/cancel; UI presentation requires a separate navigation grant.', inputSchema: clone(schema)
  }, {
    name: 'language_references', description: 'Queue all LSP reference locations for an explicit current document and UTF-16 position. includeDeclaration defaults to true. Requires host read permission. Read with language_read_result; presenting or opening results requires a separate navigation grant. Does not change focus or files.', inputSchema: clone(readSchema)
  }, {
    name: 'language_definition', description: 'Queue LSP definition locations for an explicit current document and UTF-16 position. Requires host read permission. Read with language_read_result; opening a returned location requires a separate navigation grant. Does not change focus or files.', inputSchema: clone(readSchema)
  }, {
    name: 'language_signature_help', description: 'Queue read-only call signatures and active-parameter documentation for an explicit current document and zero-based UTF-16 position. Requires host read permission. Use language_read_result or language_cancel_read; never changes editor focus or files.', inputSchema: clone(readSchema)
  }, {
    name: 'language_completion_proposal', description: 'Read a completed language_completion request and prepare one candidate plus all same-document import/additional edits as an isolated ProposedEdit. itemIndex selects the zero-based candidate; start/end give fallback UTF-8 byte offsets. Poll this action until ready=true before consuming language_read_result. Requires the same explicit document identity and host read grant; rejects stale results and invalid/overlapping edits. Does not apply, focus or save. Proposal acceptance uses normal review/conflict checks.', inputSchema: proposalSchema
  }, {
    name: 'language_read_result', description: 'Consume a completed language read for the same explicit document identity; returns ready=false while pending. Rejects changed documents and other targets.', inputSchema: clone(schema)
  }, {
    name: 'language_cancel_read', description: 'Cancel the matching scoped language read and release its result without editing or changing editor focus.', inputSchema: schema
  }];
}

export function invokeLanguageRead(
  context: ReadOnly<LanguageToolContext>,
  workspace: Signal<Workspace>,
  state: Signal<LanguageState>,
  requests: ReadOnly<Sender<LanguageMessage>>,
  name: ReadOnly<string>,
  payload: ReadOnly<string>
): Result<string, string> {
  if (!context.allowRead) return Err('Language-service read access is not permitted by the host.');

  if (!languageReadTools().some((tool) => tool.name === name)) return Err('Unknown document language action.');

  try {
    const args = JSON.parse<LanguageReadArguments>(payload, {
      maxBytes: 8192, maxDepth: 8, maxEntries: 32, maxNodes: 64
    });
    const current = workspace.get();

    if (args.root !== context.root || args.root !== current.root) return Err('Language-service workspace changed.');

    if (args.id.length === 0 || args.id.length > 128) return Err('Invalid language read identity.');

    if (!current.files.some((file) => file.document.path === args.path && file.document.session === args.session && file.document.revision === args.revision)) return Err('Language document changed.');
    const id = 'agent:' + args.id;
    const next = state.get();

    if (name === 'language_hover' || name === 'language_completion' || name === 'language_signature_help' || name === 'language_definition' || name === 'language_references' || name === 'language_file_references') {
      const position = name === 'language_file_references' ? {
        line: 0, character: 0
      }

      : args.position;

      if (position === undefined) return Err('A UTF-16 language position is required.');
      unwrap(queueLanguageRead(
        current,
        next,
        requests,
        clone(id),
        {
          path: clone(args.path), session: clone(args.session), revision: args.revision, method: name === 'language_file_references' ? 'tsrust/fileReferences' : name === 'language_hover' ? 'textDocument/hover' : name === 'language_completion' ? 'textDocument/completion' : name === 'language_definition' ? 'textDocument/definition' : name === 'language_references' ? 'textDocument/references' : 'textDocument/signatureHelp', position: clone(position), includeDeclaration: args.includeDeclaration
        },
        undefined
      ));
      state.set(next);
      return Ok('{"queued":true}');
    }

    const pendingIndex = next.queries.findIndex((query) => query.id === id && query.document.path === args.path && query.document.session === args.session && query.document.revision === args.revision);
    const resultIndex = next.readResults.findIndex((result) => result.query.id === id && result.query.document.path === args.path && result.query.document.session === args.session && result.query.document.revision === args.revision);

    if (pendingIndex < 0 && resultIndex < 0) return Err('No matching language read.');

    if (name === 'language_cancel_read') {
      unwrap(cancelLanguageRead(next, requests, id));
      state.set(next);
      return Ok('{"cancelled":true}');
    }

    if (resultIndex < 0) return Ok('{"ready":false}');

    if (name === 'language_completion_proposal') {
      const completed = next.readResults[resultIndex];

      if (completed.query.method !== 'textDocument/completion') return Err('This request is not a completion read.');

      if (completed.error !== '') return Err(clone(completed.error));
      const start = args.start;
      const end = args.end;
      const itemIndex = args.itemIndex;

      if (start === undefined || end === undefined || itemIndex === undefined || start < 0 || end < start || itemIndex < 0) return Err('A candidate index and fallback byte range are required.');
      const item = completionItem(completed.result, itemIndex);
      const file = current.files.find((file) => file.document.path === args.path && file.document.session === args.session && file.document.revision === args.revision);

      if (file === undefined) return Err('Language document changed.');
      const after = unwrap(completionText(file.document.text, item, start, end));
      return Ok(JSON.stringify({
        ready: true, proposal: propose(file.document, after)
      }));
    }

    const answer = JSON.stringify({
      ready: true, result: clone(next.readResults[resultIndex].result), error: clone(next.readResults[resultIndex].error)
    });
    next.readResults = next.readResults.filter((entry) => entry.query.id !== id);
    state.set(next);
    return Ok(answer);
  } catch (error) {
    return Err(JSON.stringify(error));
  }
}

function completionItem(payload: ReadOnly<string>, index: int): string {
  const value = unwrap(parse(payload, {
    maxBytes: 16 * 1024 * 1024, maxDepth: 64, maxEntries: 100000, maxNodes: 500000
  }));

  if (kind(value) === 'array') {
    const item = unwrap(at(value, index));

    if (item === undefined) throw 'Completion candidate is unavailable.';
    return unwrap(stringify(item, 16 * 1024 * 1024));
  }

  const items = unwrap(get(value, 'items'));

  if (items === undefined) throw 'Completion response has no candidates.';
  const item = unwrap(at(items, index));

  if (item === undefined) throw 'Completion candidate is unavailable.';
  return unwrap(stringify(item, 16 * 1024 * 1024));
}
