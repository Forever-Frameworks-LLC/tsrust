import { Sender } from 'std:futures';
import { Signal } from 'std:ui';

import { Problem } from '../../lib/workspace/problems.tsr';
import { EditorTool } from '../editor-tools.tsr';
import { Workspace } from '../../lib/workspace/workspace.tsr';
import { DiagnosticPosition } from '../../lib/language/diagnostics.tsr';
import { LanguageState, queueLanguageRead, cancelLanguageRead, connectionFor } from './controller.tsr';
import { LanguageMessage } from './session.tsr';
import { languageSettingsTools, invokeLanguageSettingsTool } from './settings-tools.tsr';

export function restartLanguageService(requests: ReadOnly<Sender<LanguageMessage>>, generation: int, server: string = 'tsrust'): Result<void, string> {
  match (requests.trySend({
    server: clone(server), kind: generation === 0 && server !== 'tsrust' ? 'start' : 'restart', generation
  })) {
    Ok(_) => {
      return Ok();
    },
    Err(error) => {
      return Err('Could not queue language service restart: ' + error.code);
    }
  }
}

export function requestLanguageRestart(state: Mutable<LanguageState>, requests: ReadOnly<Sender<LanguageMessage>>, server: string, generation: int): Result<void, string> {
  const index = state.connections.findIndex((entry) => entry.server === server);

  if (index < 0) return Err('No matching language server is registered.');

  if (state.connections[index].generation !== generation) return Err('Language-service connection changed.');

  match (restartLanguageService(requests, generation, server)) {
    Err(error) => {
      return Err(clone(error));
    },
    Ok(_) => {}
  }

  state.connections[index].ready = false;
  state.connections[index].requested = true;
  state.connections[index].status = 'LSP: restarting';
  return Ok();
}

export interface LanguageToolContext {
  settingsPath?: string;
  allowSettingsRead?: boolean;
  allowSettingsProposal?: boolean;
  server?: string;
  root: string;
  generation: int;
  status: string;
  problems: Problem[];
  allowRead: boolean;
  allowRestart: boolean;
}

interface LanguageArguments {
  server?: string;
  root: string;
  generation?: int;
}

export function languageTools(): EditorTool[] {
  return [{
    name: 'language_service_status', description: 'Read the current workspace language-service status and source-labelled LSP diagnostics without changing focus or files. The trusted host must grant read access.', inputSchema: '{"type":"object","properties":{"root":{"type":"string"}},"required":["root"]}'
  }, {
    name: 'restart_language_service', description: 'Restart the existing workspace language server through the same action as the status menu. Requires a trusted host process-control grant and matching connection generation; cannot select an executable or change files.', inputSchema: '{"type":"object","properties":{"root":{"type":"string"},"server":{"type":"string"},"generation":{"type":"integer","minimum":0}},"required":["root","generation"]}'
  }, ...languageReadTools(), ...languageSettingsTools()];
}

export function invokeLanguageTool(
  context: ReadOnly<LanguageToolContext>,
  requests: ReadOnly<Sender<LanguageMessage>>,
  name: ReadOnly<string>,
  payload: ReadOnly<string>,
  workspace: Signal<Workspace> | undefined = undefined,
  state: Signal<LanguageState> | undefined = undefined
): Result<string, string> {
  if (languageSettingsTools().some((tool) => tool.name === name)) {
    if (workspace !== undefined && workspace.get().root !== context.root) return Err('Language-service workspace changed.');
    return invokeLanguageSettingsTool({
      root: clone(context.root), settingsPath: clone(context.settingsPath), allowSettingsRead: context.allowSettingsRead, allowSettingsProposal: context.allowSettingsProposal
    }, name, payload);
  }

  if (languageReadTools().some((tool) => tool.name === name)) {
    if (workspace === undefined || state === undefined) return Err('Document language reads are unavailable in this host context.');
    return invokeLanguageRead(
      context,
      workspace,
      state,
      requests,
      name,
      payload
    );
  }

  if (name !== 'language_service_status' && name !== 'restart_language_service') return Err('Unknown language-service action.');

  if (!languageTools().some((tool) => tool.name === name)) return Err('Unknown language-service action.');

  if (payload.length > 4096) return Err('Invalid language-service arguments.');

  try {
    const args = JSON.parse<LanguageArguments>(payload, {
      maxBytes: 4096, maxDepth: 4, maxEntries: 8, maxNodes: 16
    });

    if (args.root !== context.root) return Err('Language-service workspace changed.');

    if (workspace !== undefined && workspace.get().root !== args.root) return Err('Language-service workspace changed.');

    const server = clone(args.server) ?? clone(context.server) ?? 'tsrust';

    if (name === 'language_service_status') {
      if (!context.allowRead) return Err('Language-service read access is not permitted by the host.');

      if (state !== undefined) return Ok(JSON.stringify({
        connections: state.get().connections, problems: context.problems.filter((problem) => problem.source.startsWith('lsp:'))
      }));
      return Ok(JSON.stringify({
        server: clone(server), generation: context.generation, status: clone(context.status), problems: context.problems.filter((problem) => problem.source === 'lsp:' + server)
      }));
    }

    if (!context.allowRestart) return Err('Language-service restart is not permitted by the host.');

    let generation = context.generation;

    if (state !== undefined) {
      const connection = connectionFor(state.get(), server);

      if (connection === undefined) return Err('No matching language server is registered.');
      generation = connection.generation;
    } else if (server !== (context.server ?? 'tsrust')) return Err('No matching language server is registered.');

    if (args.generation !== generation) return Err('Language-service connection changed.');

    if (state !== undefined) {
      const next = state.get();
      unwrap(requestLanguageRestart(next, requests, server, generation));
      state.set(next);
    } else unwrap(restartLanguageService(requests, generation, server));
    return Ok('{"queued":true}');
  } catch (error) {
    return Err(JSON.stringify(error));
  }
}

interface LanguageReadArguments {
  root: string;
  id: string;
  path: string;
  session: string;
  revision: int;
  position?: DiagnosticPosition;
}

export function languageReadTools(): EditorTool[] {
  const schema = '{"type":"object","properties":{"root":{"type":"string"},"id":{"type":"string"},"path":{"type":"string"},"session":{"type":"string"},"revision":{"type":"integer"},"position":{"type":"object","properties":{"line":{"type":"integer","minimum":0},"character":{"type":"integer","minimum":0}},"required":["line","character"]}},"required":["root","id","path","session","revision"]}';
  const readSchema = schema.slice(0, schema.length - 2) + ',"position"]}';
  return [{
    name: 'language_hover', description: 'Queue a read-only LSP hover for an explicit current document and zero-based UTF-16 position. Requires host read permission. Does not focus, edit or save. Use language_read_result to receive it or language_cancel_read to cancel.', inputSchema: clone(readSchema)
  }, {
    name: 'language_completion', description: 'Queue current LSP completion candidates without inserting them. Requires an explicit document identity, zero-based UTF-16 position and host read grant. Returned edits are proposals only; this action cannot apply them.', inputSchema: clone(readSchema)
  }, {
    name: 'language_signature_help', description: 'Queue read-only call signatures and active-parameter documentation for an explicit current document and zero-based UTF-16 position. Requires host read permission. Use language_read_result or language_cancel_read; never changes editor focus or files.', inputSchema: clone(readSchema)
  }, {
    name: 'language_read_result', description: 'Consume a completed language read for the same explicit document identity; returns ready=false while pending. Rejects changed documents and other targets.', inputSchema: clone(schema)
  }, {
    name: 'language_cancel_read', description: 'Cancel the matching scoped language read and release its result without editing or changing editor focus.', inputSchema: schema
  }];
}

export function invokeLanguageRead(
  context: ReadOnly<LanguageToolContext>,
  workspace: Signal<Workspace>,
  state: Signal<LanguageState>,
  requests: ReadOnly<Sender<LanguageMessage>>,
  name: ReadOnly<string>,
  payload: ReadOnly<string>
): Result<string, string> {
  if (!context.allowRead) return Err('Language-service read access is not permitted by the host.');

  if (!languageReadTools().some((tool) => tool.name === name)) return Err('Unknown document language action.');

  try {
    const args = JSON.parse<LanguageReadArguments>(payload, {
      maxBytes: 8192, maxDepth: 8, maxEntries: 32, maxNodes: 64
    });
    const current = workspace.get();

    if (args.root !== context.root || args.root !== current.root) return Err('Language-service workspace changed.');

    if (args.id.length === 0 || args.id.length > 128) return Err('Invalid language read identity.');

    if (!current.files.some((file) => file.document.path === args.path && file.document.session === args.session && file.document.revision === args.revision)) return Err('Language document changed.');
    const id = 'agent:' + args.id;
    const next = state.get();

    if (name === 'language_hover' || name === 'language_completion' || name === 'language_signature_help') {
      const position = args.position;

      if (position === undefined) return Err('A UTF-16 language position is required.');
      unwrap(queueLanguageRead(
        current,
        next,
        requests,
        clone(id),
        {
          path: clone(args.path), session: clone(args.session), revision: args.revision, method: name === 'language_hover' ? 'textDocument/hover' : name === 'language_completion' ? 'textDocument/completion' : 'textDocument/signatureHelp', position: clone(position)
        },
        undefined
      ));
      state.set(next);
      return Ok('{"queued":true}');
    }

    const pendingIndex = next.queries.findIndex((query) => query.id === id && query.document.path === args.path && query.document.session === args.session && query.document.revision === args.revision);
    const resultIndex = next.readResults.findIndex((result) => result.query.id === id && result.query.document.path === args.path && result.query.document.session === args.session && result.query.document.revision === args.revision);

    if (pendingIndex < 0 && resultIndex < 0) return Err('No matching language read.');

    if (name === 'language_cancel_read') {
      unwrap(cancelLanguageRead(next, requests, id));
      state.set(next);
      return Ok('{"cancelled":true}');
    }

    if (resultIndex < 0) return Ok('{"ready":false}');
    const answer = JSON.stringify({
      ready: true, result: clone(next.readResults[resultIndex].result), error: clone(next.readResults[resultIndex].error)
    });
    next.readResults = next.readResults.filter((entry) => entry.query.id !== id);
    state.set(next);
    return Ok(answer);
  } catch (error) {
    return Err(JSON.stringify(error));
  }
}
