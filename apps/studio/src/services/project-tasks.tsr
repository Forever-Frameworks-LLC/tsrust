import { Signal, useId, controlTerminal } from 'std:ui';
import { Workspace } from '../lib/workspace/workspace.tsr';
import { StudioConfig } from '../lib/settings/settings.tsr';
import { dirty } from '../lib/workspace/documents.tsr';
import { TerminalWorkspace, addTerminal } from '../lib/workspace/terminals.tsr';
import { FormattingOptions } from '../lib/settings/formatting.tsr';

export interface ProjectTask {
  kind: string;
  title: string;
  program: string;
  args: string[];
}

export function prepareProjectTask(workspace: ReadOnly<Workspace>, program: string, kind: string, options: ReadOnly<FormattingOptions>, allowCheck: boolean, allowWrite: boolean): Result<ProjectTask, string> {
  if (kind === 'check') {
    if (!allowCheck) return Err('Project checking is not permitted by the host.');
    return Ok({
      kind, title: 'Check project', program, args: ['check', '.', '--color=always', '--progress']
    });
  }

  if (kind !== 'format') return Err('Unknown project task.');

  if (!allowWrite) return Err('Project formatting requires a workspace write grant.');

  if (workspace.files.some((file) => dirty(file.document))) return Err('Save or discard unsaved changes before formatting the project. Format Document can format an unsaved buffer.');
  return Ok({
    kind, title: 'Format project', program, args: ['format', '.', '--options', JSON.stringify(options), '--color=always', '--progress']
  });
}

// The UI grants this explicit command; model payloads never supply these grants.
export function runProjectTask(workspace: Signal<Workspace>, settings: Signal<StudioConfig>, terminals: Signal<TerminalWorkspace>, panel: Signal<string>, error: Signal<string>, program: string, kind: string): void {
  match (prepareProjectTask(workspace.get(), program, kind, settings.get().format, true, true)) {
    Err(message) => {
      const next = workspace.get();
      next.error = clone(message);
      workspace.set(next);
      panel.set('problems');
    },
    Ok(task) => {
      const next = terminals.get();
      const id = useId();

      match (addTerminal(next, clone(id))) {
        Err(message) => {
          error.set(clone(message));
        },
        Ok(_) => {
          const index = next.sessions.length - 1;
          next.sessions[index].title = clone(task.title);
          next.sessions[index].program = clone(task.program);
          next.sessions[index].args = clone(task.args);
          next.sessions[index].task = clone(task.kind);
          terminals.set(next);
          panel.set('terminal');
          controlTerminal(id, {
            action: 'focus'
          }, (result) => {
            error.set(clone(result.error ?? ''));
          });
        }
      }
    }
  }
}
