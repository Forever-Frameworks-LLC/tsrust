import { canonicalize, stat } from 'std:fs';
import { Signal, useId, controlTerminal } from 'std:ui';

import { FormattingOptions } from '../lib/settings/formatting.tsr';
import { StudioConfig } from '../lib/settings/settings.tsr';
import { QueuedFormatting, enqueueFormatting, activeSourceDocument, canFormat } from '../lib/workspace/formatting-actions.tsr';
import { TerminalWorkspace, addTerminal } from '../lib/workspace/terminals.tsr';
import { Workspace, projectFiles, maxEditableBytes } from '../lib/workspace/workspace.tsr';

export interface ProjectTask {
  kind: string;
  title: string;
  program: string;
  args: string[];
}

export function prepareProjectTask(
  workspace: ReadOnly<Workspace>,
  program: string,
  kind: string,
  options: ReadOnly<FormattingOptions>,
  allowCheck: boolean,
  allowWrite: boolean,
  terminalOutput: boolean = true
): Result<ProjectTask, string> {
  if (kind === 'check-document') {
    if (!allowCheck) return Err('Project checking is not permitted by the host.');

    if (!activeSourceDocument(workspace)) return Err('Checking supports saved .tsr and .tsrx documents.');

    try {
      if (unwrap(canonicalize(workspace.active)) !== workspace.active || !unwrap(stat(workspace.active)).isFile) return Err('The saved document is no longer available at this path.');
    } catch (_) {
      return Err('The saved document is no longer available at this path.');
    }

    const args = ['check', clone(workspace.active), '--diagnostics-only', terminalOutput ? '--color=always' : '--color=never'];

    if (terminalOutput) args.push('--progress');
    return Ok({
      kind, title: 'Check document (saved)', program, args
    });
  }

  if (kind === 'check') {
    if (!allowCheck) return Err('Project checking is not permitted by the host.');
    return Ok({
      kind, title: 'Check project', program, args: ['check', '.', '--color=always', '--progress']
    });
  }

  if (kind !== 'format') return Err('Unknown project task.');

  if (!allowWrite) return Err('Project formatting requires a workspace write grant.');

  // Match compiler discovery, including ignored sources. Open drafts use revisioned proposals.
  match (projectFiles(workspace.root, true)) {
    Err(error) => {
      return Err(clone(error));
    },
    Ok(files) => {
      const unopened = files.filter((file) => canFormat(file.path) && !workspace.files.some((open) => open.document.path === file.path));
      const args: string[] = unopened.length === 0 ? [] : ['format', '--write', '--text-files-up-to', maxEditableBytes().toString(), '--options', JSON.stringify(options), '--color=always', '--progress'];

      for (const file of unopened) args.push(clone(file.path));
      return Ok({
        kind, title: 'Format project', program, args
      });
    }
  }
}

// The UI grants this explicit command; model payloads never supply these grants.
export function runProjectTask(
  workspace: Signal<Workspace>,
  settings: Signal<StudioConfig>,
  terminals: Signal<TerminalWorkspace>,
  panel: Signal<string>,
  error: Signal<string>,
  program: string,
  kind: string,
  queue: Signal<QueuedFormatting[]> | undefined = undefined
): void {
  match (prepareProjectTask(
    workspace.get(),
    program,
    clone(kind),
    settings.get().format,
    true,
    true
  )) {
    Err(message) => {
      const next = workspace.get();
      next.error = clone(message);
      workspace.set(next);
      panel.set('problems');
    },
    Ok(task) => {
      if (kind === 'format' && queue !== undefined) {
        const pending = queue.get();
        const current = workspace.get();

        for (const file of current.files) enqueueFormatting(pending, current, file.document.path, 'project-format');
        queue.set(pending);
      }

      if (task.args.length === 0) return;
      const next = terminals.get();
      const id = useId();

      match (addTerminal(next, clone(id))) {
        Err(message) => {
          error.set(clone(message));
        },
        Ok(_) => {
          const index = next.sessions.length - 1;
          next.sessions[index].title = clone(task.title);
          next.sessions[index].program = clone(task.program);
          next.sessions[index].args = clone(task.args);
          next.sessions[index].task = clone(task.kind);
          terminals.set(next);
          panel.set('terminal');
          controlTerminal(id, {
            action: 'focus'
          }, (result) => {
            error.set(clone(result.error ?? ''));
          });
        }
      }
    }
  }
}
