import { fromUtf8, length, toUtf8 } from 'std:bytes';
import { Channel, Sender } from 'std:futures';
import { isAbsolute, separator } from 'std:path';
import { lstat, stat } from 'std:fs';
import { compile } from 'std:regex';
import { run } from 'std:process';

function workspaceFile(path: ReadOnly<string>): boolean {
  const parts = separator() === '/' ? path.split('/') : path.replaceAll(separator(), '/').split('/');
  return path !== '' && !isAbsolute(path) && !parts.some((part) => part === '' || part === '.' || part === '..');
}

export async function readGitView(root: ReadOnly<string>, mode: ReadOnly<string>, file: string = ''): Task<Result<string, string>> {
  if (file !== '' && (!workspaceFile(file) || (mode !== 'working' && mode !== 'staged'))) return Err('Choose a file inside the workspace.');
  const args = ['--literal-pathspecs', '--no-optional-locks', '-c', 'core.quotePath=false', '-c', 'color.ui=false'];

  if (mode === 'status') {
    for (const arg of ['-c', 'status.relativePaths=true', 'status', '--short', '--branch', '--untracked-files=all']) args.push(clone(arg));
  } else if (mode === 'conflicts') {
    for (const arg of ['diff', '--relative', '--name-only', '--diff-filter=U', '--no-ext-diff']) args.push(clone(arg));
  } else if (mode === 'history') {
    for (const arg of ['log', '--ignore-missing', '--no-decorate', '--no-show-signature', '--format=%h  %as  %s', 'HEAD']) args.push(clone(arg));
  } else if (mode === 'working' || mode === 'staged') {
    for (const arg of ['diff', '--relative', '--no-ext-diff', '--no-textconv', '--unified=3', '--no-renames', '--src-prefix=a/', '--dst-prefix=b/']) args.push(clone(arg));

    if (mode === 'working' && file !== '') {
      match (await gitOutput(root, ['--literal-pathspecs', 'ls-files', '--others', '--exclude-standard', '-z', '--', clone(file)])) {
        Ok(names) => {
          if (names === file + '\0') {
            match (lstat(root + separator() + file)) {
              Ok(info) => {
                if (!info.isFile && !info.isSymlink) return Err('Choose a regular file.');
              },
              Err(error) => {
                return Err(clone(error.message));
              }
            }
            // Git's no-index diff uses /dev/null for the absent side and exits 1 for differences.
            args.push('--no-index');
            args.push('--');
            args.push('/dev/null');
            args.push(file === '-' ? './-' : clone(file));
            return await gitOutput(root, args, '', true);
          }
        },
        Err(error) => {
          return Err(error);
        }
      }
    }

    if (mode === 'staged') args.push('--cached');
  } else return Err('Unknown source control view.');
  args.push('--');
  args.push(file === '' ? '.' : file);

  return await gitOutput(root, args);
}

// NUL-delimited names preserve whitespace and Git pathspec punctuation.
export async function changedFiles(root: ReadOnly<string>): Task<Result<string[], string>> {
  const names = new Set<string>();

  for (const args of [['ls-files', '-z', '--modified', '--others', '--exclude-standard', '--', '.'], ['diff', '--cached', '--relative', '--name-only', '--no-renames', '-z', '--', '.']]) {
    match (await gitOutput(root, clone(args))) {
      Ok(text) => {
        for (const path of text.split('\0')) if (path !== '') names.add(clone(path));
      },
      Err(error) => {
        return Err(error);
      }
    }
  }

  const paths = Array.from(names);
  paths.sort();
  return Ok(paths);
}

export interface DiffHunk {
  label: string;
  header: string;
  start: int;
  end: int;
}

export function diffHunks(diff: ReadOnly<string>): DiffHunk[] {
  const hunks: DiffHunk[] = [];
  let file = '';
  let header = '';
  let offset = 0;
  let active = false;

  for (const line of diff.split('\n')) {
    if (line.startsWith('diff ')) {
      if (active) hunks[hunks.length - 1].end = offset;
      file = line.startsWith('diff --git ') ? line.slice(11) : '';
      header = '';
      active = false;
    } else if (!active && file !== '' && (line.startsWith('new file mode ') || line.startsWith('deleted file mode '))) {
      // Creating an index entry needs its original Git mode, including on reverse apply.
      header = 'diff --git ' + file + '\n' + line + '\n';
    } else if (!active && line.startsWith('--- ')) {
      header += line + '\n';
    } else if (!active && header !== '' && line.startsWith('+++ ')) {
      header += line + '\n';
    } else if (file !== '' && line.startsWith('@@ ')) {
      if (active) hunks[hunks.length - 1].end = offset;
      hunks.push({
        label: file + '  ' + line, header: clone(header), start: offset, end: diff.length
      });
      active = true;
    }

    offset += line.length + 1;
  }

  return hunks;
}

export interface GitRequest {
  mode: string;
  action?: string;
  path?: string;
  hunk?: string;
  patch?: string;
  viewFile?: string;
  commit?: string;
}

export async function gitRequest(root: ReadOnly<string>, request: ReadOnly<GitRequest>): Task<Result<string, string>> {
  const action = request.action;

  if (request.mode === 'commit') {
    const id = request.commit ?? '';

    if (action !== undefined || !unwrap(compile('^[0-9a-f]{4,64}$')).isMatch(id)) return Err('Choose a commit from history.');
    return await gitOutput(root, ['--no-optional-locks', '-c', 'core.quotePath=false', '-c', 'color.ui=false', 'show', '--relative', '--no-ext-diff', '--no-textconv', '--no-show-signature', '--format=fuller', '--patch', id + '^{commit}', '--', '.']);
  }

  const viewFile = clone(request.viewFile) ?? '';

  if (viewFile !== '' && (!workspaceFile(viewFile) || (request.mode !== 'working' && request.mode !== 'staged'))) return Err('Choose a file inside the workspace.');

  if (action === undefined) return await readGitView(root, request.mode, clone(viewFile));

  if (action === 'stage-hunk' || action === 'unstage-hunk') {
    const reverse = action === 'unstage-hunk';

    if (request.mode !== (reverse ? 'staged' : 'working')) return Err('Unknown source control action.');
    let diff = '';

    match (await readGitView(root, request.mode, clone(viewFile))) {
      Ok(text) => {
        diff = text;
      },
      Err(reason) => {
        return Err(reason);
      }
    }

    const label = request.hunk ?? '';
    const hunk = diffHunks(diff).find((entry: ReadOnly<DiffHunk>) => entry.label === label);

    if (hunk === undefined || hunk.header === '') return Err('The hunk changed. Refresh the diff.');
    const patch = hunk.header + diff.slice(hunk.start, hunk.end);

    if (patch !== (request.patch ?? '')) return Err('The hunk changed. Refresh the diff.');
    let top = '';
    let prefix = '';

    match (await gitOutput(root, ['rev-parse', '--show-toplevel'])) {
      Ok(text) => {
        top = text.slice(0, -1);
      },
      Err(reason) => {
        return Err(reason);
      }
    }

    match (await gitOutput(root, ['rev-parse', '--show-prefix'])) {
      Ok(text) => {
        prefix = text.slice(0, -1);
      },
      Err(reason) => {
        return Err(reason);
      }
    }

    const args = ['apply', '--cached', '--whitespace=nowarn', '-p1'];

    if (prefix !== '') args.push('--directory=' + prefix.slice(0, -1));

    if (reverse) args.push('--reverse');

    // Git searches from the destination line. Earlier, omitted hunks did not shift this index.
    const body = diff.slice(hunk.start, hunk.end);
    const boundary = body.indexOf(' @@');
    const ranges = body.slice(3, boundary).split(' ');
    const before = ranges[0].slice(1).split(',');
    const after = ranges[1].slice(1).split(',');
    let indexedPatch = patch;

    if (before[0] !== '0' && after[0] !== '0') {
      const start = reverse ? clone(after[0]) : clone(before[0]);
      before[0] = clone(start);
      after[0] = clone(start);
      indexedPatch = hunk.header + '@@ -' + before.join(',') + ' +' + after.join(',') + body.slice(boundary);
    }

    match (await gitOutput(top, args, indexedPatch)) {
      Ok(_) => {
        return await readGitView(root, request.mode, clone(viewFile));
      },
      Err(reason) => {
        return Err(reason);
      }
    }
  }

  if (action !== 'stage' && action !== 'unstage') return Err('Unknown source control action.');
  const path = request.path ?? '';

  if (!workspaceFile(path)) return Err('Choose a file inside the workspace.');

  match (stat(root + separator() + path)) {
    Ok(info) => {
      if (!info.isFile) return Err('Choose a regular file.');
    },
    Err(error) => {
      if (error.code !== 'not-found') return Err(clone(error.message));

      match (await changedFiles(root)) {
        Ok(paths) => {
          if (!paths.includes(path) || paths.some((other) => other.startsWith(path + '/'))) return Err('Choose a file inside the workspace.');
        },
        Err(reason) => {
          return Err(reason);
        }
      }
    }
  }

  const args = ['--literal-pathspecs', action === 'stage' ? 'add' : 'reset', '--', clone(path)];

  match (await gitOutput(root, args)) {
    Err(error) => {
      return Err(error);
    },
    Ok(_) => {
      return await readGitView(root, request.mode, clone(viewFile));
    }
  }
}

async function gitOutput(root: ReadOnly<string>, args: string[], input: string = '', diffExit: boolean = false): Task<Result<string, string>> {
  match (await run('git', args, {
    cwd: clone(root), input: unwrap(fromUtf8(input)), deadlineMs: 30000, maxOutputBytes: 2 * 1024 * 1024
  })) {
    Err(error) => {
      return Err(clone(error.message));
    },
    Ok(output) => {
      try {
        if (!output.status.success && !(diffExit && output.status.code === 1 && length(output.stderr) === 0)) return Err(unwrap(toUtf8(output.stderr)).trim());
        return Ok(unwrap(toUtf8(output.stdout)));
      } catch (_) {
        return Err('Git output is not valid UTF-8.');
      }
    }
  }
}

export interface GitReply {
  mode: string;
  text: string;
  failed: boolean;
  files?: string[];
}

export async function gitWorker(root: string, requests: Channel<GitRequest>, replies: Sender<GitReply>): Task<void> {
  while (true) {
    const request = await requests.receive();
    const mode = clone(request.mode);

    match (await gitRequest(root, request)) {
      Ok(text) => {
        let files: string[] = [];

        if (mode === 'status') {
          match (await changedFiles(root)) {
            Ok(paths) => {
              files = paths;
            },
            Err(error) => {
              await replies.send({
                mode, text: error, failed: true
              });
              continue;
            }
          }
        }

        await replies.send({
          mode, text, failed: false, files
        });
      },
      Err(error) => {
        await replies.send({
          mode, text: error, failed: true
        });
      }
    }
  }
}
