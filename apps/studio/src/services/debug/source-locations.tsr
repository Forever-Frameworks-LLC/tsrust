import { canonicalize, readTextFile } from 'std:fs';
import { basename, dirname, join } from 'std:path';
import { fromUtf8, toHex } from 'std:bytes';
import { sha256 } from 'std:crypto';

import { artifactChecksum } from '../ai/model-extensions.tsr';

export function executableDebugUnit(program: ReadOnly<string>): string {
  const folder = program + '.tsrust-debug';
  const name = unwrap(readTextFile(join(folder, artifactChecksum(program) + '.unit'), 75));

  if (basename(name) !== name || name.length !== 75 || !name.startsWith('program_') || !name.endsWith('.rs')) throw 'Invalid debugger source unit.';
  return join(folder, name);
}

export interface OriginalPosition {
  path: string;
  line: int;
  column: int;
}

// Index only the generated line immediately following a compiler marker pair.
// An adjacent function or generated cleanup instruction may have no original statement.
export function debugLocations(program: ReadOnly<string>, path: ReadOnly<string>): Map<int, OriginalPosition> {
  const locations = new Map<int, OriginalPosition>();
  const name = basename(path);

  if (name.length !== 75 || !name.startsWith('program_') || !name.endsWith('.rs')) return locations;

  try {
    const folder = unwrap(canonicalize(program + '.tsrust-debug'));
    const resolved = unwrap(canonicalize(path));

    if (dirname(resolved) !== folder || basename(resolved) !== name) return locations;
    const source = unwrap(readTextFile(resolved));

    if (name !== 'program_' + unwrap(toHex(sha256(unwrap(fromUtf8(source))))) + '.rs') return locations;
    const lines = source.split('\n');
    const prefix = '// tsrust-position ';

    for (let i = 0; i + 2 < lines.length; i += 1) {
      if (!lines[i].startsWith(prefix) || !lines[i + 1].startsWith('// tsrust-source ')) continue;
      const position = JSON.parse<OriginalPosition>(lines[i].slice(prefix.length));

      if (position.line > 0 && position.column > 0 && position.path !== '') locations.set(i + 3, position);
    }
  } catch (_) {}

  return locations;
}
