import { fromUtf8, length } from 'std:bytes';
import { Sender, Channel } from 'std:futures';
import { Signal, translate } from 'std:ui';

import { StudioConfig } from '../../lib/settings/settings.tsr';
import { ChatMessage } from '../../lib/ai/prompts.tsr';
import {
  ChatHistory,
  emptyHistory,
  createChat,
  chatIdentity,
  Conversation,
  setChatDraft,
  draftContext,
  setDraftContext,
  messageContent
} from '../../lib/ai/conversations.tsr';
import { ModelRequest, ModelUpdate } from '../../lib/ai/protocol.tsr';
import { EditorTool } from '../editor-tools.tsr';
import { Workspace } from '../../lib/workspace/workspace.tsr';
import { DirectoryTree } from '../../lib/explorer/tree.tsr';
import { EditorContextResult, editorContext, readContext } from './context.tsr';
import { ChatStore, persistChats } from './history.tsr';

import { ProposedEdit, propose } from '../../lib/workspace/documents.tsr';
import { replacementProposal } from '../../lib/ai/edits.tsr';

export interface AiState {
  editTarget?: ProposedEdit;
  review?: ProposedEdit;
  phase: string;
  active: string;
  targetChat: string;
  pending?: ModelRequest;
  history: ChatHistory;
  view: string;
  notice: string;
}

export interface AiContext {
  state: Signal<AiState>;
  settings: Signal<StudioConfig>;
  commands: Sender<ModelRequest>;
  store?: Signal<ChatStore>;
  allowRead: boolean;
  allowControl: boolean;
  allowInference: boolean;
  allowDelete?: boolean;
  workspace?: Signal<Workspace>;
  projectTree?: Signal<DirectoryTree>;
  allowedContextPaths?: string[];
}

interface Arguments {
  prompt?: string;
  request?: string;
  chat?: string;
  revision?: int;
  path?: string;
  kind?: string;
  context?: string;
}

export function initialAiState(history: ChatHistory = emptyHistory(), notice: string = ''): AiState {
  return {
    phase: 'stopped', active: '', targetChat: '', history, view: 'thread', notice
  };
}

export function aiContextHandles(context: ReadOnly<AiContext>, allowDelete: boolean = false): AiContext {
  const tree = context.projectTree;
  const store = context.store;
  const workspace = context.workspace;
  return {
    projectTree: tree === undefined ? undefined : tree.handle(), state: context.state.handle(), settings: context.settings.handle(), commands: context.commands.share(), store: store === undefined ? undefined : store.handle(), workspace: workspace === undefined ? undefined : workspace.handle(), allowedContextPaths: clone(context.allowedContextPaths), allowRead: context.allowRead, allowControl: context.allowControl, allowInference: context.allowInference, allowDelete: allowDelete && (context.allowControl)
  };
}

function publish(context: ReadOnly<AiContext>, next: AiState, strict: boolean = false): Result<void, string> {
  const store = context.store;

  if (store !== undefined) {
    const journal = store.get();

    match (persistChats(next.history, journal)) {
      Ok(_) => {},
      Err(error) => {
        if (strict) return Err(clone(error));
        next.notice = next.notice === '' ? clone(error) : next.notice + '\n' + error;
      }
    }

    store.set(journal);
  }

  context.state.set(next);
  return Ok();
}

export function modelTools(): EditorTool[] {
  return [{
    name: 'local_model_read', description: 'Read host-bound model state and conversations, or supply a chat ID to read only its transcript, draft and attached context without selecting it. An empty ID targets the unassigned draft. Requires a host read grant.', inputSchema: '{"type":"object","properties":{"chat":{"type":"string"}}}'
  }, {
    name: 'local_model_send', description: 'Send in the explicit selected conversation. Starts the configured local model automatically when stopped, then generates. No tools or workspace writes. Requires host inference permission and lifecycle permission when loading.', inputSchema: '{"type":"object","properties":{"prompt":{"type":"string","maxLength":65536},"chat":{"type":"string"}},"required":["prompt","chat"]}'
  }, {
    name: 'local_model_cancel', description: 'Cancel the explicit active request, including automatic model startup. Rejects stale identities. Requires host lifecycle permission.', inputSchema: '{"type":"object","properties":{"request":{"type":"string"}},"required":["request"]}'
  }, {
    name: 'local_model_start', description: 'Administrative model load using trusted configured paths. Requires host lifecycle permission.', inputSchema: '{"type":"object","properties":{}}'
  }, {
    name: 'local_model_stop', description: 'Cancel generation and unload the owned local model. Requires host lifecycle permission.', inputSchema: '{"type":"object","properties":{}}'
  }, {
    name: 'chat_set_draft', description: 'Update the explicit selected conversation draft without sending. Requires host control permission.', inputSchema: '{"type":"object","properties":{"prompt":{"type":"string","maxLength":65536},"chat":{"type":"string"}},"required":["prompt","chat"]}'
  }, {
    name: 'chat_attach_context', description: 'Attach a bounded UTF-8 file or SKILL.md snapshot to the explicit current draft. Reads unsaved open text when available. Requires host read/control grants and a bound workspace; outside paths additionally require a trusted picker grant. Does not change workspace files.', inputSchema: '{"type":"object","properties":{"chat":{"type":"string"},"path":{"type":"string"},"kind":{"enum":["file","skill"]}},"required":["chat","path","kind"]}'
  }, {
    name: 'chat_detach_context', description: 'Remove an explicit context snapshot from the selected draft without changing any file. Requires host control permission.', inputSchema: '{"type":"object","properties":{"chat":{"type":"string"},"context":{"type":"string"}},"required":["chat","context"]}'
  }, {
    name: 'chat_new', description: 'Create and select a persistent conversation in this bound workspace. Requires host control permission.', inputSchema: '{"type":"object","properties":{}}'
  }, {
    name: 'chat_open', description: 'Select the exact existing conversation. Does not redirect an in-flight reply. Requires host control permission.', inputSchema: '{"type":"object","properties":{"chat":{"type":"string"}},"required":["chat"]}'
  }, {
    name: 'chat_show_all', description: 'Show the bound workspace conversation list. Requires host control permission.', inputSchema: '{"type":"object","properties":{}}'
  }, {
    name: 'chat_delete', description: 'Remove an exact idle conversation from persistent history. Requires separately approved host deletion permission; arguments cannot grant it. Rejects an in-flight target and storage conflicts.', inputSchema: '{"type":"object","properties":{"chat":{"type":"string"},"revision":{"type":"integer","minimum":0}},"required":["chat","revision"]}'
  }];
}

function startRequest(context: ReadOnly<AiContext>): Result<ModelRequest, string> {
  if (!context.allowControl) return Err('The host has not permitted model lifecycle actions.');
  const config = context.settings.get();

  if (config.aiModelPath === '' || config.aiTokenizerPath === '') return Err('Choose a model and tokenizer in Application → Settings → AI before sending.');
  return Ok({
    kind: 'start', id: '', prompt: '', maxTokens: 0, modelPath: clone(config.aiModelPath), tokenizerPath: clone(config.aiTokenizerPath)
  });
}

function restorePending(next: Mutable<AiState>, status: string): void {
  const pending = clone(next.pending);

  if (pending !== undefined) {
    const index = next.history.chats.findIndex((chat) => chat.id === next.targetChat);

    if (index >= 0) {
      const requestId = clone(pending.id);
      const user = next.history.chats[index].messages.findIndex((message) => message.role === 'user' && message.request === requestId);

      if (next.history.chats[index].draft === '' && (next.history.chats[index].context ?? []).length === 0) {
        next.history.chats[index].draft = clone(pending.prompt);

        if (user >= 0) next.history.chats[index].context = clone(next.history.chats[index].messages[user].context) ?? [];
        next.history.chats[index].messages = next.history.chats[index].messages.filter((message) => message.request !== requestId);
      } else {
        // Keep the original prompt and attachments in history when the composer already holds new work.
        const reply = next.history.chats[index].messages.findIndex((message) => message.request === requestId && message.role === 'assistant');

        if (user >= 0) next.history.chats[index].messages[user].status = clone(status);

        if (reply >= 0) next.history.chats[index].messages[reply].status = clone(status);
      }

      next.history.chats[index].revision += 1;
    }
  }

  next.pending = undefined;
  next.active = '';
  next.targetChat = '';
}

export function invokeModelTool(context: ReadOnly<AiContext>, name: ReadOnly<string>, payload: ReadOnly<string>): Result<string, string> {
  if (!modelTools().some((tool) => tool.name === name)) return Err('Unknown local model action.');
  const next = context.state.get();

  try {
    const args = JSON.parse<Arguments>(payload, {
      maxBytes: 512 * 1024, maxDepth: 4, maxEntries: 8, maxNodes: 16
    });

    if (name === 'local_model_read') {
      if (!context.allowRead) return Err('The host has not permitted reading this conversation.');

      if (args.chat === undefined) return Ok(JSON.stringify(next));

      if (args.chat === '') {
        const draft: Conversation = {
          id: '', title: '', revision: 0, draft: clone(next.history.draft), context: clone(next.history.context) ?? [], messages: []
        };
        return Ok(JSON.stringify(draft));
      }

      const chat = next.history.chats.find((item) => item.id === args.chat);

      if (chat === undefined) return Err('This conversation no longer exists.');
      return Ok(JSON.stringify(chat));
    }

    next.notice = '';

    if (name.startsWith('chat_')) {
      if (!context.allowControl) return Err('The host has not permitted changing conversations.');

      if (name === 'chat_attach_context' || name === 'chat_detach_context') {
        if (args.chat !== next.history.active) return Err('The selected conversation changed before sending.');
        const fragments = draftContext(next.history);

        if (name === 'chat_attach_context') {
          if (!context.allowRead) return Err('The host has not permitted reading chat context.');
          const workspace = context.workspace;

          if (workspace === undefined || workspace.get().root !== next.history.root) return Err('Chat context is not bound to this workspace.');

          match (readContext(workspace.get(), args.path ?? '', args.kind ?? 'file', context.allowedContextPaths ?? [])) {
            Err(error) => {
              return Err(clone(error));
            },
            Ok(fragment) => {
              if (!fragments.some((item) => item.path === fragment.path && item.kind === fragment.kind)) fragments.push(clone(fragment));
            }
          }
        } else {
          const index = fragments.findIndex((fragment) => fragment.id === args.context);

          if (index < 0) return Err('This context attachment is no longer present.');
          fragments.splice(index, 1);
        }

        setDraftContext(next.history, fragments);
      } else if (name === 'chat_set_draft') {
        if (args.chat !== next.history.active) return Err('The selected conversation changed before sending.');

        if (length(unwrap(fromUtf8(args.prompt ?? ''))) > 65536) return Err('This message is too large. Shorten it before sending.');
        setChatDraft(next.history, args.prompt ?? '');
      } else if (name === 'chat_new') {
        createChat(next.history);
        next.view = 'thread';
      } else if (name === 'chat_show_all') next.view = 'all';
      else {
        const index = next.history.chats.findIndex((chat) => chat.id === args.chat);

        if (index < 0) return Err('This conversation no longer exists.');

        if (name === 'chat_delete') {
          if (context.allowDelete !== true) return Err('Deleting a conversation requires host approval.');

          if (args.revision !== next.history.chats[index].revision) return Err('This conversation changed. Review it before deleting.');

          if (next.targetChat === args.chat && next.active !== '') return Err('Stop this response before deleting its conversation.');
          next.history.chats.splice(index, 1);

          if (next.history.active === args.chat) next.history.active = '';
          next.view = 'all';
        } else {
          next.history.active = args.chat ?? '';
          next.view = 'thread';
        }
      }

      match (publish(context, next, name === 'chat_delete')) {
        Err(error) => {
          return Err(clone(error));
        },
        Ok(_) => {
          return Ok('{"accepted":true}');
        }
      }
    }

    let request: ModelRequest = {
      kind: '', id: '', prompt: '', maxTokens: 0
    };

    if (name === 'local_model_send') {
      if (!context.allowInference) return Err('The host has not permitted inference.');

      if (args.chat !== next.history.active) return Err('The selected conversation changed before sending.');

      if (next.phase !== 'ready' && next.phase !== 'stopped') return Err('Wait for the current response or stop it before sending another.');
      const prompt = args.prompt ?? '';

      if (prompt.trim() === '') return Err('Enter a message before sending.');

      if (length(unwrap(fromUtf8(prompt))) > 65536) return Err('This message is too large. Shorten it before sending.');

      if (next.history.active === '') createChat(next.history);
      const index = next.history.chats.findIndex((chat) => chat.id === next.history.active);

      if (index < 0) return Err('This conversation no longer exists.');
      next.active = chatIdentity();
      next.targetChat = clone(next.history.active);

      if (next.history.chats[index].title === '') next.history.chats[index].title = Array.from(prompt.trim().split('\n')[0]).slice(0, 80).join('');
      const workspace = context.workspace;
      const tree = context.projectTree;
      const canReadWorkspace = context.allowRead && workspace !== undefined && workspace.get().root === next.history.root;
      const attachments = draftContext(next.history);
      const grounding: EditorContextResult = canReadWorkspace && workspace !== undefined ? editorContext(workspace.get(), tree === undefined ? undefined : tree.get(), attachments, prompt) : {
        excerpt: '', candidates: [], unavailable: []
      };
      const excerpt = grounding.excerpt;
      next.history.chats[index].messages.push({
        role: 'user', text: clone(prompt), request: clone(next.active), status: 'complete', context: clone(attachments), workspaceExcerpt: excerpt === '' ? undefined : excerpt
      });
      const messages: ChatMessage[] = next.history.chats[index].messages.filter((message) => message.text !== '' && (message.role !== 'user' || message.status === undefined || message.status === 'complete')).map((message): ChatMessage => ({
        role: clone(message.role), content: messageContent(message, canReadWorkspace)
      }));
      next.editTarget = undefined;

      if (prompt.toLowerCase().startsWith('edit: ')) {
        if (next.review !== undefined) return Err('Review the previous edit proposal first.');

        if (!canReadWorkspace || workspace === undefined) return Err('Open a text file to propose an edit.');
        const current = workspace.get();
        const file = current.files.find((entry) => entry.document.path === current.active && entry.kind === 'text');

        if (file === undefined) return Err('Open a text file to propose an edit.');
        next.editTarget = propose(file.document, '');
        const anchor = file.document.text === '' ? 'The file is empty. Set before to the empty string and after to the new file contents.' : 'Copy before exactly from a unique passage in the file. Include the surrounding text needed to identify it.';
        messages[messages.length - 1].content = 'Propose changes to the active file. Return a JSON object with string fields "before" and "after". For multiple replacements, return an array of these objects. Match each against the original file. ' + anchor + ' No Markdown.\nTask: ' + prompt.slice(6) + '\nSource file: ' + file.name + '\n' + file.document.text + (attachments.length === 0 ? '' : '\nUser-selected context:\n' + JSON.stringify(attachments));
      }

      const generation: ModelRequest = {
        kind: 'generate', id: clone(next.active), prompt: clone(prompt), maxTokens: context.settings.get().aiResponseTokens, messages
      };

      if (length(unwrap(fromUtf8(JSON.stringify(generation)))) > 128 * 1024) return Err('The conversation and attachments are too large. Start a new chat or remove some context.');
      let reply = '';

      if (grounding.candidates.length > 0) reply = translate('Which file did you mean?') + '\n\n' + grounding.candidates.join('\n\n');

      if (grounding.unavailable.length > 0) reply += (reply === '' ? '' : '\n\n') + translate('Studio could not read text from these files.') + '\n\n' + grounding.unavailable.join('\n\n');
      next.history.chats[index].messages.push({
        role: 'assistant', text: clone(reply), request: clone(next.active), status: reply === '' ? 'pending' : 'complete'
      });
      next.history.chats[index].draft = '';
      next.history.chats[index].context = [];
      next.history.chats[index].revision += 1;
      next.history.draft = '';

      if (reply !== '') {
        next.editTarget = undefined;
        next.active = '';
        next.targetChat = '';
        unwrap(publish(context, next));
        return Ok('{"accepted":true}');
      }

      if (next.phase === 'stopped') match (startRequest(context)) {
        Err(error) => {
          return Err(clone(error));
        },
        Ok(start) => {
          request = start;
        }
      }

      if (next.phase === 'stopped') {
        next.pending = generation;
        next.phase = 'starting';
      } else {
        request = generation;
        next.phase = 'generating';
      }
    } else {
      if (!context.allowControl) return Err('The host has not permitted model lifecycle actions.');

      if (name === 'local_model_start') {
        if (next.phase !== 'stopped') return Err('The local model is already starting or running.');

        match (startRequest(context)) {
          Err(error) => {
            return Err(clone(error));
          },
          Ok(start) => {
            request = start;
          }
        }

        next.phase = 'starting';
      } else if (name === 'local_model_stop') {
        if (!['starting', 'ready', 'generating'].includes(next.phase)) return Err('The local model is not running.');
        request.kind = 'shutdown';
        next.phase = 'stopping';
      } else {
        if (args.request !== next.active || next.active === '' || !['starting', 'generating'].includes(next.phase)) return Err('The generation request is no longer active.');

        if (next.phase === 'starting') {
          request.kind = 'shutdown';
          next.phase = 'stopping';
        } else {
          request.kind = 'cancel';
          request.id = clone(next.active);
        }
      }
    }

    if (request.kind === 'cancel' || request.kind === 'shutdown') next.editTarget = undefined;

    match (context.commands.trySend(request)) {
      Err(_) => {
        return Err('The model command queue is full or closed.');
      },
      Ok(_) => {}
    }

    unwrap(publish(context, next));
    return Ok('{"accepted":true}');
  } catch (_) {
    return Err('Could not perform the chat action. Check the model settings and try again.');
  }
}

export function pollModel(context: ReadOnly<AiContext>, updates: Mutable<Channel<ModelUpdate>>): void {
  const next = context.state.get();
  let changed = false;
  let save = false;

  for (let count = 0; count < 8; count += 1) {
    match (updates.tryReceive()) {
      Err(_) => {
        break;
      },
      Ok(update) => {
        changed = true;

        if (update.kind === 'ready') {
          if (next.phase === 'starting') next.phase = 'ready';
        } else if (update.kind === 'stopped') {
          if (next.pending !== undefined) {
            const status = next.phase === 'stopping' ? 'cancelled' : 'error';
            restorePending(next, status);
          } else {
            const chat = next.history.chats.findIndex((chat) => chat.id === next.targetChat);

            if (chat >= 0) for (let message = 0; message < next.history.chats[chat].messages.length; message += 1) {
              if (next.history.chats[chat].messages[message].request === next.active && next.history.chats[chat].messages[message].status === 'pending') {
                next.history.chats[chat].messages[message].status = 'interrupted';
                next.history.chats[chat].revision += 1;
              }
            }

            next.active = '';
            next.targetChat = '';
          }

          next.editTarget = undefined;
          next.phase = 'stopped';
          save = true;
        } else if (update.id === next.active && update.id !== '') {
          const chat = next.history.chats.findIndex((chat) => chat.id === next.targetChat);

          if (chat >= 0) {
            const message = next.history.chats[chat].messages.findIndex((message) => message.role === 'assistant' && message.request === update.id);

            if (message >= 0) {
              next.history.chats[chat].revision += 1;

              if (update.kind === 'prefix' || update.kind === 'complete') next.history.chats[chat].messages[message].text = clone(update.text);

              if (update.kind === 'complete' && next.editTarget !== undefined && update.stop !== 'length') {
                match (replacementProposal(next.editTarget, update.text)) {
                  Ok(proposal) => {
                    next.review = proposal;
                  },
                  Err(error) => {
                    next.notice = error;
                  }
                }
              }

              if (update.kind === 'complete') next.history.chats[chat].messages[message].limited = update.stop === 'length';

              if (update.kind === 'complete' || update.kind === 'cancelled' || update.kind === 'error') next.history.chats[chat].messages[message].status = clone(update.kind);
            }
          }

          if (['complete', 'cancelled', 'error'].includes(update.kind)) {
            next.editTarget = undefined;

            if (next.phase !== 'stopping') next.phase = 'ready';
            next.active = '';
            next.targetChat = '';
            save = true;
          }

          if (update.error !== '') next.notice = modelNotice(update.error);
        } else if (update.kind === 'error') next.notice = modelNotice(update.error);
      }
    }
  }

  if (next.phase === 'ready' && next.pending !== undefined) {
    const pending = clone(next.pending);

    if (pending !== undefined) match (context.commands.trySend(pending)) {
      Ok(_) => {
        next.pending = undefined;
        next.phase = 'generating';
        changed = true;
        save = true;
      },
      Err(error) => {
        if (error.code !== 'full') {
          restorePending(next, 'error');
          next.notice = 'The model command queue is full or closed.';
          changed = true;
          save = true;
        }
      }
    }
  }

  if (changed) {
    if (save) publish(context, next);
    else context.state.set(next);
  }
}

// UI adapters surface the same guarded errors returned to programmatic callers.
export function performModelAction(context: ReadOnly<AiContext>, name: string, payload: string = '{}'): boolean {
  match (invokeModelTool(context, name, payload)) {
    Ok(_) => {
      return true;
    },
    Err(error) => {
      const next = context.state.get();
      next.notice = error;
      context.state.set(next);
      return false;
    }
  }
}

interface ModelFailure {
  message?: string;
  cause?: string;
}

function modelNotice(error: ReadOnly<string>): string {
  let text = clone(error);

  try {
    text = JSON.parse<string>(error);
  } catch (_) {
    try {
      const failure = JSON.parse<ModelFailure>(error);
      text = failure.message ?? failure.cause ?? clone(error);
    } catch (_) {}
  }

  if (text.includes('admission context')) return 'This conversation is too long for the selected model. Start a new chat or remove some context.';

  if (text.includes('prompt exceeds')) return 'The message and context are too large for the selected model. Shorten them and try again.';
  return text;
}
