import {
  fromUtf8,
  toUtf8,
  view
} from 'std:bytes';

import { canonicalize, stat, readTextFile } from 'std:fs';
import { compile } from 'std:regex';
import { basename, dirname, join, separator } from 'std:path';

import { ContextFragment } from '../../lib/ai/conversations.tsr';
import { LanguageReferences, ReferenceLocation, referenceSymbol } from '../../lib/language/references.tsr';
import { diagnosticPath } from '../../lib/language/diagnostics.tsr';
import { DirectoryTree } from '../../lib/explorer/tree.tsr';
import { Workspace } from '../../lib/workspace/workspace.tsr';
import { chatIdentity } from '../../lib/ai/conversations.tsr';

// Only trusted picker results may extend a read beyond the bound workspace.
export function readContext(workspace: ReadOnly<Workspace>, path: ReadOnly<string>, kind: ReadOnly<string>, allowedPaths: ReadOnly<string[]>): Result<ContextFragment, string> {
  try {
    if (kind !== 'file' && kind !== 'skill') return Err('Unknown chat context type.');
    const resolved = unwrap(canonicalize(path.startsWith('/') ? clone(path) : join(workspace.root, path)));
    const root = workspace.root.endsWith(separator()) ? clone(workspace.root) : workspace.root + separator();

    if (!resolved.startsWith(root)) {
      let approved = false;

      for (const allowed of allowedPaths) {
        match (canonicalize(allowed)) {
          Ok(real) => {
            if (real === resolved) approved = true;
          },
          Err(_) => {}
        }
      }

      if (!approved) return Err('Choose outside-workspace attachments through the file picker.');
    }

    if (!unwrap(stat(resolved)).isFile) return Err('Choose a regular text file.');

    if (kind === 'skill' && basename(resolved) !== 'SKILL.md') return Err('Choose a SKILL.md file for skill context.');
    const opened = workspace.files.find((file) => file.document.path === resolved);
    let text = '';

    if (opened !== undefined) {
      if (opened.kind !== 'text' && opened.kind !== 'image') return Err('Choose a UTF-8 text file for context.');

      if (opened.kind === 'image') return Err('The selected model accepts text context. Image attachments need a vision model.');
      text = clone(opened.document.text);
    } else match (readTextFile(resolved)) {
      Ok(source) => {
        text = clone(source);
      },
      Err(_) => {
        return Err('Choose a UTF-8 text file for context.');
      }
    }

    if (text.includes('\0')) return Err('Choose a UTF-8 text file for context.');
    return Ok({
      id: chatIdentity(), kind: clone(kind), path: clone(resolved), label: kind === 'skill' ? basename(dirname(resolved)) : basename(resolved), text
    });
  } catch (_) {
    return Err('Could not read the selected chat context file.');
  }
}

function namedExcerpt(workspace: ReadOnly<Workspace>, path: ReadOnly<string>, prefix: ReadOnly<string>): Result<string, string> {
  try {
    if (!path.startsWith(prefix)) return Err('Unavailable file');
    const opened = workspace.files.find((file) => file.document.path === path);
    let excerpt = '';

    if (opened !== undefined) {
      if (opened.kind !== 'text') return Err('Expected text file');
      excerpt = clone(opened.document.text);
    } else {
      const resolved = unwrap(canonicalize(path));

      if (!resolved.startsWith(prefix) || !unwrap(stat(resolved)).isFile) return Err('Unavailable file');
      excerpt = unwrap(readTextFile(resolved));
    }

    if (excerpt.includes('\0')) return Err('Expected text file');
    return Ok(excerpt);
  } catch (_) {
    return Err('Unavailable text excerpt');
  }
}

function mentionsPath(prompt: ReadOnly<string>, path: ReadOnly<string>): boolean {
  let offset = 0;

  while (offset < prompt.length) {
    const start = prompt.indexOf(path, offset);

    if (start < 0) return false;
    const end = start + path.length;
    const before = start === 0 || [' ', '\n', '\t', '\r', '(', '[', '"', "'", '`'].some((mark) => prompt.slice(0, start).endsWith(mark));
    const after = end === prompt.length || [' ', '\n', '\t', '\r', ')', ']', '"', "'", '`', ':', ',', '!', '?'].some((mark) => prompt.startsWith(mark, end)) || (prompt.startsWith('.', end) && (end + 1 === prompt.length || prompt.startsWith(' ', end + 1)));

    if (before && after) return true;
    offset = end;
  }

  return false;
}

// Cache source reads for this request only. Recheck stale locations against the current text.
function referenceLine(workspace: ReadOnly<Workspace>, path: ReadOnly<string>, hit: ReadOnly<ReferenceLocation>, symbol: ReadOnly<string>, cache: Mutable<Map<string, string[]>>): string {
  if (!cache.has(path)) {
    const file = workspace.files.find((entry) => entry.document.path === path);
    let source = '';

    if (file !== undefined) {
      if (file.kind === 'text') source = clone(file.document.text);
    } else if (unwrap(stat(path)).isFile) {
      match (readTextFile(path)) {
        Ok(text) => {
          source = text;
        },
        Err(_) => {}
      }
    }

    cache.set(clone(path), source.includes('\0') ? [] : source.split('\n'));
  }

  const lines = cache.get(path);
  const index = hit.range.start.line;

  if (lines === undefined || index >= lines.length) return '';
  const line = lines[index];

  if (referenceSymbol(line, {
    line: 0, character: hit.range.start.character
  }) !== symbol) return '';
  return line.trim();
}

// A references result is a snapshot of a language-server query, not a fresh search.
export function referenceContext(workspace: ReadOnly<Workspace>, result: ReadOnly<LanguageReferences>, prompt: ReadOnly<string>): string {
  const root = workspace.root;
  const query = result.query;

  if (result.root !== root || result.pending === true || (result.error ?? '') !== '' || query === undefined || query.kind === 'file' || query.symbol === '') return '';
  const symbol = clone(query.symbol);
  const identifiers = unwrap(compile('[\\p{L}\\p{N}_$]+'));
  const bytesPrompt = unwrap(fromUtf8(prompt));

  if (!identifiers.findAll(prompt).some((token) => unwrap(toUtf8(unwrap(view(bytesPrompt, token.start, token.end)))) === symbol)) return '';
  const prefix = root.endsWith(separator()) ? clone(root) : root + separator();
  const cache = new Map<string, string[]>();
  const rows: string[] = [];


  try {
    if (!unwrap(canonicalize(query.path)).startsWith(prefix)) return '';
  } catch (_) {
    return '';
  }

  for (let index = 0; index < result.locations.length; index += 1) {
    const hit = result.locations[index];



    try {
      const path = unwrap(canonicalize(diagnosticPath(hit.uri)));

      if (!path.startsWith(prefix) || hit.range.start.line < 0 || hit.range.start.character < 0) continue;
      const snippet = referenceLine(workspace, path, hit, symbol, cache);
      const row = path.slice(prefix.length) + ':' + (hit.range.start.line + 1).toString() + ':' + (hit.range.start.character + 1).toString() + (snippet === '' ? '' : '  ' + snippet);

      if (rows.includes(row)) continue;

      rows.push(row);
    } catch (_) {}
  }

  return rows.length === 0 ? '' : '\n\nLast Find References results for ' + query.symbol + ':\n' + rows.join('\n');
}

export interface EditorContextResult {
  excerpt: string;
  candidates: string[];
  unavailable: string[];
}

export function editorContext(
  workspace: ReadOnly<Workspace>,
  tree: ReadOnly<DirectoryTree> | undefined,
  attached: ReadOnly<ContextFragment[]>,
  prompt: ReadOnly<string>,
  editing: boolean,
  hasReferences: boolean
): EditorContextResult {
  const ambiguous: string[] = [];
  const unavailable: string[] = [];
  const prefix = workspace.root.endsWith(separator()) ? clone(workspace.root) : workspace.root + separator();
  let result = '';
  const active = workspace.files.find((file) => file.document.path === workspace.active);

  if (!editing && active !== undefined && active.kind === 'text' && active.document.path.startsWith(prefix) && (!hasReferences || mentionsPath(prompt, active.name) || mentionsPath(prompt, active.document.path.slice(prefix.length))) && !attached.some((fragment) => fragment.path === workspace.active)) {
    result = 'Active editor file: ' + active.document.path.slice(prefix.length) + '\n' + active.document.text;
  }

  if (tree !== undefined && tree.root === workspace.root) {
    const question = prompt.toLowerCase();
    const listFiles = ['files', 'project structure', 'workspace structure', 'directory', 'arquivos', 'diretório'].some((word) => question.includes(word));
    const paths: string[] = [];
    const mentionedNames = new Map<string, int>();

    for (const directory of tree.directories) {
      for (const file of directory.children) {
        if (!file.directory && file.path.startsWith(prefix) && mentionsPath(prompt, file.name)) {
          const count = mentionedNames.get(file.name) ?? 0;
          mentionedNames.set(clone(file.name), count + 1);
        }
      }
    }



    for (const directory of tree.directories) {
      for (const file of directory.children) {
        if (file.directory || !file.path.startsWith(prefix)) continue;
        const path = file.path.slice(prefix.length);

        const nameCount = mentionedNames.get(file.name) ?? 0;
        const referenced = nameCount === 1 || (path !== file.name && mentionsPath(prompt, path)) || mentionsPath(prompt, './' + path);

        if (nameCount > 1) {

          ambiguous.push('./' + path);
        }

        if ((file.path !== workspace.active || active?.kind !== 'text') && referenced && !attached.some((fragment) => fragment.path === file.path)) {
          match (namedExcerpt(workspace, file.path, prefix)) {
            Ok(excerpt) => {
              result += '\n\nReferenced workspace file: ' + path + '\n' + excerpt;
            },
            Err(_) => {
              unavailable.push(clone(path));
            }
          }


        }

        if (editing || !listFiles) continue;

        paths.push(path);
      }
    }


    if (paths.length > 0) result += (result === '' ? '' : '\n\n') + 'Workspace files:\n' + paths.join('\n');
  }

  return {
    excerpt: result, candidates: ambiguous, unavailable
  };
}
