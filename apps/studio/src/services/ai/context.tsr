import {
  Bytes,
  fromUtf8,
  length,
  at,
  toUtf8,
  view
} from 'std:bytes';

import { canonicalize, stat, readTextFile } from 'std:fs';
import { basename, dirname, join, separator } from 'std:path';

import { ContextFragment } from '../../lib/ai/conversations.tsr';
import { DirectoryTree } from '../../lib/explorer/tree.tsr';
import { Workspace, readPrefix } from '../../lib/workspace/workspace.tsr';
import { chatIdentity } from '../../lib/ai/conversations.tsr';

// Only trusted picker results may extend a read beyond the bound workspace.
export function readContext(workspace: ReadOnly<Workspace>, path: ReadOnly<string>, kind: ReadOnly<string>, allowedPaths: ReadOnly<string[]>): Result<ContextFragment, string> {
  try {
    if (kind !== 'file' && kind !== 'skill') return Err('Unknown chat context type.');
    const resolved = unwrap(canonicalize(path.startsWith('/') ? clone(path) : join(workspace.root, path)));
    const root = workspace.root.endsWith(separator()) ? clone(workspace.root) : workspace.root + separator();

    if (!resolved.startsWith(root)) {
      let approved = false;

      for (const allowed of allowedPaths) {
        match (canonicalize(allowed)) {
          Ok(real) => {
            if (real === resolved) approved = true;
          },
          Err(_) => {}
        }
      }

      if (!approved) return Err('Choose outside-workspace attachments through the file picker.');
    }

    if (!unwrap(stat(resolved)).isFile) return Err('Choose a regular text file.');

    if (kind === 'skill' && basename(resolved) !== 'SKILL.md') return Err('Choose a SKILL.md file for skill context.');
    const opened = workspace.files.find((file) => file.document.path === resolved);
    let text = '';

    if (opened !== undefined) {
      if (opened.kind !== 'text' && opened.kind !== 'image') return Err('Choose a UTF-8 text file smaller than 32 KiB for context.');

      if (opened.kind === 'image') return Err('The selected model accepts text context. Image attachments need a vision model.');
      text = clone(opened.document.text);
    } else match (readTextFile(resolved, 32768)) {
      Ok(source) => {
        text = clone(source);
      },
      Err(_) => {
        return Err('Choose a UTF-8 text file smaller than 32 KiB for context.');
      }
    }

    if (text.includes('\0') || length(unwrap(fromUtf8(text))) > 32768) return Err('Choose a UTF-8 text file smaller than 32 KiB for context.');
    return Ok({
      id: chatIdentity(), kind: clone(kind), path: clone(resolved), label: kind === 'skill' ? basename(dirname(resolved)) : basename(resolved), text
    });
  } catch (_) {
    return Err('Could not read the selected chat context file.');
  }
}

function contextExcerpt(bytes: ReadOnly<Bytes>): string {
  const count = length(bytes);
  let end = count < 2048 ? count : 2048;

  while (end < count && unwrap(at(bytes, end)) >= 128 && unwrap(at(bytes, end)) < 192) end -= 1;
  return unwrap(toUtf8(unwrap(view(bytes, 0, end)))) + (end < count ? '\n…' : '');
}

function namedExcerpt(workspace: ReadOnly<Workspace>, path: ReadOnly<string>, prefix: ReadOnly<string>): Result<string, string> {
  try {
    const resolved = unwrap(canonicalize(path));

    if (!resolved.startsWith(prefix) || !unwrap(stat(resolved)).isFile) return Err('Unavailable file');
    const opened = workspace.files.find((file) => file.document.path === resolved);

    if (opened !== undefined && opened.kind !== 'text') return Err('Expected text file');
    const excerpt = opened === undefined ? contextExcerpt(readPrefix(resolved, 2049)) : contextExcerpt(unwrap(fromUtf8(opened.document.text)));

    if (excerpt.includes('\0')) return Err('Expected text file');
    return Ok(excerpt);
  } catch (_) {
    return Err('Unavailable text excerpt');
  }
}

function mentionsPath(prompt: ReadOnly<string>, path: ReadOnly<string>): boolean {
  let offset = 0;

  while (offset < prompt.length) {
    const start = prompt.indexOf(path, offset);

    if (start < 0) return false;
    const end = start + path.length;
    const before = start === 0 || [' ', '\n', '\t', '\r', '(', '[', '"', "'", '`'].some((mark) => prompt.slice(0, start).endsWith(mark));
    const after = end === prompt.length || [' ', '\n', '\t', '\r', ')', ']', '"', "'", '`', ':', ',', '!', '?'].some((mark) => prompt.startsWith(mark, end)) || (prompt.startsWith('.', end) && (end + 1 === prompt.length || prompt.startsWith(' ', end + 1)));

    if (before && after) return true;
    offset = end;
  }

  return false;
}

export interface EditorContextResult {
  excerpt: string;
  candidates: string[];
}

export function editorContext(workspace: ReadOnly<Workspace>, tree: ReadOnly<DirectoryTree> | undefined, attached: ReadOnly<ContextFragment[]>, prompt: ReadOnly<string>): EditorContextResult {
  const ambiguous: string[] = [];
  const prefix = workspace.root.endsWith(separator()) ? clone(workspace.root) : workspace.root + separator();
  let result = '';
  const active = workspace.files.find((file) => file.document.path === workspace.active);

  if (active !== undefined && active.kind === 'text' && active.document.path.startsWith(prefix) && !attached.some((fragment) => fragment.path === workspace.active)) {
    result = 'Active editor file: ' + active.document.path.slice(prefix.length) + '\n' + contextExcerpt(unwrap(fromUtf8(active.document.text)));
  }

  if (tree !== undefined && tree.root === workspace.root) {
    const paths: string[] = [];
    const mentionedNames = new Map<string, int>();

    for (const directory of tree.directories) {
      for (const file of directory.children) {
        if (!file.directory && file.path.startsWith(prefix) && mentionsPath(prompt, file.name)) {
          const count = mentionedNames.get(file.name) ?? 0;
          mentionedNames.set(clone(file.name), count + 1);
        }
      }
    }

    let size = 0;
    let named = 0;
    let ambiguousBytes = 0;

    for (const directory of tree.directories) {
      for (const file of directory.children) {
        if (file.directory || !file.path.startsWith(prefix)) continue;
        const path = file.path.slice(prefix.length);

        const nameCount = mentionedNames.get(file.name) ?? 0;
        const referenced = nameCount === 1 || (path !== file.name && mentionsPath(prompt, path)) || mentionsPath(prompt, './' + path);

        if (nameCount > 1 && ambiguous.length < 12 && ambiguousBytes + path.length + 3 <= 1024) {
          ambiguousBytes += path.length + 3;
          ambiguous.push('./' + path);
        }

        if (named < 2 && file.path !== workspace.active && referenced && !attached.some((fragment) => fragment.path === file.path)) {
          match (namedExcerpt(workspace, file.path, prefix)) {
            Ok(excerpt) => {
              result += '\n\nReferenced workspace file: ' + path + '\n' + excerpt;
              named += 1;
            },
            Err(_) => {}
          }
        }

        if (paths.length >= 24 || size + path.length + 1 > 1024) continue;
        size += path.length + 1;
        paths.push(path);
      }
    }


    if (paths.length > 0) result += (result === '' ? '' : '\n\n') + 'Workspace files (sample):\n' + paths.join('\n');
  }

  return {
    excerpt: result, candidates: ambiguous
  };
}
