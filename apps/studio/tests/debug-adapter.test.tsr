import { get } from 'std:env';
import { canonicalize, createTempDir, removeDirAll } from 'std:fs';
import { run, spawn } from 'std:process';
import { strictEqual, test } from 'std:testing';

import { readFrame, writeFrame } from '../src/services/lsp/transport.tsr';

interface AdapterReply {
  type: string;
  command?: string;
  event?: string;
  request_seq?: int;
  success?: boolean;
  body?: AdapterBody;
}

interface DebugFrame {
  id: int;
  name: string;
  instructionPointerReference?: string;
}

interface DebugBreakpoint {
  verified: boolean;
}

interface DebugScope {
  name: string;
  variablesReference: int;
}

interface DebugVariable {
  name: string;
  value: string;
  variablesReference: int;
}

interface AdapterBody {
  scopes?: DebugScope[];
  variables?: DebugVariable[];
  supportsFunctionBreakpoints?: boolean;
  breakpoints?: DebugBreakpoint[];
  stackFrames?: DebugFrame[];
  reason?: string;
  threadId?: int;
  supportsConfigurationDoneRequest?: boolean;
  exitCode?: int;
  category?: string;
  output?: string;
}

async function runDebugTarget(adapter: string, program: string): Task<void> {
  const child = unwrap(spawn(adapter, [], {
    stdin: 'pipe', stdout: 'pipe', stderr: 'inherit'
  }));

  try {
    const writer = child.takeStdin();
    const reader = child.takeStdout();

    if (writer === undefined || reader === undefined) throw 'Missing adapter pipes.';
    await writeFrame(writer, JSON.stringify({
      seq: 1, type: 'request', command: 'initialize', arguments: {
        clientID: 'tsrust-studio', adapterID: 'lldb', pathFormat: 'path', linesStartAt1: true, columnsStartAt1: true
      }
    }));
    let launched = false;
    let configured = false;
    let thread = 0;
    let initialAddress = '';
    let steppedAddress = '';
    let stepAcknowledged = false;
    let resumed = false;
    let output = '';
    let exited = false;
    let terminated = false;

    while (!launched || !configured || !stepAcknowledged || !resumed || !exited || !terminated) {
      const frame = await readFrame(reader).timeout(10000);
      const reply = JSON.parse<AdapterReply>(frame);

      if (reply.type === 'response') {
        if (reply.success !== true) throw frame;

        if (reply.command === 'initialize') {
          strictEqual(reply.request_seq, 1);
          strictEqual(reply.body?.supportsConfigurationDoneRequest, true);
          strictEqual(reply.body?.supportsFunctionBreakpoints, true);
          await writeFrame(writer, JSON.stringify({
            seq: 2, type: 'request', command: 'launch', arguments: {
              program: clone(program)
            }
          }));
        } else if (reply.command === 'launch') {
          strictEqual(reply.request_seq, 2);
          launched = true;
        } else if (reply.command === 'setFunctionBreakpoints') {
          strictEqual(reply.request_seq, 3);
          const points = clone(reply.body?.breakpoints) ?? [];
          strictEqual(points.length, 1);
          strictEqual(points[0].verified, true);
          await writeFrame(writer, '{"seq":4,"type":"request","command":"configurationDone","arguments":{}}');
        } else if (reply.command === 'configurationDone') {
          strictEqual(reply.request_seq, 4);
          configured = true;
        } else if (reply.command === 'stackTrace') {
          const frames = clone(reply.body?.stackFrames) ?? [];
          strictEqual(frames.length > 0, true);
          strictEqual(frames[0].name.includes('main'), true);
          const address = clone(frames[0].instructionPointerReference) ?? '';
          strictEqual(address !== '', true);

          if (reply.request_seq === 5) {
            initialAddress = clone(address);
            await writeFrame(writer, JSON.stringify({
              seq: 6, type: 'request', command: 'next', arguments: {
                threadId: thread, granularity: 'instruction'
              }
            }));
          } else {
            strictEqual(reply.request_seq, 7);
            strictEqual(address !== initialAddress, true);
            steppedAddress = clone(address);
            await writeFrame(writer, JSON.stringify({
              seq: 8, type: 'request', command: 'scopes', arguments: {
                frameId: frames[0].id
              }
            }));
          }
        } else if (reply.command === 'scopes') {
          strictEqual(reply.request_seq, 8);
          const scopes = clone(reply.body?.scopes) ?? [];
          const registers = scopes.find((scope) => scope.name === 'Registers');

          if (registers === undefined || registers.variablesReference <= 0) throw 'Frame has no register scope.';
          await writeFrame(writer, JSON.stringify({
            seq: 9, type: 'request', command: 'variables', arguments: {
              variablesReference: registers.variablesReference
            }
          }));
        } else if (reply.command === 'variables') {
          const variables = clone(reply.body?.variables) ?? [];

          if (reply.request_seq === 9) {
            const group = variables.find((item) => item.name === 'General Purpose Registers');

            if (group === undefined || group.variablesReference <= 0) throw 'General purpose registers missing.';
            await writeFrame(writer, JSON.stringify({
              seq: 10, type: 'request', command: 'variables', arguments: {
                variablesReference: group.variablesReference
              }
            }));
          } else {
            strictEqual(reply.request_seq, 10);
            const pc = variables.find((item) => item.name === 'pc' || item.name === 'rip');

            if (pc === undefined || pc.value === '') throw 'Program counter missing.';
            strictEqual(parseInt(pc.value.split(' ')[0], 16), parseInt(steppedAddress, 16));
            await writeFrame(writer, JSON.stringify({
              seq: 11, type: 'request', command: 'continue', arguments: {
                threadId: thread
              }
            }));
          }
        } else if (reply.command === 'next') {
          strictEqual(reply.request_seq, 6);
          stepAcknowledged = true;
        } else if (reply.command === 'continue') {
          strictEqual(reply.request_seq, 11);
          resumed = true;
        }
      } else if (reply.event === 'initialized') {
        await writeFrame(writer, '{"seq":3,"type":"request","command":"setFunctionBreakpoints","arguments":{"breakpoints":[{"name":"main"}]}}');
      } else if (reply.event === 'stopped') {
        const firstStop = initialAddress === '';
        strictEqual(reply.body?.reason, firstStop ? 'breakpoint' : 'step');
        const stoppedThread = reply.body?.threadId ?? 0;
        strictEqual(stoppedThread > 0, true);

        if (!firstStop) strictEqual(stoppedThread, thread);
        thread = stoppedThread;
        await writeFrame(writer, JSON.stringify({
          seq: firstStop ? 5 : 7, type: 'request', command: 'stackTrace', arguments: {
            threadId: thread
          }
        }));
      } else if (reply.event === 'output' && reply.body?.category === 'stdout') {
        output += reply.body?.output ?? '';
      } else if (reply.event === 'exited') {
        strictEqual(reply.body?.exitCode, 0);
        exited = true;
      } else if (reply.event === 'terminated') terminated = true;
    }

    strictEqual(output.trim(), 'Studio debugger fixture');
  } finally {
    try {
      unwrap(await child.kill());
    } catch (_) {}

    unwrap(await child.wait());
  }
}

test('LLDB steps a compiled Tsrust program, inspects frame registers and resumes', async () => {
  const folder = unwrap(createTempDir(undefined, 'studio-debug-target-'));

  try {
    const program = folder + '/debug-target';
    const source = unwrap(canonicalize('tests/fixtures/debug-target.tsr'));
    const compiler = unwrap(get('TSRUST')) ?? 'tsrust';
    const build = unwrap(await run(compiler, ['build', source, '-o', clone(program)], {}));
    strictEqual(build.status.success, true);
    await runDebugTarget(unwrap(get('LLDB_DAP')) ?? 'lldb-dap', program).timeout(30000);
  } finally {
    unwrap(removeDirAll(folder));
  }
});
