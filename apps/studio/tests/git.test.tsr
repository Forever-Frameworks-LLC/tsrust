import { createTempDir, mkdirAll, removeFile, removeDirAll, writeTextFile } from 'std:fs';
import { run } from 'std:process';
import { strictEqual, test } from 'std:testing';
import { changedFiles, gitRequest, readGitView } from '../src/services/git.tsr';

test('source control reads status and separate staged and working diffs scoped to the Studio workspace', async () => {
  const root = unwrap(createTempDir(undefined, 'studio-git-'));

  try {
    const sub = root + '/project';
    unwrap(mkdirAll(sub));

    match (await readGitView(sub, 'status')) {
      Ok(_) => {
        throw 'Expected non-repository error';
      },
      Err(error) => {
        strictEqual(error !== '', true);
      }
    }

    strictEqual(unwrap(await run('git', ['init', '-q'], {
      cwd: clone(root)
    })).status.success, true);
    strictEqual(unwrap(await readGitView(sub, 'history')), '');
    unwrap(writeTextFile(sub + '/ré view.txt', 'staged line\n'));
    unwrap(writeTextFile(root + '/outside.txt', 'outside workspace'));
    strictEqual(unwrap(await run('git', ['add', '--', '.'], {
      cwd: clone(root)
    })).status.success, true);
    unwrap(writeTextFile(sub + '/ré view.txt', 'working line\n'));
    unwrap(writeTextFile(sub + '/new.txt', 'untracked'));
    const status = unwrap(await readGitView(sub, 'status'));
    strictEqual(status.includes('AM '), true);
    strictEqual(status.includes('ré view.txt'), true);
    strictEqual(status.includes('?? new.txt'), true);
    strictEqual(status.includes('outside.txt'), false);
    const staged = unwrap(await readGitView(sub, 'staged'));
    strictEqual(staged.includes('+staged line'), true);
    strictEqual(staged.includes('working line') || staged.includes('outside.txt'), false);
    const working = unwrap(await readGitView(sub, 'working'));
    strictEqual(working.includes('-staged line'), true);
    strictEqual(working.includes('+working line'), true);
    const literal = '[x].txt';
    unwrap(writeTextFile(sub + '/' + literal, 'one file'));
    unwrap(writeTextFile(sub + '/x.txt', 'another file'));
    const afterStage = unwrap(await gitRequest(sub, {
      mode: 'status', action: 'stage', path: clone(literal)
    }));
    strictEqual(afterStage.includes('A  [x].txt'), true);
    strictEqual(afterStage.includes('?? x.txt'), true);
    const afterUndo = unwrap(await gitRequest(sub, {
      mode: 'status', action: 'unstage', path: literal
    }));
    strictEqual(afterUndo.includes('?? [x].txt'), true);
    strictEqual(afterUndo.includes('AM '), true);

    for (const path of ['.', '../outside.txt', clone(root)]) {
      match (await gitRequest(sub, {
        mode: 'status', action: 'stage', path: clone(path)
      })) {
        Ok(_) => {
          throw 'Invalid staging target accepted';
        },
        Err(error) => {
          strictEqual(error !== '', true);
        }
      }
    }

    strictEqual(unwrap(await run('git', ['-c', 'user.name=Studio', '-c', 'user.email=test@example.invalid', 'commit', '-qm', 'baseline'], {
      cwd: clone(root)
    })).status.success, true);
    unwrap(writeTextFile(root + '/outside.txt', 'changed outside'));
    strictEqual(unwrap(await run('git', ['-c', 'user.name=Studio', '-c', 'user.email=test@example.invalid', 'commit', '-qm', 'outside only', '--', 'outside.txt'], {
      cwd: clone(root)
    })).status.success, true);
    const history = unwrap(await readGitView(sub, 'history'));
    strictEqual(history.includes('baseline'), true);
    strictEqual(history.includes('outside only'), false);
    unwrap(await gitRequest(sub, {
      mode: 'status', action: 'stage', path: 'ré view.txt'
    }));
    const reset = unwrap(await gitRequest(sub, {
      mode: 'working', action: 'unstage', path: 'ré view.txt'
    }));
    strictEqual(reset.includes('-staged line') && reset.includes('+working line'), true);
    const odd = 'tab\tand\nnewline.txt';
    unwrap(writeTextFile(sub + '/' + odd, 'untracked'));
    unwrap(removeFile(sub + '/ré view.txt'));
    const paths = unwrap(await changedFiles(sub));
    strictEqual(paths.includes(odd), true);
    strictEqual(paths.includes('ré view.txt'), true);
    strictEqual(paths.includes('outside.txt'), false);
    const removed = unwrap(await gitRequest(sub, {
      mode: 'staged', action: 'stage', path: 'ré view.txt'
    }));
    strictEqual(removed.includes('deleted file mode'), true);
    strictEqual(unwrap(await changedFiles(sub)).includes('ré view.txt'), true);
    const restored = unwrap(await gitRequest(sub, {
      mode: 'status', action: 'unstage', path: 'ré view.txt'
    }));
    strictEqual(restored.includes(' D '), true);
  } finally {
    unwrap(removeDirAll(root));
  }
});

async function repoGit(root: ReadOnly<string>, args: string[]): Task<boolean> {
  return unwrap(await run('git', ['-c', 'user.name=Studio', '-c', 'user.email=test@example.invalid', '-c', 'commit.gpgSign=false'].concat(args), {
    cwd: clone(root)
  })).status.success;
}

test('conflicts list only unresolved workspace paths until the saved resolution is staged', async () => {
  const root = unwrap(createTempDir(undefined, 'studio-git-conflicts-'));

  try {
    const sub = root + '/project';
    unwrap(mkdirAll(sub));
    strictEqual(await repoGit(root, ['init', '-q', '-b', 'main']), true);

    for (const branch of ['base', 'topic', 'main']) {
      if (branch === 'topic') strictEqual(await repoGit(root, ['checkout', '-qb', 'topic']), true);

      if (branch === 'main') strictEqual(await repoGit(root, ['checkout', '-q', 'main']), true);
      unwrap(writeTextFile(sub + '/ré view.txt', branch + '\n'));
      unwrap(writeTextFile(root + '/outside.txt', branch + '\n'));
      strictEqual(await repoGit(root, ['add', '--', '.']), true);
      strictEqual(await repoGit(root, ['commit', '-qm', clone(branch)]), true);
    }

    strictEqual(await repoGit(root, ['merge', '--no-edit', 'topic']), false);
    strictEqual(unwrap(await readGitView(sub, 'conflicts')), 'ré view.txt\n');
    unwrap(writeTextFile(sub + '/ré view.txt', 'resolved\n'));
    strictEqual(unwrap(await gitRequest(sub, {
      mode: 'conflicts', action: 'stage', path: 'ré view.txt'
    })), '');
    strictEqual(unwrap(await readGitView(root, 'conflicts')), 'outside.txt\n');
  } finally {
    unwrap(removeDirAll(root));
  }
});
