import { get } from 'std:env';
import { canonicalize, createTempDir, readTextFile, removeDirAll, writeTextFile } from 'std:fs';
import { Channel, delay } from 'std:futures';
import { join } from 'std:path';
import { strictEqual, test } from 'std:testing';

import { DiagnosticRange, LanguageDocument, documentUri, languageIdentity } from '../src/lib/language/diagnostics.tsr';
import { languagePresets } from '../src/lib/language/presets.tsr';
import { languageRoute } from '../src/lib/language/servers.tsr';
import { languageServices } from '../src/services/lsp/registry.tsr';
import { LanguageMessage, LanguageUpdate } from '../src/services/lsp/session.tsr';

interface DefinitionLink {
  targetUri: string;
  targetSelectionRange: DiagnosticRange;
}

async function nextRustUpdate(updates: ReadOnly<Channel<LanguageUpdate>>, kind: string): Task<LanguageUpdate> {
  while (true) {
    const event = await updates.receive();

    if (event.kind === 'failed') throw event.message;

    if (event.kind === kind) return event;
  }
}

test('installed rust-analyzer resolves an unsaved Rust function through the Studio registry', async () => {
  const root = unwrap(canonicalize(unwrap(createTempDir(undefined, 'studio-rust-lsp-'))));
  const path = join(root, 'lib.rs');
  const saved = 'pub fn saved() -> u32 { 1 }\n';
  unwrap(writeTextFile(join(root, 'Cargo.toml'), '[package]\nname = "studio_rust_fixture"\nversion = "0.1.0"\nedition = "2021"\n[lib]\npath = "lib.rs"\n'));
  unwrap(writeTextFile(path, saved));
  const server = languagePresets().find((entry) => entry.id === 'rust');

  if (server === undefined) throw 'Missing Rust preset.';
  server.program = unwrap(get('RUST_ANALYZER')) ?? 'rust-analyzer';
  const route = languageRoute([clone(server)], path);

  if (route === undefined) throw 'Rust source has no service route.';
  const messages = new Channel<LanguageMessage>(16);
  const updates = new Channel<LanguageUpdate>(16);
  const requests = messages.sender();
  const worker = languageServices(clone(root), [server], messages, updates.sender()).start();

  try {
    await requests.send({
      server: clone(route.server), kind: 'start', generation: 0
    });
    const ready = await nextRustUpdate(updates, 'ready').timeout(20000);
    const document: LanguageDocument = {
      server: clone(route.server), languageId: clone(route.language), path: clone(path), session: 'rust-one', revision: 1, version: 1, text: 'pub fn draft_only() -> u32 { 2 }\npub fn caller() -> u32 { draft_only() }\n'
    };
    await requests.send({
      server: clone(route.server), kind: 'document', generation: ready.generation, document: clone(document)
    });
    // Initialization can finish before rust-analyzer has loaded the crate graph.
    let hover = '';

    for (let attempt = 0; attempt < 50; attempt += 1) {
      const id = 'rust-hover-' + attempt.toString();
      await requests.send({
        server: clone(route.server), kind: 'query', generation: ready.generation, query: {
          id: clone(id), method: 'textDocument/hover', document: languageIdentity(document), position: {
            line: 1, character: 28
          }
        }
      });
      const reply = await nextRustUpdate(updates, 'query').timeout(10000);
      strictEqual(reply.query?.id, id);
      hover = reply.result ?? '';

      if (hover.includes('draft_only') && hover.includes('u32')) break;
      await delay(200);
    }

    strictEqual(hover.includes('draft_only') && hover.includes('u32'), true, hover);
    await requests.send({
      server: clone(route.server), kind: 'query', generation: ready.generation, query: {
        id: 'rust-definition', method: 'textDocument/definition', document: languageIdentity(document), position: {
          line: 1, character: 28
        }
      }
    });
    const definition = await nextRustUpdate(updates, 'query').timeout(10000);
    strictEqual(definition.query?.id, 'rust-definition');
    const result = definition.result ?? '';
    const links = JSON.parse<DefinitionLink[]>(result);
    strictEqual(links.length, 1);
    strictEqual(links[0].targetUri, documentUri(path));
    strictEqual(links[0].targetSelectionRange.start.line, 0);
    strictEqual(links[0].targetSelectionRange.start.character, 7);
    strictEqual(links[0].targetSelectionRange.end.line, 0);
    strictEqual(links[0].targetSelectionRange.end.character, 17);
    strictEqual(unwrap(readTextFile(path)), saved);
  } finally {
    worker.cancel();

    try {
      await worker;
    } catch (_) {}

    unwrap(removeDirAll(root));
  }
});
