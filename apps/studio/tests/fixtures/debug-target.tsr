import { readTextFile } from 'std:fs';

function main(): void {
  match (readTextFile('studio-debug-mode', 64)) {
    Ok(mode) => {
      if (mode === 'fail') throw 'Requested fixture failure';
    },
    Err(_) => {}
  }

  console.log('Studio debugger fixture');
  console.log('');
  const answer = twice(6);

  if (answer !== 12) throw 'Unexpected result';
}

function twice(n: int): int {
  return n * 2;
}
