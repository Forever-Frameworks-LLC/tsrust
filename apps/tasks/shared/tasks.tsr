export interface TaskRecord {
  id: string;
  title: string;
  description: string;
  status: 'todo' | 'in_progress' | 'done';
  priority: int;
  assignee: string;
  due_date: string | null;
  version: int;
  updated_at: string;
}

export interface Snapshot {
  cursor: int;
  tasks: TaskRecord[];
}
