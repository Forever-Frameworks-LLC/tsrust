import { get } from 'std:env';
import { Client, request } from 'std:http';
import { connect } from 'std:sql';
import { test, strictEqual } from 'std:testing';
import { Snapshot } from '../../shared/tasks.tsr';

test('HTTP snapshots include external database changes and their committed cursor', async () => {
  const url = unwrap(get('DATABASE_URL'));
  const api = unwrap(get('WORKLIST_API_URL'));

  if (url === undefined || api === undefined) throw 'Set DATABASE_URL and WORKLIST_API_URL.';
  const pool = await connect(url, 2);
  await pool.execute("INSERT INTO tasks(id, title) VALUES ('snapshot-test', 'Ship café update')");

  try {
    const markers = await pool.query("SELECT MAX(sequence) AS cursor FROM task_changes WHERE task_id = 'snapshot-test'");
    const committed = unwrap(markers[0].int('cursor'));
    const client = new Client();
    const response = await client.send(request('GET', api + '/snapshot', ''));
    strictEqual(response.status(), 200);
    const snapshot = JSON.parse<Snapshot>(await response.text());
    const record = snapshot.tasks.find((task) => task.id === 'snapshot-test');

    if (record === undefined) throw 'Snapshot omitted the committed external change.';
    strictEqual(record.title, 'Ship café update');
    strictEqual(record.version, 1);
    strictEqual(snapshot.cursor >= committed, true);
  } finally {
    await pool.execute("DELETE FROM tasks WHERE id = 'snapshot-test'");
    await pool.close();
  }
});
