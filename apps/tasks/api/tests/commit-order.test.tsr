import { toHex } from 'std:bytes';
import { randomBytes } from 'std:crypto';
import { get } from 'std:env';
import { Channel, Sender, all, delay } from 'std:futures';
import { Client, request } from 'std:http';
import { Pool, Transaction, connect } from 'std:sql';
import { test, strictEqual } from 'std:testing';

import { Snapshot, ChangeBatch } from '../../shared/tasks.tsr';
import { routes } from '../src/application.tsr';

async function queuedWrite(pool: ReadOnly<Pool>, ready: Sender<int>, id: string): Task<void> {
  await ready.send(1);
  await pool.execute("INSERT INTO tasks(id, title) VALUES ($1, 'Queued commit')", [id]);
}

async function observeThenCommit(
  transaction: Owned<Transaction>,
  pool: ReadOnly<Pool>,
  ready: ReadOnly<Channel<int>>,
  base: ReadOnly<string>,
  first: ReadOnly<string>,
  second: ReadOnly<string>,
  cursor: int
): Task<void> {
  await ready.receive();
  let blocked = false;

  for (let attempt = 0; attempt < 200 && !blocked; attempt++) {
    const waiters = await pool.query("SELECT COUNT(*) AS total FROM pg_stat_activity WHERE datname = current_database() AND wait_event = 'advisory' AND query LIKE 'INSERT INTO tasks(id, title)%'");
    blocked = unwrap(waiters[0].int('total')) > 0;

    if (!blocked) await delay(10);
  }

  strictEqual(blocked, true);
  const client = new Client();
  const response = await client.send(request('GET', base + '/snapshot', ''));
  const snapshot = JSON.parse<Snapshot>(await response.text());
  strictEqual(snapshot.cursor, cursor);
  strictEqual(snapshot.tasks.some((task) => task.id === first || task.id === second), false);
  const pending = await client.send(request('GET', base + '/changes?after=' + cursor.toString(), ''));
  strictEqual(JSON.parse<ChangeBatch>(await pending.text()).changes.length, 0);
  await transaction.commit();
}

test('concurrent writers cannot commit behind an acknowledged cursor and rollback gaps remain resumable', async () => {
  const url = unwrap(get('DATABASE_URL'));

  if (url === undefined) throw 'Set DATABASE_URL.';
  const database: string = url;
  const pool = await connect(clone(database), 4);
  const app = routes(await connect(database, 2));
  const server = await app.listen('127.0.0.1:0');
  const base = 'http://' + server.address();
  const first = 'commit-order-first-' + unwrap(toHex(unwrap(randomBytes(16))));
  const second = first + '-second';

  try {
    const client = new Client();
    const initial = await client.send(request('GET', base + '/snapshot', ''));
    const before = JSON.parse<Snapshot>(await initial.text());
    const rolledBack = await pool.begin();
    await rolledBack.execute("INSERT INTO tasks(id, title) VALUES ($1, 'Rolled back')", [clone(first)]);
    const allocated = await rolledBack.query('SELECT MAX(sequence) AS cursor FROM task_changes');
    const gap = unwrap(allocated[0].int('cursor'));
    await rolledBack.rollback();
    const transaction = await pool.begin();
    await transaction.execute("INSERT INTO tasks(id, title) VALUES ($1, 'First commit')", [clone(first)]);
    const ready = new Channel<int>(1);
    const sender = ready.sender();
    const queuedId = clone(second);
    await all([observeThenCommit(
      transaction,
      pool,
      ready,
      base,
      first,
      second,
      before.cursor
    ), queuedWrite(pool, sender, queuedId)]);
    const reply = await client.send(request('GET', base + '/changes?after=' + before.cursor.toString(), ''));
    const batch = JSON.parse<ChangeBatch>(await reply.text());
    strictEqual(batch.changes.length, 2);
    strictEqual(batch.changes[0].id, first);
    strictEqual(batch.changes[1].id, second);
    strictEqual(batch.changes[0].sequence > gap, true);
    strictEqual(batch.changes[1].sequence > batch.changes[0].sequence, true);
    strictEqual(batch.cursor, batch.changes[1].sequence);
    const current = await client.send(request('GET', base + '/snapshot', ''));
    const snapshot = JSON.parse<Snapshot>(await current.text());
    strictEqual(snapshot.cursor, batch.cursor);
    strictEqual(snapshot.tasks.filter((task) => task.id === first || task.id === second).length, 2);
  } finally {
    await pool.execute('DELETE FROM tasks WHERE id = $1 OR id = $2', [first, second]);
    await server.shutdown();
    await pool.close();
  }
});
