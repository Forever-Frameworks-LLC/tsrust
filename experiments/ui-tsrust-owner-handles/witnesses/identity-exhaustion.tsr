import { strictEqual } from 'std:testing';
import { Owner, Handle, runtime, root, mount, add, read, enqueue, drain, values } from './owner.tsr';

function increment(owner: Mutable<Owner>, handle: ReadOnly<Handle>, delta: int): void {
  add(owner, handle, delta);
}

function main(): void {
  const left = runtime();
  const right = runtime();
  const a = left();
  const lastOwner = left();
  const b = right();
  strictEqual(a.runtime, 1);
  strictEqual(b.runtime, 2);
  strictEqual(a.id, 1);
  strictEqual(lastOwner.id, 2);
  strictEqual(b.id, 1);
  const parent = root(a);
  const first = mount(a, parent, 'first', 7, increment);
  const last = mount(a, parent, 'last', 9, increment);
  strictEqual(first.instance, 1);
  strictEqual(last.instance, 2);
  strictEqual(a.next, 3);
  enqueue(a, first, 1);
  for (let i = 0; i < 2; i++) {
    let failed = false;
    try {
      runtime();
    } catch (error) {
      strictEqual(error, 'runtime identity exhausted');
      failed = true;
    }

    strictEqual(failed, true);
    failed = false;
    try {
      left();
    } catch (error) {
      strictEqual(error, 'owner identity exhausted');
      failed = true;
    }

    strictEqual(failed, true);
    failed = false;
    try {
      mount(a, parent, 'overflow', 999, increment);
    } catch (error) {
      strictEqual(error, 'instance identity exhausted');
      failed = true;
    }

    strictEqual(failed, true);
    strictEqual(a.next, 3);
    strictEqual(a.nodes.length, 2);
    strictEqual(a.handlers.length, 2);
    strictEqual(a.queue.length, 1);
    strictEqual(a.retired.length, 0);
    strictEqual(values(a, parent), 'first:7;last:9;');
  }

  const lastOther = right();
  strictEqual(lastOther.id, 2);
  strictEqual(lastOther.runtime, 2);
  strictEqual(drain(a), 'ok;');
  strictEqual(read(a, first), 8);
  strictEqual(read(a, last), 9);
  console.log('PASS identity exhaustion: last runtime/owner/instance; repeated rejection preserves state');
}
