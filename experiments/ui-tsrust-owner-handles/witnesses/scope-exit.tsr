import { strictEqual } from 'std:testing';
import { Domain, Owner, Handle, create, root, mount, add } from './owner.tsr';

function orphan(domain: Mutable<Domain>): Handle {
  const owner = create(domain);
  const parent = root(owner);
  return mount(owner, parent, 'item', 0, (state: Mutable<Owner>, handle: ReadOnly<Handle>, delta: int): void => {
    add(state, handle, delta);
  });
}

function main(): void {
  const domain: Domain = {
    next: 1
  };
  const handle = orphan(domain);
  strictEqual(handle.owner, 1);
  strictEqual(handle.instance, 1);
  // This proves handle escape, not observable state/capture destruction.
  console.log('BLOCKED: exact state/capture destruction is not observable in these witnesses');
}
