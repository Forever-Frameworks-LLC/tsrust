import { strictEqual } from "std:testing";

function main() {
  const values = new Set<int>([3, 1, 3, 2]);
  let count = 0;
  values.forEach(() => {
    count = count + 1;
  });
  strictEqual(count, 3);
  let total = 0;
  values.forEach((value) => {
    total = total + value;
  });
  strictEqual(total, 6);
  let order = "";
  values.forEach((value, key, source) => {
    strictEqual(value, key);
    strictEqual(source.has(value), true);
    strictEqual(source.size, 3);
    order = order + String(value);
  });
  strictEqual(order, "312");
  const names = new Set<string>([String("one"), String("two")]);
  let text = "";
  names.forEach((value, key) => {
    strictEqual(value, key);
    text = text + value;
  });
  strictEqual(text, "onetwo");
  names.clear();
  strictEqual(names.size, 0);
  const empty = new Set<int>();
  let seen = 0;
  empty.forEach(() => {
    seen = seen + 1;
  });
  strictEqual(seen, 0);
  let caught = 0;
  let visited = "";
  try {
    values.forEach((value) => {
      visited = visited + String(value);
      if (value === 1) {
        throw "stop";
      }
    });
  } catch (error) {
    if (typeof error === "string") {
      strictEqual(error, "stop");
      caught = 1;
    }
  }

  strictEqual(caught, 1, "callback error must reach catch");
  strictEqual(visited, "31");
  strictEqual(values.size, 3);
  let cleanup = 0;
  try {
    try {
      values.forEach((value) => {
        if (value === 3) {
          throw "done";
        }
      });
    } finally {
      cleanup = cleanup + 1;
    }
  } catch (error) {
    if (typeof error === "string") {
      strictEqual(error, "done");
    }
  }

  strictEqual(cleanup, 1);
}
