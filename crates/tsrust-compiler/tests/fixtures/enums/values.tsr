import { strictEqual } from 'std:testing';

type Box<T> = {
    value: T;
};
enum Flag {
    Read = 1 << 0, Write = 1 << 1, Both = Flag.Read | Write, Inverse = ~0
}

enum Phase {
    Ready, Busy = 4, Done, Duplicate = 4
}

enum Label {
    Short = "s", Long = "long"
}

enum Fraction {
    Half = 0.5, Next
}

type Envelope = {
    phase: Phase;
};

function advance(value: Phase): Phase {
    if (value === Phase.Ready) {
        return Phase.Busy;
    }

    return Phase.Done;
}

function main() {
    strictEqual(Number(Flag.Both), 3.0);
    strictEqual(Number(Flag.Inverse), -1.0);
    const ready = Phase.Ready;
    strictEqual(Number(ready), 0.0);
    strictEqual(Number(Phase.Done), 5.0);
    strictEqual(Phase.Busy === Phase.Duplicate, true);
    strictEqual(advance(ready) === Phase.Busy, true);
    strictEqual(ready === Phase.Ready, true);
    strictEqual(String(Label.Long), "long");
    strictEqual(typeof Phase.Ready, "number");
    strictEqual(typeof Label.Short, "string");
    strictEqual(String(Phase.Busy), "4");
    strictEqual(Boolean(Phase.Ready), false);
    strictEqual(Boolean(Phase.Busy), true);
    strictEqual(Phase.Done, Phase.Done);
    strictEqual(Label.Short, Label.Short);
    const choice: Phase | string = Phase.Ready;
    if (typeof choice === "number") {
        strictEqual(Number(choice), 0.0);
    }

    strictEqual(Number(Fraction.Next), 1.5);
    const envelope: Envelope = {
        phase: ready
    };
    strictEqual(envelope.phase === Phase.Ready, true);
    const phases: Phase[] = [ready, Phase.Busy];
    phases.push(Phase.Done);
    strictEqual(phases[0] === ready, true);
    strictEqual(phases.includes(Phase.Busy), true);
    const mapped = phases.map((phase: Phase): number => Number(phase));
    strictEqual(mapped[2], 5.0);
    let count = 0;
    for (const phase of phases) {
        count = count + 1;
    }

    strictEqual(count, 3);
}
