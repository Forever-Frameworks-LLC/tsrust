import { alloc, view, length, at } from "std:bytes";
import { strictEqual } from "std:testing";

function main() {
  match (alloc(3, 65)) {
    Ok(bytes) => {
      match (view(bytes, 1, 3)) {
        Ok(part) => {
          strictEqual(length(part), 2);
          match (at(part, 0)) {
            Ok(value) => {
              strictEqual(value, 65);
            },
            Err(error) => {
              throw error.message;
            },
          }
        },
        Err(error) => {
          throw error.message;
        },
      }
    },
    Err(error) => {
      throw error.message;
    },
  }
}
