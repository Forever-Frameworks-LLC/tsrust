import { Bytes, ByteView, fromUtf8, view, length } from "std:bytes";
import { strictEqual } from "std:testing";

type Picker = {
  pick: Once<Function<ByteView, [Owned<ByteView>]>>;
  marker: int;
};

function slice(bytes: ReadOnly<Bytes>, start: int, end: int): ByteView {
  match (view(bytes, start, end)) {
    Ok(part) => {
      return part;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function choose(bytes: ReadOnly<Bytes>): ByteView {
  const picker: Picker = {
    pick: (other: Owned<ByteView>) => other, marker: 1
  };
  return picker.pick(slice(bytes, 1, 3));
}

function direct(bytes: ReadOnly<Bytes>): ByteView {
  const pick = (other: Owned<ByteView>): ByteView => other;
  return pick(slice(bytes, 2, 5));
}

function captured(first: ByteView, second: ByteView): ByteView {
  const picker: Picker = {
    pick: (other: Owned<ByteView>) => {
      const kept = first;
      strictEqual(length(kept), 1);
      return other;
    }, marker: 2
  };
  return picker.pick(second);
}

function localCaptured(first: ByteView, second: ByteView): ByteView {
  const pick = (other: Owned<ByteView>): ByteView => {
    const kept = first;
    strictEqual(length(kept), 1);
    return other;
  };
  return pick(second);
}

function main() {
  match (fromUtf8("hello")) {
    Ok(bytes) => {
      strictEqual(length(choose(bytes)), 2);
      strictEqual(length(direct(bytes)), 3);
      strictEqual(length(captured(slice(bytes, 0, 1), slice(bytes, 1, 4))), 3);
      strictEqual(length(localCaptured(slice(bytes, 0, 1), slice(bytes, 2, 4))), 2);
    },
    Err(error) => {
      throw error.message;
    },
  }
}
