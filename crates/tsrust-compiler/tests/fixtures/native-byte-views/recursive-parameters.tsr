import { Bytes, ByteView, alloc, view, length, at } from "std:bytes";
import { strictEqual } from "std:testing";

type Holder = {
  data: ByteView;
  read: Once<Function<ByteView>>;
  next?: Holder;
};

function bytes(value: int): Bytes {
  match (alloc(2, value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function read(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, 2)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function build(first: ByteView, second: ByteView): Holder {
  return {
    data: first, read: () => second
  };
}

function take(holder: Holder) {
  return holder.read;
}

function size(holder: ReadOnly<Holder>): int {
  return length(holder.data);
}

function relay(holder: Holder): Holder {
  return holder;
}

function main() {
  const first = bytes(3);
  const second = bytes(7);
  const holder = relay(build(read(first), read(second)));
  strictEqual(size(holder), 2);
  const callback = take(holder);
  const result = callback();
  match (at(result, 0)) {
    Ok(value) => {
      strictEqual(value, 7);
    },
    Err(error) => {
      throw error.message;
    },
  }
}
