import { strictEqual } from 'std:testing';
import { person, settings, requests, recordRequest, configure } from './state.tsr';

function main() {
  recordRequest();
  recordRequest();
  configure(5);
  strictEqual(requests, 2);
  strictEqual(settings.retries, 5);
  const copy = clone(settings);
  copy.retries = 9;
  strictEqual(settings.retries, 5);
  {
    const outcome0 = person.safeParseJson('{"name":"Ada","age":30}');
    if (outcome0.success) {
      const value = outcome0.data;
      strictEqual(value.name, 'Ada');
    } else {
      const error = outcome0.error;
      throw 'Expected valid person';
    }
  }
}
