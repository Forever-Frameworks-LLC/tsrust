import { Bytes, ByteView, alloc, view, length, at } from "std:bytes";
import { strictEqual } from "std:testing";

type Holder = {
  read: Once<Function<ByteView>>;
  next?: Holder;
};

function bytes(value: int): Bytes {
  match (alloc(2, value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function read(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, 2)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function build(first: ByteView, second: ByteView): Holder {
  return {
    read: () => second
  };
}

function keep(second: ByteView): Holder {
  const unused = bytes(3);
  return build(read(unused), second);
}

export function run() {
  const owner = bytes(7);
  const holder = keep(read(owner));
  const result = holder.read();
  strictEqual(length(result), 2);
}
