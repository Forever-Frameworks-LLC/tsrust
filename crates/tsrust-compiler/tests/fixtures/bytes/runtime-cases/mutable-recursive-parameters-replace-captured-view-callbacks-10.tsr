import { Bytes, ByteViewMut, alloc, viewMut, length, at } from "std:bytes";
import { strictEqual } from "std:testing";

type Holder = {
  data: ByteViewMut;
  read: Once<Function<ByteViewMut>>;
  next?: Holder;
};

function bytes(value: int): Bytes {
  match (alloc(2, value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function read(owner: Mutable<Bytes>): ByteViewMut {
  match (viewMut(owner, 0, 2)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function build(first: ByteViewMut, second: ByteViewMut): Holder {
  return {
    data: first, read: () => second
  };
}

function replace(holder: Mutable<Holder>, replacement: ByteViewMut): void {
  holder.read = () => replacement;
}

export function run() {
  const first = bytes(3);
  const second = bytes(7);
  const third = bytes(11);
  const holder = build(read(first), read(second));
  replace(holder, read(third));
  const result = holder.read();
  match (at(result, 0)) {
    Ok(value) => {
      strictEqual(value, 11);
    },
    Err(error) => {
      throw error.message;
    },
  }
}
