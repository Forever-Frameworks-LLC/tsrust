import { Bytes, ByteView, alloc, view, length, at } from "std:bytes";
import { strictEqual } from "std:testing";

type Holder = {
  read?: Once<Function<ByteView>>;
  next?: Holder;
};

function bytes(value: int): Bytes {
  match (alloc(2, value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function read(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, 2)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    },
  }
}

function build(first: ByteView, second: ByteView): Holder {
  return {
    read: () => second
  };
}

function other(first: ByteView, second: ByteView): Holder {
  return {
    read: () => second
  };
}

function empty(first: ByteView): Holder {
  return {};
}

function vacant(): Holder {
  const short = bytes(9);
  return empty(read(short));
}

export function run() {
  const owner = bytes(7);
  const holder = vacant();
  strictEqual(holder.read === undefined, true);
  const value = read(owner);
  holder.read = () => value;
  const result = holder.read!();
  strictEqual(length(result), 2);
}
