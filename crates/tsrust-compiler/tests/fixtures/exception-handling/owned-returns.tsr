import { strictEqual } from "std:testing";

type Row = {
  name: string;
  other: string;
};

function take(row: Row, early: boolean, trace: int[]): string {
  try {
    try {
      if (early) {
        return row.name;
      }
    } finally {
      trace.push(row.other.length);
    }
  } finally {
    trace.push(9);
  }

  return row.name;
}

type CleanupHolder = {
  run: ReadOnly<Function<int>>;
};

function takeWithCallbacks(row: Row, early: boolean, trace: int[]): string {
  const old = [3];
  const current = [7];
  const handlers = new Map<string, CleanupHolder>();
  handlers.set("old", {
    run: (): int => old[0]
  });
  try {
    try {
      if (early) {
        return row.name;
      }

      handlers.clear();
      handlers.set("new", {
        run: (): int => current[0]
      });
      throw 32;
    } finally {}
  } catch (error) {
    trace.push(32);
  } finally {
    const item = handlers.get(early ? "old" : "new");
    if (item !== undefined) {
      trace.push(item.run());
    }
  }

  return row.name;
}

function selectWithCleanup(row: Row, early: boolean, replace: boolean): string {
  try {
    if (early) {
      return row.name;
    }
  } finally {
    if (replace) {
      return row.other;
    }
  }

  return row.other;
}

function takeThroughLoop(row: Row, mode: int, trace: int[]): string {
  for (let i = 0; i < 2; i += 1) {
    try {
      if (mode === 0) {
        return row.name;
      }

      if (mode === 1 || mode === 2) {
        throw mode;
      }
    } catch (error) {
      if (mode === 1) {
        break;
      }

      if (mode === 2) {
        continue;
      }
    } finally {
      trace.push(i);
    }
  }

  return row.name;
}

function takeThroughCatch(row: Row, mode: int, trace: int[]): string {
  try {
    if (mode === 0) {
      return row.name;
    }

    if (mode === 1) {
      throw 31;
    }

    trace.push(29);
  } catch (error) {
    trace.push(30);
    if (mode === 1) {
      return row.name;
    }
  } finally {
    trace.push(31);
  }

  return row.name;
}

type CallbackFieldOwner = {
  text: string;
  run: ReadOnly<Function<int>>;
};

function takeCapturedCallbackField(row: Row, early: boolean, trace: int[]): string {
  const lengths = [row.other.length];
  const owner: CallbackFieldOwner = {
    text: row.name, run: (): int => lengths[0]
  };
  const action = (): string => {
    try {
      if (early) {
        return owner.text;
      }
    } finally {
      trace.push(owner.run());
    }

    return owner.text;
  };
  return action();
}

function main() {
  const capturedTrace: int[] = [];
  strictEqual(takeCapturedCallbackField({
    name: "first", other: "one"
  }, true, capturedTrace), "first");
  strictEqual(takeCapturedCallbackField({
    name: "second", other: "four"
  }, false, capturedTrace), "second");
  strictEqual(capturedTrace.join(","), "3,4");
  const trace: int[] = [];
  strictEqual(take({
    name: "first", other: "one"
  }, true, trace), "first");
  strictEqual(take({
    name: "second", other: "four"
  }, false, trace), "second");
  strictEqual(trace.join(","), "3,9,4,9");
  const callbackTrace: int[] = [];
  strictEqual(takeWithCallbacks({
    name: "first", other: "one"
  }, true, callbackTrace), "first");
  strictEqual(takeWithCallbacks({
    name: "second", other: "two"
  }, false, callbackTrace), "second");
  strictEqual(callbackTrace.join(","), "3,32,7");
  strictEqual(selectWithCleanup({
    name: "left", other: "right"
  }, true, false), "left");
  strictEqual(selectWithCleanup({
    name: "left", other: "right"
  }, false, false), "right");
  strictEqual(selectWithCleanup({
    name: "left", other: "right"
  }, true, true), "right");
  strictEqual(selectWithCleanup({
    name: "left", other: "right"
  }, false, true), "right");
  for (let mode = 0; mode < 4; mode += 1) {
    const loopTrace: int[] = [];
    strictEqual(takeThroughLoop({
      name: "owner", other: "sibling"
    }, mode, loopTrace), "owner");
    strictEqual(loopTrace.join(","), mode < 2 ? "0" : "0,1");
  }

  for (let mode = 0; mode < 3; mode += 1) {
    const catchTrace: int[] = [];
    strictEqual(takeThroughCatch({
      name: "owner", other: "sibling"
    }, mode, catchTrace), "owner");
    strictEqual(catchTrace.join(","), mode === 0 ? "31" : mode === 1 ? "30,31" : "29,31");
  }
}
