import { strictEqual } from "std:testing";

type Row = {
  name: string;
  other: string;
};

function take(row: Row, early: boolean, trace: int[]): string {
  try {
    try {
      if (early) {
        return row.name;
      }
    } finally {
      trace.push(row.other.length);
    }
  } finally {
    trace.push(9);
  }

  return row.name;
}

type CleanupHolder = {
  run: ReadOnly<Function<int>>;
};

function takeWithCallbacks(row: Row, early: boolean, trace: int[]): string {
  const old = [3];
  const current = [7];
  const handlers = new Map<string, CleanupHolder>();
  handlers.set("old", {
    run: (): int => old[0]
  });
  try {
    if (early) {
      return row.name;
    }

    handlers.clear();
    handlers.set("new", {
      run: (): int => current[0]
    });
  } finally {
    const item = handlers.get(early ? "old" : "new");
    if (item !== undefined) {
      trace.push(item.run());
    }
  }

  return row.name;
}

function selectWithCleanup(row: Row, early: boolean, replace: boolean): string {
  try {
    if (early) {
      return row.name;
    }
  } finally {
    if (replace) {
      return row.other;
    }
  }

  return row.other;
}

function main() {
  const trace: int[] = [];
  strictEqual(take({
    name: "first", other: "one"
  }, true, trace), "first");
  strictEqual(take({
    name: "second", other: "four"
  }, false, trace), "second");
  strictEqual(trace.join(","), "3,9,4,9");
  const callbackTrace: int[] = [];
  strictEqual(takeWithCallbacks({
    name: "first", other: "one"
  }, true, callbackTrace), "first");
  strictEqual(takeWithCallbacks({
    name: "second", other: "two"
  }, false, callbackTrace), "second");
  strictEqual(callbackTrace.join(","), "3,7");
  strictEqual(selectWithCleanup({
    name: "left", other: "right"
  }, true, false), "left");
  strictEqual(selectWithCleanup({
    name: "left", other: "right"
  }, false, false), "right");
  strictEqual(selectWithCleanup({
    name: "left", other: "right"
  }, true, true), "right");
  strictEqual(selectWithCleanup({
    name: "left", other: "right"
  }, false, true), "right");
}
