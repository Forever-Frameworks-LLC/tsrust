function main() {
    const source = [3, 1, 2];
    const copy = Array.from(source);
    copy.push(9);
    console.log(source.join(","), copy.join(","));
    console.log(Array.from([1, 2, 3], (value: int, index: int): int => {
        return value * 10 + index;
    }).join(","));
    console.log(Array.from("aé😀").join("|"), Array.from("").length);
    console.log(Array.from(new Set<int>([3, 1, 3]), (value, index) => {
        return value * 10 + index;
    }).join(","));
    const values = new Map<string, int>([["a", 2], ["b", 3]]);
    const pairs = Array.from(values);
    pairs[0][1] = 9;
    console.log(Array.from(values, ([key, value], index) => {
        return key + String(value + index);
    }).join("|"), pairs[0][1]);
    console.log(Array.from([4], (value: int, index: int, extra: int = 7) => {
        return value + index + extra;
    }).join(","));
}
