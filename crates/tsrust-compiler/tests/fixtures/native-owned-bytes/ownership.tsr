import { Bytes, ByteError, alloc, at, set, resize, append, copy, length } from "std:bytes";
import { strictEqual } from "std:testing";

type Holder = {
    bytes: Bytes;
};

type State = {
    finalized: int;
    calls: int;
};

function make(size: int, fill: int): Bytes {
    match (alloc(size, fill)) {
        Ok(bytes) => {
            return bytes;
        },
        Err(error) => {
            throw error.message;
        },
    }
}

function read(bytes: ReadOnly<Bytes>, index: int): int {
    match (at(bytes, index)) {
        Ok(value) => {
            return value;
        },
        Err(error) => {
            throw error.message;
        },
    }
}

function write(bytes: Mutable<Bytes>, index: int, value: int): void {
    match (set(bytes, index, value)) {
        Ok(_) => {
        },
        Err(error) => {
            throw error.message;
        },
    }
}

function identity<T>(value: T): T {
    return value;
}

function factory(bytes: Bytes): Function<int> {
    return (): int => {
        return length(bytes);
    };
}

function once(bytes: Bytes): Once<Function<Bytes>> {
    return (): Bytes => {
        return bytes;
    };
}

function failing(bytes: Bytes): Function<int> {
    return (): int => {
        throw String(length(bytes));
    };
}

function finish(bytes: Bytes, state: Mutable<State>, fail: boolean): Bytes {
    const spare = clone(bytes);
    try {
        if (fail) {
            throw "expected";
        }

        return bytes;
    } finally {
        state.finalized += length(spare);
    }
}

function tick(state: Mutable<State>, value: int): int {
    state.calls += 1;
    return value;
}

function values(state: Mutable<State>): int[] {
    state.calls += 1;
    return [7, 8];
}

function exercise(): void {
    const bytes = make(3, 65);
    const other = clone(bytes);
    write(bytes, 0, 90);
    strictEqual(read(other, 0), 65);
    write(other, 1, 7);
    strictEqual(read(bytes, 1), 65);
    const rows: Holder[] = [{
        bytes: identity(bytes)
    }];
    const copiedRows = clone(rows);
    const row = rows.remove(0);
    write(row.bytes, 1, 9);
    strictEqual(read(copiedRows[0].bytes, 1), 65);
    const map = new Map<int, Bytes>();
    map.set(1, row.bytes);
    const mapCopy = clone(map);
    map.clear();
    strictEqual(length(mapCopy.get(1)!), 3);
    const optional: Bytes | undefined = make(2, 1);
    const optionalCopy = clone(optional);
    strictEqual(length(optionalCopy!), 2);
    let result: Result<Bytes, ByteError> = alloc(4, 2);
    const resultCopy = clone(result);
    result = alloc(1, 3);
    match (resultCopy) {
        Ok(saved) => {
            strictEqual(length(saved), 4);
        },
        Err(error) => {
            throw error.message;
        },
    }

    const action = factory(make(5, 4));
    strictEqual(action(), 5);
    strictEqual(action(), 5);
    const take = once(make(6, 5));
    const taken = take();
    strictEqual(length(taken), 6);
    const unused = once(make(7, 6));
    const failure = failing(make(8, 7));
    try {
        failure();
    } catch (error) {
        strictEqual(error, "8");
    }

    const state: State = {
        finalized: 0, calls: 0
    };
    const returned = finish(make(2, 8), state, false);
    strictEqual(length(returned), 2);
    try {
        finish(make(3, 9), state, true);
    } catch (error) {
        strictEqual(error, "expected");
    }

    strictEqual(state.finalized, 5);
    match (alloc(tick(state, 2), tick(state, 0))) {
        Ok(counted) => {
            match (resize(counted, tick(state, 4), tick(state, 1))) {
                Ok(_) => {
                },
                Err(error) => {
                    throw error.message;
                },
            }

            match (append(counted, values(state))) {
                Ok(_) => {
                },
                Err(error) => {
                    throw error.message;
                },
            }

            match (copy(counted, tick(state, 1), tick(state, 3))) {
                Ok(part) => {
                    strictEqual(length(part), 2);
                },
                Err(error) => {
                    throw error.message;
                },
            }

            strictEqual(length(counted), 6);
        },
        Err(error) => {
            throw error.message;
        },
    }

    strictEqual(state.calls, 7);
}

function main() {
    exercise();
}
