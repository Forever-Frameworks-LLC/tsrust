import { strictEqual } from 'std:testing';

enum State {
    Ready, Busy
}

function make(): Set<int> {
    return new Set<int>([4, 4]);
}

function sizeOf<T>(values: Set<T>): int {
    return values.size;
}

function main() {
    const values = new Set<int>([3, 1, 3, 2]);
    strictEqual(values.size, 3);
    strictEqual(values.has(3), true);
    strictEqual(values.has(9), false);
    values.add(4);
    values.add(1);
    strictEqual(values.size, 4);
    strictEqual(values.delete(1), true);
    strictEqual(values.delete(1), false);
    values.add(1);
    let order = "";
    for (const value of values) {
        order = order + String(value);
    }

    strictEqual(order, "3241");
    const snapshot = values.values();
    strictEqual(snapshot.join(","), "3,2,4,1");
    values.clear();
    strictEqual(values.size, 0);
    strictEqual(snapshot.length, 4);

    const numbers = new Set<number>([NaN, NaN, - 0.0, 0.0, Infinity]);
    strictEqual(numbers.size, 3);
    strictEqual(numbers.has(NaN), true);
    strictEqual(numbers.has(- 0.0), true);
    strictEqual(numbers.delete(NaN), true);
    strictEqual(numbers.size, 2);

    const words = [String("one"), String("two"), String("one")];
    const names: Set<string> = new Set(words);
    strictEqual(words.length, 3);
    strictEqual(names.size, 2);
    let joined = "";
    for (const word of names) {
        joined = joined + word;
    }

    strictEqual(joined, "onetwo");
    names.add(String("three"));
    strictEqual(names.has("three"), true);
    const keys = names.keys();
    strictEqual(keys.join(","), "one,two,three");

    const empty: Set<boolean> = new Set();
    empty.add(true);
    empty.add(false);
    strictEqual(empty.size, 2);
    const characters = new Set("a🙂a");
    strictEqual(characters.size, 2);
    strictEqual(characters.has("🙂"), true);
    const copied = new Set(names);
    strictEqual(copied.size, 3);
    strictEqual(names.size, 3);
    const missing = new Set<int>(undefined);
    const absent = new Set<int>(null);
    strictEqual(missing.size + absent.size, 0);
    const alternatives = new Set<int | string>([1, "one", 1]);
    strictEqual(alternatives.size, 2);
    strictEqual(alternatives.has("one"), true);
    strictEqual(alternatives.delete(1), true);
    const states = new Set<State>([State.Ready, State.Busy, State.Ready]);
    strictEqual(states.size, 2);
    strictEqual(states.has(State.Busy), true);
    const returned = make();
    strictEqual(sizeOf(returned), 1);
    const cloned = clone(names);
    cloned.delete("one");
    strictEqual(names.size, 3);
    strictEqual(cloned.size, 2);
}
