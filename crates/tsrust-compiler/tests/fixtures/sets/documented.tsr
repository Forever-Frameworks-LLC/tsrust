function main() {
    {
        const values = new Set<int>([2, 1, 2]);
        console.log(values.size);
    }

    {
        const values = new Set<int>([2, 1, 2]);
        values.add(3);
        console.log(values.size);
    }

    {
        const values = new Set<int>([2, 1, 2]);
        console.log(values.has(2));
    }

    {
        const values = new Set<int>([2, 1, 2]);
        console.log(values.delete(2), values.size);
    }

    {
        const values = new Set<int>([2, 1, 2]);
        values.clear();
        console.log(values.size);
    }

    {
        const values = new Set<int>([2, 1, 2]);
        console.log(values.values().join(","));
    }

    {
        const values = new Set<int>([2, 1, 2]);
        console.log(values.keys().join(","));
    }

    {
        const values = new Set<string>(["b", "a", "b"]);
        const pairs = values.entries();
        console.log(pairs[0][0], pairs[0][1]);
    }

    {
        const values = new Set<int>([3, 1, 3]);
        let total = 0;
        values.forEach((value) => {
            total = total + value;
        });
        console.log(total);
    }

    {
        const values = new Set<int>([1, 2]);
        console.log(values.isSubsetOf(new Set<int>([1, 2, 3])));
    }

    {
        const values = new Set<string>(["a", "b"]);
        console.log(values.isSupersetOf(new Set<string>(["b"])));
    }

    {
        const values = new Set<int>([1, 2]);
        console.log(values.isDisjointFrom(new Set<string>(["1", "2"])));
    }

    {
        const values = new Set<int>([3, 1]);
        const result = values.union(new Set<int>([1, 2]));
        console.log(result.values().join(","));
    }

    {
        const values = new Set<int>([3, 1, 2]);
        const result = values.intersection(new Set<int>([2, 1]));
        console.log(result.values().join(","));
    }

    {
        const values = new Set<int>([3, 1, 2]);
        const result = values.difference(new Set<int>([1, 2]));
        console.log(result.values().join(","));
    }

    {
        const values = new Set<int>([3, 1, 2]);
        const result = values.symmetricDifference(new Set<int>([2, 4, 1]));
        console.log(result.values().join(","));
    }

    {
        const values = new Set<int>([2, 1, 2]);
        console.log(values.size);
    }
}
