import { strictEqual } from 'std:testing';
import { Iterator } from 'std:iterator';

export function run() {
  {
    const observed1_0 = Iterator.from([1, 2, 3]).take(2).toArray().join(',');
    strictEqual(observed1_0, "1,2");
  }

  const number = 7;
  const callbacks = Iterator.from([(): int => number]).toArray();
  {
    const observed2_0 = callbacks[0]();
    strictEqual(observed2_0, 7);
  }
}
