  strictEqual(values.join(","), "1,2");
}

function checkFallibleSuccess(): void {
  const values = [3, 1, 2, 1];
  const sorted = values.toSorted((a: int, b: int): int => {
    if (a < 0) {
      throw "negative";
    }

    return a - b;
  });
  strictEqual(sorted.join(","), "1,1,2,3");
  strictEqual(values.join(","), "3,1,2,1");
  values.sort((a: int, b: int): int => {
    if (a < 0) {
      throw "negative";
    }

    return a - b;
  });
  strictEqual(values.join(","), "1,1,2,3");
  const words = ["b", "a", "c"];
  words.sort((a: string, b: string): int => {
    if (a === "missing") {
      throw "missing";
    }

    return a < b ? -1 : a > b ? 1 : 0;
  });
  strictEqual(words.join(","), "a,b,c");
  strictEqual(values.map((v: int): int => {
    if (v < 0) {
      throw "negative";
    }

    return v + 1;
  }).join(","), "2,2,3,4");
  strictEqual(values.filter((v: int): boolean => {
    if (v < 0) {
      throw "negative";
    }

    return v > 1;
  }).join(","), "2,3");
  let calls = 0;
  strictEqual(values.some((v: int): boolean => {
    calls += 1; if (v === 3) {
      throw "unreached";
    }

    return v === 1;
  }), true);
  strictEqual(calls, 1);
  let finalized = 0;
  let caught = 0;
  try {
    words.map((v: string): string => {
      throw "owned input";
    });
  } catch (error) {
    if (typeof error === "string") {
      strictEqual(error, "owned input");
      caught = 1;
    }
  } finally {
    finalized = 1;
  }

  strictEqual(caught, 1);
  strictEqual(finalized, 1);
  strictEqual(words.join(","), "a,b,c");
}

function main() {
  checkFallibleSuccess();
  checkMap();
  checkFilter();
  checkFlatMap();
  checkSome();
  checkEvery();
  checkFind();
  checkFindLast();
  checkFindIndex();
  checkFindLastIndex();
  checkReduce();
  checkReduceRight();
  checkSort();
  checkToSorted();
}
