import { strictEqual } from "std:testing";

function checkMap(): void {
  const values = [1, 2];
  let caught = 0;
  try {
    values.map((value): int => {
      if (value === 2) {
        throw "map";
      }

      return value;
    });
  } catch (error) {
    if (typeof error === "string") {
      strictEqual(error, "map");
      caught = 1;
    }
  }

  strictEqual(caught, 1, "map callback error must reach catch");
  strictEqual(values.join(","), "1,2");
}

