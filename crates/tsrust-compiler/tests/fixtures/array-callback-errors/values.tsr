function checkReduce(): void {
  const values = [1, 2];
  let caught = 0;
  try {
    values.reduce((total: int, value: int): int => {
      if (value === 2) {
        throw "reduce";
      }

      return total + value;
    }, 0);
  } catch (error) {
    if (typeof error === "string") {
      strictEqual(error, "reduce");
      caught = 1;
    }
  }

  strictEqual(caught, 1, "reduce callback error must reach catch");
  strictEqual(values.join(","), "1,2");
}

