function sum(values: int[]): int {
    let total = 0;
    let index = 0;
    while (index < values.length) {
        total = total + values[index];
        index = index + 1;
    }

    return total;
}

function main() {
    const values = [1, 2, 3];
    values.push(4);
    console.log(sum(values));
    console.log(values.length);
    const flags: boolean[] = [true, true];
    flags[1] = false;
    console.log(flags[0]);
    console.log(flags[1]);
}
