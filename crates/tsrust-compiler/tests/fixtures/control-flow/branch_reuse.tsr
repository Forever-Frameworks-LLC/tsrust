type User = { name: string; };

function show(user: User, change: boolean) {
    if (change) {
        user.name = "Sam";
    } else {
        console.log(user.name);
    }
    console.log(user.name);
}

function main() {
    const user: User = { name: "Pat" };
    show(user, false);
    show(user, true);
    console.log(user.name);
}
