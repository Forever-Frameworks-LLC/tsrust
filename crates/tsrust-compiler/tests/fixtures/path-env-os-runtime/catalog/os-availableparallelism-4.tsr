import { availableParallelism } from 'std:os';

export function run() {
  match (availableParallelism()) {
    Ok(value) => {},
    Err(error) => {
      if (error.code !== 'Io' && error.code !== 'NotUnicode' && error.code !== 'Range') {
        throw error.message;
      }
    }
  }

  console.log('OS observation completed');
}
