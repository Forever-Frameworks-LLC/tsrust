import { strictEqual } from "std:testing";

type Id = int | string;

type Ids = Id[];

type Count = int;

type Pair = [Count, string];

type Maybe = Label | undefined;

type Label = string;

type Point = {
  x: Count;
  y: Count;
};

type Points = Point[];

type Scores = Map<Label, Count>;

type Seen = Set<Id>;

type Measure = Function<Count, [ReadOnly<Label>]>;

type Grid = Count[][];

function describe(id: Id): Label {
  if (typeof id === "string") {
    return "text:" + id;
  }

  return "number:" + String(id);
}

function first(ids: Ids): Maybe {
  if (ids.length === 0) {
    return undefined;
  }

  return describe(ids[0]);
}

function total(points: Points): Count {
  let sum: Count = 0;
  for (const point of points) {
    sum += point.x + point.y;
  }

  return sum;
}

function main() {
  const ids: Ids = [1, "two"];
  strictEqual(describe(ids[0]), "number:1");
  strictEqual(describe(ids[1]), "text:two");
  strictEqual(first(ids) === "number:1", true);
  const empty: Ids = [];
  strictEqual(first(empty) === undefined, true);
  const pair: Pair = [2, "b"];
  const [count, label] = pair;
  strictEqual(count + 1, 3);
  strictEqual(label, "b");
  const points: Points = [{
    x: 1, y: 2
  }, {
    x: 3, y: 4
  }];
  strictEqual(total(points), 10);
  const scores: Scores = new Map<Label, Count>();
  scores.set("a", 4);
  strictEqual(scores.get("a") === 4, true);
  const seen: Seen = new Set<Id>();
  seen.add(1);
  seen.add("one");
  strictEqual(seen.size, 2);
  const measure: Measure = (text: Label): Count => text.length;
  strictEqual(measure("four"), 4);
  const grid: Grid = [[1, 2], [3]];
  strictEqual(grid[1][0], 3);
  const widened = 5 as Id;
  strictEqual(describe(widened), "number:5");
  const lengths = ["a", "bcd"].map((text: Label): Count => text.length);
  strictEqual(lengths[1], 3);
}
