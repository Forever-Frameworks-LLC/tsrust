type User = {
  name: string;
};

function main() {
  const user: User = {
    name: "Pat"
  };
  const get = (): User => {
    return user;
  };
  const first = get();
  // @tsrust ignore - Intentional closure-consumed rejection fixture; emission must still fail.
  const second = get();
  console.log(first.name);
  console.log(second.name);
}
