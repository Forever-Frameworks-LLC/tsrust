type User = {
  name: string;
};

function maybe(user: User, flag: boolean) {
  if (flag) {
    const get = (): User => {
      return user;
    };
  }

  // @tsrust ignore - Intentional transferred rejection fixture; emission must still fail.
  console.log(user.name);
}

function main() {
  maybe({
    name: "Pat"
  }, false);
}
