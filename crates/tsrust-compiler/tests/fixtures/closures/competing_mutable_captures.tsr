type User = {
  name: string;
};

function main() {
  const user: User = {
    name: "Pat"
  };
  const first = (): void => {
    user.name = "Sam";
  };
  // @tsrust ignore - Intentional capture-conflict rejection fixture; emission must still fail.
  const second = (): void => {
    user.name = "Sam";
  };
  first();
  second();
}
