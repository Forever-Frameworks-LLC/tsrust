type User = {
  name: string;
};

function main() {
  const user: User = {
    name: "Pat"
  };
  const show = (): void => {
    console.log(user.name);
  };
  show();
  // @tsrust ignore - Intentional capture-conflict rejection fixture; emission must still fail.
  user.name = "Sam";
  console.log(user.name);
}
