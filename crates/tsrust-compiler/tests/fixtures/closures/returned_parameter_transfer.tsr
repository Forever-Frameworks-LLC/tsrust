type User = {
  name: string;
};

function make(user: User): () => string {
  return (): string => {
    return user.name.trim();
  };
}

function main() {
  const user: User = {
    name: "Pat"
  };
  const show = make(user);
  // @tsrust ignore - Intentional transferred rejection fixture; emission must still fail.
  console.log(user.name);
  console.log(show());
}
