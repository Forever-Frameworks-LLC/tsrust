import { reader, writer, write, writeAll, flush, copy, close } from 'std:io';
import { createTempDir, create, readFile, removeDirAll } from 'std:fs';
import { fromUtf8, toUtf8 } from 'std:bytes';

export async function main(): Task<void> {
  const directory = unwrap(createTempDir(undefined, 'io-example-'));
  const path = directory + '/bytes';
  const output = writer(unwrap(create(path)));
  const input = reader(unwrap(fromUtf8('ok')));
  console.log(unwrap(await copy(input, output, 1)));
  unwrap(await close(input));
  unwrap(await close(output));
  console.log(unwrap(toUtf8(unwrap(readFile(path)))));
  unwrap(removeDirAll(directory));
}
