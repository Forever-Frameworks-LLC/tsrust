import { App, Client, Request, Response, request, stream } from "std:http";
import { open, create, writeFile, readFile, removeFile } from "std:fs";
import { reader, writer, body, copy, close } from "std:io";
import { fromUtf8, toUtf8 } from "std:bytes";
async function download(input: Request): Task<Response> {
  return stream(body(reader(unwrap(open("io-source.txt")))), 200);
}

export async function main(): Task<void> {
  unwrap(writeFile("io-source.txt", unwrap(fromUtf8("split-é-lines\r\nlast"))));
  const app = new App();
  app.get("/file", download);
  const server = await app.listen("127.0.0.1:0");
  try {
    const client = new Client();
    const response = await client.send(request("GET", "http://" + server.address() + "/file", ""));
    const input = reader(response.body());
    const output = writer(unwrap(create("io-destination.txt")));
    console.log(unwrap(await copy(input, output, 3)));
    unwrap(await close(input));
    unwrap(await close(output));
    console.log(unwrap(toUtf8(unwrap(readFile("io-destination.txt")))));
  } finally {
    await server.shutdown();
    unwrap(removeFile("io-source.txt"));
    unwrap(removeFile("io-destination.txt"));
  }
}
