import { Deque } from 'std:collections';
import { Bytes, ByteView, fromUtf8, view, toUtf8, length } from "std:bytes";
import { strictEqual } from "std:testing";

function bytes(text: string): Bytes {
  match (fromUtf8(text)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function window(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, length(owner))) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function text(value: ByteView): string {
  match (toUtf8(value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    }
  }
}


function read(value: ReadOnly<ByteView>): int {
  return length(value);
}

function take(...values: ByteView[]): ByteView[] {
  return values;
}

function identity(value: ByteView): ByteView {
  return value;
}

export function main() {
  const owner = bytes('ab');
  const values = new Deque<ByteView>();
  values.pushBack(window(owner));
  strictEqual(read(...values), 2);
  const parts = take(...values);
  strictEqual(length(parts[0]), 2);
}
