import { Deque } from 'std:collections';
import { Bytes, ByteView, fromUtf8, view, toUtf8, length } from "std:bytes";
import { strictEqual } from "std:testing";

function bytes(text: string): Bytes {
  match (fromUtf8(text)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function window(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, length(owner))) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function text(value: ByteView): string {
  match (toUtf8(value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    }
  }
}


type Reader = {
  read: ReadOnly<Function<int>>;
};

export function main() {
  const owner = bytes('ab');
  const part = window(owner);
  const values = new Deque<Reader>();
  values.pushBack({
    read: () => length(part)
  });
  for (const item of values) {
    strictEqual(item.read(), 2);
  }

  const item = values.popFront()!;
  strictEqual(item.read(), 2);
}
