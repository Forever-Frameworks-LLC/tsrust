import { Deque } from 'std:collections';
import { strictEqual } from 'std:testing';

export function main() {
  const values = new Deque<string>();
  values.pushBack('b');
  values.pushFront('a');
  values.pushBack('c');
  let joined = '';
  for (const value of values) {
    joined += value;
  }

  strictEqual(joined, 'abc');
  strictEqual(values.size, 3);
  values.clear();
  for (const value of values) {
    throw 'empty queue visited';
  }
}
