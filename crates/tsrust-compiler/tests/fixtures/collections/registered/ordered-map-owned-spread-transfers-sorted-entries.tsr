import { OrderedMap } from 'std:collections';
import { strictEqual } from 'std:testing';

function collect(...entries: [string, string][]): string {
  let text = '';
  for (const entry of entries) {
    text += entry[0] + entry[1];
  }

  return text;
}

export function main() {
  const values = new OrderedMap<string, string>();
  values.set('z', 'last');
  values.set('a', 'first');
  const entries = [...values];
  strictEqual(entries[0][0], 'a');
  strictEqual(entries[1][1], 'last');
  const more = new OrderedMap<string, string>();
  more.set('b', '2');
  more.set('a', '1');
  strictEqual(collect(...more), 'a1b2');
}
