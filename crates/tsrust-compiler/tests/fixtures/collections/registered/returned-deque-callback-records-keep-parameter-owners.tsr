import { Deque } from 'std:collections';
import { Bytes, ByteView, fromUtf8, view, toUtf8, length } from "std:bytes";
import { strictEqual } from "std:testing";

function bytes(text: string): Bytes {
  match (fromUtf8(text)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function window(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, length(owner))) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function text(value: ByteView): string {
  match (toUtf8(value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    }
  }
}


type Reader = {
  read: Once<Function<ByteView>>;
};

function collect(owner: ReadOnly<Bytes>): Deque<Reader> {
  const part = window(owner);
  const values = new Deque<Reader>();
  values.pushBack({
    read: () => part
  });
  return values;
}

export function main() {
  const owner = bytes('ab');
  const values = collect(owner);
  const item = values.popFront()!;
  strictEqual(length(item.read()), 2);
}
