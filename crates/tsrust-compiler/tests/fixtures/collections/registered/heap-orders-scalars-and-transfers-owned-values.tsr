import { Heap as Queue } from 'std:collections';
import { strictEqual } from 'std:testing';

export function main() {
  const values = new Queue<int>();
  strictEqual(values.size, 0);
  strictEqual(values.pop(), undefined);
  values.push(2);
  values.push(9);
  values.push(9);
  strictEqual(values.peek(), 9);
  const copy = clone(values);
  strictEqual(copy.pop(), 9);
  strictEqual(values.size, 3);
  strictEqual(values.pop(), 9);
  strictEqual(values.pop(), 9);
  strictEqual(values.pop(), 2);
  strictEqual(values.peek(), undefined);
  const words = new Queue<string>();
  words.push('a');
  words.push('🦀');
  words.push('界');
  {
    const top = words.peek();
    if (top !== undefined) {
      strictEqual(top, '🦀');
    }
  }

  const word = words.pop()!;
  strictEqual(word, '🦀');
  words.clear();
  strictEqual(words.size, 0);
}
