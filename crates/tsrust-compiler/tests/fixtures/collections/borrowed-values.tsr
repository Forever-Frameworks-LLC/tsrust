import { Bytes, ByteView, fromUtf8, view, toUtf8, length } from "std:bytes";
import { strictEqual } from "std:testing";

function bytes(text: string): Bytes {
  match (fromUtf8(text)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function window(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, length(owner))) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function text(value: ByteView): string {
  match (toUtf8(value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

type Value = {
  count: int;
};

type Chain = {
  data: ByteView;
  next?: Chain;
};

function main() {
  const owner = bytes("shared");
  {
    const values = new Map<int, ByteView>();
    values.set(2, window(owner));
    values.set(1, window(owner));
    values.set(2, window(owner));
    strictEqual(values.size, 2, "map size after replacement");
    strictEqual(values.keys().join(","), "2,1", "replacement preserves insertion order");
    let seen = "";
    for (const [key, value] of values) {
      seen += String(key) + text(value) + "|";
    }

    strictEqual(seen, "2shared|1shared|", "borrowed iteration reads views");
    strictEqual(values.delete(2), true, "delete finds key");
    values.set(2, window(owner));
    strictEqual(values.keys().join(","), "1,2", "reinsertion moves key last");
    values.clear();
    strictEqual(values.size, 0, "clear removes entries");
  }

  strictEqual(length(owner), 6, "owner remains live");
  {
    const tail: Chain = {
      data: window(owner), next: undefined
    };
    const head: Chain = {
      data: window(owner), next: tail
    };
    const chain = [head];
    strictEqual(chain.join(","), "[object Object]", "recursive records join with real lifetimes");
  }

  const records = new Map<int, Value>();
  records.set(2, {
    count: 20
  });
  records.set(1, {
    count: 10
  });
  records.delete(2);
  records.set(2, {
    count: 30
  });
  strictEqual(records.size, 2, "ordinary record survivor remains");
  strictEqual(records.keys().join(","), "1,2", "ordinary record reinsertion order");
  const owned = new Map<int, int[]>();
  owned.set(1, [3, 5]);
  const copied = clone(owned);
  owned.clear();
  const selected = copied.get(1);
  if (selected !== undefined) {
    strictEqual(selected[1], 5, "deep clone retains owned array");
  } else {
    throw "missing cloned entry";
  }

  const keys = new Set<string>(["b", "a", "b"]);
  const saved = clone(keys);
  keys.delete("b");
  keys.add("b");
  strictEqual(keys.values().join(","), "a,b", "set reinsertion order");
  strictEqual(saved.values().join(","), "b,a", "set clone is independent");
}
