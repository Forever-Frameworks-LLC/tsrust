import { Bytes, ByteView, fromUtf8, view, toUtf8, length } from "std:bytes";
import { strictEqual } from "std:testing";

function bytes(text: string): Bytes {
  match (fromUtf8(text)) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function window(owner: ReadOnly<Bytes>): ByteView {
  match (view(owner, 0, length(owner))) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function text(value: ByteView): string {
  match (toUtf8(value)) {
    Ok(result) => {
      return result;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function fill(values: Mutable<Map<int, ByteView>>, owner: ReadOnly<Bytes>) {
  values.set(1, window(owner));
}

function collect(owner: ReadOnly<Bytes>): Map<int, ByteView> {
  const result = new Map<int, ByteView>();
  fill(result, owner);
  return result;
}

function identity(values: Map<int, ByteView>, ignored: Map<int, ByteView>): Map<int, ByteView> {
  return values;
}

function save(values: Map<int, ByteView>) {
  return () => values;
}

function inspect(values: ReadOnly<Map<int, ByteView>>): string {
  const selected = values.get(1);
  if (selected !== undefined) {
    return text(selected);
  }

  return "missing";
}

type Payload = {
  part: ByteView;
  label: string;
};

function packageView(owner: ReadOnly<Bytes>): Map<int, Payload> {
  const result = new Map<int, Payload>();
  result.set(1, {
    part: window(owner), label: "wrapped"
  });
  return result;
}

function restoreWrapped(values: Map<int, Payload>, ignored: Map<int, Payload>): Map<int, Payload> {
  return values;
}

function main() {
  const owner = bytes("return");
  let values = collect(owner);
  {
    const short = bytes("short");
    values = identity(collect(owner), collect(short));
  }

  strictEqual(inspect(values), "return");
  for (const [key, value] of values) {
    strictEqual(text(value), "return");
  }

  const wrapped = restoreWrapped(packageView(owner), packageView(owner));
  for (const [key, value] of wrapped) {
    strictEqual(text(value.part), "return");
    strictEqual(value.label, "wrapped");
  }

  const saved = save(values);
  const restored = saved();
  strictEqual(inspect(restored), "return");
}
