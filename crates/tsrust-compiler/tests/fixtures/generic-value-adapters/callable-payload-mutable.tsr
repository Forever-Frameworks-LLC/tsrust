function make() {
    let calls = 0;
    function invoke<T>(action: T): void {
        calls += 1;
        console.log(calls, action());
    }
    return invoke;
}

function main() {
    let count = 0;
    const action = (): int => { count += 1; return count; };
    const fixed: Function<void, [action: Mutable<Function<int, []>>]> = make();
    fixed(action);
    fixed(action);
    console.log(action());
}
