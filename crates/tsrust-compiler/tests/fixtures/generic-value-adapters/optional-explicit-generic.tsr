import { strictEqual } from 'std:testing';

function make() {
    let calls = 0;
    function identity<T>(value: T): T {
        calls += 1;
        console.log(calls);
        return value;
    }

    return identity;
}

function enabled(flag: boolean): boolean {
    return flag;
}

function main() {
    let effects = 0;
    const missing = enabled(false) ? make() : undefined;
    const absent = missing ?. < int >(effects++);
    strictEqual(absent ?? -1, -1);
    strictEqual(effects, 0);
    const present = enabled(true) ? make() : undefined;
    const first = present ?. < int >(++effects);
    const second = present ?. < int >(++effects);
    strictEqual(first ?? -1, 1);
    strictEqual(second ?? -1, 2);
    strictEqual(effects, 2);
}
