import { strictEqual } from 'std:testing';

function increment(value: int): int { return value + 1; }
function make() {
    let calls = 0;
    function invoke<T>(action: Function<T, [value: T]>, value: T): T {
        calls += 1;
        console.log(calls);
        return action(value);
    }
    return invoke;
}
function main() {
    const fixed: Function<int, [action: Function<int, [value: int]>, value: int]> = make();
    strictEqual(fixed(increment, 7), 8);
    strictEqual(fixed(increment, 8), 9);
}
