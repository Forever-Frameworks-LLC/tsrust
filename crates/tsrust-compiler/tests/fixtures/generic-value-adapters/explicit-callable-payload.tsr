import { strictEqual } from 'std:testing';

function make() {
    let calls = 0;
    function identity<T>(value: T): T {
        calls += 1;
        console.log(calls);
        return value;
    }

    return identity;
}

function main() {
    const identity = make();
    const first = identity<Function<int, [value: int]>> ((value: int): int => value + 1);
    const second = identity<Function<int, [value: int]>> ((value: int): int => value + 2);
    strictEqual(first(7), 8);
    strictEqual(second(7), 9);
}
