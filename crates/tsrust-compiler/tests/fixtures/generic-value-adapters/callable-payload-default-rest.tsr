import { strictEqual } from 'std:testing';

function next(): int { console.log("default"); return 4; }
function sum(value: int = next(), ...tail: int[]): int {
    let result = value;
    for (const item of tail) { result += item; }
    return result;
}
function make() {
    let calls = 0;
    function identity<T>(value: T): T { calls += 1; console.log(calls); return value; }
    return identity;
}
function main() {
    const fixed: Function<Function<int, [value?: int, ...tail: int[]]>, [action: Function<int, [value?: int, ...tail: int[]]>]> = make();
    const action = fixed(sum);
    strictEqual(action(), 4);
    strictEqual(action(undefined, 1, 2), 7);
    strictEqual(action(7, ...[3, 4]), 14);
}
