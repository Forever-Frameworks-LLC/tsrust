function make() {
  let calls = 0;
  function invoke<T>(action: T): void {
    calls += 1;
    console.log(calls, action());
  }

  return invoke;
}

function main() {
  const text = "owner";
  const action = (): int => text.length;
  const fixed: Function<void, [action: ReadOnly<Function<int, []>>]> = make();
  fixed(action);
  fixed(action);
  console.log(action());
}
