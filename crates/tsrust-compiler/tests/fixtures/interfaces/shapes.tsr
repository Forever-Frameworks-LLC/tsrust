import { strictEqual } from "std:testing";

interface Named {
  name: string;
}

interface Positioned {
  x: int;
  y?: int;
}

interface Player extends Named, Positioned {
  score: int,
  tags: string[]
}

interface Box<T> {
  value: T;
  label?: string;
}

interface Team {
  lead: Player;
  members: Player[];
}

type Scores = Map<string, int>;

interface Board extends Named {
  scores: Scores;
}

function describe(player: Player): string {
  return player.name + ":" + String(player.x + (player.y ?? 0)) + ":" + String(player.score);
}

function rename(named: Named, name: string): void {
  named.name = name;
}

function main() {
  const lead: Player = {
    name: "Pat", x: 1, score: 3, tags: ["a"]
  };
  strictEqual(describe(lead), "Pat:1:3");
  const second: Player = {
    name: "Sam", x: 2, y: 5, score: 4, tags: []
  };
  strictEqual(describe(second), "Sam:7:4");
  const named: Named = {
    name: "old"
  };
  rename(named, "new");
  strictEqual(named.name, "new");
  const box: Box<int> = {
    value: 7
  };
  strictEqual(box.value + (box.label ?? "").length, 7);
  const text: Box<string> = {
    value: "v", label: "l"
  };
  strictEqual(text.value + (text.label ?? ""), "vl");
  const team: Team = {
    lead: clone(lead), members: [clone(second)]
  };
  strictEqual(team.lead.name + team.members[0].name, "PatSam");
  const board: Board = {
    name: "main", scores: new Map<string, int>()
  };
  board.scores.set("a", 2);
  strictEqual(board.scores.get("a") === 2, true);
  const { name, score } = second;
  strictEqual(name + String(score), "Sam4");
}
