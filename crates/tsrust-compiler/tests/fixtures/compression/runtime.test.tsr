import { describe, test, strictEqual } from 'std:testing';
import { gzip as encodeFactory, gunzip as decodeFactory, compressReader as readerFactory, decompressReader as decoderFactory } from 'std:compression';
import { ThreadPool } from 'std:threads';
import { reader, close } from 'std:io';
import { fromUtf8, toUtf8 } from 'std:bytes';
import { main as example0 } from './catalog-00.tsr';
import { main as example1 } from './catalog-01.tsr';
import { main as example2 } from './catalog-02.tsr';
import { main as example3 } from './catalog-03.tsr';
import { main as example4 } from './catalog-04.tsr';
import { main as example5 } from './catalog-05.tsr';
import { main as example6 } from './catalog-06.tsr';
import { main as example7 } from './catalog-07.tsr';
import { main as example8 } from './catalog-08.tsr';
import { main as example9 } from './buffers.tsr';
import { main as example10 } from './readers.tsr';
import { main as example11 } from './writers.tsr';
import { main as example12 } from './pipe.tsr';
import { main as example13 } from './copy-endpoints.tsr';
import { main as example14 } from './tcp-pipeline.tsr';
import { main as example15 } from './format-descriptor.tsr';

describe('compression runtime', () => {
  test('catalog-00', () => {
    example0();
  });
  test('catalog-01', () => {
    example1();
  });
  test('catalog-02', () => {
    example2();
  });
  test('catalog-03', async () => {
    await example3();
  });
  test('catalog-04', async () => {
    await example4();
  });
  test('catalog-05', async () => {
    await example5();
  });
  test('catalog-06', () => {
    example6();
  });
  test('catalog-07', async () => {
    await example7();
  });
  test('catalog-08', async () => {
    await example8();
  });
  test('buffers', async () => {
    await example9();
    const pool = new ThreadPool({
      workers: 1, capacity: 1
    });
    const pack = encodeFactory;
    const unpack = decodeFactory;
    const input = unwrap(fromUtf8('stored factory'));
    const packed = unwrap(await pack(pool, input, {
      level: 1
    }));
    strictEqual(unwrap(toUtf8(unwrap(await unpack(pool, packed, {
      maxOutputBytes: 14
    })))), 'stored factory');
    const invalidInput = unwrap(fromUtf8('invalid level'));
    match (await pack(pool, invalidInput, {
      level: 10
    })) {
      Ok(value) => {
        throw 'stored compressor accepted invalid level';
      },
      Err(error) => {
        strictEqual(error.code, 'range');
      }
    }

    unwrap(pool.shutdown());
  });
  test('readers', async () => {
    await example10();
    const pool = new ThreadPool({
      workers: 1, capacity: 1
    });
    const encode = readerFactory;
    const decode = decoderFactory;
    const input = reader(unwrap(fromUtf8('stored stream')));
    const encoded = unwrap(encode(pool, input, 'gzip', {
      level: 1
    }));
    const packed = unwrap(await encoded.readAll());
    unwrap(await close(unwrap(await encoded.finish())));
    const packedInput = reader(packed);
    const decoded = unwrap(decode(pool, packedInput, 'gzip', {
      maxOutputBytes: 13
    }));
    strictEqual(unwrap(toUtf8(unwrap(await decoded.readAll()))), 'stored stream');
    unwrap(await close(unwrap(await decoded.finish())));
    unwrap(pool.shutdown());
  });
  test('writers', async () => {
    await example11();
  });
  test('pipe', async () => {
    await example12();
  });
  test('copy-endpoints', async () => {
    await example13();
  });
  test('tcp-pipeline', async () => {
    await example14();
  });
  test('format-descriptor', async () => {
    await example15();
  });
});
