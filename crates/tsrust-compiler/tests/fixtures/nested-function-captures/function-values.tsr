import { strictEqual } from "std:testing";

function apply(values: int[], change: (value: int) => int): int[] {
    return values.map(change);
}

function main() {
    const base = [10];
    function shifted(value: int): int {
        return value + base[0];
    }
    strictEqual([1, 2].map(shifted).join(","), "11,12");

    let sum = 0;
    function accumulate(value: int): void {
        sum += value;
    }
    [1, 2, 3].forEach(accumulate);
    strictEqual(sum, 6);

    const counts = [0];
    function tick(): int {
        counts[0] += 1;
        return counts[0];
    }
    {
        const run = tick;
        strictEqual(run(), 1);
        strictEqual(run(), 2);
    }
    strictEqual(counts[0], 2);

    const labels: string[] = [];
    function label(name: string, mark: int): void {
        labels.push(name + String(mark + base[0]));
    }
    function each(names: string[]): void {
        const write = label;
        for (const name of names) {
            write(name, names.length);
        }
    }
    each(["a", "b"]);
    strictEqual(labels.join(","), "a12,b12");

    const keep = [1, 12, 30].filter(above);
    strictEqual(keep.join(","), "12,30");
    function above(value: int): boolean {
        return value > base[0];
    }

    // A callback parameter owns its callable, so the captured array moves into it.
    const offsets = [100];
    function offset(value: int): int {
        return value + offsets[0];
    }
    strictEqual(apply([3], offset).join(","), "103");
}
