import { strictEqual } from "std:testing";

function main() {
  const base = [3];
  function even(n: int): int {
    if (n === 0) {
      return base[0];
    }

    return odd(n - 1);
  }

  function odd(n: int): int {
    if (n === 0) {
      return base[0] + 1;
    }

    return even(n - 1);
  }

  function forward(n: int): int {
    return even(n);
  }

  strictEqual(forward(4), 3);
  strictEqual(forward(3), 4);
  strictEqual(base[0], 3);
}
