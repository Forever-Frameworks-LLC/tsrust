type Choice = 'left' | 'right';

function wide(value: int): string | undefined {
  if (value === 0) {
    return undefined;
  }

  return 'wide';
}

function narrow(value: int): Choice | undefined {
  if (value === 0) {
    return undefined;
  }

  if (value === 1) {
    return 'left';
  }

  return 'right';
}

function main() {
  const left = wide(0);
  const right = narrow(1);
  console.log(left ?? right);
  console.log(right ?? 'none');
  const saved = clone(left) ?? clone(right);
  console.log(saved ?? 'none');
  const present = wide(1);
  console.log(present ?? right);
  console.log(present ?? 'none');
}
