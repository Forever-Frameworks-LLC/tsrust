import { request, MultipartPart } from 'std:http';
import { length } from 'std:bytes';

export async function main(): Task<void> {
  const upload = request('POST', 'http://localhost/', '--x\r\nContent-Disposition: form-data; name="attachment"; filename="../untrusted"\r\nContent-Type: application/octet-stream\r\n\r\nabc\r\n--x--\r\n');
  upload.setHeader('content-type', 'multipart/form-data; boundary=x');
  const parts: MultipartPart[] = await upload.multipart();
  console.log(parts[0].name, parts[0].fileName === '../untrusted', parts[0].contentType === 'application/octet-stream', length(parts[0].data));
}
