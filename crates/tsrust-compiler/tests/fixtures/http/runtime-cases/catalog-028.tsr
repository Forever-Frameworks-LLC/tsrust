import { App, Client, Request, Response, Body, Next, text, html, json, request, stream } from 'std:http';
async function handle(input: Request): Task<Response> {
  return text('ok');
}

export async function main(): Task<void> {
  const app = new App();
  app.use((input: Request, next: Next): Task<Response> => next.run(input));
  const server = await app.listen("127.0.0.1:0");
  const client = new Client();
  const response = await client.send(request("GET", "http://" + server.address() + "/", ""));
  await server.shutdown();
  console.log('ok');
}
