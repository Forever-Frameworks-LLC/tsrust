type State = {
  value: int;
};

function increment(value: int): int {
  return value + 1;
}

function main() {
  const state: State = {
    value: 0
  };
  const counter: ((() => int)) = (): int => {
    state.value = state.value + 1;
    return state.value;
  };
  console.log(counter(), counter());
  const moved: () => int = counter;
  console.log(moved());
  const action: (value: int) => int = increment;
  console.log(action(4));
}
