function retain(action: Function<int>): () => int {
  const next = action;
  return (): int => { return next(); };
}
function counter(): () => int {
  let count = 0;
  return retain((): int => { count = count + 1; return count; });
}
function main() {
  const first = counter();
  const second = counter();
  console.log(first());
  console.log(first());
  console.log(second());
}
