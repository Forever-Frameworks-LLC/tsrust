type State = {
  on: boolean;
};

function twice(action: Mutable<Function<boolean>>) {
  console.log(action());
  console.log(action());
}

function use(state: State) {
  twice((): boolean => {
    if (state.on) {
      state.on = false;
    } else {
      state.on = true;
    }

    return state.on;
  });
  console.log(state.on);
  twice((): boolean => {
    state.on = true; return state.on;
  });
  console.log(state.on);
}

function main() {
  const state: State = {
    on: false
  };
  use(state);
  console.log(state.on);
}
