import { dirname, extname } from "std:path";
import { strictEqual } from "std:testing";

function main() {
    const path = "/tmp/é😊.tar.gz/";
    const parent = dirname;
    const extension = extname;
    strictEqual(parent(path), "/tmp");
    strictEqual(extension(path), ".gz");
    strictEqual(path, "/tmp/é😊.tar.gz/");
    strictEqual(dirname(""), ".");
    strictEqual(dirname("//a"), "//");
    strictEqual(extname(".hidden"), "");
    strictEqual(extname(".."), "");
    strictEqual(extname("..."), ".");
}
