import { strictEqual } from "std:testing";

function main() {
  const values = new Map<string, int>([["a", 1], ["b", 2], ["a", 3]]);
  values.delete("a");
  values.set("a", 4);
  const keys = values.keys();
  const numbers = values.values();
  const entries = values.entries();
  strictEqual(keys.join(","), "b,a");
  strictEqual(numbers.join(","), "2,4");
  strictEqual(entries[0][0], "b");
  strictEqual(entries[0][1], 2);
  strictEqual(entries[1][0], "a");
  strictEqual(entries[1][1], 4);
  values.clear();
  strictEqual(entries.length, 2);
  strictEqual(keys.length, 2);
  strictEqual(numbers.length, 2);
  strictEqual(values.size, 0);
  const empty = new Map<int, string>();
  strictEqual(empty.keys().length, 0);
  strictEqual(empty.values().length, 0);
  strictEqual(empty.entries().length, 0);
  const names = new Map<int, string>([[1, String("one")], [2, String("two")]]);
  const copied = names.values();
  names.clear();
  strictEqual(copied.join(","), "one,two");
  const alternatives = new Map<int | string, int>([[1, 2], ["one", 3]]);
  const mixed = alternatives.keys();
  strictEqual(mixed.join(","), "1,one");
}
