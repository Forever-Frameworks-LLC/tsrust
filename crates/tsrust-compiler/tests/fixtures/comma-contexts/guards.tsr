import { strictEqual } from "std:testing";

type Row = {
  value: int | null;
};

function reset(row: Row): int {
  row.value = null;
  return 0;
}

function numberValue(value: int | null): int {
  if (value !== (0, null)) {
    return value + 1;
  }

  return 0;
}

function textLength(value: int | string): int {
  if ((0, typeof value) === "string") {
    return value.length;
  }

  return value;
}

function main() {
  strictEqual(numberValue(2), 3);
  strictEqual(numberValue(null), 0);
  strictEqual(textLength("text"), 4);
  strictEqual(textLength(2), 2);
  const row: Row = {
    value: 3
  };
  let seen = 0;
  if (row.value !== (reset(row), null)) {
    strictEqual(row.value === null, true);
    seen = 1;
  }

  strictEqual(seen, 1);
}
