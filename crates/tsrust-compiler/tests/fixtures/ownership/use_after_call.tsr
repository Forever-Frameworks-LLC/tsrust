type User = {
  name: string;
};

function take(user: User): User {
  return user;
}

function main() {
  const user: User = {
    name: "Pat"
  };
  const user2 = user;
  // @tsrust ignore - Intentional transferred rejection fixture; emission must still fail.
  const saved = take(user);
  console.log(saved.name);
  // @tsrust ignore - Intentional transferred rejection fixture; emission must still fail.
  console.log(user.name);
}
