type User = {
  name: string;
};

function renameAndLog(first: User, second: User) {
  first.name = "Sam";
  console.log(second.name);
}

function main() {
  const user: User = {
    name: "Pat"
  };
  // @tsrust ignore - Intentional conflicting-access rejection fixture; emission must still fail.
  renameAndLog(user, user);
}
