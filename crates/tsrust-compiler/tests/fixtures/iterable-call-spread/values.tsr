import { strictEqual } from "std:testing";

type Counter = {
    value: int;
};

type Row = {
    label: string;
    action: Once<Function<int>>;
};

function three(a: string, b: string, c: string): string {
    return a + "|" + b + "|" + c;
}

function sum(...values: int[]): int {
    let total = 0;
    for (const value of values) {
        total += value;
    }

    return total;
}

function letters(...values: string[]): string {
    return values.join("|");
}

function pair(first: [int, int], second: [int, int]): int {
    return first[0] + first[1] + second[0] + second[1];
}

function label(entry: [int, Row]): string {
    return entry[1].label + ":" + String(entry[0]);
}

function take(value: Owned<string>): string {
    return value;
}

function positions(a: int, b: int, c: int): int {
    return a * 100 + b * 10 + c;
}

function make(counter: Mutable<Counter>): Set<int> {
    counter.value += 1;
    return new Set<int>([counter.value]);
}

function mark(counter: Mutable<Counter>): int {
    counter.value += 1;
    return counter.value;
}

function readonlySum(values: ReadOnly<Set<int>>): int {
    return sum(...values);
}

function first<T>(value: T): T {
    return value;
}

function defaults(value: int = 9): int {
    return value;
}

function failSource(counter: Mutable<Counter>): Set<int> {
    counter.value += 1;
    throw "source";
}

function capture(value: Owned<string>): Function<string> {
    return (): string => {
        return value + "!";
    };
}

function main() {
    const source = String("Aé🙂");
    strictEqual(three(...source), "A|é|🙂");
    strictEqual(source, "Aé🙂");
    strictEqual(letters(...source), "A|é|🙂");
    strictEqual(letters(...""), "");
    const keys = new Set<int>([3, 1, 3]);
    strictEqual(sum(...keys, 7), 11);
    strictEqual(keys.size, 2);
    strictEqual(readonlySum(keys), 4);
    strictEqual(Math.max(...new Set<number>([- 2.0, 4.0, 1.0])), 4.0);
    strictEqual(String.fromCodePoint(...new Set<int>([65, 128578])), "A🙂");
    const values = new Map<int, int>([[1, 7], [2, 8]]);
    strictEqual(pair(...values), 18);
    strictEqual(values.size, 2);
    const rows = new Map<int, Row>();
    rows.set(4, {
        label: "owned", action: (): int => {
            return 7;
        }
    });
    strictEqual(label(...rows), "owned:4");
    strictEqual(rows.size, 1);
    const names = new Set<string>([String("x")]);
    strictEqual(take(...names), "x");
    const counter: Counter = {
        value: 0
    };
    strictEqual(positions(mark(counter), ...make(counter), mark(counter)), 123);
    strictEqual(counter.value, 3);
    strictEqual(first(...new Set<int>([8])), 8);
    strictEqual("x".concat(..."ab"), "xab");
    const single = String("x");
    strictEqual(take(...single), "x");
    strictEqual(single, "x");
    strictEqual(Boolean(..."a"), true);
    strictEqual(Array.isArray(..."abc"), false);
    strictEqual(defaults(...new Set()), 9);
    let caught = 0;
    try {
        sum(...failSource(counter), mark(counter));
    } catch (error) {
        if (typeof error === "string") {
            strictEqual(error, "source");
            caught = 1;
        }
    } finally {
        counter.value += 10;
    }

    strictEqual(caught, 1);
    strictEqual(counter.value, 14);
    const action: ReadOnly<Function<int, [...values: int[]]>> | null = null;
    strictEqual(String(action ?.(...make(counter))), "undefined");
    strictEqual(counter.value, 14);
    const inserts = new Set<string>([String("a"), "b"]);
    strictEqual(String.raw({
        raw: ["<", ":", ">"]
    }, ...inserts), "<a:b>");
    strictEqual(inserts.size, 2);
    strictEqual(String.raw({
        raw: ["<", ":", ">"]
    }, ..."ab"), "<a:b>");
    let original = String("x");
    const held = capture(...original);
    original = "y";
    strictEqual(held(), "x!");
    strictEqual(original, "y");
    const empty: int[] = Array.from(new Set<int>());
    strictEqual(sum(...empty), 0);
}
