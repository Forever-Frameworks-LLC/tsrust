export interface SpeechButtonProps {
  /** BCP 47 language such as en-US or fr-FR. Defaults to the system language. */
  locale?: ReactiveValue<string> | TextBinding;
  /** Shows the input level beside the button while listening. */
  waveform?: ReactiveValue<boolean>;
  /** Button and waveform size; medium by default. */
  size?: ReactiveValue<'xsmall' | 'small' | 'medium' | 'large'>;
  /** Disables button interaction; false by default. Does not stop an already running session. */
  disabled?: ReactiveValue<boolean>;
  /** Shows a disabled microphone when no recognizer is available, instead of hiding it. Defaults to false. */
  showWhenUnsupported?: ReactiveValue<boolean>;
  /** Whether to use the system recognizer. Defaults to true. false leaves this button unsupported, even with locale set. Read once at mount. */
  systemFallback?: ReactiveValue<boolean>;
  /** Nonnegative milliseconds to wait for a final transcript after stopping, then finish with the transcript so far. Defaults to 3000. Read once at mount; negative values throw before mounting. */
  stopTimeout?: ReactiveValue<int>;
  /** Waveform appearance while capturing; bars by default. Requires waveform=true. */
  waveformStyle?: ReactiveValue<'bars' | 'liquid'>;
  /** Receives the whole transcript so far while the user speaks. */
  onPartial?: Owned<Function<void, [text: ReadOnly<string>]>>;
  /** Receives the final transcript when the session ends; it may be empty. */
  onFinal?: Owned<Function<void, [text: ReadOnly<string>]>>;
  /** Receives a readable message when recognition fails, such as denied microphone access. */
  onError?: Owned<Function<void, [message: ReadOnly<string>]>>;
  /** Called when a session starts capturing audio. */
  onStarted?: Owned<Function<void>>;
  /** Called if the recognizer session is explicitly cancelled and its transcript discarded. Stopping normally, including its timeout, calls onFinal instead. */
  onCancelled?: Owned<Function<void>>;
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** A microphone button that dictates with the system speech recognizer (macOS and Windows). Click to start; click again to stop and receive the final transcript. Locale, systemFallback and stopTimeout are read once when mounted; disabled, size and waveform presentation can change without restarting the recognizer. Unsupported hosts hide the button unless showWhenUnsupported is true. Each mounted button owns its recognizer and releases capture when disposed. */
export function SpeechButton(props: SpeechButtonProps): Node {
  let node = kitNode('SpeechButton', [], props.className);
  const prop_locale = props.locale;
  if (prop_locale !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'locale', prop_locale));
  }

  const prop_waveform = props.waveform;
  if (prop_waveform !== undefined) {
    node = kitFlag(node, 'waveform', prop_waveform);
  }

  const prop_size = props.size;
  if (prop_size !== undefined) {
    if (typeof prop_size === 'string') {
      node = unwrapNode(nativeKitSet(node, 'size', `${prop_size}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'size', nativeBindText(prop_size.evaluate)));
    }
  }

  const prop_disabled = props.disabled;
  if (prop_disabled !== undefined) {
    node = kitFlag(node, 'disabled', prop_disabled);
  }

  const prop_showWhenUnsupported = props.showWhenUnsupported;
  if (prop_showWhenUnsupported !== undefined) {
    node = kitFlag(node, 'showWhenUnsupported', prop_showWhenUnsupported);
  }

  const prop_systemFallback = props.systemFallback;
  if (prop_systemFallback !== undefined) {
    node = kitFlag(node, 'systemFallback', prop_systemFallback);
  }

  const prop_stopTimeout = props.stopTimeout;
  if (prop_stopTimeout !== undefined) {
    node = kitInt(node, 'stopTimeout', prop_stopTimeout);
  }

  const prop_waveformStyle = props.waveformStyle;
  if (prop_waveformStyle !== undefined) {
    if (typeof prop_waveformStyle === 'string') {
      node = unwrapNode(nativeKitSet(node, 'waveformStyle', `${prop_waveformStyle}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'waveformStyle', nativeBindText(prop_waveformStyle.evaluate)));
    }
  }

  const event_onPartial = props.onPartial;
  if (event_onPartial !== undefined) {
    node = unwrapNode(nativeKitOn(node, 'partial', event_onPartial));
  }

  const event_onFinal = props.onFinal;
  if (event_onFinal !== undefined) {
    node = unwrapNode(nativeKitOn(node, 'final', event_onFinal));
  }

  const event_onError = props.onError;
  if (event_onError !== undefined) {
    node = unwrapNode(nativeKitOn(node, 'error', event_onError));
  }

  const event_onStarted = props.onStarted;
  if (event_onStarted !== undefined) {
    node = unwrapNode(nativeKitOnVoid(node, 'started', event_onStarted));
  }

  const event_onCancelled = props.onCancelled;
  if (event_onCancelled !== undefined) {
    node = unwrapNode(nativeKitOnVoid(node, 'cancelled', event_onCancelled));
  }

  return node;
}

export interface PlotProps {
  /** Category labels along the x axis, one per value. Expressions reading component signals update live; plain arrays are read at construction. */
  labels?: ReactiveValue<string[]>;
  /** Draws the x axis with labels. Defaults to false. */
  axis?: ReactiveValue<boolean>;
  /** Draws dashed horizontal grid lines. Defaults to false. */
  grid?: ReactiveValue<boolean>;
  /** PlotLine, PlotArea, PlotBars and an optional PlotTooltip elements. */
  children?: Child[];
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** A custom chart over shared category labels: layer PlotLine, PlotArea and PlotBars marks on one value scale, with optional axis labels and grid. */
export function Plot(props: PlotProps): Node {
  let node = kitNode('Plot', props.children ?? [], props.className);
  const prop_labels = props.labels;
  if (prop_labels !== undefined) {
    if (Array.isArray(prop_labels)) {
      node = unwrapNode(nativeKitSet(node, 'labels', JSON.stringify(prop_labels)));
    } else {
      const evaluate = prop_labels.evaluate;
      node = unwrapNode(nativeKitBind(node, 'labels', nativeBindText(() => JSON.stringify(evaluate()))));
    }
  }

  const prop_axis = props.axis;
  if (prop_axis !== undefined) {
    node = kitFlag(node, 'axis', prop_axis);
  }

  const prop_grid = props.grid;
  if (prop_grid !== undefined) {
    node = kitFlag(node, 'grid', prop_grid);
  }

  return node;
}

export interface PlotTooltipProps {
  /** Glides crosshair and dots between categories. Defaults to true; false snaps to the category. */
  glide?: ReactiveValue<boolean>;
  /** Optional overlay opacity, clamped to 0–1. Must be finite. Omit to use Kit’s hover fade. */
  progress?: ReactiveValue<number>;
  /** Overrides the category label shown as the title. Omit to show the hovered label; an empty string hides the title. */
  title?: ReactiveValue<string> | TextBinding;
  /** Includes a colored row for each series value at the hovered category. Defaults to true. Short series omit missing values. */
  showSeries?: ReactiveValue<boolean>;
  /** Nonnegative finite spacing in logical pixels between the pointer and tooltip box, at most the native float maximum. Defaults to 8; invalid values throw a UI error. */
  gap?: ReactiveValue<number>;
  /** Crosshair direction. Defaults to vertical. Its data coordinate follows the category center and pointer height. */
  crossLine?: ReactiveValue<'none' | 'vertical' | 'horizontal' | 'both'>;
  /** Draws a colored dot at each available series value. Defaults to true. */
  dots?: ReactiveValue<boolean>;
  /** Shows the tooltip box background, border and shadow. Defaults to true. Crosshair and dots remain when false. */
  appearance?: ReactiveValue<boolean>;
  /** PlotTooltipRow elements. */
  children?: Child[];
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** A hover overlay for its parent Plot. The pointer chooses the nearest category band; automatic rows show each available series value. Uses the plot’s stable identity and releases hover state with the plot. No tooltip is shown for an empty plot or over axis labels. */
export function PlotTooltip(props: PlotTooltipProps): Node {
  let node = kitNode('PlotTooltip', props.children ?? [], props.className);
  const prop_glide = props.glide;
  if (prop_glide !== undefined) {
    node = kitFlag(node, 'glide', prop_glide);
  }

  const prop_progress = props.progress;
  if (prop_progress !== undefined) {
    node = kitNumber(node, 'progress', prop_progress);
  }

  const prop_title = props.title;
  if (prop_title !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'title', prop_title));
  }

  const prop_showSeries = props.showSeries;
  if (prop_showSeries !== undefined) {
    node = kitFlag(node, 'showSeries', prop_showSeries);
  }

  const prop_gap = props.gap;
  if (prop_gap !== undefined) {
    node = kitNumber(node, 'gap', prop_gap);
  }

  const prop_crossLine = props.crossLine;
  if (prop_crossLine !== undefined) {
    if (typeof prop_crossLine === 'string') {
      node = unwrapNode(nativeKitSet(node, 'crossLine', `${prop_crossLine}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'crossLine', nativeBindText(prop_crossLine.evaluate)));
    }
  }

  const prop_dots = props.dots;
  if (prop_dots !== undefined) {
    node = kitFlag(node, 'dots', prop_dots);
  }

  const prop_appearance = props.appearance;
  if (prop_appearance !== undefined) {
    node = kitFlag(node, 'appearance', prop_appearance);
  }

  return node;
}

export interface PlotTooltipRowProps {
  /** Row label, empty by default. */
  label?: ReactiveValue<string> | TextBinding;
  /** Displayed value, empty by default. Signal expressions update live. */
  value?: ReactiveValue<string> | TextBinding;
  /** Optional swatch color: a theme or Tailwind palette color, or #rrggbb. Omit for a plain row. */
  color?: ReactiveValue<string> | TextBinding;
  /** Optional text color for this row’s value. Uses the same color names as Plot marks; omit to inherit tooltip text color. */
  valueColor?: ReactiveValue<string> | TextBinding;
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** An extra row in PlotTooltip, after automatic series rows. Values are application supplied; a row without color aligns with series rows without drawing a swatch. */
export function PlotTooltipRow(props: PlotTooltipRowProps): Node {
  let node = kitNode('PlotTooltipRow', [], props.className);
  const prop_label = props.label;
  if (prop_label !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'label', prop_label));
  }

  const prop_value = props.value;
  if (prop_value !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'value', prop_value));
  }

  const prop_color = props.color;
  if (prop_color !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'color', prop_color));
  }

  const prop_valueColor = props.valueColor;
  if (prop_valueColor !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'valueColor', prop_valueColor));
  }

  return node;
}

export interface PlotLineProps {
  /** Finite numbers, in label order. NaN and infinities throw a UI error. Missing trailing values are omitted; extra values beyond the labels are not drawn. Expressions reading component signals update live; plain arrays are read at construction. */
  values?: ReactiveValue<number[]>;
  /** Theme color (chart-1 … chart-5, primary, destructive, foreground, muted-foreground) or #rrggbb. Defaults to the next chart color. */
  color?: ReactiveValue<string> | TextBinding;
  /** Smooth (default), straight segments, or steps. */
  curve?: ReactiveValue<'natural' | 'linear' | 'step'>;
  /** Marks each point with a dot. */
  dots?: ReactiveValue<boolean>;
  /** Nonnegative finite stroke width in logical pixels, at most the native float maximum. Defaults to 2; invalid values throw a UI error. */
  width?: ReactiveValue<number>;
  /** Series name in PlotTooltip. Defaults to Series 1, Series 2, and so on in mark order. */
  label?: ReactiveValue<string> | TextBinding;
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** A line through one value per Plot label. */
export function PlotLine(props: PlotLineProps): Node {
  let node = kitNode('PlotLine', [], props.className);
  const prop_values = props.values;
  if (prop_values !== undefined) {
    if (Array.isArray(prop_values)) {
      node = unwrapNode(nativeKitSet(node, 'values', prop_values.join('\n')));
    } else {
      const evaluate = prop_values.evaluate;
      node = unwrapNode(nativeKitBind(node, 'values', nativeBindText(() => evaluate().join('\n'))));
    }
  }

  const prop_color = props.color;
  if (prop_color !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'color', prop_color));
  }

  const prop_curve = props.curve;
  if (prop_curve !== undefined) {
    if (typeof prop_curve === 'string') {
      node = unwrapNode(nativeKitSet(node, 'curve', `${prop_curve}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'curve', nativeBindText(prop_curve.evaluate)));
    }
  }

  const prop_dots = props.dots;
  if (prop_dots !== undefined) {
    node = kitFlag(node, 'dots', prop_dots);
  }

  const prop_width = props.width;
  if (prop_width !== undefined) {
    node = kitNumber(node, 'width', prop_width);
  }

  const prop_label = props.label;
  if (prop_label !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'label', prop_label));
  }

  return node;
}

