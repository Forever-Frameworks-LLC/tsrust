  /** left keeps the column in place while scrolling sideways. */
  fixed?: ReactiveValue<'left'>;
  /** false stops resizing this column. Defaults to true. */
  resizable?: ReactiveValue<boolean>;
  /** false stops moving this column. Defaults to true. */
  movable?: ReactiveValue<boolean>;
  /** false stops selecting this column. Defaults to true. */
