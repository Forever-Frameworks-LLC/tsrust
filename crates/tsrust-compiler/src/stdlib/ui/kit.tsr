  children?: Child[];
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** One file or media item. Compose AttachmentMedia, AttachmentContent (AttachmentTitle, AttachmentDescription) and AttachmentActions, or use the title/description/icon/image props. */
export function Attachment(props: AttachmentProps): Node {
  let node = kitNode('Attachment', props.children ?? [], props.className);
  const prop_title = props.title;
  if (prop_title !== undefined) {
