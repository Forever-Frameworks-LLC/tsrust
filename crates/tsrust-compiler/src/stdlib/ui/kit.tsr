    }
  }

  const prop_layout = props.layout;
  if (prop_layout !== undefined) {
    if (typeof prop_layout === 'string') {
      node = unwrapNode(nativeKitSet(node, 'layout', `${prop_layout}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'layout', nativeBindText(prop_layout.evaluate)));
    }
  }

  const prop_dirty = props.dirty;
  if (prop_dirty !== undefined) {
    node = kitFlag(node, 'dirty', prop_dirty);
  }

  const event_onReset = props.onReset;
  if (event_onReset !== undefined) {
    node = unwrapNode(nativeKitOnVoid(node, 'reset', event_onReset));
  }

  return node;
}

