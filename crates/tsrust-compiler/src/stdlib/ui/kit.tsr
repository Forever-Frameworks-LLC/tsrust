export interface SelectProps {
  /** Options, in order. */
  items?: string[];
  /** Selected option. An empty string selects nothing. */
  value?: ReactiveValue<string>;
  /** Text shown when nothing is selected. */
  placeholder?: ReactiveValue<string>;
  /** Disabled selects cannot open. */
  disabled?: ReactiveValue<boolean>;
  /** Receives the chosen option. */
  onChange?: Owned<Function<void, [value: ReadOnly<string>]>>;
  /** Shared utility classes applied around the component, such as width or margin. */
  className?: string;
}

/** A dropdown that picks one string from a list. */
export function Select(props: SelectProps): Node {
  let node = kitNode('Select', [], props.className ?? '');
  const prop_items = props.items;
  if (prop_items !== undefined) { node = unwrapNode(nativeKitSet(node, 'items', prop_items.join('\n'))); }
  const prop_value = props.value;
  if (prop_value !== undefined) { node = kitText(node, 'value', prop_value); }
  const prop_placeholder = props.placeholder;
  if (prop_placeholder !== undefined) { node = kitText(node, 'placeholder', prop_placeholder); }
  const prop_disabled = props.disabled;
  if (prop_disabled !== undefined) { node = kitFlag(node, 'disabled', prop_disabled); }
  const event_onChange = props.onChange;
  if (event_onChange !== undefined) { node = unwrapNode(nativeKitOn(node, 'change', event_onChange)); }
  return node;
}

