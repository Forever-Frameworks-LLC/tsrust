  }

  const prop_syntaxHighlight = props.syntaxHighlight;
  if (prop_syntaxHighlight !== undefined) {
    node = kitFlag(node, 'syntaxHighlight', prop_syntaxHighlight);
  }

  const prop_headerVisible = props.headerVisible;
  if (prop_headerVisible !== undefined) {
    node = kitFlag(node, 'headerVisible', prop_headerVisible);
  }

  const prop_hoverHighlight = props.hoverHighlight;
  if (prop_hoverHighlight !== undefined) {
    if (typeof prop_hoverHighlight === 'string') {
      node = unwrapNode(nativeKitSet(node, 'hoverHighlight', `${prop_hoverHighlight}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'hoverHighlight', nativeBindText(prop_hoverHighlight.evaluate)));
    }
  }

  const prop_hunkSeparator = props.hunkSeparator;
  if (prop_hunkSeparator !== undefined) {
    if (typeof prop_hunkSeparator === 'string') {
      node = unwrapNode(nativeKitSet(node, 'hunkSeparator', `${prop_hunkSeparator}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'hunkSeparator', nativeBindText(prop_hunkSeparator.evaluate)));
    }
  }

  const prop_changeIndicator = props.changeIndicator;
  if (prop_changeIndicator !== undefined) {
    if (typeof prop_changeIndicator === 'string') {
      node = unwrapNode(nativeKitSet(node, 'changeIndicator', `${prop_changeIndicator}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'changeIndicator', nativeBindText(prop_changeIndicator.evaluate)));
    }
  }

  const prop_changeBackground = props.changeBackground;
  if (prop_changeBackground !== undefined) {
    node = kitFlag(node, 'changeBackground', prop_changeBackground);
  }

  const prop_softWrap = props.softWrap;
  if (prop_softWrap !== undefined) {
    node = kitFlag(node, 'softWrap', prop_softWrap);
  }

  const prop_contextLines = props.contextLines;
  if (prop_contextLines !== undefined) {
    node = kitInt(node, 'contextLines', prop_contextLines);
  }

  const prop_expansionLines = props.expansionLines;
  if (prop_expansionLines !== undefined) {
    node = kitInt(node, 'expansionLines', prop_expansionLines);
  }

  const prop_minCollapsedLines = props.minCollapsedLines;
  if (prop_minCollapsedLines !== undefined) {
    node = kitInt(node, 'minCollapsedLines', prop_minCollapsedLines);
  }

  const prop_inlineUnit = props.inlineUnit;
  if (prop_inlineUnit !== undefined) {
    if (typeof prop_inlineUnit === 'string') {
      node = unwrapNode(nativeKitSet(node, 'inlineUnit', `${prop_inlineUnit}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'inlineUnit', nativeBindText(prop_inlineUnit.evaluate)));
    }
  }

  const prop_inlineMaxLineLength = props.inlineMaxLineLength;
  if (prop_inlineMaxLineLength !== undefined) {
    node = kitInt(node, 'inlineMaxLineLength', prop_inlineMaxLineLength);
  }

  const prop_syntaxMaxLineLength = props.syntaxMaxLineLength;
  if (prop_syntaxMaxLineLength !== undefined) {
    node = kitInt(node, 'syntaxMaxLineLength', prop_syntaxMaxLineLength);
  }

  const event_onLineClick = props.onLineClick;
