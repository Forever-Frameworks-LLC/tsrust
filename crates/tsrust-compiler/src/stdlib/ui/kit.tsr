export interface DialogProps {
  /** Opens the dialog when true and closes it when false. */
  open?: ReactiveValue<boolean>;
  /** Dialog heading. */
  title?: ReactiveValue<string>;
  /** Shows an OK button with this text. */
  okText?: ReactiveValue<string>;
  /** Shows a Cancel button with this text. */
  cancelText?: ReactiveValue<string>;
  /** Called when the user dismisses the dialog; set open to false here. */
  onClose?: Owned<Function<void>>;
  /** Called when the OK button is clicked. */
  onOk?: Owned<Function<void>>;
  /** Content shown inside the component. */
  children?: Child[];
  /** Shared utility classes applied around the component, such as width or margin. */
  className?: string;
}

/** A modal dialog shown while open is true. Its children are the dialog body. */
export function Dialog(props: DialogProps): Node {
  let node = kitNode('Dialog', props.children ?? [], props.className ?? '');
  const prop_open = props.open;
  if (prop_open !== undefined) { node = kitFlag(node, 'open', prop_open); }
  const prop_title = props.title;
  if (prop_title !== undefined) { node = kitText(node, 'title', prop_title); }
  const prop_okText = props.okText;
  if (prop_okText !== undefined) { node = kitText(node, 'okText', prop_okText); }
  const prop_cancelText = props.cancelText;
  if (prop_cancelText !== undefined) { node = kitText(node, 'cancelText', prop_cancelText); }
  const event_onClose = props.onClose;
  if (event_onClose !== undefined) { node = unwrapNode(nativeKitOnVoid(node, 'close', event_onClose)); }
  const event_onOk = props.onOk;
  if (event_onOk !== undefined) { node = unwrapNode(nativeKitOnVoid(node, 'ok', event_onOk)); }
  return node;
}

export interface SheetProps {
  /** Shows the sheet when true and hides it when false. */
  open?: ReactiveValue<boolean>;
  /** Sheet heading. */
  title?: ReactiveValue<string>;
  /** Window edge. Defaults to right. */
  side?: ReactiveValue<'right' | 'left' | 'top' | 'bottom'>;
  /** Called when the user dismisses the sheet; set open to false here. */
  onClose?: Owned<Function<void>>;
  /** Content shown inside the component. */
  children?: Child[];
  /** Shared utility classes applied around the component, such as width or margin. */
  className?: string;
}

/** A panel that slides in from the window edge while open is true. */
export function Sheet(props: SheetProps): Node {
  let node = kitNode('Sheet', props.children ?? [], props.className ?? '');
  const prop_open = props.open;
  if (prop_open !== undefined) { node = kitFlag(node, 'open', prop_open); }
  const prop_title = props.title;
  if (prop_title !== undefined) { node = kitText(node, 'title', prop_title); }
  const prop_side = props.side;
  if (prop_side !== undefined) {
    if (typeof prop_side === 'string') { node = unwrapNode(nativeKitSet(node, 'side', `${prop_side}`)); }
    else { node = unwrapNode(nativeKitBind(node, 'side', nativeBindText(prop_side.evaluate))); }
  }
  const event_onClose = props.onClose;
  if (event_onClose !== undefined) { node = unwrapNode(nativeKitOnVoid(node, 'close', event_onClose)); }
  return node;
}

