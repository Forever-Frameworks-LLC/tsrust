  /** Trigger look. */
  variant?: ReactiveValue<'default' | 'primary' | 'secondary' | 'danger' | 'warning' | 'success' | 'info' | 'ghost' | 'link' | 'text'>;
  /** Outline trigger. */
  outline?: ReactiveValue<boolean>;
  /** Trigger size. */
  size?: ReactiveValue<'xsmall' | 'small' | 'medium' | 'large'>;
  /** Disables the trigger. */
  disabled?: ReactiveValue<boolean>;
  /** Shows the trigger pressed. */
  selected?: ReactiveValue<boolean>;
  /** Point of the menu aligned to the trigger. Defaults to top-left. */
  anchor?: ReactiveValue<'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'top-center' | 'bottom-center' | 'left-center' | 'right-center'>;
  /** Name read by screen readers for the menu toggle. */
  menuLabel?: ReactiveValue<string> | TextBinding;
  /** Custom trigger fill: a theme color name or #rrggbb. */
  color?: ReactiveValue<string> | TextBinding;
  /** Custom trigger text color. */
  foreground?: ReactiveValue<string> | TextBinding;
  /** Custom trigger hover fill. */
  hoverColor?: ReactiveValue<string> | TextBinding;
  /** Custom trigger pressed fill. */
  activeColor?: ReactiveValue<string> | TextBinding;
  /** Minimum menu width in pixels. */
  minWidth?: ReactiveValue<number>;
  /** Maximum menu width in pixels. */
  maxWidth?: ReactiveValue<number>;
  /** Maximum menu height in pixels; taller menus scroll. */
  maxHeight?: ReactiveValue<number>;
  /** Lets a long menu scroll. */
  scrollable?: ReactiveValue<boolean>;
  /** Side the check mark of checked items is drawn on. Defaults to left. */
  checkSide?: ReactiveValue<'left' | 'right'>;
