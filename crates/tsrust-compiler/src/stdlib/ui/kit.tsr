export interface DataTableProps {
  /** The cells as JSON: an array of rows, each an array of cell values (`JSON.stringify(rows)`). Non-string values show as JSON text. */
  rows?: ReactiveValue<string> | TextBinding;
  /** Column titles, when there are no DataTableColumn children. Expressions reading component signals update live; plain arrays are read at construction. */
  columns?: ReactiveValue<string[]>;
  /** Alternates row backgrounds. */
  stripe?: ReactiveValue<boolean>;
  /** false removes the outer border. Defaults to true. */
  bordered?: ReactiveValue<boolean>;
  /** false turns off sorting for every column. Defaults to true; each column opts in with `sortable`. */
  sortable?: ReactiveValue<boolean>;
  /** false turns off row selection. Defaults to true. */
  rowSelectable?: ReactiveValue<boolean>;
  /** Clicking a header selects the column. */
  columnSelectable?: ReactiveValue<boolean>;
  /** Selects single cells instead of rows; arrow keys move between cells. */
  cellSelectable?: ReactiveValue<boolean>;
  /** Selects only on Cmd/Ctrl-click, so plain clicks leave the selection. */
  selectOnModifierClick?: ReactiveValue<boolean>;
  /** false stops arrow keys at the first and last row. Defaults to true. */
  loopSelection?: ReactiveValue<boolean>;
  /** false stops dragging headers to reorder columns. Defaults to true. */
  columnMovable?: ReactiveValue<boolean>;
  /** false stops dragging header edges to resize columns. Defaults to true. */
  columnResizable?: ReactiveValue<boolean>;
  /** With cellSelectable, the leading column that selects whole rows; false hides it (clicking a selected cell again then selects its row). Defaults to true. */
  rowHeader?: ReactiveValue<boolean>;
  /** Draws a border after the fixed columns. */
  fixedColumnsBorder?: ReactiveValue<boolean>;
  /** false hides the vertical scrollbar. Defaults to true. */
  scrollbarVisible?: ReactiveValue<boolean>;
  /** false hides the horizontal scrollbar. Defaults to true. */
  horizontalScrollbarVisible?: ReactiveValue<boolean>;
  /** Elastic overscroll at the edges. */
  scrollBounce?: ReactiveValue<boolean>;
  /** Header row height in pixels. */
  headerRowHeight?: ReactiveValue<number>;
  /** Selected row by its index in `rows`, controlled; the table scrolls to it. */
  selectedRow?: ReactiveValue<int>;
  /** Shows skeleton rows instead of the data. */
  loading?: ReactiveValue<boolean>;
  /** More rows can load; scrolling near the end fires onLoadMore. */
  hasMore?: ReactiveValue<boolean>;
  /** Rows from the end at which onLoadMore fires. Defaults to 20. */
  loadMoreThreshold?: ReactiveValue<int>;
  /** Name screen readers announce for the table. */
  accessibilityLabel?: ReactiveValue<string> | TextBinding;
  /** Row size: xsmall, small, medium (default) or large. */
  size?: ReactiveValue<'xsmall' | 'small' | 'medium' | 'large'>;
  /** Receives the selected row's index in `rows` (sorting does not change it). */
  onSelect?: Owned<Function<void, [row: int]>>;
  /** Receives a double-clicked row's index. */
  onActivate?: Owned<Function<void, [row: int]>>;
  /** Receives the selected column's key. */
  onSelectColumn?: Owned<Function<void, [key: ReadOnly<string>]>>;
  /** Receives the selected cell as [row index, column key]. */
  onSelectCell?: Owned<Function<void, [cell: ReadOnly<string[]>]>>;
  /** Receives a double-clicked cell as [row index, column key]. */
  onActivateCell?: Owned<Function<void, [cell: ReadOnly<string[]>]>>;
  /** Receives [column key, direction] after a header click; direction is ascending, descending or empty for the original order. */
  onSort?: Owned<Function<void, [sort: ReadOnly<string[]>]>>;
  /** Receives the column keys in their new order after a drag. */
  onColumnsChange?: Owned<Function<void, [keys: ReadOnly<string[]>]>>;
  /** Receives every column width in pixels after a resize. */
  onColumnWidthsChange?: Owned<Function<void, [widths: ReadOnly<string[]>]>>;
  /** Receives a right-clicked row's index. */
  onRightClick?: Owned<Function<void, [row: int]>>;
  /** Receives the row index as its DataTableMenu opens. */
  onContextMenu?: Owned<Function<void, [row: int]>>;
  /** Runs when Escape clears the selection. */
  onClearSelection?: Owned<Function<void>>;
  /** Runs when scrolling nears the end while hasMore is true. */
  onLoadMore?: Owned<Function<void>>;
  /** DataTableColumn, DataTableEmpty and DataTableMenu elements. */
  children?: Child[];
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** A virtualized table over many rows: sortable, resizable and movable columns, fixed columns, row, column or cell selection, a right-click menu and incremental loading. Columns come from DataTableColumn children; give it a height with className. */
