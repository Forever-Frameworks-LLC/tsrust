  }

  const prop_image = props.image;
  if (prop_image !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'image', prop_image));
  }

  const prop_status = props.status;
  if (prop_status !== undefined) {
    if (typeof prop_status === 'string') {
      node = unwrapNode(nativeKitSet(node, 'status', `${prop_status}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'status', nativeBindText(prop_status.evaluate)));
    }
  }

  const prop_progress = props.progress;
  if (prop_progress !== undefined) {
    node = kitNumber(node, 'progress', prop_progress);
  }

  const prop_tooltip = props.tooltip;
  if (prop_tooltip !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'tooltip', prop_tooltip));
  }

  const prop_vertical = props.vertical;
  if (prop_vertical !== undefined) {
    node = kitFlag(node, 'vertical', prop_vertical);
  }

  const prop_size = props.size;
  if (prop_size !== undefined) {
    if (typeof prop_size === 'string') {
      node = unwrapNode(nativeKitSet(node, 'size', `${prop_size}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'size', nativeBindText(prop_size.evaluate)));
    }
  }

  const prop_shimmerDuration = props.shimmerDuration;
  if (prop_shimmerDuration !== undefined) {
    node = kitInt(node, 'shimmerDuration', prop_shimmerDuration);
  }

  const prop_shimmerColor = props.shimmerColor;
  if (prop_shimmerColor !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'shimmerColor', prop_shimmerColor));
  }

  const event_onClick = props.onClick;
  if (event_onClick !== undefined) {
    node = unwrapNode(nativeKitOnVoid(node, 'click', event_onClick));
  }

  const event_onRemove = props.onRemove;
  if (event_onRemove !== undefined) {
