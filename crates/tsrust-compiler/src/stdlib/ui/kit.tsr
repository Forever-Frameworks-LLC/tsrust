  }

  const prop_bordered = props.bordered;
  if (prop_bordered !== undefined) {
    node = kitFlag(node, 'bordered', prop_bordered);
  }

  const prop_sortable = props.sortable;
  if (prop_sortable !== undefined) {
    node = kitFlag(node, 'sortable', prop_sortable);
  }

  const prop_rowSelectable = props.rowSelectable;
  if (prop_rowSelectable !== undefined) {
    node = kitFlag(node, 'rowSelectable', prop_rowSelectable);
  }

  const prop_columnSelectable = props.columnSelectable;
