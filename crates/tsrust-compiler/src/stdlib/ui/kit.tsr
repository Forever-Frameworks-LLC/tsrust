export interface ShortcutProps {
  /** Command name, such as save; also named by Button tooltipCommand and menu items. */
  command?: ReactiveValue<string> | TextBinding;
  /** Keystrokes in GPUI notation, such as cmd-s, ctrl-shift-p or alt-enter; secondary-s means cmd on macOS and ctrl elsewhere. */
  keys?: ReactiveValue<string> | TextBinding;
  /** Called when the keys are pressed. */
  onTrigger?: Owned<Function<void>>;
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** Binds a keyboard shortcut to a named command while it is mounted. Buttons, menu items and key hints that name the same command show this shortcut. */
export function Shortcut(props: ShortcutProps): Node {
  let node = kitNode('Shortcut', [], props.className);
  const prop_command = props.command;
  if (prop_command !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'command', prop_command));
  }

  const prop_keys = props.keys;
  if (prop_keys !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'keys', prop_keys));
  }

  const event_onTrigger = props.onTrigger;
  if (event_onTrigger !== undefined) {
    node = unwrapNode(nativeKitOnVoid(node, 'trigger', event_onTrigger));
  }

  return node;
}

export interface TickerProps {
  /** Milliseconds between ticks. Defaults to 16 (about 60 per second). */
  interval?: ReactiveValue<number>;
  /** false pauses the ticks. Defaults to true. */
  running?: ReactiveValue<boolean>;
  /** Receives the tick count since the timer started (1, 2, 3 and so on). */
  onTick?: Owned<Function<void, [frame: int]>>;
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** An invisible timer for animation: it calls onTick on a fixed interval while running. Update signals in onTick to move things; it stops when unmounted. */
export function Ticker(props: TickerProps): Node {
  let node = kitNode('Ticker', [], props.className);
  const prop_interval = props.interval;
  if (prop_interval !== undefined) {
    node = kitNumber(node, 'interval', prop_interval);
  }

  const prop_running = props.running;
  if (prop_running !== undefined) {
    node = kitFlag(node, 'running', prop_running);
  }

  const event_onTick = props.onTick;
  if (event_onTick !== undefined) {
    node = unwrapNode(nativeKitOnInt(node, 'tick', event_onTick));
  }

  return node;
}

