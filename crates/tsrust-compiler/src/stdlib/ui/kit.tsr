export interface SubmenuProps {
  /** Entry text. */
  label?: ReactiveValue<string> | TextBinding;
  /** Leading icon. */
  icon?: ReactiveValue<IconName>;
  /** MenuItem, MenuLabel, MenuSeparator and Submenu elements. */
  children?: Child[];
  /** Shared utility classes applied around the component, such as width or margin. */
  className?: string;
}

/** A nested menu opened from its parent menu. */
export function Submenu(props: SubmenuProps): Node {
  let node = kitNode('Submenu', props.children ?? [], props.className ?? '');
  const prop_label = props.label;
  if (prop_label !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'label', prop_label));
  }

  const prop_icon = props.icon;
  if (prop_icon !== undefined) {
    if (typeof prop_icon === 'string') {
      node = unwrapNode(nativeKitSet(node, 'icon', `${prop_icon}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'icon', nativeBindText(prop_icon.evaluate)));
    }
  }

  return node;
}

export interface AvatarGroupProps {
  /** Most avatars to show. */
  limit?: ReactiveValue<int>;
  /** Shows an ellipsis avatar when some avatars are hidden by the limit. */
  ellipsis?: ReactiveValue<boolean>;
  /** Size. Defaults to medium. */
  size?: ReactiveValue<'xsmall' | 'small' | 'medium' | 'large'>;
  /** Avatar elements. */
  children?: Child[];
  /** Shared utility classes applied around the component, such as width or margin. */
  className?: string;
}

/** Overlapping avatars; avatars past the limit are hidden or summarized by an ellipsis. */
export function AvatarGroup(props: AvatarGroupProps): Node {
  let node = kitNode('AvatarGroup', props.children ?? [], props.className ?? '');
  const prop_limit = props.limit;
  if (prop_limit !== undefined) {
    node = kitInt(node, 'limit', prop_limit);
  }

  const prop_ellipsis = props.ellipsis;
  if (prop_ellipsis !== undefined) {
    node = kitFlag(node, 'ellipsis', prop_ellipsis);
  }

  const prop_size = props.size;
  if (prop_size !== undefined) {
    if (typeof prop_size === 'string') {
      node = unwrapNode(nativeKitSet(node, 'size', `${prop_size}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'size', nativeBindText(prop_size.evaluate)));
    }
  }

  return node;
}

