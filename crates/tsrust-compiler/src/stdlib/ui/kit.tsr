export interface DiffProps {
  /** Unified diff text, as printed by git diff. */
  patch?: ReactiveValue<string> | TextBinding;
  /** One column, or old and new side by side. Defaults to unified. */
  mode?: ReactiveValue<'unified' | 'split'>;
  /** Shows original and modified source line numbers. Defaults to true. */
  lineNumbers?: ReactiveValue<boolean>;
  /** Colors recognized source languages. Defaults to true; unknown languages remain plain text. */
  syntaxHighlight?: ReactiveValue<boolean>;
  /** Shows each file header and its collapse control. Defaults to true. */
  headerVisible?: ReactiveValue<boolean>;
  /** Emphasizes the hovered code row, number gutter or both. Defaults to none. */
  hoverHighlight?: ReactiveValue<'none' | 'line' | 'line-number' | 'both'>;
  /** Displays the Git hunk header (default), omitted-line count or a thin divider. */
  hunkSeparator?: ReactiveValue<'metadata' | 'line-info' | 'simple'>;
  /** Marks changed rows with plus/minus signs (default), colored bars or no gutter mark. */
  changeIndicator?: ReactiveValue<'signs' | 'bars' | 'none'>;
  /** Tints added and removed row backgrounds. Defaults to true. */
  changeBackground?: ReactiveValue<boolean>;
  /** Wraps long source lines within the view. Defaults to false; horizontal scrolling preserves source lines. */
  softWrap?: ReactiveValue<boolean>;
  /** Unchanged lines shown around changes. Defaults to 3; -1 shows all available context. Other negative values throw. Cannot recover lines omitted from the patch. */
  contextLines?: ReactiveValue<int>;
  /** Lines revealed by one unchanged-section disclosure. Defaults to 20; requires an integer >= 1. */
  expansionLines?: ReactiveValue<int>;
  /** Minimum unchanged run kept collapsed. Defaults to 2; requires an integer >= 1. */
  minCollapsedLines?: ReactiveValue<int>;
  /** Emphasizes changed words (default), Unicode characters, or whole lines only. */
  inlineUnit?: ReactiveValue<'word' | 'character' | 'none'>;
  /** Maximum source-line byte length for inline comparison. Defaults to 1000; requires an integer >= 1. Longer lines retain whole-line coloring. */
  inlineMaxLineLength?: ReactiveValue<int>;
  /** Maximum source-line byte length for syntax coloring. Defaults to 1000; requires an integer >= 1. Longer lines remain plain text. */
  syntaxMaxLineLength?: ReactiveValue<int>;
  /** Receives a JSON position {path, side, line} when source code is clicked outside a selection drag. side is original or modified; line is one-based. The snapshot can be parsed with JSON.parse. */
  onLineClick?: Owned<Function<void, [value: ReadOnly<string>]>>;
  /** Receives the same JSON position as onLineClick while hovering, or JSON null on leaving a line. */
  onLineHover?: Owned<Function<void, [value: ReadOnly<string>]>>;
  /** Shows the add-annotation affordance. Receives a JSON inclusive range {path, side, start, endSide, end}. It spans the selected lines when applicable; all line numbers are one-based. */
  onAddAnnotation?: Owned<Function<void, [value: ReadOnly<string>]>>;
  /** DiffAnnotation, DiffDecoration, DiffGutterMarker and DiffHeader elements. */
  children?: Child[];
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** A read-only, virtualized view of a unified or Git patch, with one section per changed file. Display and context props preserve the retained comparison state; mode changes can reset horizontal scrolling and context changes can adjust folded rows. Changing patch replaces the parsed files. Invalid patch text reports its parse line and message and stops the application. For example, <Diff patch={patch} mode="split" softWrap={true}/> wraps both source columns. Callbacks receive retained JSON snapshots with file paths and one-based source positions. Ownership: the mounted node owns one comparison state; callbacks retain weak window owners. */
export function Diff(props: DiffProps): Node {
  let node = kitNode('Diff', props.children ?? [], props.className);
  const prop_patch = props.patch;
  if (prop_patch !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'patch', prop_patch));
