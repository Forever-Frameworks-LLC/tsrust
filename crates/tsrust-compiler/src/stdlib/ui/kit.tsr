    node = kitFlag(node, 'selectOnModifierClick', prop_selectOnModifierClick);
  }

  const prop_loopSelection = props.loopSelection;
  if (prop_loopSelection !== undefined) {
    node = kitFlag(node, 'loopSelection', prop_loopSelection);
  }

  const prop_columnMovable = props.columnMovable;
  if (prop_columnMovable !== undefined) {
    node = kitFlag(node, 'columnMovable', prop_columnMovable);
  }

  const prop_columnResizable = props.columnResizable;
  if (prop_columnResizable !== undefined) {
    node = kitFlag(node, 'columnResizable', prop_columnResizable);
  }

  const prop_rowHeader = props.rowHeader;
  if (prop_rowHeader !== undefined) {
    node = kitFlag(node, 'rowHeader', prop_rowHeader);
  }

  const prop_fixedColumnsBorder = props.fixedColumnsBorder;
  if (prop_fixedColumnsBorder !== undefined) {
    node = kitFlag(node, 'fixedColumnsBorder', prop_fixedColumnsBorder);
  }

  const prop_scrollbarVisible = props.scrollbarVisible;
  if (prop_scrollbarVisible !== undefined) {
    node = kitFlag(node, 'scrollbarVisible', prop_scrollbarVisible);
  }

  const prop_horizontalScrollbarVisible = props.horizontalScrollbarVisible;
  if (prop_horizontalScrollbarVisible !== undefined) {
    node = kitFlag(node, 'horizontalScrollbarVisible', prop_horizontalScrollbarVisible);
  }

  const prop_scrollBounce = props.scrollBounce;
  if (prop_scrollBounce !== undefined) {
    node = kitFlag(node, 'scrollBounce', prop_scrollBounce);
  }

  const prop_headerRowHeight = props.headerRowHeight;
  if (prop_headerRowHeight !== undefined) {
    node = kitNumber(node, 'headerRowHeight', prop_headerRowHeight);
  }

  const prop_selectedRow = props.selectedRow;
  if (prop_selectedRow !== undefined) {
    node = kitInt(node, 'selectedRow', prop_selectedRow);
  }

  const prop_loading = props.loading;
  if (prop_loading !== undefined) {
    node = kitFlag(node, 'loading', prop_loading);
  }

  const prop_hasMore = props.hasMore;
  if (prop_hasMore !== undefined) {
    node = kitFlag(node, 'hasMore', prop_hasMore);
  }

  const prop_loadMoreThreshold = props.loadMoreThreshold;
  if (prop_loadMoreThreshold !== undefined) {
    node = kitInt(node, 'loadMoreThreshold', prop_loadMoreThreshold);
  }

  const prop_accessibilityLabel = props.accessibilityLabel;
  if (prop_accessibilityLabel !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'accessibilityLabel', prop_accessibilityLabel));
  }

  const prop_size = props.size;
  if (prop_size !== undefined) {
    if (typeof prop_size === 'string') {
      node = unwrapNode(nativeKitSet(node, 'size', `${prop_size}`));
    } else {
      node = unwrapNode(nativeKitBind(node, 'size', nativeBindText(prop_size.evaluate)));
