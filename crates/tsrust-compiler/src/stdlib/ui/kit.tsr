  className?: ReactiveValue<string>;
}

/** A step-by-step survey of Question elements with progress, Back/Skip/Next/Submit and required-answer validation. Choosing an answer moves to the next question. Question ids, labels, required/multiple flags, defaults and freeform input definitions are read once at mount. Changing size or Question/QuestionChoice.disabled preserves answers. Duplicate ids, more than one default choice for a single-answer question, and multiple inputs in one question throw. Ownership: the questionnaire owns its answer and input state until disposal. */
