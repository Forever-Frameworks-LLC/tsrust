export interface ListProps {
  /** Shows a search field that filters rows by their text, value and keywords. */
  searchable?: ReactiveValue<boolean>;
  /** Hint in the search field. */
  placeholder?: ReactiveValue<string> | TextBinding;
  /** false turns off row highlighting and keyboard selection. Defaults to true. */
  selectable?: ReactiveValue<boolean>;
  /** Highlighted row (0-based across all groups), controlled. */
