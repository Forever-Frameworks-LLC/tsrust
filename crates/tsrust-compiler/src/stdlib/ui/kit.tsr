export interface ComboboxProps {
  /** Plain options whose label is also the value; SelectItem children add more. */
  items?: string[];
  /** Selected values, controlled, one per line (a single value for single-select); set it from onChange. Without it the combobox keeps its own selection. */
  value?: ReactiveValue<string> | TextBinding;
  /** Initially selected values when `value` is unset. */
