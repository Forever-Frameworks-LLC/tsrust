  /** Shows a clear button while something is selected. */
  cleanable?: ReactiveValue<boolean>;
  /** Ignores clicks and keys. */
  disabled?: ReactiveValue<boolean>;
  /** Icon in place of the dropdown caret. */
  icon?: ReactiveValue<IconName>;
  /** Icon marking selected options. Defaults to a check. */
  checkIcon?: ReactiveValue<IconName>;
  /** false draws the bare trigger. */
  appearance?: ReactiveValue<boolean>;
  /** Width of the open list in pixels. */
  menuWidth?: ReactiveValue<number>;
  /** Most height in pixels the open list takes before it scrolls. */
  menuMaxHeight?: ReactiveValue<number>;
  /** Focuses the combobox when it mounts. */
