  children?: Child[];
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

/** One setting: a title and description beside its control (the children). Its children own their control size and disabled state. Supply dirty and onReset together for page reset; no value is inferred or mutated automatically. */
export function SettingItem(props: SettingItemProps): Node {
  let node = kitNode('SettingItem', props.children ?? [], props.className);
  const prop_title = props.title;
  if (prop_title !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'title', prop_title));
  }

  const prop_description = props.description;
  if (prop_description !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'description', prop_description));
  }

  const prop_keywords = props.keywords;
  if (prop_keywords !== undefined) {
    if (Array.isArray(prop_keywords)) {
      node = unwrapNode(nativeKitSet(node, 'keywords', prop_keywords.join('\n')));
    } else {
