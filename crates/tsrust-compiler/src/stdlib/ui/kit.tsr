export interface SettingsProps {
  /** Settings layout and label size; medium by default. Set child control sizes separately. */
  size?: ReactiveValue<'xsmall' | 'small' | 'medium' | 'large'>;
  /** Initial sidebar width in logical pixels; 250 by default. Finite nonnegative native pixel range. User resizing is retained. */
  sidebarWidth?: ReactiveValue<number>;
  /** Minimum sidebar width in logical pixels; 160 by default. Must not exceed sidebarMaxWidth. */
  sidebarMinWidth?: ReactiveValue<number>;
  /** Maximum sidebar width in logical pixels; 360 by default. Must be at least sidebarMinWidth. */
  sidebarMaxWidth?: ReactiveValue<number>;
  /** Zero-based initial page index, 0 by default. Read at mount. An unavailable index falls back to the first visible page. */
  defaultPage?: ReactiveValue<int>;
  /** Optional zero-based initial group index within defaultPage; absent selects the page heading. Read at mount. */
  defaultGroup?: ReactiveValue<int>;
  /** Default group surface; normal by default. SettingsGroup.variant overrides it. */
  groupVariant?: ReactiveValue<'normal' | 'fill' | 'outline'>;
  /** Utility styles applied to the sidebar surface. */
  sidebarClassName?: ReactiveValue<string> | TextBinding;
  /** Utility styles applied to the sidebar search header. SettingsPage.headerClassName styles each content page heading separately. */
  headerClassName?: ReactiveValue<string> | TextBinding;
