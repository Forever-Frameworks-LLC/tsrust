  label?: ReactiveValue<string>;
  /** Greys the step out. */
  disabled?: ReactiveValue<boolean>;
  /** Shared utility classes applied around the component, such as width or margin. */
  className?: string;
}

/** One step in a Stepper. */
export function StepperItem(props: StepperItemProps): Node {
  let node = kitNode('StepperItem', [], props.className ?? '');
  const prop_label = props.label;
  if (prop_label !== undefined) { node = kitText(node, 'label', prop_label); }
  const prop_disabled = props.disabled;
  if (prop_disabled !== undefined) { node = kitFlag(node, 'disabled', prop_disabled); }
  return node;
}

export interface TabsProps {
  /** Index of the selected tab. */
  selected?: ReactiveValue<int>;
  /** Visual style. Defaults to the standard tab style. */
  variant?: ReactiveValue<'underline' | 'pill' | 'outline' | 'segmented'>;
  /** Receives the clicked tab's index. */
  onChange?: Owned<Function<void, [index: int]>>;
  /** Tab elements. */
  children?: Child[];
  /** Shared utility classes applied around the component, such as width or margin. */
  className?: string;
}

/** A tab bar. Children are Tab elements; show the matching panel yourself from the selected index. */
export function Tabs(props: TabsProps): Node {
  let node = kitNode('Tabs', props.children ?? [], props.className ?? '');
  const prop_selected = props.selected;
  if (prop_selected !== undefined) { node = kitInt(node, 'selected', prop_selected); }
  const prop_variant = props.variant;
  if (prop_variant !== undefined) {
    if (typeof prop_variant === 'string') { node = unwrapNode(nativeKitSet(node, 'variant', `${prop_variant}`)); }
    else { node = unwrapNode(nativeKitBind(node, 'variant', nativeBindText(prop_variant.evaluate))); }
  }
  const event_onChange = props.onChange;
  if (event_onChange !== undefined) { node = unwrapNode(nativeKitOnInt(node, 'change', event_onChange)); }
  return node;
}

export interface TabProps {
  /** Tab text. */
  label?: ReactiveValue<string>;
  /** Disabled tabs cannot be selected. */
  disabled?: ReactiveValue<boolean>;
  /** Shared utility classes applied around the component, such as width or margin. */
  className?: string;
}

/** One tab in Tabs. */
export function Tab(props: TabProps): Node {
  let node = kitNode('Tab', [], props.className ?? '');
  const prop_label = props.label;
  if (prop_label !== undefined) { node = kitText(node, 'label', prop_label); }
  const prop_disabled = props.disabled;
  if (prop_disabled !== undefined) { node = kitFlag(node, 'disabled', prop_disabled); }
  return node;
}

export interface AccordionProps {
  /** Allows several sections open at once. */
  multiple?: ReactiveValue<boolean>;
  /** Draws borders around sections. Defaults to true. */
