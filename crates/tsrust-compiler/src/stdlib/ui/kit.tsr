export interface CodeEditorProps {
  /** Controlled full text. Omission preserves local edits; a changed value replaces the buffer. Pair with onChange to retain user edits. */
  value?: ReactiveValue<string> | TextBinding;
  /** Highlighting language, such as rust, typescript or json. tsr/tsrust select the TypeScript grammar; tsrx selects TSX. Read when the editor mounts; omission displays plain text. readInput reports the canonical grammar name. */
  language?: ReactiveValue<string> | TextBinding;
  /** Prevents edits. */
  readOnly?: ReactiveValue<boolean>;
  /** Identifier for controlInput and readInput. Use a unique, nonempty name in this window. */
  id?: ReactiveValue<string> | TextBinding;
  /** Initial text when value is omitted. Read once at mount; later changes do not replace edits. */
  defaultValue?: ReactiveValue<string> | TextBinding;
  /** Hint shown while the buffer is empty. Defaults to empty. */
  placeholder?: ReactiveValue<string> | TextBinding;
  /** Prevents editing and focus. Defaults to false. */
  disabled?: ReactiveValue<boolean>;
  /** false removes the field background and border. Defaults to true. */
  appearance?: ReactiveValue<boolean>;
  /** false removes the border while preserving the background. Defaults to true. */
  bordered?: ReactiveValue<boolean>;
  /** Accessible editor name, such as Source code. */
  accessibilityLabel?: ReactiveValue<string> | TextBinding;
  /** Keyboard focus order. Defaults to zero. */
  tabIndex?: ReactiveValue<int>;
  /** Optional accessibility role override. Omission keeps the editor text-field role. */
  role?: ReactiveValue<'searchbox' | 'combobox' | 'spinbutton' | 'none'>;
  /** Padding density. Defaults to medium; className controls code font size. */
  size?: ReactiveValue<'xsmall' | 'small' | 'medium' | 'large'>;
  /** Focuses this editor when it mounts. Defaults to false. */
  autoFocus?: ReactiveValue<boolean>;
  /** Shows source line numbers. Defaults to true. */
  lineNumbers?: ReactiveValue<boolean>;
  /** Enables gutter folding. Defaults to true; disabling unfolds existing ranges. */
  folding?: ReactiveValue<boolean>;
  /** Automatically closes matching brackets and quotes. Defaults to true. */
  autoClose?: ReactiveValue<boolean>;
  /** Uses language-aware indentation when typing. Defaults to true. */
  smartIndent?: ReactiveValue<boolean>;
  /** Shows indentation guides. Defaults to true. */
  indentGuides?: ReactiveValue<boolean>;
  /** Escape clears the editor when true. Defaults to false. */
  cleanOnEscape?: ReactiveValue<boolean>;
  /** true emits onSubmit on Enter instead of inserting a newline. Defaults to false. */
  submitOnEnter?: ReactiveValue<boolean>;
  /** false disables the built-in right-click edit menu. Defaults to true. */
  contextMenu?: ReactiveValue<boolean>;
  /** Shows spaces and tabs as visible marks. Defaults to false. */
  showWhitespace?: ReactiveValue<boolean>;
  /** Text alignment. Defaults to left. */
  textAlign?: ReactiveValue<'left' | 'center' | 'right'>;
  /** Extra rows scrollable past the final line. Nonnegative; omission keeps the Kit default. */
  scrollBeyondLastLine?: ReactiveValue<int>;
  /** Rows kept visible around the cursor. Nonnegative; omission keeps the Kit default. */
  cursorSurroundingLines?: ReactiveValue<int>;
  /** Touch keyboard Enter label. Read at mount; defaults to enter. */
  enterKeyHint?: ReactiveValue<'enter' | 'done' | 'go' | 'next' | 'previous' | 'search' | 'send'>;
  /** Platform autocorrection. Read at mount; omission keeps the platform default. */
  autoCorrect?: ReactiveValue<boolean>;
  /** Platform capitalization. Read at mount; omission keeps the platform default. */
  autoCapitalize?: ReactiveValue<'none' | 'words' | 'sentences' | 'characters'>;
  /** Allows find/replace rather than find alone. Read at mount; defaults to true. */
  replaceable?: ReactiveValue<boolean>;
  /** Wraps long source lines. Omission keeps the Kit editor default. */
  softWrap?: ReactiveValue<boolean>;
  /** Enables find and the search actions of controlInput. Defaults to true. */
  searchable?: ReactiveValue<boolean>;
  /** Enables elastic overscroll. Omission keeps the Kit default. */
  scrollBounce?: ReactiveValue<boolean>;
  /** Wrapped-line indentation. Omission keeps the Kit default. */
  wrappingIndent?: ReactiveValue<'same' | 'none'>;
  /** Spaces per indentation level. Positive integer; defaults to two. */
  tabSize?: ReactiveValue<int>;
  /** Uses a tab character with tabSize rather than spaces. Defaults to false. */
  hardTabs?: ReactiveValue<boolean>;
  /** Receives the full text after each edit. */
  onChange?: Owned<Function<void, [text: ReadOnly<string>]>>;
  /** Runs when the editor gains keyboard focus. */
  onFocus?: Owned<Function<void>>;
  /** Runs when the editor loses keyboard focus. */
  onBlur?: Owned<Function<void>>;
  /** Runs on Enter submission; secondary reports Cmd on macOS or Ctrl elsewhere. */
  onSubmit?: Owned<Function<void, [secondary: boolean]>>;
  /** Synchronously inspects a JSON clipboard snapshot {text, paths, imageCount}. text is string or null; paths is a file-path array; imageCount counts images without exposing their bytes. Return true to consume the paste without default insertion, or false to insert normal text. Errors stop the application. Web platforms without synchronous clipboard access skip this handler. Ownership: snapshot is borrowed only for the call; clone text to retain it. */
  onPaste?: Owned<Function<boolean, [payload: ReadOnly<string>]>>;
  /** Utility classes, empty by default. Expressions reading component signals update without remounting. Unknown utilities throw; class changes preserve the component's state and children. */
  className?: ReactiveValue<string>;
}

