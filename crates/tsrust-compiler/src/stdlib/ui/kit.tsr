  className?: ReactiveValue<string>;
}

/** A named top-level application menu inside AppMenuBar. Menu items dispatch Shortcut commands in the active window. Ownership: transfers its entries to the application menu definition. */
export function AppMenu(props: AppMenuProps): Node {
  let node = kitNode('AppMenu', props.children ?? [], props.className);
  const prop_label = props.label;
  if (prop_label !== undefined) {
    node = unwrapNode(nativeKitValue(node, 'label', prop_label));
  }

  const prop_disabled = props.disabled;
  if (prop_disabled !== undefined) {
    node = kitFlag(node, 'disabled', prop_disabled);
  }

  return node;
}

export interface DropdownMenuProps {
