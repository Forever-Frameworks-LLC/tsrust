}
/** Creates a multiline field. CRLF/CR values normalize to LF; no numeric conversion occurs. */
export function Textarea(props: TextareaProps<ReactiveValue<string>, ReactiveValue<string>>): Node {
  return <TextField {...props} multiline={true}/>;
}

interface InputOptions {
  placeholder: string;
  disabled: boolean;
  readOnly: boolean;
  multiline: boolean;
  required: boolean;
  name: string;
  autoComplete: string;
  type: string;
}

