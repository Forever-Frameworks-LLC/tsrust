/** Creates a container, preserving child order. className defaults to empty. Unknown utilities or depth over 128 throw a message. Consumes its children. */
export function View(props: ViewProps<ReactiveValue<string>, ReactiveValue<string>>): Node {
  const Render = props.render;
  props.render = undefined;
  if (Render !== undefined) {
    return <Render {...props}/>;
  }

  const className = props.className;
  const variant = props['data-variant'];
  const classes = typeof className === 'string' ? clone(className) : '';
  const metadata = semanticConfig(String(props.as ?? ''), String(props.role ?? ''), props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', typeof variant === 'string' ? clone(variant) : '', String(props['aria-orientation'] ?? ''), props['aria-describedby'] ?? '', props['aria-invalid'], props.htmlFor ?? '', props.windowDragRegion ?? false, props.tabIndex, undefined, undefined, props['data-state'], props.colSpan, String(props.scope ?? ''));
