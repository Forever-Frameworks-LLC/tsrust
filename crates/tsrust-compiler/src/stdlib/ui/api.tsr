  node = fieldOption(node, 'height', height === undefined ? undefined : `${height}`);
  node = fieldLive(node, 'masked', props.masked);
  node = fieldFlag(node, 'cleanOnEscape', props.cleanOnEscape);
  node = fieldFlag(node, 'submitOnEnter', props.submitOnEnter);
  node = fieldFlag(node, 'contextMenu', props.contextMenu);
  node = fieldLive(node, 'loading', props.loading);
  node = fieldFlag(node, 'showWhitespace', props.showWhitespace);
  node = fieldOption(node, 'textAlign', textAlign === undefined ? undefined : `${textAlign}`);
  node = fieldNumber(node, 'scrollBeyondLastLine', props.scrollBeyondLastLine);
  node = fieldNumber(node, 'cursorSurroundingLines', props.cursorSurroundingLines);
  node = fieldOption(node, 'mask', props.mask);
  node = fieldOption(node, 'thousandsSeparator', props.thousandsSeparator);
  node = fieldNumber(node, 'fractionDigits', props.fractionDigits);
  node = fieldOption(node, 'pattern', props.pattern);
  node = fieldOption(node, 'enterKeyHint', enterKeyHint === undefined ? undefined : `${enterKeyHint}`);
  node = fieldFlag(node, 'autoCorrect', props.autoCorrect);
  node = fieldOption(node, 'autoCapitalize', autoCapitalize === undefined ? undefined : `${autoCapitalize}`);
  node = options.autoComplete === '' ? node : fieldOption(node, 'autoComplete', clone(options.autoComplete));
  const onFocus = props.onFocus;
  if (onFocus !== undefined) {
    node = unwrapNode(nativeKitOnVoid(node, 'focus', onFocus));
  }

  const onBlur = props.onBlur;
  if (onBlur !== undefined) {
    node = unwrapNode(nativeKitOnVoid(node, 'blur', onBlur));
  }

  const onSubmit = props.onSubmit;
  if (onSubmit !== undefined) {
    node = unwrapNode(nativeKitOnBoolean(node, 'submit', onSubmit));
  }

  const onTokenClick = props.onTokenClick;
  if (onTokenClick !== undefined) {
    node = unwrapNode(nativeKitOn(node, 'tokenClick', onTokenClick));
  }

  const onTokenHover = props.onTokenHover;
  if (onTokenHover !== undefined) {
