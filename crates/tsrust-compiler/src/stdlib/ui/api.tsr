import { Node as NativeNode, UiError as NativeUiError, text, view, disabledButton, document as nativeDocument, run as nativeRun } from 'std:ui-runtime';

/** An owned UI subtree. Moving a Node transfers all descendants. Nodes cannot be cloned or sent to workers. */
export type Node = NativeNode;
/** A renderer or node-construction failure with a readable message. */
export type UiError = NativeUiError;

export interface TextProps {
  children: string[];
  className?: string;
}

export interface ViewProps {
  children: Node[];
  className?: string;
}

export interface ButtonProps {
  children: string[];
  className?: string;
  disabled: boolean;
}

/** Creates a text node by joining text children without a separator. className defaults to empty. Unknown or conflicting utilities throw a message. Owns its text. */
export function Text(props: TextProps): Node {
  const result = text(props.children.join(''), props.className ?? '');
  match (result) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}
/** Creates a container, preserving child order. className defaults to empty. Unknown/conflicting utilities or depth over 128 throw a message. Consumes its children. */
export function View(props: ViewProps): Node {
  const result = view(props.children, props.className ?? '');
  match (result) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}
/** Creates a disabled semantic button with text children. disabled must be true in the static slice. Unknown/conflicting utilities throw a message. Owns its label. */
export function Button(props: ButtonProps): Node {
  if (!props.disabled) {
    throw 'Interactive buttons require the interactive UI runtime';
  }

  const result = disabledButton(props.children.join(''), props.className ?? '');
  match (result) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}
/** Produces a complete escaped HTML document with shared utility styles. Borrows the tree and title; returns an owned string. Does not execute callbacks or mutate nodes. */
export function document(node: ReadOnly<Node>, title: string): string {
  return nativeDocument(node, title);
}
/** Opens a GPU-rendered native window on the main thread and waits for closure. Returns Ok after cleanup or Err with a renderer error. Consumes the tree; title is borrowed. */
export function run(node: Node, title: string): Result<void, UiError> {
  return nativeRun(node, title);
}
