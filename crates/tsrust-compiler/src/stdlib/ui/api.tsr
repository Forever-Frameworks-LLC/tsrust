/** A controlInput action. */
export type InputAction = 'focus' | 'selectAll' | 'unselect' | 'clear' | 'insert' | 'replace' | 'setValue' | 'setCursor' | 'setSelection' | 'addSelection' | 'toggleMasked' | 'scrollTo' | 'insertToken' | 'openSearch' | 'openReplace' | 'search' | 'nextMatch' | 'previousMatch' | 'replaceMatch' | 'replaceAllMatches' | 'closeSearch';

/** Arguments for controlInput actions that take them. */
export interface InputActionOptions {
  /** Text to insert, replace with or search for; for insertToken, the token id and text. */
  value?: string;
  /** For insertToken, the text shown in place of value. */
  label?: string;
  /** Byte offset for setCursor and the start of setSelection/addSelection; horizontal pixels for scrollTo. */
  start?: int;
  /** Byte offset of the selection end; vertical pixels for scrollTo. */
  end?: int;
}

/** Runs an action on the Input or Textarea whose id matches, on the next frame. insert and replace edit at the cursor or selection; setValue replaces all text; search actions need searchable. Example: controlInput('name', 'focus'). Unknown ids do nothing. */
export function controlInput(id: string, action: InputAction, options?: InputActionOptions): void {
  const extra = options ?? {};
  unwrap(nativeCommand('input', JSON.stringify({
    id: id, action: `${action}`, value: extra.value ?? '', label: extra.label ?? '', start: extra.start ?? 0, end: extra.end ?? 0
  })));
}

/** A field's text, selection and scroll position, read by readInput. */
export interface InputSnapshot {
  /** False when no mounted field has the id; the other fields are then absent. */
  found: boolean;
  /** The current text. */
  value?: string;
  /** The text without mask literals, such as 5551234567 for (555)-123-4567. */
  unmaskedValue?: string;
  /** The selected text, or empty. */
  selectedText?: string;
  /** Selection start as a byte offset; equals selectionEnd when only the cursor is placed. */
  selectionStart?: int;
  /** Selection end as a byte offset. */
  selectionEnd?: int;
  /** True when the selection was made backwards. */
  selectionReversed?: boolean;
  /** Horizontal scroll offset in pixels. */
  scrollX?: number;
  /** Vertical scroll offset in pixels. */
  scrollY?: number;
  /** First visible row of a multiline field. */
  firstVisibleRow?: int;
  /** Row after the last visible row of a multiline field. */
  lastVisibleRow?: int;
  /** True while the field has keyboard focus. */
  focused?: boolean;
}

/** Reads the Input or Textarea whose id matches on the next frame, then calls onRead. Example: readInput('notes', (field) => { selection.set(field.selectedText ?? ''); }). */
export function readInput(id: string, onRead: Owned<Function<void, [field: ReadOnly<InputSnapshot>]>>): void {
