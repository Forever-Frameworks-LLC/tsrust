    } else {
      node = applyProperties(unwrapNode(nativeBindDisabled(unwrapNode(nativeButton(children, classes, false, handler)), disabled.evaluate)), metadata, className, variant);
    }
  } else if (handler !== undefined) {
    node = applyProperties(unwrapNode(nativeButton(children, classes, disabled ?? false, handler)), metadata, className, variant);
  } else {
    node = applyProperties(unwrapNode(staticButton(children, classes, disabled ?? false)), metadata, className, variant);
  }

  for (const [name, value] of options) {
    node = unwrapNode(nativeKitSet(node, name, value));
  }

  if (loading !== undefined) {
    node = kitFlag(node, 'loading', loading);
  }

  if (selected !== undefined) {
    node = kitFlag(node, 'selected', selected);
  }

  for (const [name, value] of extra) {
    node = unwrapNode(nativeKitSet(node, name, value));
  }

  if (progress !== undefined) {
    node = kitNumber(node, 'progress', progress);
  }

  if (toggled !== undefined) {
    node = kitFlag(node, 'toggled', toggled);
  }

  if (onHover !== undefined) {
    node = unwrapNode(nativeKitOnBoolean(node, 'hover', onHover));
  }

  return node;
}

/** Kit button options that are set, as name/value pairs. */
function buttonOptions(variant: string | undefined, size: string | undefined, icon: string | undefined, outline: boolean, compact: boolean, caret: boolean, tooltip: string): [string, string][] {
  const options: [string, string][] = [];
  if (variant !== undefined) {
    options.push(['variant', variant]);
  }

  if (size !== undefined) {
    options.push(['size', size]);
  }

  if (icon !== undefined) {
    options.push(['icon', icon]);
  }

  if (outline) {
    options.push(['outline', 'true']);
  }

  if (compact) {
    options.push(['compact', 'true']);
  }

  if (caret) {
    options.push(['caret', 'true']);
  }

  if (tooltip !== '') {
    options.push(['tooltip', tooltip]);
  }

  return options;
}

/** An application path or HTTPS link. External links open in the default browser. */
interface LinkProperties<Classes, Variant> extends ElementProps<Variant> {
  /** Absolute local path with optional heading fragment, or an HTTPS URL without credentials. Local queries, escapes and traversal are rejected. */
  href: string;
  /** True dims the link and ignores clicks. Live when it reads state. */
  disabled?: boolean | ReactiveBoolean;
  children?: Child[];
  className?: Classes;
}

export type LinkProps<Classes = string, Variant = string> = LinkProperties<Classes, Variant>;
/** Navigates locally or opens an HTTPS URL. The current page and ancestor path segments expose aria-current for styling and accessibility. External links leave application history unchanged. Launch failures throw. */
export function Link(props: LinkProps<ReactiveValue<string>, ReactiveValue<string>>): Node {
  const className = props.className;
  const variant = props['data-variant'];
  const classes = typeof className === 'string' ? clone(className) : '';
  const metadata = semanticConfig('', '', props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', typeof variant === 'string' ? clone(variant) : '', '', props['aria-describedby'] ?? '', props['aria-invalid']);
  let node = unwrapNode(nativeLink(props.children ?? [], classes, props.href));
