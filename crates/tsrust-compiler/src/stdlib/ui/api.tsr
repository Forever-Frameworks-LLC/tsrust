  return applyProperties(node, metadata, className, variant);
}
/** Creates the single application location owner, initially /. Its get/set methods use checked absolute local paths. */
export function location(): Signal<string> {
  return unwrap(nativeLocation());
}
/** Pushes an application path. Navigating to the current path is a no-op. */
export function navigate(path: string): void {
  unwrap(nativeNavigate(path));
}
/** Visits the preceding application history entry. No prior entry is a no-op. */
export function back(): void {
  unwrap(nativeTraverse(false));
}
/** Visits the following application history entry. No following entry is a no-op. */
export function forward(): void {
  unwrap(nativeTraverse(true));
}

/** A retained lazy route. Create one location() owner in the application root first. */
export interface RouteProps {
  /** Absolute local path. Trailing slashes normalize; queries, escapes, traversal and fragments reject. */
  path: string;
  /** True by default. False also matches descendant path segments; /docs does not match /docs-other. Hash changes do not reconstruct content. */
  exact?: boolean;
  /** Called once on the first matching location. Its Node, state, controls and scroll positions remain retained during later visits. Factory failures propagate; no retry is implied. */
  render: Owned<Function<Node>>;
}
/** Renders no node until its path matches, then retains the same subtree while inactive. No wrapper layout or focus stop is added. Root disposal releases both uncalled factories and visited content. Only visited routes construct their content; this does not split downloaded executable code. */
export function Route(props: RouteProps): Node {
  return unwrapNode(nativeRoute(props.path, props.exact ?? true, props.render));
}

/** Produces a complete escaped HTML document with shared utility styles. Borrows the tree and title; returns an owned string. Does not execute callbacks or mutate nodes. */
export function document(node: ReadOnly<Node>, title: string): string {
  match (nativeValidateRoot(node)) {
    Ok(_) => {},
    Err(error) => {
      throw error.message;
    }
  }

  return nativeDocument(node, title);
}
/** Checked native window creation options. */
export interface WindowOptions {
  /** Initial content width, 240–16384 logical pixels; defaults to 640. */
  width?: number;
  /** Initial content height, 160–16384 logical pixels; defaults to 480. */
  height?: number;
  /** Minimum width, 240–initial width; defaults to 240. */
  minWidth?: number;
  /** Minimum height, 160–initial height; defaults to 160. */
  minHeight?: number;
  /** Native by default. Custom currently requires macOS and keeps traffic-light controls over content. Reserve header space and mark drag surfaces with View.windowDragRegion. Creation-time only. */
