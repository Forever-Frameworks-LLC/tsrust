import { setTranslations as nativeSetTranslations, setLocale as nativeSetLocale, locale as nativeLocale, translate as nativeTranslate, translation as nativeTranslation } from 'std:ui-runtime';
import { command as nativeCommand, commandReply as nativeCommandReply, openWindow as nativeOpenWindow, appearance as nativeAppearance, appInfo as nativeAppInfo } from 'std:ui-runtime';
import { useId as nativeUseId, svg as nativeSvg, path as nativePath, bindPath as nativeBindPath, validateRoot as nativeValidateRoot, bindClass as nativeBindClass, bindVariant as nativeBindVariant, Computed as NativeComputed, computed as nativeComputed, route as nativeRoute, visibility as nativeVisibility, copyButton as nativeCopyButton, location as nativeLocation, navigate as nativeNavigate, traverse as nativeTraverse, link as nativeLink, themeMode as nativeThemeMode, bindHidden as nativeBindHidden, branch as nativeBranch, TextBinding as NativeTextBinding, bindText as nativeBindText, input as nativeInput, inputChange as nativeInputChange, bindReadOnly as nativeBindReadOnly, bindSemantics as nativeBindSemantics, semantics as nativeSemantics, bindDisabled as nativeBindDisabled, theme as nativeTheme, Signal as NativeSignal, signal as nativeSignal, ownState as nativeOwnState, button as nativeButton, Node as NativeNode, UiError as NativeUiError, text, view, staticButton, document as nativeDocument, run as nativeRun } from 'std:ui-runtime';

/** An owned UI subtree. Moving a Node transfers all descendants. Nodes cannot be cloned or sent to workers. */
export type Node = NativeNode;
/** A renderer or node-construction failure with a readable message. */
export type UiError = NativeUiError;

/** An owned live scalar text expression produced automatically by JSX. It has no public constructor or receiver methods. */
export type TextBinding = NativeTextBinding;
/** Ordered strings/numeric snapshots and live bindings; null and undefined produce no text. */
export type TextChild = string | int | number | TextBinding | Signal<int> | Signal<number> | Signal<boolean> | Signal<string> | null | undefined;
/** Ordered text, direct Signal bindings or owned subtrees. Adjacent text shares one run; null, undefined and empty literals are omitted. Supported JSX scalar expressions reading local component state refresh; local-state JSX ternaries lazily mount selected subtrees. Other computed values remain construction-time snapshots. Ownership: transfers Nodes/strings once; state bindings are non-retaining. */
export type Child = TextChild | Node;

/** A deferred child array. Nested JSX becomes this owned zero-argument factory only when the component declares it. Each call constructs fresh content; dropping it does not construct content. */
export type LazyChildren = Owned<Function<Child[]>>;

/** Reserves a unique runtime-local UI identifier. Keep its owned string in component construction; every call allocates a different ID. No arguments or receiver. Throws if the counter is exhausted. */
export function useId(): string {
  return unwrap(nativeUseId());
}


/** Shared element identity and accessible naming. Attributes are escaped in HTML and applied to the same native subtree. */
interface ElementMetadata<Variant> {
  /** A document ID without ASCII whitespace/control characters. Defaults to no ID. */
  id?: string;
  /** Live accessible name for buttons, headings, named sections or supported named roles. Generic text/containers, paragraphs, code and presentation cannot be named. */
  'aria-label'?: ReactiveValue<string | undefined>;
  /** Live flag excluding a noninteractive subtree from accessibility. Enabled controls inside it are rejected. Defaults to false. */
  'aria-hidden'?: ReactiveValue<boolean | undefined>;
  /** Live space-separated IDs of descriptive content. Missing IDs are ignored; text is exposed as a description. */
  'aria-describedby'?: ReactiveValue<string | undefined>;
  /** Live validation state for assistive technology and styling; does not run validation. Omission leaves it unspecified. */
  'aria-invalid'?: ReactiveValue<boolean | undefined>;
  /** Local component slot for styling and inspection. ASCII letters, digits and hyphens; defaults to none. */
  'data-slot'?: string;
  /** Component size metadata for checked data/group selectors. ASCII letters, digits and hyphens; empty means absent. */
  'data-size'?: string;
  /** Component variant metadata for data/group selectors; ASCII letters, digits and hyphens. Empty means absent. Does not change styles without a matching class. */
  'data-variant'?: Variant;
}

/** Noninteractive semantic roles shared by View and Text. Unsupported roles fail rather than losing accessibility behavior. */
export type ElementProps<Variant = string> = ElementMetadata<Variant>;
interface SemanticMetadata<Variant> extends ElementProps<Variant> {
  /** Defaults to the element's implicit role. A region requires aria-label; separators require empty content. */
  role?: 'alert' | 'status' | 'separator' | 'group' | 'note' | 'region' | 'none' | 'presentation';
  /** Only valid for role=separator; defaults to horizontal. */
  'aria-orientation'?: 'horizontal' | 'vertical';
}

export type SemanticProps<Variant = string> = SemanticMetadata<Variant>;

interface SvgPaintProps {
  /** Fill paint: none, currentColor, a semantic token name, checked hex or in-gamut oklch. Svg defaults to currentColor; Path inherits. External paint URLs are rejected. */
  fill?: string;
  /** Stroke paint with the same accepted values as fill. Svg defaults to none; Path inherits. */
  stroke?: string;
  /** Finite nonnegative stroke width in viewBox units. Svg defaults to 1; Path inherits. Native geometry precision applies. */
  strokeWidth?: number;
  /** End-cap geometry. Svg defaults to butt; Path inherits. */
  strokeLinecap?: 'butt' | 'round' | 'square';
  /** Join geometry. Svg defaults to miter; Path inherits. */
  strokeLinejoin?: 'miter' | 'round' | 'bevel';
  /** Finite miter length/width limit, at least 1. Svg defaults to 4; Path inherits. */
  strokeMiterlimit?: number;
  /** Interior winding rule. Svg defaults to nonzero; Path inherits. */
  fillRule?: 'nonzero' | 'evenodd';
}

interface SvgProperties<Classes, Variant> extends ElementProps<Variant>, SvgPaintProps {
  /** Four finite x/y/width/height numbers separated by spaces or commas. Width/height must be positive. Defaults to 0 0 24 24. */
  viewBox?: string;
  /** Preferred viewport width in logical pixels. Finite and nonnegative; defaults to 24. Width utilities override this value. */
  width?: number;
  /** Preferred viewport height in logical pixels. Finite and nonnegative; defaults to 24. Height utilities override this value. */
  height?: number;
  /** none stretches independently. xMin/Mid/MaxYMin/Mid/Max plus optional meet/slice aligns a uniform scale. Defaults to xMidYMid meet. */
  preserveAspectRatio?: string;
  /** Image semantics. Named images default to img; unlabelled icons default to presentation and aria-hidden. Visible images require aria-label. */
  role?: 'img' | 'presentation';
  /** Owned Path nodes in paint order. Other node/text children reject. An empty d hides a retained path. */
  children?: Child[];
  /** Shared box and color utilities. Defaults to empty. Svg starts at 24 by 24 and clips to its viewport; overflow-visible opts out. Intrinsic auto/fit sizing rejects; use explicit, fractional or viewport dimensions. */
  className?: Classes;
}

export type SvgProps<Classes = string, Variant = string> = SvgProperties<Classes, Variant>;
interface PathProperties<Data, Classes, Variant> extends ElementProps<Variant>, SvgPaintProps {
  /** SVG M/L/H/V/C/S/Q/T/A/Z commands, relative or absolute. Empty is valid. Invalid/nonfinite data rejects. Live expressions update the same path. Limits: 1048576 UTF-8 bytes and 100000 source segments/resulting elements. Nonzero arc radii must exceed 0.00001 units; zero radii draw a line. Original strings stay unchanged. */
  d: Data;
  /** Base semantic text colors and opacity only. Defaults to empty. Put layout, theme scopes and interaction styles on the enclosing Svg. */
  className?: Classes;
}

export type PathProps<Data = string, Classes = string, Variant = string> = PathProperties<Data, Classes, Variant>;
interface SvgOptions {
  viewBox: string;
  width: number;
  height: number;
  preserveAspectRatio: string;
  paint: SvgPaintProps;
}

function checkSvgPaint(strokeWidth: number | undefined, strokeMiterlimit: number | undefined): void {
  if (strokeWidth !== undefined && (!Number.isFinite(strokeWidth) || strokeWidth < 0)) {
    throw 'SVG strokeWidth must be finite and nonnegative';
  }

  if (strokeMiterlimit !== undefined && (!Number.isFinite(strokeMiterlimit) || strokeMiterlimit < 1)) {
    throw 'SVG strokeMiterlimit must be finite and at least 1';
  }
}
/** Creates a checked vector viewport with owned Path children. Defaults to a decorative 24px image; provide aria-label for meaningful imagery. It draws as an SVG image with theme colors resolved; no external resources are loaded. */
export function Svg(props: SvgProps<ReactiveValue<string>, ReactiveValue<string>>): Node {
  checkSvgPaint(props.strokeWidth, props.strokeMiterlimit);
  const width: number = props.width ?? 24;
  const height: number = props.height ?? 24;
  if (!Number.isFinite(width) || !Number.isFinite(height) || width < 0 || height < 0) {
    throw 'SVG width/height must be finite and nonnegative';
  }

  const className = props.className;
  const variant = props['data-variant'];
  const label = props['aria-label'] ?? '';
  const hidden = props['aria-hidden'];
  const metadata = semanticConfig('svg', String(props.role ?? ''), label, props.id ?? '', hidden, props['data-slot'] ?? '', props['data-size'] ?? '', typeof variant === 'string' ? clone(variant) : '', '', props['aria-describedby'] ?? '', props['aria-invalid']);
  const options: SvgOptions = {
    viewBox: props.viewBox ?? '0 0 24 24', width, height, preserveAspectRatio: props.preserveAspectRatio ?? 'xMidYMid meet', paint: {
      fill: props.fill, stroke: props.stroke, strokeWidth: props.strokeWidth, strokeLinecap: props.strokeLinecap, strokeLinejoin: props.strokeLinejoin, strokeMiterlimit: props.strokeMiterlimit, fillRule: props.fillRule
    }
  };
  const config = JSON.stringify(options);
  return applyProperties(unwrapNode(nativeSvg(props.children ?? [], typeof className === 'string' ? clone(className) : '', config)), metadata, className, variant);
}
/** Creates owned path geometry for an enclosing Svg. Paint inherits from Svg unless overridden. Resource bindings use weak captures; removing the tree releases its evaluators. */
export function Path(props: PathProps<ReactiveValue<string>, ReactiveValue<string>, ReactiveValue<string>>): Node {
  checkSvgPaint(props.strokeWidth, props.strokeMiterlimit);
  const data = props.d;
  const className = props.className;
  const variant = props['data-variant'];
  const metadata = semanticConfig('', '', props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', typeof variant === 'string' ? clone(variant) : '', '', props['aria-describedby'] ?? '', props['aria-invalid']);
  const options: SvgPaintProps = {
    fill: props.fill, stroke: props.stroke, strokeWidth: props.strokeWidth, strokeLinecap: props.strokeLinecap, strokeLinejoin: props.strokeLinejoin, strokeMiterlimit: props.strokeMiterlimit, fillRule: props.fillRule
  };
  const config = JSON.stringify(options);
  const node = unwrapNode(nativePath(typeof data === 'string' ? clone(data) : '', typeof className === 'string' ? clone(className) : '', config));
  const bound = typeof data === 'string' ? node : unwrapNode(nativeBindPath(node, data.evaluate));
  return applyProperties(bound, metadata, className, variant);
}

interface TextProperties<Classes, Variant> extends SemanticProps<Variant> {
  /** Defaults to span. Heading levels are reflected in native accessibility. */
  as?: 'span' | 'div' | 'p' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'code' | 'kbd' | 'strong' | 'em' | 'del';
  /** Ordered text content. Pass between tags or with children={values}; combining both is rejected. */
  children?: Child[];
  /** Text tone. default and inherit keep the inherited color; secondary and muted use muted-foreground. Inside a Kit component with text children, such as Label, secondary text fills its secondary slot. */
  variant?: 'default' | 'inherit' | 'secondary' | 'muted';
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Includes relative/absolute parent positioning and checked insets; inline descendants require typography only. Includes aspect-square/video/[W/H]/[R]/auto with finite positive f32 ratios. Explicit sizes and min/max bounds still apply. Later classes win per property/state. */
  className?: Classes;
}

export type TextProps<Classes = string, Variant = string> = TextProperties<Classes, Variant>;

interface ViewProperties<Classes, Variant> extends SemanticProps<Variant> {
  /** Receives initial visibility and changes after layout. Visible means positive area inside the viewport and every clipping ancestor, not occlusion detection. Hidden subtrees report false. No scroll interception. */
  onVisibilityChange?: Owned<Function<void, [visible: boolean]>>;
  /** 0 participates in source-order keyboard focus; -1 allows pointer/accessibility focus only. Omission is not focusable. Positive values are rejected. Name scroll regions with role=region and aria-label. */
  tabIndex?: int;
  /** Removes this subtree from layout, paint, interaction and accessibility while retaining its state. JSX state conditions refresh after handlers. Defaults to false. */
  hidden?: boolean | ReactiveBoolean;
  /** Marks a native custom-header drag surface. Interactive descendants, including disabled controls and labels, exclude dragging. */
  windowDragRegion?: boolean;
  /** Semantic container tag; defaults to div. Landmarks, lists, blockquotes and table parts preserve their native accessibility roles. Layout remains explicit through className. kbd and code accept composed phrasing children. */
  as?: 'div' | 'section' | 'span' | 'label' | 'kbd' | 'code' | 'nav' | 'main' | 'header' | 'footer' | 'aside' | 'article' | 'blockquote' | 'ul' | 'ol' | 'li' | 'table' | 'thead' | 'tbody' | 'tfoot' | 'caption' | 'tr' | 'th' | 'td';
  /** For as=label, the single ID of its associated control. Omission labels the first enclosed control. */
  htmlFor?: string;
  /** Optional live styling state, such as selected. ASCII letters, digits and hyphens; empty omits it. Does not change accessibility selection. */
  'data-state'?: ReactiveValue<string | undefined>;
  /** Static horizontal table-cell span, integer 1–1000. Defaults to one; only th/td accept it. Invalid values throw. */
  colSpan?: int;
  /** Table header association; only th accepts row, col, rowgroup or colgroup. Omission uses automatic association. */
  scope?: 'row' | 'col' | 'rowgroup' | 'colgroup';
  /** Owned ordered content. Pass between tags or with children={values}; combining both is rejected. Forwarding transfers the array once. */
  children?: Child[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Includes relative/absolute parent positioning and checked insets; inline descendants require typography only. Includes aspect-square/video/[W/H]/[R]/auto with finite positive f32 ratios. Explicit sizes and min/max bounds still apply. Later classes win per property/state. */
  className?: Classes;
}

/** Props forwarded once to a replacement View renderer; there is no render field to recurse through. */
export type ViewRenderProps<Classes = ReactiveValue<string>, Variant = ReactiveValue<string>> = ViewProperties<Classes, Variant>;
interface ViewComponentProps<Classes, Variant> extends ViewRenderProps<Classes, Variant> {
  /** Optional replacement factory. Forward its owned props into one UI node; returning it adds no wrapper or focus stop. */
  render?: Owned<Function<Node, [props: Owned<ViewRenderProps>]>>;
}

export type ViewProps<Classes = string, Variant = string> = ViewComponentProps<Classes, Variant>;

interface ButtonProperties<Classes, Variant> extends ElementProps<Variant> {
  /** Live expansion state. Undefined removes the explicit state; application handlers control visibility. */
  'aria-expanded'?: ReactiveValue<boolean | undefined>;
  /** Live space-separated controlled element IDs. Undefined/empty removes the relationship; missing targets are ignored natively. */
  'aria-controls'?: ReactiveValue<string | undefined>;
  /** Owned ordered content. Pass between tags or with children={values}; combining both is rejected. Forwarding transfers the array once. */
  children?: Child[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Includes relative/absolute parent positioning and checked insets; inline descendants require typography only. Includes aspect-square/video/[W/H]/[R]/auto with finite positive f32 ratios. Explicit sizes and min/max bounds still apply. Later classes win per property/state. */
  className?: Classes;
  disabled?: boolean | ReactiveBoolean;
  onPress?: Owned<Function<void>>;
  /** GPUI Kit look: default (neutral, when omitted), primary, secondary, danger, warning, success, info, ghost, link or text. Applies to unclassed buttons. */
  variant?: 'default' | 'primary' | 'secondary' | 'danger' | 'warning' | 'success' | 'info' | 'ghost' | 'link' | 'text';
  /** xsmall, small, medium (default) or large. */
  size?: 'xsmall' | 'small' | 'medium' | 'large';
  /** Leading icon; a button with only an icon becomes square. */
  icon?: IconName;
  /** Draws the variant as an outline. */
  outline?: boolean;
  /** Tighter horizontal padding. */
  compact?: boolean;
  /** Shows a spinner and blocks clicks while true. */
  loading?: ReactiveValue<boolean>;
  /** Marks the button as selected, as in a toggle group. */
  selected?: ReactiveValue<boolean>;
  /** Adds a dropdown caret after the label. */
  caret?: boolean;
  /** Tooltip shown on hover. */
  tooltip?: string;
  /** A Shortcut command whose keys the tooltip shows, such as save. */
  tooltipCommand?: string;
  /** Side the tooltip opens on. Defaults to top. */
  tooltipPlacement?: 'top' | 'bottom' | 'left' | 'right';
  /** Milliseconds before the tooltip appears. */
  tooltipDelay?: int;
  /** Corner rounding: none, small, medium (default) or large. */
  rounded?: 'none' | 'small' | 'medium' | 'large';
  /** Icon shown while loading, instead of the spinner. */
  loadingIcon?: IconName;
  /** Shows a spinner as the icon. */
  spinner?: boolean;
  /** Shows a progress circle (0–100) as the icon. */
  progress?: ReactiveValue<number>;
  /** Draws the button pressed in, as for a toggle. */
  toggled?: ReactiveValue<boolean>;
  /** Accessibility role: button (default), link, menuitem, tab, checkbox, switch or none. */
  role?: 'button' | 'link' | 'menuitem' | 'tab' | 'checkbox' | 'switch' | 'none';
  /** Keyboard tab order; -1 skips the button. */
  tabIndex?: int;
  /** False removes the button from the tab order. Defaults to true. */
  tabStop?: boolean;
  /** Custom variant fill: a theme color name (such as magenta) or #rrggbb. */
  color?: string;
  /** Custom variant text color. */
  foreground?: string;
  /** Custom variant hover fill. */
  hoverColor?: string;
  /** Custom variant pressed fill. */
  activeColor?: string;
  /** Called with true when the pointer enters and false when it leaves. */
  onHover?: Owned<Function<void, [hovered: boolean]>>;
}

/** Button props supplied to a replacement factory, including children, disabled state and onPress. */
export type ButtonRenderProps<Classes = ReactiveValue<string>, Variant = ReactiveValue<string>> = ButtonProperties<Classes, Variant>;
interface ButtonComponentProps<Classes, Variant> extends ButtonRenderProps<Classes, Variant> {
  /** Optional replacement factory. Forward all supplied behavior onto one control; it is called once and adds no wrapper. */
  render?: Owned<Function<Node, [props: Owned<ButtonRenderProps>]>>;
}

export type ButtonProps<Classes = string, Variant = string> = ButtonComponentProps<Classes, Variant>;

/** Text-field values preserve exact ints and ordinary number formatting. Signal and derived bindings retain no state owner. */
export type InputValue = string | int | number | Signal<string> | Signal<int> | Signal<number> | ReactiveInputValue;

/** A read-only snapshot supplied during a text-field change. It retains no element or state. */
export interface InputTarget {
  /** Current normalized field text, including Unicode. It does not parse numeric input. */
  value: string;
  /** The field's name, or an empty string when omitted. */
  name: string;
  /** The field's explicit id, or an empty string when omitted. */
  id: string;
}

export interface InputChangeEvent {
  /** Snapshot of the field that changed. */
  target: InputTarget;
  /** Snapshot of the field whose handler is running; matches target for a directly registered handler. */
  currentTarget: InputTarget;
}

interface TextFieldProperties<Classes, Variant> extends ElementProps<Variant> {
  /** Controlled text/numeric value. Direct signals and state-reading JSX expressions refresh after handlers. Omission selects uncontrolled state. */
  value?: InputValue;
  /** Initial uncontrolled value only; an explicit value takes precedence, including the empty string and zero. */
  defaultValue?: string | int | number;
  /** Hint shown when empty. A visible Label or aria-label should provide the accessible name. */
  placeholder?: string;
  /** Disabled fields cannot edit or receive focus. State-reading JSX conditions refresh after handlers. */
  disabled?: boolean | ReactiveBoolean;
  /** Read-only fields retain selection/focus but cannot change text. State-reading JSX conditions refresh after handlers. */
  readOnly?: boolean | ReactiveBoolean;
  required?: boolean;
  name?: string;
  autoComplete?: string;
  className?: Classes;
  /** Receives a borrowed value snapshot; edit logic stays in application code. String state.set copies the new text. */
  onChange?: Owned<Function<void, [event: ReadOnly<InputChangeEvent>]>>;
  /** xsmall, small, medium (default) or large. */
  size?: 'xsmall' | 'small' | 'medium' | 'large';
  /** false draws the bare text without the field's border and background, for custom containers. Defaults to true. */
  appearance?: boolean;
  /** false removes the border but keeps the background. Defaults to true. */
  bordered?: boolean;
  /** Keyboard focus order; positive values come first in ascending order. */
  tabIndex?: int;
  /** Accessibility role: searchbox, combobox, spinbutton, or none for presentational. Defaults to a text field. */
  role?: 'searchbox' | 'combobox' | 'spinbutton' | 'none';
  /** Fixed height in pixels; on Input, 'full' fills the parent's height. */
  height?: int | 'full';
  /** Input only: draws the value as bullets and keeps it out of copy and cut. type="password" masks too. */
  masked?: ReactiveValue<boolean>;
  /** Escape clears the field. */
  cleanOnEscape?: boolean;
  /** Whether Enter submits (onSubmit) instead of inserting a newline. Input submits by default; Textarea inserts newlines unless this is true. */
  submitOnEnter?: boolean;
  /** false turns off the right-click edit menu. Defaults to true. */
  contextMenu?: boolean;
  /** Input only: shows a spinner while true. */
  loading?: ReactiveValue<boolean>;
  /** Draws spaces and tabs as visible marks. */
  showWhitespace?: boolean;
  /** Horizontal text alignment of a single-line field. Defaults to left. */
  textAlign?: 'left' | 'center' | 'right';
  /** Extra rows the view can scroll past the last line. */
  scrollBeyondLastLine?: int;
  /** Lines kept visible around the cursor while scrolling. */
  cursorSurroundingLines?: int;
  /** Formats typing as it happens: 9 is an optional digit, # a digit, A a letter, others are literal, as in "(999)-999-9999". */
  mask?: string;
  /** Groups the integer part with this character, such as ",", turning on number formatting. */
  thousandsSeparator?: string;
  /** Number formatting with at most this many decimal places. */
  fractionDigits?: int;
  /** Input only: a regular expression the whole value must match; edits that would break it are rejected. */
  pattern?: string;
  /** The Enter key's label on touch keyboards. Read when the field mounts. */
  enterKeyHint?: 'enter' | 'done' | 'go' | 'next' | 'previous' | 'search' | 'send';
  /** Platform autocorrection. Read when the field mounts. */
  autoCorrect?: boolean;
  /** Platform automatic capitalization. Read when the field mounts. */
  autoCapitalize?: 'none' | 'words' | 'sentences' | 'characters';
  /** Runs when the field gains keyboard focus. */
  onFocus?: Owned<Function<void>>;
  /** Runs when the field loses keyboard focus. */
  onBlur?: Owned<Function<void>>;
  /** Runs on Enter; secondary is true with the platform modifier (cmd on macOS, ctrl elsewhere). */
  onSubmit?: Owned<Function<void, [secondary: boolean]>>;
  /** Runs when an inline token (inserted with controlInput 'insertToken') is clicked, with its id. */
  onTokenClick?: Owned<Function<void, [id: ReadOnly<string>]>>;
  /** Runs when the pointer enters an inline token (its id) or leaves it (empty). */
  onTokenHover?: Owned<Function<void, [id: ReadOnly<string>]>>;
}

export type TextFieldProps<Classes = string, Variant = string> = TextFieldProperties<Classes, Variant>;

interface InputProperties<Classes, Variant> extends TextFieldProps<Classes, Variant> {
  /** password masks the value with a reveal toggle; email, url, tel and search set the platform keyboard and autofill. Defaults to text. */
  type?: 'text' | 'password' | 'email' | 'url' | 'tel' | 'search';
  /** Shows a clear button while the field has a value. */
  cleanable?: boolean;
  /** Shows the eye button that reveals a masked value. Defaults to true for type="password". */
  maskToggle?: boolean;
  /** false keeps the normal border while focused. Defaults to true. */
  focusBordered?: boolean;
  /** Icon before the text. For buttons and text addons use InputGroup. */
  prefix?: IconName;
  /** Icon after the text. */
  suffix?: IconName;
  /** Draws the field as selected. */
  selected?: boolean;
}

export type InputProps<Classes = string, Variant = string> = InputProperties<Classes, Variant>;

interface TextareaProperties<Classes, Variant> extends TextFieldProps<Classes, Variant> {
  /** Visible rows. Defaults to 4. */
  rows?: int;
  /** With maxRows, grows with its content between these row counts. */
  minRows?: int;
  /** The most rows an auto-growing textarea shows before it scrolls. */
  maxRows?: int;
  /** false scrolls long lines horizontally instead of wrapping. Defaults to true. */
  softWrap?: boolean;
  /** Turns on find (cmd/ctrl-F) and the search actions of controlInput. */
  searchable?: boolean;
  /** false keeps find from offering replace. Read when the field mounts. */
  replaceable?: boolean;
  /** Elastic overscroll at the edges. */
  scrollBounce?: boolean;
  /** Wrapped lines start at the line's indent (same, the default) or at column zero (none). */
  wrappingIndent?: 'same' | 'none';
  /** Spaces per Tab. */
  tabSize?: int;
  /** Tab inserts a tab character instead of spaces. */
  hardTabs?: boolean;
}

export type TextareaProps<Classes = string, Variant = string> = TextareaProperties<Classes, Variant>;

function fieldOption(node: Node, name: string, value: string | undefined): Node {
  if (value === undefined) {
    return node;
  }

  return unwrapNode(nativeKitSet(node, name, value));
}

function fieldFlag(node: Node, name: string, value: boolean | undefined): Node {
  if (value === undefined) {
    return node;
  }

  return unwrapNode(nativeKitSet(node, name, value ? 'true' : 'false'));
}

function fieldNumber(node: Node, name: string, value: int | undefined): Node {
  if (value === undefined) {
    return node;
  }

  return unwrapNode(nativeKitSet(node, name, `${value}`));
}

function fieldLive(node: Node, name: string, value: ReactiveValue<boolean> | undefined): Node {
  if (value === undefined) {
    return node;
  }

  return kitFlag(node, name, value);
}

/** Creates a single-line field. CR/LF are removed like HTML text inputs; values otherwise remain exact Unicode strings. */
export function Input(props: InputProps<ReactiveValue<string>, ReactiveValue<string>>): Node {
  const kind = props.type !== undefined ? clone(props.type) : undefined;
  const cleanable = props.cleanable;
  const maskToggle = props.maskToggle;
  const focusBordered = props.focusBordered;
  const prefix = props.prefix !== undefined ? clone(props.prefix) : undefined;
  const suffix = props.suffix !== undefined ? clone(props.suffix) : undefined;
  const selected = props.selected;
  let node = <TextField {...props} multiline={false}/>;
  node = fieldOption(node, 'type', kind === undefined ? undefined : `${kind}`);
  node = fieldFlag(node, 'cleanable', cleanable);
  node = fieldFlag(node, 'maskToggle', maskToggle);
  node = fieldFlag(node, 'focusBordered', focusBordered);
  node = fieldOption(node, 'prefix', prefix);
  node = fieldOption(node, 'suffix', suffix);
  return fieldFlag(node, 'selected', selected);
}
/** Creates a multiline field. CRLF/CR values normalize to LF; no numeric conversion occurs. */
