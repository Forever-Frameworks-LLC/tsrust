/** Opens a GPU-rendered native window on the main thread and waits for closure. Checked options apply during creation. Returns Ok after cleanup or Err for invalid options, renderer or handler errors. Consumes the tree; title is borrowed. */
export function run(node: Node, title: string, options?: WindowOptions): Result<void, UiError> {
  return nativeRun(node, title, JSON.stringify(options ?? {}));
}

/** Component-owned scalar state. Returning its UI subtree transfers this owner automatically. */
export type Signal<T = int> = NativeSignal<T>;

export function signal<T>(initial: T): Signal<T> {
  return nativeSignal(initial);
}





function retainComponentState<T, N>(node: N, state: T): N {
  return unwrap(nativeOwnState(node, state));
}

/** Surface theme colors are required; syntax colors are optional. Colors are checked #RRGGBB/#RRGGBBAA sRGB, in-gamut oklch() or @token aliases in the same mode; background must be opaque. */
export interface ThemeColors {
  background: string;
  foreground: string;
  card: string;
  cardForeground: string;
  primary: string;
  primaryForeground: string;
  secondary: string;
  secondaryForeground: string;
  muted: string;
  mutedForeground: string;
  accent: string;
  accentForeground: string;
  destructive: string;
  destructiveForeground: string;
  border: string;
  input: string;
  ring: string;
  /** Optional code keyword color; omitted uses the mode's built-in syntax color. */
  syntaxKeyword?: string;
  /** Optional quoted string color; supports the same checked color syntax and aliases. */
  syntaxString?: string;
  /** Optional numeric literal color. Omission keeps the built-in mode color. */
  syntaxNumber?: string;
  /** Optional type/component name color. Omission keeps the built-in mode color. */
  syntaxType?: string;
}

export interface ThemeScale {
  sm: int | number;
  md: int | number;
  lg: int | number;
}

/** Corner radius scale. xl defaults to lg for existing themes. */
export interface ThemeRadius extends ThemeScale {
  /** Extra-large corner radius in finite logical pixels, 0–256; omitted uses lg. */
  xl?: int | number;
}

export interface ThemeTypography {
  /** Heading generic family, default sans. Named font files are not supported. */
  headingFamily?: 'sans' | 'serif' | 'mono';
  base: int | number;
  xl: int | number;
}

export interface ThemeConfig {
  schemaVersion: int;
  light: ThemeColors;
  dark: ThemeColors;
  spacing: ThemeScale;
  radius: ThemeRadius;
  typography: ThemeTypography;
}
/** Applies checked project tokens to this subtree. Mode defaults to light. A string Signal switches palettes after handlers without remounting children. */
export function withTheme<T>(node: Node, value: ReadOnly<T>, mode?: string | Signal<string>): Node {
  const config = JSON.stringify(value);
  if (mode === undefined) {
    return unwrap(nativeTheme(node, config, 'light'));
  }

  if (typeof mode === 'string') {
    return unwrap(nativeTheme(node, config, mode));
  }

  return unwrap(nativeThemeMode(node, config, mode));
}

/** A reusable scalar expression for a component prop. JSX creates this binding automatically for state-reading expressions. */
export interface Reactive<T> {
  /** Zero-argument checked getter. Owns its callback and does not retain component state owners. */
  evaluate: Owned<Function<T>>;
}
/** A constant or live scalar component prop. Reactivity requires a declared ReactiveValue prop and useProp() in the component that reads it. */
export type ReactiveValue<T> = Reactive<T> | T;
/** A component-owned read-only expression. get() evaluates its latest scalar value; there is no setter. */
export type Computed<T> = NativeComputed<T>;
/** Owns a reusable zero-argument scalar getter. get() evaluates on each read without memoization. Returning the component tree retains this value automatically. */
export function computed<T>(source: Owned<Function<T>>): Computed<T> {
  return nativeComputed(source);
}

/** Adapts a constant or live component prop into a read-only value. The returned tree retains its owner automatically. */
export function useProp<T>(source: ReactiveValue<T>): Computed<T> {
  return nativeComputed(source);
}
/** A boolean condition refreshed after UI handlers without rerunning the component. */
export interface ReactiveBoolean {
  /** Zero-argument boolean predicate; owns its callback with non-retaining state captures. */
  evaluate: Owned<Function<boolean>>;
}
/** A checked text-control value expression. The tagged scalar union preserves int, number and string without conversion. */
export interface ReactiveInputValue {
  /** Zero-argument scalar getter. Errors propagate; expressions must not mutate state. Captured component state remains non-retaining. */
  evaluate: Owned<Function<string | int | number>>;
}

function bindBranch(predicate: Owned<Function<boolean>>, present: Owned<Function<Child>>, absent: Owned<Function<Child>>): Node {
  return unwrapNode(nativeBranch(predicate, present, absent));
}

function bindText(evaluate: Owned<Function<string | int | number | boolean | null | undefined>>): TextBinding {
  return nativeBindText(evaluate);
}

function bindValue(evaluate: Owned<Function<string | int | number>>): ReactiveInputValue {
  return {
    evaluate
  };
}

function bindCondition(evaluate: Owned<Function<boolean>>): ReactiveBoolean {
  return {
    evaluate
  };
}

interface SemanticConfig {
  tag: string;
  role: string;
  label: string;
  id: string;
  hidden: boolean;
  slot: string;
  size: string;
  variant: string;
  orientation: string;
  describedBy: string;
  invalid: string;
  expanded: string;
  controls: string;
  htmlFor: string;
  windowDragRegion: boolean;
  tabIndex?: int;
  state: string;
  colSpan?: int;
  scope: string;
}

function semanticString(value: Mutable<ReactiveValue<string | undefined> | undefined>): string {
  if (value === undefined) {
    return '';
  }

  if (typeof value === 'string') {
    return clone(value);
  }

  return value.evaluate() ?? '';
}

function semanticBoolean(value: Mutable<ReactiveValue<boolean | undefined> | undefined>): boolean | undefined {
  if (value === undefined || typeof value === 'boolean') {
    return value;
  }

  return value.evaluate();
}

function semanticSnapshot(config: ReadOnly<SemanticConfig>, label: Mutable<ReactiveValue<string | undefined> | undefined>, hidden: Mutable<ReactiveValue<boolean | undefined> | undefined>, describedBy: Mutable<ReactiveValue<string | undefined> | undefined>, invalid: Mutable<ReactiveValue<boolean | undefined> | undefined>, expanded: Mutable<ReactiveValue<boolean | undefined> | undefined>, controls: Mutable<ReactiveValue<string | undefined> | undefined>, state: Mutable<ReactiveValue<string | undefined> | undefined>): string {
  const next = clone(config);
  next.label = semanticString(label);
  const hiddenValue = semanticBoolean(hidden);
  next.hidden = hiddenValue ?? (config.tag === 'svg' && next.label === '');
  next.describedBy = semanticString(describedBy);
  const invalidValue = semanticBoolean(invalid);
  next.invalid = invalidValue === undefined ? '' : String(invalidValue);
  const expandedValue = semanticBoolean(expanded);
  next.expanded = expandedValue === undefined ? '' : String(expandedValue);
  next.controls = semanticString(controls);
  next.state = semanticString(state);
  if (config.tag === 'svg' && config.role === '') {
    next.role = next.label === '' ? 'presentation' : 'img';
  }

  return JSON.stringify(next);
}

function semanticConfig(tag: string, role: string, label: ReactiveValue<string | undefined> | undefined, id: string, hidden: ReactiveValue<boolean | undefined> | undefined, slot: string, size: string, variant: string, orientation: string, describedBy: ReactiveValue<string | undefined> | undefined = '', invalid: ReactiveValue<boolean | undefined> | undefined = undefined, htmlFor: string = '', windowDragRegion: boolean = false, tabIndex?: int, expanded?: ReactiveValue<boolean | undefined>, controls?: ReactiveValue<string | undefined>, state?: ReactiveValue<string | undefined>, colSpan?: int, scope: string = ''): ReactiveValue<string> {
  const config: SemanticConfig = {
    tag, role, label: '', id, hidden: false, slot, size, variant, orientation, describedBy: '', invalid: '', expanded: '', controls: '', htmlFor, windowDragRegion, tabIndex, state: '', colSpan, scope
  };
  if ((label === undefined || typeof label === 'string') && (hidden === undefined || typeof hidden === 'boolean') && (describedBy === undefined || typeof describedBy === 'string') && (invalid === undefined || typeof invalid === 'boolean') && (expanded === undefined || typeof expanded === 'boolean') && (controls === undefined || typeof controls === 'string') && (state === undefined || typeof state === 'string')) {
    if (config.tag === '' && config.role === '' && (label === undefined || label === '') && config.id === '' && (hidden === undefined || !hidden) && config.slot === '' && config.size === '' && config.variant === '' && config.orientation === '' && (describedBy === undefined || describedBy === '') && invalid === undefined && expanded === undefined && (controls === undefined || controls === '') && config.htmlFor === '' && !config.windowDragRegion && config.tabIndex === undefined && (state === undefined || state === '') && colSpan === undefined && config.scope === '') {
      return '';
    }

    config.label = typeof label === 'string' ? clone(label) : '';
    config.hidden = typeof hidden === 'boolean' ? hidden : (config.tag === 'svg' && config.label === '');
    config.describedBy = typeof describedBy === 'string' ? clone(describedBy) : '';
    config.invalid = typeof invalid === 'boolean' ? String(invalid) : '';
    config.expanded = typeof expanded === 'boolean' ? String(expanded) : '';
    config.controls = typeof controls === 'string' ? clone(controls) : '';
    config.state = typeof state === 'string' ? clone(state) : '';
    if (config.tag === 'svg' && config.role === '') {
      config.role = config.label === '' ? 'presentation' : 'img';
    }

    return JSON.stringify(config);
  }

  return {
    evaluate: () => semanticSnapshot(config, label, hidden, describedBy, invalid, expanded, controls, state)
  };
}

function applySemantics(node: Node, metadata: ReactiveValue<string>): Node {
  if (typeof metadata === 'string') {
    return unwrapNode(nativeSemantics(node, metadata));
  }

  return unwrapNode(nativeBindSemantics(node, metadata.evaluate));
}

function unwrapNode(result: Result<Node, UiError>): Node {
  match (result) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}

function applyProperties(node: Node, metadata: ReactiveValue<string>, classes: ReactiveValue<string> | undefined, variant: ReactiveValue<string> | undefined): Node {
  const decorated = applySemantics(node, metadata);
  const styled = classes !== undefined && typeof classes !== 'string' ? unwrapNode(nativeBindClass(decorated, classes.evaluate)) : decorated;
  return variant !== undefined && typeof variant !== 'string' ? unwrapNode(nativeBindVariant(styled, variant.evaluate)) : styled;
}

/** Notification options. */
export interface NotifyOptions {
  /** Bold heading above the message. */
  title?: string;
  /** Color and icon. Defaults to info. */
  variant?: 'info' | 'success' | 'warning' | 'error';
  /** Where it appears: app (an in-window toast, the default), system (the OS notification center) or both. System delivery needs a bundled app and may be disabled by the user. */
  delivery?: 'app' | 'system' | 'both';
}

/** Shows a toast notification in the active window. It hides itself after a few seconds. Example: notify('Saved', { variant: 'success' }). */
export function notify(message: string, options?: NotifyOptions): void {
  let title = '';
  let variant = 'info';
  let delivery = 'app';
  if (options !== undefined) {
    const choice = clone(options);
    const heading = choice.title;
    if (heading !== undefined) {
      title = heading;
    }

    const target = choice.delivery;
    if (target !== undefined) {
      delivery = `${target}`;
    }

    const chosen = options.variant;
    if (chosen !== undefined) {
      variant = `${chosen}`;
    }
  }

  unwrap(nativeCommand('notify', JSON.stringify({
    message: message, title: title, variant: variant, delivery: delivery
  })));
}

/** Sets the active window's title. */
export function setWindowTitle(title: string): void {
  unwrap(nativeCommand('set-title', JSON.stringify({
    title: title
  })));
}

/** Minimizes the active window. */
export function minimizeWindow(): void {
  unwrap(nativeCommand('minimize', '{}'));
}

/** Toggles the active window between its normal and zoomed (maximized) size. */
export function zoomWindow(): void {
  unwrap(nativeCommand('zoom', '{}'));
}

/** Toggles full-screen mode for the active window. */
export function toggleFullscreen(): void {
  unwrap(nativeCommand('fullscreen', '{}'));
}

/** Closes the active window. The application quits when its last window closes. */
export function closeWindow(): void {
  unwrap(nativeCommand('close', '{}'));
}

/** Quits the application; run returns Ok afterwards. */
export function quit(): void {
  unwrap(nativeCommand('quit', '{}'));
}

/** Opens a URL with the system's default handler, such as a browser for https links. */
export function openUrl(url: string): void {
  unwrap(nativeCommand('open-url', JSON.stringify({
    url: url
  })));
}

/** Copies text to the system clipboard. */
export function writeClipboard(text: string): void {
  unwrap(nativeCommand('write-clipboard', JSON.stringify({
    text: text
  })));
}

/** Reads text from the system clipboard and passes it to onRead; empty when the clipboard has no text. */
export function readClipboard(onRead: Owned<Function<void, [text: ReadOnly<string>]>>): void {
  unwrap(nativeCommandReply('read-clipboard', '{}', onRead));
}

/** File picker options. */
export interface PickFilesOptions {
  /** Allows choosing several files. Defaults to false. */
  multiple?: boolean;
  /** Chooses folders instead of files. Defaults to false. */
  directories?: boolean;
}

/** Shows the system open dialog. onPicked receives the chosen paths, one per line, or an empty string when cancelled. */
export function pickFiles(onPicked: Owned<Function<void, [paths: ReadOnly<string>]>>, options?: PickFilesOptions): void {
  const multiple = options?.multiple ?? false;
  const directories = options?.directories ?? false;
  unwrap(nativeCommandReply('pick-files', JSON.stringify({
    multiple: multiple, directories: directories
  }), onPicked));
}

/** Shows the system save dialog with a suggested file name. onChosen receives the chosen path, or an empty string when cancelled. */
export function saveFile(suggestedName: string, onChosen: Owned<Function<void, [path: ReadOnly<string>]>>): void {
  unwrap(nativeCommandReply('save-file', JSON.stringify({
    name: suggestedName
  }), onChosen));
}

/** Opens another window showing node. Call it from a handler or before run; windows share component state passed into them. */
export function openWindow(node: Node, title: string, options?: WindowOptions): void {
  unwrap(nativeOpenWindow(node, title, JSON.stringify(options ?? {})));
}

/** The system light or dark appearance, as seen by the most recent frame. */
export function systemAppearance(): 'light' | 'dark' {
  return nativeAppearance() === 'dark' ? 'dark' : 'light';
}

/** The packaged application's identity, from the app.json that tsrust package writes. Every field is empty when the program runs unpackaged, such as under tsrust run. */
export interface AppInfo {
  /** Display name, such as Notes. */
  name: string;
  /** Reverse-DNS identifier, such as com.example.notes. */
  id: string;
  /** Installed version, MAJOR.MINOR.PATCH. */
  version: string;
  /** GitHub repository (owner/name) whose releases provide updates. */
  repo: string;
}

/** The packaged application's name, identifier, version and update repository. Example: appInfo().version is '1.2.0'. */
export function appInfo(): AppInfo {
  return JSON.parse<AppInfo>(nativeAppInfo());
}

/** The result of checkForUpdates. */
export interface UpdateCheck {
  /** The installed version. */
  current: string;
  /** The latest release's version, or empty when the check failed. */
  latest: string;
  /** True when the latest release is newer and ships an archive for this platform. */
  available: boolean;
  /** The release notes (Markdown). */
  notes: string;
  /** Why the check failed, such as no network or no --repo; empty on success. */
  error: string;
}

/** Asks GitHub for the repository's latest release without blocking the window, then calls onChecked. Example: checkForUpdates((update) => { if (update.available) { notify(`Version ${update.latest} is ready`); } }). */
export function checkForUpdates(onChecked: Owned<Function<void, [update: ReadOnly<UpdateCheck>]>>): void {
  unwrap(nativeCommandReply('check-update', '{}', (text: ReadOnly<string>): void => {
    onChecked(JSON.parse<UpdateCheck>(text));
  }));
}

/** Downloads the latest release for this platform, verifies it against the release's SHA256SUMS (and its code signature on macOS), and replaces the installed app. onInstalled receives an empty string on success, else the error. The running app is unchanged until relaunch(). */
export function installUpdate(onInstalled: Owned<Function<void, [error: ReadOnly<string>]>>): void {
  unwrap(nativeCommandReply('install-update', '{}', onInstalled));
}

/** Starts the installed application again and quits this one, such as after installUpdate. */
export function relaunch(): void {
  unwrap(nativeCommand('relaunch', '{}'));
}

/** Registers one locale's messages: a JSON-compatible object such as an imported locales/fr.json. Nested objects make dotted keys (menu.save). Registering a locale again replaces it. */
export function setTranslations<T>(locale: string, messages: T): void {
  unwrap(nativeSetTranslations(locale, JSON.stringify(messages)));
}

/** Switches the current locale, such as 'fr' or 'pt-BR'. Text from t() and GPUI Kit's own component strings update on the next frame. */
export function setLocale(locale: string): void {
  nativeSetLocale(locale);
}

/** The current locale tag. It starts as the system locale, or en when that cannot be read. */
export function locale(): string {
  return nativeLocale();
}

/** Live translated text for a JSX child or a component string prop; it follows setLocale. Missing keys fall back to the language, then en, then the key itself. Use tWith for placeholders. */
export function t(key: string): TextBinding {
  return nativeTranslation(key, '{}');
}

/** Live translated text with fixed values: {name} placeholders are filled from values, and a numeric count selects key_zero, key_one or key_other. It follows setLocale; values are read once, so for values that read state write translateWith inside JSX instead. Example: tWith('greeting', { name: 'Ada' }). */
export function tWith<T>(key: string, values: T): TextBinding {
  return nativeTranslation(key, JSON.stringify(values));
}

/** The translated text right now, as a plain string, for code outside JSX such as notify(translate('saved')). */
export function translate(key: string): string {
  return nativeTranslate(key, '{}');
}

/** The translated text right now with values filled in, as a plain string. Inside JSX, an expression such as {translateWith('items', { count: count.get() })} refreshes with both the state it reads and the locale. */
export function translateWith<T>(key: string, values: T): string {
  return nativeTranslate(key, JSON.stringify(values));
}

/** Registers a GPUI Kit theme set: a JSON-compatible object such as an imported themes/gruvbox.json, in GPUI Kit's theme format (a name and a themes array of named light or dark color sets). Use one with useTheme. An invalid set shows an error notification. */
export function registerThemes<T>(themes: T): void {
  const json: string = JSON.stringify(themes);
  unwrap(nativeCommand('register-themes', JSON.stringify({
    json: json
  })));
}

/** Applies a registered GPUI Kit theme by name, such as 'Gruvbox Dark Medium', to every window. Utility colors such as text-muted-foreground follow it. An unknown name shows an error notification. */
export function useTheme(name: string): void {
  unwrap(nativeCommand('use-theme', JSON.stringify({
    name: name
  })));
}

/** Switches GPUI Kit's light or dark theme for every window, or follows the system appearance with 'system'. */
export function setTheme(mode: 'light' | 'dark' | 'system'): void {
  unwrap(nativeCommand('theme', JSON.stringify({
    mode: `${mode}`
  })));
}
