  props.render = undefined;
  if (Render !== undefined) {
    return <Render {...props}/>;
  }

  const className = props.className;
  const variant = props['data-variant'];
  const classes = typeof className === 'string' ? clone(className) : '';
  const metadata = semanticConfig('', '', props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', typeof variant === 'string' ? clone(variant) : '', '', props['aria-describedby'] ?? '', props['aria-invalid'], '', false, undefined, props['aria-expanded'], props['aria-controls']);
