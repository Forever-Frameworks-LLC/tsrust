/** A platform clipboard control. It reports completion only after the platform write settles. */
interface CopyButtonProperties<Classes, Variant> extends ElementProps<Variant> {
  /** Exact clipboard text; Unicode, CRLF and trailing whitespace are preserved. */
  value: string;
  /** Shared button utilities. Defaults to empty. */
  className?: Classes;
}

export type CopyButtonProps<Classes = string, Variant = string> = CopyButtonProperties<Classes, Variant>;
/** A copy icon button: activating it writes value to the system clipboard and briefly shows a check mark. Ownership: owns a text snapshot. */
export function CopyButton(props: CopyButtonProps<ReactiveValue<string>, ReactiveValue<string>>): Node {
