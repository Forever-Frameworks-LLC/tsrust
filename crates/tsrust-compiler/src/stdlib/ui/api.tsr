import { semantics as nativeSemantics, bindDisabled as nativeBindDisabled, theme as nativeTheme, Signal as NativeSignal, signal as nativeSignal, handle as nativeHandle, ownState as nativeOwnState, button as nativeButton, Node as NativeNode, UiError as NativeUiError, text, view, staticButton, document as nativeDocument, run as nativeRun } from 'std:ui-runtime';

/** An owned UI subtree. Moving a Node transfers all descendants. Nodes cannot be cloned or sent to workers. */
export type Node = NativeNode;
/** A renderer or node-construction failure with a readable message. */
export type UiError = NativeUiError;

export type TextChild = string | Signal;
/** Ordered text, direct Signal bindings or owned subtrees. Adjacent text shares one run; empty literals are omitted. Computed strings/trees are construction-time snapshots. Ownership: transfers Nodes/strings once; state bindings are non-retaining. */
export type Child = TextChild | Node;

/** Shared element identity and accessible naming. Attributes are escaped in HTML and applied to the same native subtree. */
export interface ElementProps {
  /** A document ID without ASCII whitespace/control characters. Defaults to no ID. */
  id?: string;
  /** Accessible name for buttons, headings, named sections or supported named roles. Generic text/containers, paragraphs, code and presentation cannot be named. */
  'aria-label'?: string;
  /** Excludes a noninteractive subtree from accessibility. Enabled controls inside it are rejected. Defaults to false. */
  'aria-hidden'?: boolean;
  /** Local component slot for styling and inspection. ASCII letters, digits and hyphens; defaults to none. */
  'data-slot'?: string;
}

/** Noninteractive semantic roles shared by View and Text. Unsupported roles fail rather than losing accessibility behavior. */
export interface SemanticProps extends ElementProps {
  /** Defaults to the element's implicit role. A region requires aria-label; separators require empty content. */
  role?: 'alert' | 'status' | 'separator' | 'group' | 'note' | 'region' | 'none' | 'presentation';
  /** Only valid for role=separator; defaults to horizontal. */
  'aria-orientation'?: 'horizontal' | 'vertical';
}

export interface TextProps extends SemanticProps {
  /** Defaults to span. Heading levels are reflected in native accessibility. */
  as?: 'span' | 'div' | 'p' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'code' | 'kbd';
  children?: TextChild[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Later classes win per property/state. */
  className?: string;
}

export interface ViewProps extends SemanticProps {
  /** Semantic container tag; defaults to div. */
  as?: 'div' | 'section' | 'span';
  children?: Child[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Later classes win per property/state. */
  className?: string;
}

export interface ButtonProps extends ElementProps {
  children?: Child[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Later classes win per property/state. */
  className?: string;
  disabled?: boolean | ReactiveBoolean;
  onPress?: Owned<Function<void>>;
}

/** Creates a text node by joining text children without a separator. className defaults to empty. Unknown utilities throw a message. Owns its text. */
export function Text(props: TextProps): Node {
  const metadata = semanticConfig(String(props.as ?? ''), String(props.role ?? ''), props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', String(props['aria-orientation'] ?? ''));
  const result = text(props.children ?? [], props.className ?? '');
  match (result) {
    Ok(value) => {
      return applySemantics(value, metadata);
    },
    Err(error) => {
      throw error.message;
    }
  }
}
/** Creates a container, preserving child order. className defaults to empty. Unknown utilities or depth over 128 throw a message. Consumes its children. */
export function View(props: ViewProps): Node {
  const metadata = semanticConfig(String(props.as ?? ''), String(props.role ?? ''), props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', String(props['aria-orientation'] ?? ''));
  const result = view(props.children ?? [], props.className ?? '');
  match (result) {
    Ok(value) => {
      return applySemantics(value, metadata);
    },
    Err(error) => {
      throw error.message;
    }
  }
}
/** Creates a semantic button with optional retained onPress and composed phrasing children. Disabled buttons never activate. */
export function Button(props: ButtonProps): Node {
  const metadata = semanticConfig('', '', props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', '');
  const children = props.children ?? [];
  const handler = props.onPress;
  const disabled = props.disabled;
  if (disabled !== undefined && typeof disabled !== 'boolean') {
    if (handler === undefined) {
      return applySemantics(unwrapNode(nativeBindDisabled(unwrapNode(staticButton(children, props.className ?? '', false)), disabled.evaluate)), metadata);
    }

    return applySemantics(unwrapNode(nativeBindDisabled(unwrapNode(nativeButton(children, props.className ?? '', false, handler)), disabled.evaluate)), metadata);
  }

  if (handler !== undefined) {
    return applySemantics(unwrapNode(nativeButton(children, props.className ?? '', disabled ?? false, handler)), metadata);
  }

  return applySemantics(unwrapNode(staticButton(children, props.className ?? '', disabled ?? false)), metadata);
}

/** Produces a complete escaped HTML document with shared utility styles. Borrows the tree and title; returns an owned string. Does not execute callbacks or mutate nodes. */
export function document(node: ReadOnly<Node>, title: string): string {
  return nativeDocument(node, title);
}
/** Opens a GPU-rendered native window on the main thread and waits for closure. Returns Ok after cleanup or Err with a renderer error. Consumes the tree; title is borrowed. */
export function run(node: Node, title: string): Result<void, UiError> {
  return nativeRun(node, title);
}

/** Component-owned integer state. Returning its UI subtree transfers this owner automatically. */
export type Signal = NativeSignal;

export function signal(initial: int): Signal {
  return nativeSignal(initial);
}

function bindState(state: ReadOnly<Signal>): Signal {
  return nativeHandle(state);
}



function retainComponentState(node: Node, state: Signal): Node {
  return unwrap(nativeOwnState(node, state));
}

/** Required theme tokens. Colors are opaque #RRGGBB sRGB or @token aliases in the same mode. */
export interface ThemeColors {
  background: string;
  foreground: string;
  card: string;
  cardForeground: string;
  primary: string;
  primaryForeground: string;
  secondary: string;
  secondaryForeground: string;
  muted: string;
  mutedForeground: string;
  accent: string;
  accentForeground: string;
  destructive: string;
  destructiveForeground: string;
  border: string;
  input: string;
  ring: string;
}

export interface ThemeScale {
  sm: int | number;
  md: int | number;
  lg: int | number;
}

export interface ThemeTypography {
  base: int | number;
  xl: int | number;
}

export interface ThemeConfig {
  schemaVersion: int;
  light: ThemeColors;
  dark: ThemeColors;
  spacing: ThemeScale;
  radius: ThemeScale;
  typography: ThemeTypography;
}
/** Applies checked project tokens to this subtree. Mode defaults to light. Does not change component state. */
export function withTheme<T>(node: Node, value: ReadOnly<T>, mode?: string): Node {
  return unwrap(nativeTheme(node, JSON.stringify(value), mode ?? 'light'));
}

/** A boolean condition that refreshes after UI handlers without rerunning the component. Ownership: the returned subtree owns the condition. */
export interface ReactiveBoolean {
  /** Evaluates the captured condition with no arguments. Returns boolean; state-read errors propagate. The mounted tree calls it after handlers. It must not mutate state. Owns its callback environment; captures do not retain state owners. */
  evaluate: Owned<Function<boolean>>;
}

function bindCondition(evaluate: Owned<Function<boolean>>): ReactiveBoolean {
  return {
    evaluate
  };
}

interface SemanticConfig {
  tag: string;
  role: string;
  label: string;
  id: string;
  hidden: boolean;
  slot: string;
  orientation: string;
}

function semanticConfig(tag: string, role: string, label: string, id: string, hidden: boolean, slot: string, orientation: string): string {
  if (tag === '' && role === '' && label === '' && id === '' && !hidden && slot === '' && orientation === '') {
    return '';
  }

  const config: SemanticConfig = {
    tag, role, label, id, hidden, slot, orientation
  };
  return JSON.stringify(config);
}

function applySemantics(node: Node, metadata: string): Node {
  return unwrapNode(nativeSemantics(node, metadata));
}

function unwrapNode(result: Result<Node, UiError>): Node {
  match (result) {
    Ok(value) => {
      return value;
    },
    Err(error) => {
      throw error.message;
    }
  }
}
