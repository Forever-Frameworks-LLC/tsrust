import { copyButton as nativeCopyButton, location as nativeLocation, navigate as nativeNavigate, traverse as nativeTraverse, link as nativeLink, themeMode as nativeThemeMode, bindHidden as nativeBindHidden, branch as nativeBranch, TextBinding as NativeTextBinding, bindText as nativeBindText, input as nativeInput, inputChange as nativeInputChange, bindReadOnly as nativeBindReadOnly, semantics as nativeSemantics, bindDisabled as nativeBindDisabled, theme as nativeTheme, Signal as NativeSignal, signal as nativeSignal, handle as nativeHandle, ownState as nativeOwnState, button as nativeButton, Node as NativeNode, UiError as NativeUiError, text, view, staticButton, document as nativeDocument, run as nativeRun } from 'std:ui-runtime';

/** An owned UI subtree. Moving a Node transfers all descendants. Nodes cannot be cloned or sent to workers. */
export type Node = NativeNode;
/** A renderer or node-construction failure with a readable message. */
export type UiError = NativeUiError;

/** An owned live scalar text expression produced automatically by JSX. It has no public constructor or receiver methods. */
export type TextBinding = NativeTextBinding;
/** Ordered strings/numeric snapshots and live bindings; null and undefined produce no text. */
export type TextChild = string | int | number | TextBinding | Signal<int> | Signal<number> | Signal<boolean> | Signal<string> | null | undefined;
/** Ordered text, direct Signal bindings or owned subtrees. Adjacent text shares one run; null, undefined and empty literals are omitted. Supported JSX scalar expressions reading local component state refresh; local-state JSX ternaries lazily mount selected subtrees. Other computed values remain construction-time snapshots. Ownership: transfers Nodes/strings once; state bindings are non-retaining. */
export type Child = TextChild | Node;

/** Shared element identity and accessible naming. Attributes are escaped in HTML and applied to the same native subtree. */
export interface ElementProps {
  /** A document ID without ASCII whitespace/control characters. Defaults to no ID. */
  id?: string;
  /** Accessible name for buttons, headings, named sections or supported named roles. Generic text/containers, paragraphs, code and presentation cannot be named. */
  'aria-label'?: string;
  /** Excludes a noninteractive subtree from accessibility. Enabled controls inside it are rejected. Defaults to false. */
  'aria-hidden'?: boolean;
  /** Space-separated IDs of descriptive content. Missing IDs are ignored; text is exposed as a description. */
  'aria-describedby'?: string;
  /** Marks validation state for assistive technology and styling; does not run validation. Omission leaves it unspecified. */
  'aria-invalid'?: boolean;
  /** Local component slot for styling and inspection. ASCII letters, digits and hyphens; defaults to none. */
  'data-slot'?: string;
  /** Component size metadata for checked data/group selectors. ASCII letters, digits and hyphens; empty means absent. */
  'data-size'?: string;
}

/** Noninteractive semantic roles shared by View and Text. Unsupported roles fail rather than losing accessibility behavior. */
export interface SemanticProps extends ElementProps {
  /** Defaults to the element's implicit role. A region requires aria-label; separators require empty content. */
  role?: 'alert' | 'status' | 'separator' | 'group' | 'note' | 'region' | 'none' | 'presentation';
  /** Only valid for role=separator; defaults to horizontal. */
  'aria-orientation'?: 'horizontal' | 'vertical';
}

export interface TextProps extends SemanticProps {
  /** Defaults to span. Heading levels are reflected in native accessibility. */
  as?: 'span' | 'div' | 'p' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'code' | 'kbd' | 'strong' | 'em' | 'del';
  /** Ordered text content. Pass between tags or with children={values}; combining both is rejected. */
  children?: Child[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Later classes win per property/state. */
  className?: string;
}

export interface ViewProps extends SemanticProps {
  /** 0 participates in source-order keyboard focus; -1 allows pointer/accessibility focus only. Omission is not focusable. Positive values are rejected. Name scroll regions with role=region and aria-label. */
  tabIndex?: int;
  /** Removes this subtree from layout, paint, interaction and accessibility while retaining its state. JSX state conditions refresh after handlers. Defaults to false. */
  hidden?: boolean | ReactiveBoolean;
  /** Marks a native custom-header drag surface. Interactive descendants, including disabled controls and labels, exclude dragging. Browser hosts keep control of their own window. */
  windowDragRegion?: boolean;
  /** Semantic container tag; defaults to div. Landmarks, lists, blockquotes and table parts preserve their native accessibility roles. Layout remains explicit through className. kbd and code accept composed phrasing children. */
  as?: 'div' | 'section' | 'span' | 'label' | 'kbd' | 'code' | 'nav' | 'main' | 'header' | 'footer' | 'aside' | 'article' | 'blockquote' | 'ul' | 'ol' | 'li' | 'table' | 'thead' | 'tbody' | 'tr' | 'th' | 'td';
  /** For as=label, the single ID of its associated control. Omission labels the first enclosed control. */
  htmlFor?: string;
  /** Owned ordered content. Pass between tags or with children={values}; combining both is rejected. Forwarding transfers the array once. */
  children?: Child[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Later classes win per property/state. */
  className?: string;
}

export interface ButtonProps extends ElementProps {
  /** Owned ordered content. Pass between tags or with children={values}; combining both is rejected. Forwarding transfers the array once. */
  children?: Child[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Later classes win per property/state. */
  className?: string;
  disabled?: boolean | ReactiveBoolean;
  onPress?: Owned<Function<void>>;
}

/** Text-field values preserve exact ints and ordinary number formatting. Signal and derived bindings retain no state owner. */
export type InputValue = string | int | number | Signal<string> | Signal<int> | Signal<number> | ReactiveInputValue;

/** A read-only snapshot supplied during a text-field change. It retains no element or state. */
export interface InputTarget {
  /** Current normalized field text, including Unicode. It does not parse numeric input. */
  value: string;
  /** The field's name, or an empty string when omitted. */
  name: string;
  /** The field's explicit id, or an empty string when omitted. */
  id: string;
}

export interface InputChangeEvent {
  /** Snapshot of the field that changed. */
  target: InputTarget;
  /** Snapshot of the field whose handler is running; matches target for a directly registered handler. */
  currentTarget: InputTarget;
}

export interface TextFieldProps extends ElementProps {
  /** Controlled text/numeric value. Direct signals and state-reading JSX expressions refresh after handlers. Omission selects uncontrolled state. */
  value?: InputValue;
  /** Initial uncontrolled value only; an explicit value takes precedence, including the empty string and zero. */
  defaultValue?: string | int | number;
  /** Hint shown when empty. A visible Label or aria-label should provide the accessible name. */
  placeholder?: string;
  /** Disabled fields cannot edit or receive focus. State-reading JSX conditions refresh after handlers. */
  disabled?: boolean | ReactiveBoolean;
  /** Read-only fields retain selection/focus but cannot change text. State-reading JSX conditions refresh after handlers. */
  readOnly?: boolean | ReactiveBoolean;
  required?: boolean;
  name?: string;
  autoComplete?: string;
  className?: string;
  /** Receives a borrowed value snapshot; edit logic stays in application code. String state.set copies the new text. */
  onChange?: Owned<Function<void, [event: ReadOnly<InputChangeEvent>]>>;
}

export interface InputProps extends TextFieldProps {
  /** This portable slice supports text. Password, file and other specialized input types fail explicitly. */
  type?: 'text';
}

export interface TextareaProps extends TextFieldProps {}

/** Creates a single-line field. CR/LF are removed like HTML text inputs; values otherwise remain exact Unicode strings. */
export function Input(props: InputProps): Node {
  return <TextField {...props} multiline={false}/>;
}
/** Creates a multiline field. CRLF/CR values normalize to LF; no numeric conversion occurs. */
export function Textarea(props: TextareaProps): Node {
  return <TextField {...props} multiline={true}/>;
}

interface InputOptions {
  placeholder: string;
  disabled: boolean;
  readOnly: boolean;
  multiline: boolean;
  required: boolean;
  name: string;
  autoComplete: string;
  type: string;
}

function inputReadOnly(node: Node, value: boolean | ReactiveBoolean | undefined): Node {
  if (value !== undefined && typeof value !== 'boolean') {
    return unwrapNode(nativeBindReadOnly(node, value.evaluate));
  }

  return node;
}

function inputFlags(node: Node, disabled: boolean | ReactiveBoolean | undefined, readOnly: boolean | ReactiveBoolean | undefined): Node {
  if (disabled !== undefined && typeof disabled !== 'boolean') {
    return inputReadOnly(unwrapNode(nativeBindDisabled(node, disabled.evaluate)), readOnly);
  }

  return inputReadOnly(node, readOnly);
}

interface TextFieldOptions extends TextFieldProps {
  multiline: boolean;
}

function TextField(props: TextFieldOptions): Node {
  const name = props.name ?? '';
  const id = props.id ?? '';
  const disabled = props.disabled;
  const readOnly = props.readOnly;
  const metadata = semanticConfig('', '', props['aria-label'] ?? '', clone(id), props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', '', props['aria-describedby'] ?? '', props['aria-invalid'] === undefined ? '' : String(props['aria-invalid']));
  const options: InputOptions = {
    placeholder: props.placeholder ?? '', disabled: typeof disabled === 'boolean' ? disabled : false, readOnly: typeof readOnly === 'boolean' ? readOnly : false, multiline: props.multiline, required: props.required ?? false, name: clone(name), autoComplete: props.autoComplete ?? '', type: 'text'
  };
  const config = JSON.stringify(options);
  const handler = props.onChange;
  if (handler !== undefined) {
    return applySemantics(inputFlags(unwrapNode(nativeInputChange(props.value, props.defaultValue, config, props.className ?? '', handler)), disabled, readOnly), metadata);
  }

  return applySemantics(inputFlags(unwrapNode(nativeInput(props.value, props.defaultValue, config, props.className ?? '')), disabled, readOnly), metadata);
}

/** A platform clipboard control. It reports completion only after the platform write settles. */
export interface CopyButtonProps extends ElementProps {
  /** Exact clipboard text; Unicode, CRLF and trailing whitespace are preserved. */
  value: string;
  /** Shared button utilities. Defaults to empty. */
  className?: string;
}
/** Copies value on activation. Shows Copy, Copying…, Copied or Copy failed. Try again.; failures retain the application and expose the platform message as a description. Ownership: owns a text snapshot; browser completion never retains a removed subtree. */
export function CopyButton(props: CopyButtonProps): Node {
  const metadata = semanticConfig('', '', props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', '', props['aria-describedby'] ?? '', props['aria-invalid'] === undefined ? '' : String(props['aria-invalid']));
  return applySemantics(unwrapNode(nativeCopyButton(props.value, props.className ?? '')), metadata);
}

/** Creates a text node by joining text children without a separator. className defaults to empty. Unknown utilities throw a message. Owns its text. */
export function Text(props: TextProps): Node {
  const metadata = semanticConfig(String(props.as ?? ''), String(props.role ?? ''), props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', String(props['aria-orientation'] ?? ''), props['aria-describedby'] ?? '', props['aria-invalid'] === undefined ? '' : String(props['aria-invalid']));
  const result = text(props.children ?? [], props.className ?? '');
  match (result) {
    Ok(value) => {
      return applySemantics(value, metadata);
    },
    Err(error) => {
      throw error.message;
    }
  }
}
/** Creates a container, preserving child order. className defaults to empty. Unknown utilities or depth over 128 throw a message. Consumes its children. */
export function View(props: ViewProps): Node {
  const metadata = semanticConfig(String(props.as ?? ''), String(props.role ?? ''), props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', String(props['aria-orientation'] ?? ''), props['aria-describedby'] ?? '', props['aria-invalid'] === undefined ? '' : String(props['aria-invalid']), props.htmlFor ?? '', props.windowDragRegion ?? false, props.tabIndex);
  const result = view(props.children ?? [], props.className ?? '');
  match (result) {
    Ok(value) => {
      const node = applySemantics(value, metadata);
      const hidden = props.hidden;
      if (hidden === undefined) {
        return node;
      }

      if (typeof hidden !== 'boolean') {
        return unwrapNode(nativeBindHidden(node, hidden.evaluate));
      }

      const collapsed = hidden === true;
      return unwrapNode(nativeBindHidden(node, () => collapsed));
    },
    Err(error) => {
      throw error.message;
    }
  }
}
/** Creates a semantic button with optional retained onPress and composed phrasing children. Disabled buttons never activate. */
export function Button(props: ButtonProps): Node {
  const metadata = semanticConfig('', '', props['aria-label'] ?? '', props.id ?? '', props['aria-hidden'] ?? false, props['data-slot'] ?? '', props['data-size'] ?? '', '', props['aria-describedby'] ?? '', props['aria-invalid'] === undefined ? '' : String(props['aria-invalid']));
  const children = props.children ?? [];
  const handler = props.onPress;
  const disabled = props.disabled;
  if (disabled !== undefined && typeof disabled !== 'boolean') {
    if (handler === undefined) {
      return applySemantics(unwrapNode(nativeBindDisabled(unwrapNode(staticButton(children, props.className ?? '', false)), disabled.evaluate)), metadata);
    }

    return applySemantics(unwrapNode(nativeBindDisabled(unwrapNode(nativeButton(children, props.className ?? '', false, handler)), disabled.evaluate)), metadata);
  }

  if (handler !== undefined) {
    return applySemantics(unwrapNode(nativeButton(children, props.className ?? '', disabled ?? false, handler)), metadata);
  }

  return applySemantics(unwrapNode(staticButton(children, props.className ?? '', disabled ?? false)), metadata);
