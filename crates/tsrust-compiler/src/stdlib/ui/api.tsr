export type ViewProps<Classes = string, Variant = string> = ViewComponentProps<Classes, Variant>;

interface ButtonProperties<Classes, Variant> extends ElementProps<Variant> {
  /** Owned ordered content. Pass between tags or with children={values}; combining both is rejected. Forwarding transfers the array once. */
  children?: Child[];
  /** Checked shared utilities: grid/flex, sizing, spacing, colors and typography. Includes relative/absolute parent positioning and checked insets; inline descendants require typography only. Includes aspect-square/video/[W/H]/[R]/auto with finite positive f32 ratios. Explicit sizes and min/max bounds still apply. Later classes win per property/state. */
