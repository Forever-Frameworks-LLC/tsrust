    extra.push(['tooltipCommand', clone(props.tooltipCommand)]);
  }

  if (props.tooltipPlacement !== undefined) {
    extra.push(['tooltipPlacement', `${props.tooltipPlacement}`]);
  }

  if (props.tooltipDelay !== undefined) {
    extra.push(['tooltipDelay', `${props.tooltipDelay}`]);
  }

  if (props.rounded !== undefined) {
    extra.push(['rounded', `${props.rounded}`]);
  }

  if (props.loadingIcon !== undefined) {
    extra.push(['loadingIcon', `${props.loadingIcon}`]);
  }

  if (props.spinner === true) {
    extra.push(['spinner', 'true']);
  }

  if (props.role !== undefined) {
    extra.push(['role', `${props.role}`]);
  }

  if (props.tabIndex !== undefined) {
    extra.push(['tabIndex', `${props.tabIndex}`]);
  }

  if (props.tabStop === false) {
    extra.push(['tabStop', 'false']);
  }

  if (props.color !== undefined) {
    extra.push(['color', clone(props.color)]);
  }

  if (props.foreground !== undefined) {
    extra.push(['foreground', clone(props.foreground)]);
  }

  if (props.hoverColor !== undefined) {
    extra.push(['hoverColor', clone(props.hoverColor)]);
  }

  if (props.activeColor !== undefined) {
    extra.push(['activeColor', clone(props.activeColor)]);
  }

  const progress = props.progress;
  const toggled = props.toggled;
  const onHover = props.onHover;
  const loading = props.loading;
  const selected = props.selected;
