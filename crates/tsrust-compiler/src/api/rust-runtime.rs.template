#[derive(Clone, Debug, PartialEq)]
pub struct ApiError { pub code: String, pub message: String, pub operation: String, pub api_version: u32 }
impl std::fmt::Display for ApiError {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { write!(formatter, "{}: {}", self.code, self.message) }
}
impl std::error::Error for ApiError {}
impl ApiError {
    pub fn new(code: &str, message: &str) -> Self { Self { code:code.into(), message:message.into(), operation:String::new(), api_version:0 } }
    pub fn is_compatibility(&self) -> bool { matches!(self.code.as_str(), "api-incompatible" | "api-operation") }
}
pub struct Request<'a> {
    pub operation: &'a str, pub input: Value, pub api_version: u32,
    pub operation_contract: &'a str, pub contract_id: &'a str,
}
pub trait Transport { fn request(&self, request: Request<'_>) -> Result<Value, ApiError>; }
impl<F> Transport for F where F: Fn(Request<'_>) -> Result<Value, ApiError> {
    fn request(&self, request: Request<'_>) -> Result<Value, ApiError> { self(request) }
}
pub struct Client<T> { transport: T, manifest: Value, protocol: Value }
impl<T: Transport> Client<T> {
    pub fn new(transport: T) -> Self {
        Self { transport, manifest:serde_json::from_str(MANIFEST).expect("generated manifest"), protocol:serde_json::from_str(PROTOCOL).expect("generated protocol") }
    }
    fn call<I: Serialize, O: serde::de::DeserializeOwned>(&self, index: usize, input: &I) -> Result<O, ApiError> {
        let operation = &self.manifest["operations"][index];
        let name = operation["name"].as_str().expect("generated operation name");
        let api_version = self.protocol["apiVersion"].as_u64().expect("generated API version") as u32;
        let annotate = |mut error: ApiError| { error.operation = name.into(); error.api_version = api_version; error };
        let input = serde_json::to_value(input).map_err(|_| annotate(ApiError::new("api-validation", "Cannot encode API input")))?;
        let input = checked(&operation["input"], &input, 0).map_err(annotate)?;
        let mut contract = self.protocol["wireContractId"].as_str().expect("generated contract");
        for profile in self.protocol["profiles"][name].as_array().expect("generated profiles") {
            if checked(&profile["input"], &input, 0).is_ok() { contract = profile["contractId"].as_str().expect("generated profile"); break; }
        }
        let request = Request { operation:name, input, api_version,
            operation_contract:self.protocol["operations"][name].as_str().expect("generated operation identity"), contract_id:contract };
        let response = self.transport.request(request).map_err(annotate)?;
        if response["ok"] == false {
            if let (Some(code), Some(message)) = (response["error"]["code"].as_str(), response["error"]["message"].as_str()) {
                return Err(annotate(ApiError::new(code, message)));
            }
        }
        if response["ok"] != true || response.get("value").is_none() { return Err(annotate(ApiError::new("api-protocol", "Malformed API response envelope"))); }
        let output = checked(&operation["output"], &response["value"], 0).map_err(annotate)?;
        serde_json::from_value(output).map_err(|_| annotate(ApiError::new("api-protocol", "Response does not match the generated Rust type")))
    }
}
fn literal_equal(left: &Value, right: &Value) -> bool {
    left == right || left.is_number() && right.is_number() && left.as_f64() == right.as_f64()
}
// serde's ordinary Option maps present null to None. Preserve presence for
// optional nullable fields; a missing field alone takes the default None.
#[allow(dead_code)] // Only referenced by generated optional DTO fields.
fn present<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(deserializer: D) -> Result<Option<T>, D::Error> {
    T::deserialize(deserializer).map(Some)
}
fn checked(shape: &Value, value: &Value, depth: usize) -> Result<Value, ApiError> {
    let invalid = || ApiError::new("api-validation", "Value does not match the checked API contract");
    if depth > 128 { return Err(invalid()); }
    Ok(match shape["type"].as_str().unwrap_or("") {
        "string" if value.is_string() => value.clone(),
        "boolean" if value.is_boolean() => value.clone(),
        "null" | "void" if value.is_null() => Value::Null,
        "integer" => {
            let number = value.as_f64().filter(|number| number.is_finite() && number.fract() == 0.0 && number.abs() <= 9_007_199_254_740_991.0).ok_or_else(invalid)?;
            serde_json::json!(number as i64)
        }
        "number" => serde_json::json!(value.as_f64().filter(|number| number.is_finite()).ok_or_else(invalid)?),
        "literal" if literal_equal(value, &shape["value"]) => shape["value"].clone(),
        "array" => Value::Array(value.as_array().ok_or_else(invalid)?.iter().map(|item| checked(&shape["items"], item, depth + 1)).collect::<Result<_, _>>()?),
        "tuple" => {
            let items = value.as_array().ok_or_else(invalid)?;
            let shapes = shape["items"].as_array().ok_or_else(invalid)?;
            if items.len() != shapes.len() { return Err(invalid()); }
            Value::Array(shapes.iter().zip(items).map(|(shape, item)| checked(shape, item, depth + 1)).collect::<Result<_, _>>()?)
        }
        "object" => {
            let fields = value.as_object().ok_or_else(invalid)?;
            let properties = shape["properties"].as_object().ok_or_else(invalid)?;
            if fields.keys().any(|name| !properties.contains_key(name)) { return Err(invalid()); }
            for name in shape["required"].as_array().ok_or_else(invalid)? { if !fields.contains_key(name.as_str().ok_or_else(invalid)?) { return Err(invalid()); } }
            Value::Object(fields.iter().map(|(name, item)| checked(&properties[name], item, depth + 1).map(|value| (name.clone(), value))).collect::<Result<_, _>>()?)
        }
        "union" => {
            let mut result = None;
            for member in shape["members"].as_array().ok_or_else(invalid)? { if let Ok(value) = checked(member, value, depth + 1) { result = Some(value); break; } }
            result.ok_or_else(invalid)?
        }
        _ => return Err(invalid()),
    })
}

#[cfg(feature = "http")]
pub use reqwest::header::{HeaderMap, HeaderName, HeaderValue};
#[cfg(feature = "http")]
pub struct HttpTransport {
    endpoint: reqwest::Url,
    client: reqwest::blocking::Client,
    headers: Box<dyn Fn() -> Result<reqwest::header::HeaderMap, ApiError> + Send + Sync>,
}
#[cfg(feature = "http")]
impl HttpTransport {
    pub fn new(address: &str) -> Result<Self, ApiError> {
        let endpoint = reqwest::Url::parse(address).map_err(|_| ApiError::new("api-config", "Invalid API URL"))?;
        if !matches!(endpoint.scheme(), "http" | "https") || endpoint.username() != "" || endpoint.password().is_some() || endpoint.fragment().is_some() {
            return Err(ApiError::new("api-config", "Use an HTTP(S) API URL without credentials or fragment"));
        }
        let client = reqwest::blocking::Client::builder().redirect(reqwest::redirect::Policy::none())
            .retry(reqwest::retry::never()).timeout(std::time::Duration::from_secs(30))
            .connect_timeout(std::time::Duration::from_secs(5)).build()
            .map_err(|_| ApiError::new("api-config", "Cannot initialize HTTP transport"))?;
        Ok(Self { endpoint, client, headers:Box::new(|| Ok(reqwest::header::HeaderMap::new())) })
    }
    pub fn with_header_provider(mut self, provider: impl Fn() -> Result<reqwest::header::HeaderMap, ApiError> + Send + Sync + 'static) -> Self {
        self.headers = Box::new(provider); self
    }
}
#[cfg(feature = "http")]
impl Transport for HttpTransport {
    fn request(&self, request: Request<'_>) -> Result<Value, ApiError> {
        use std::io::Read;
        let headers = (self.headers)()?;
        if ["host", "content-length", "transfer-encoding", "connection"].iter().any(|name| headers.contains_key(*name)) {
            return Err(ApiError::new("api-config", "Custom headers cannot override HTTP routing or framing"));
        }
        let media = format!("application/json; tsrust-api={}; tsrust-operation={}", request.api_version, request.operation_contract);
        let body = serde_json::json!({"operation":request.operation,"input":request.input}).to_string();
        let response = self.client.post(self.endpoint.clone()).headers(headers)
            .header("accept", "application/json").header("content-type", media).header("x-tsrust-contract", request.contract_id)
            .body(body).send().map_err(|_| ApiError::new("api-network", "HTTP request failed; completion is unknown"))?;
        let status = response.status();
        let content = response.headers().get("content-type").and_then(|value| value.to_str().ok()).unwrap_or("");
        if content.split(';').next().unwrap_or("").trim().to_ascii_lowercase() != "application/json" { return Err(ApiError::new("api-protocol", "Expected an application/json response")); }
        if response.content_length().is_some_and(|length| length > 1_048_576) { return Err(ApiError::new("api-protocol", "API response exceeds 1 MiB")); }
        let mut bytes = Vec::new();
        response.take(1_048_577).read_to_end(&mut bytes).map_err(|_| ApiError::new("api-network", "Cannot read API response; completion is unknown"))?;
        if bytes.len() > 1_048_576 { return Err(ApiError::new("api-protocol", "API response exceeds 1 MiB")); }
        let value: Value = serde_json::from_slice(&bytes).map_err(|_| ApiError::new("api-protocol", "Malformed API response JSON"))?;
        if !status.is_success() && value["ok"] != false { return Err(ApiError::new("api-protocol", "Non-success HTTP response has no failure envelope")); }
        Ok(value)
    }
}
